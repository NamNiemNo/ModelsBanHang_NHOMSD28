@using BlazorKhachHang.Service.IService
@using BlazorKhachHang.Components.Pages
@using System.Linq

@inherits LayoutComponentBase
@implements IDisposable

@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IGioHangService GioHangService
@inject CartState CartState
@inject FavoriteState FavoriteState
@inject IGiayYeuThichService GiayYeuThichService

<link rel="preconnect"
      href="https://fonts.googleapis.com" />

<link rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin />

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap" />

<div class="site-shell">
    <header class="site-header">
        <div class="announcement-bar">
            <div class="announcement-inner">
                <div>
                    <i class="fa-solid fa-truck-fast"></i>
                    Miễn phí vận chuyển cho đơn hàng đủ điều kiện
                </div>

                <nav>
                    <a href="/Oder">
                        <i class="fa-solid fa-location-dot"></i>
                        Theo dõi đơn hàng
                    </a>

                    <a href="#">Trợ giúp</a>
                </nav>
            </div>
        </div>

        <div class="header-main">
            <div class="header-main-inner">
                <a href="/" class="brand">
                    <span class="brand-logo-frame">
                        <img src="/Logo.jpg"
                             alt="FSHOES"
                             class="brand-logo" />
                    </span>

                    <span class="brand-copy">
                        <strong>FSHOES</strong>
                        <small>Walk your own way</small>
                    </span>
                </a>

                <form class="search-bar"
                      @onsubmit="@OnSearchSubmit"
                      @onsubmit:preventDefault="true">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input type="search"
                           placeholder="Tìm giày, thương hiệu, kiểu dáng..."
                           autocomplete="off"
                           @bind="searchKeyword"
                           @bind:event="oninput" />

                    @if (!string.IsNullOrWhiteSpace(searchKeyword))
                    {
                        <button type="button"
                                class="clear-search"
                                title="Xóa từ khóa"
                                @onclick="@ClearSearch">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    }

                    <button type="submit"
                            class="search-submit">
                        Tìm kiếm
                    </button>
                </form>

                <div class="header-actions">
                    @if (string.IsNullOrWhiteSpace(currentUsername))
                    {
                        <a href="/login"
                           class="account-button">
                            <span class="account-avatar">
                                <i class="fa-regular fa-user"></i>
                            </span>

                            <span class="account-copy">
                                <small>Tài khoản</small>
                                <strong>Đăng nhập</strong>
                            </span>
                        </a>
                    }
                    else
                    {
                        <div class="logged-account">
                            <a href="/khachhang"
                               class="account-profile-link"
                               title="Xem thông tin của tôi">

                                <span class="account-avatar logged">
                                    <i class="fa-solid fa-user-check"></i>
                                </span>

                                <span class="account-copy">
                                    <small>Xin chào</small>
                                    <strong>@currentUsername</strong>
                                </span>
                            </a>

                            <button type="button"
                                    class="logout-button"
                                    title="Đăng xuất"
                                    @onclick="@HandleLogoutAsync">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                            </button>
                        </div>
                    }

                    <a href="/favourite"
                       class="action-button"
                       title="Sản phẩm yêu thích">

                        <i class="fa-regular fa-heart"></i>

                        @if (FavoriteState.FavoriteCount > 0)
                        {
                            <span class="action-badge">
                                @FormatBadge(FavoriteState.FavoriteCount)
                            </span>
                        }
                    </a>

                    <a href="/Cart"
                       class="action-button cart-button"
                       title="Giỏ hàng">

                        <i class="fa-solid fa-bag-shopping"></i>

                        @if (CartState.CartCount > 0)
                        {
                            <span class="action-badge">
                                @FormatBadge(CartState.CartCount)
                            </span>
                        }
                    </a>

                    <button type="button"
                            class="mobile-menu-button"
                            aria-label="Mở menu"
                            aria-expanded="@isMobileMenuOpen"
                            @onclick="@ToggleMobileMenu">
                        <i class="fa-solid @(isMobileMenuOpen
                                                ? "fa-xmark"
                                                : "fa-bars")">
                        </i>
                    </button>
                </div>
            </div>
        </div>

        <nav class="main-nav @(isMobileMenuOpen ? "is-open" : null)">
            <div class="main-nav-inner">
                <NavLink href="/"
                         Match="NavLinkMatch.All"
                         ActiveClass="active"
                         class="nav-link"
                         @onclick="@CloseMobileMenu">
                    <i class="fa-solid fa-house"></i>
                    Trang chủ
                </NavLink>

                <NavLink href="/shoelist"
                         ActiveClass="active"
                         class="nav-link"
                         @onclick="@CloseMobileMenu">
                    <i class="fa-solid fa-shoe-prints"></i>
                    Sản phẩm
                </NavLink>

                <NavLink href="/vouchers"
                         ActiveClass="active"
                         class="nav-link"
                         @onclick="@CloseMobileMenu">
                    <i class="fa-solid fa-ticket"></i>
                    Ưu đãi
                    <span class="nav-tag">HOT</span>
                </NavLink>

                <NavLink href="/blog"
                         ActiveClass="active"
                         class="nav-link"
                         @onclick="@CloseMobileMenu">
                    <i class="fa-regular fa-newspaper"></i>
                    Bài viết
                </NavLink>

                <NavLink href="/polish"
                         ActiveClass="active"
                         class="nav-link"
                         @onclick="@CloseMobileMenu">
                    <i class="fa-solid fa-spray-can-sparkles"></i>
                    Chăm sóc giày
                </NavLink>

                @if (!string.IsNullOrWhiteSpace(currentUsername))
                {
                    <NavLink href="/khachhang"
                             ActiveClass="active"
                             class="nav-link mobile-profile-link"
                             @onclick="@CloseMobileMenu">
                        <i class="fa-solid fa-user"></i>
                        Tài khoản
                    </NavLink>
                }
            </div>
        </nav>
    </header>

    <main class="page-content">
        @Body
    </main>

    <footer class="site-footer">
        <section class="service-strip">
            <div class="service-strip-inner">
                <div class="service-item">
                    <span class="service-icon">
                        <i class="fa-solid fa-truck-fast"></i>
                    </span>

                    <span>
                        <strong>Giao hàng nhanh</strong>
                        <small>Đóng gói cẩn thận, giao hàng toàn quốc</small>
                    </span>
                </div>

                <div class="service-item">
                    <span class="service-icon">
                        <i class="fa-solid fa-rotate-left"></i>
                    </span>

                    <span>
                        <strong>Đổi trả thuận tiện</strong>
                        <small>Hỗ trợ đổi sản phẩm theo chính sách</small>
                    </span>
                </div>

                <div class="service-item">
                    <span class="service-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                    </span>

                    <span>
                        <strong>Thanh toán an toàn</strong>
                        <small>Thông tin của bạn luôn được bảo mật</small>
                    </span>
                </div>
            </div>
        </section>

        <div class="footer-content">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a href="/" class="footer-logo">
                        <img src="/Logo.jpg" alt="FSHOES" />
                        <span>FSHOES</span>
                    </a>

                    <p>
                        Nơi bạn tìm thấy đôi giày phù hợp cho từng
                        phong cách, hành trình và khoảnh khắc.
                    </p>

                    <div class="social-links">
                        <a href="#" title="Facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>

                        <a href="#" title="Instagram">
                            <i class="fa-brands fa-instagram"></i>
                        </a>

                        <a href="#" title="TikTok">
                            <i class="fa-brands fa-tiktok"></i>
                        </a>

                        <a href="#" title="YouTube">
                            <i class="fa-brands fa-youtube"></i>
                        </a>
                    </div>
                </div>

                <div class="footer-column">
                    <h3>Mua sắm</h3>
                    <a href="/shoelist">Tất cả sản phẩm</a>
                    <a href="/vouchers">Khuyến mãi</a>
                    <a href="/favourite">Sản phẩm yêu thích</a>
                    <a href="/Cart">Giỏ hàng</a>
                </div>

                <div class="footer-column">
                    <h3>Hỗ trợ</h3>
                    <a href="/Oder">Theo dõi đơn hàng</a>
                    <a href="#">Chính sách đổi trả</a>
                    <a href="#">Hướng dẫn chọn size</a>
                    <a href="#">Câu hỏi thường gặp</a>
                </div>

                <div class="footer-column">
                    <h3>Liên hệ</h3>

                    <p>
                        <i class="fa-solid fa-location-dot"></i>
                        Ninh Bình, Việt Nam
                    </p>

                    <p>
                        <i class="fa-solid fa-phone"></i>
                        Hỗ trợ khách hàng
                    </p>

                    <p>
                        <i class="fa-regular fa-envelope"></i>
                        support@fshoes.vn
                    </p>
                </div>
            </div>

            <div class="footer-bottom">
                <span>
                    © @DateTime.Now.Year FSHOES. All rights reserved.
                </span>

                <div>
                    <a href="#">Điều khoản sử dụng</a>
                    <a href="#">Chính sách bảo mật</a>
                </div>
            </div>
        </div>
    </footer>

</div>

<style>
    :root {
        --brand: #7a4a2d;
        --brand-dark: #2c1c13;
        --brand-deep: #1c120d;
        --brand-light: #b98256;
        --accent: #e5b47b;
        --accent-soft: #f7ead9;
        --surface: #ffffff;
        --page-bg: #f8f6f3;
        --text: #241b16;
        --text-soft: #76685f;
        --border: #e9e1da;
        --danger: #d94b4b;
        --success: #228754;
        --content-width: 1380px;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        font-family: "DM Sans", sans-serif;
        background: var(--page-bg);
    }

    .site-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        color: var(--text);
        background: var(--page-bg);
    }

    .site-header {
        position: relative;
        z-index: 1000;
        background: #fff;
    }

    .announcement-bar {
        color: rgba(255, 255, 255, 0.9);
        background: linear-gradient( 110deg, var(--brand-deep), var(--brand-dark) );
    }

    .announcement-inner {
        width: min(calc(100% - 48px), var(--content-width));
        min-height: 36px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin: 0 auto;
        font-size: 11px;
    }

        .announcement-inner > div,
        .announcement-inner nav,
        .announcement-inner a {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .announcement-inner nav {
            gap: 20px;
        }

        .announcement-inner a {
            color: inherit;
            text-decoration: none;
        }

    .header-main {
        border-bottom: 1px solid #eee7e1;
        background: #fff;
    }

    .header-main-inner {
        width: min(calc(100% - 48px), var(--content-width));
        min-height: 91px;
        display: grid;
        grid-template-columns: auto minmax(300px, 620px) auto;
        align-items: center;
        gap: 32px;
        margin: 0 auto;
    }

    .brand {
        min-width: 205px;
        display: flex;
        align-items: center;
        gap: 11px;
        color: var(--text);
        text-decoration: none;
    }

    .brand-logo-frame {
        width: 64px;
        height: 64px;
        display: grid;
        place-items: center;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 17px;
        background: #fff;
        box-shadow: 0 6px 18px rgba(44, 28, 19, 0.07);
    }

    .brand-logo {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .brand-copy {
        display: flex;
        flex-direction: column;
    }

        .brand-copy strong {
            color: var(--brand-dark);
            font-family: "Playfair Display", serif;
            font-size: 24px;
            letter-spacing: 0.08em;
        }

        .brand-copy small {
            margin-top: 5px;
            color: var(--text-soft);
            font-size: 9px;
            letter-spacing: 0.13em;
            text-transform: uppercase;
        }

    .search-bar {
        min-width: 0;
        height: 49px;
        display: flex;
        align-items: center;
        overflow: hidden;
        padding-left: 17px;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: #faf7f2;
    }

        .search-bar:focus-within {
            border-color: var(--brand-light);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(185, 130, 86, 0.13);
        }

        .search-bar > i {
            color: var(--brand);
        }

        .search-bar input {
            min-width: 0;
            width: 100%;
            height: 100%;
            padding: 0 13px;
            border: none;
            outline: none;
            background: transparent;
            font-size: 13px;
        }

    .clear-search {
        width: 31px;
        height: 31px;
        border: none;
        border-radius: 50%;
        background: transparent;
        color: #8e7d72;
        cursor: pointer;
    }

    .search-submit {
        height: 39px;
        margin-right: 5px;
        padding: 0 17px;
        border: none;
        border-radius: 11px;
        background: linear-gradient( 135deg, var(--brand), var(--brand-dark) );
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .header-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 9px;
    }

    .account-button,
    .logged-account {
        min-width: 145px;
        height: 46px;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 4px 7px 4px 5px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: #fff;
        color: var(--text);
        text-decoration: none;
    }

        .account-button:hover,
        .logged-account:hover {
            border-color: #d5c0af;
            box-shadow: 0 6px 18px rgba(44, 28, 19, 0.08);
        }

    .account-profile-link {
        min-width: 0;
        display: flex;
        flex: 1;
        align-items: center;
        gap: 9px;
        color: inherit;
        text-decoration: none;
    }

    .account-avatar {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: var(--accent-soft);
        color: var(--brand);
    }

        .account-avatar.logged {
            background: #e5f5ec;
            color: var(--success);
        }

    .account-copy {
        min-width: 0;
        display: flex;
        flex: 1;
        flex-direction: column;
    }

        .account-copy small {
            color: var(--text-soft);
            font-size: 9px;
        }

        .account-copy strong {
            max-width: 105px;
            margin-top: 2px;
            overflow: hidden;
            color: var(--brand-dark);
            font-size: 11px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .logout-button {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: #b4a49a;
        cursor: pointer;
    }

        .logout-button:hover {
            background: #ffeded;
            color: var(--danger);
        }

    .action-button,
    .mobile-menu-button {
        position: relative;
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: #fff;
        color: var(--brand-dark);
        text-decoration: none;
        cursor: pointer;
    }

        .action-button:hover,
        .mobile-menu-button:hover {
            color: var(--brand);
            transform: translateY(-2px);
        }

    .cart-button {
        border-color: var(--brand-dark);
        background: var(--brand-dark);
        color: #fff;
    }

    .action-badge {
        position: absolute;
        top: -7px;
        right: -7px;
        min-width: 21px;
        height: 21px;
        display: grid;
        place-items: center;
        padding: 0 4px;
        border: 2px solid #fff;
        border-radius: 999px;
        background: var(--danger);
        color: #fff;
        font-size: 9px;
        font-weight: 800;
    }

    .mobile-menu-button {
        display: none;
    }

    .main-nav {
        border-bottom: 1px solid var(--border);
        background: #fff;
    }

    .main-nav-inner {
        width: min(calc(100% - 48px), var(--content-width));
        min-height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(27px, 4vw, 65px);
        margin: 0 auto;
    }

    .nav-link {
        position: relative;
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #756860;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-decoration: none;
        text-transform: uppercase;
    }

        .nav-link::after {
            position: absolute;
            right: 0;
            bottom: -1px;
            left: 0;
            height: 3px;
            border-radius: 3px 3px 0 0;
            background: linear-gradient( 90deg, var(--brand), var(--accent) );
            content: "";
            opacity: 0;
            transform: scaleX(0.4);
            transition: 0.2s;
        }

        .nav-link:hover,
        .nav-link.active {
            color: var(--brand-dark);
        }

            .nav-link:hover::after,
            .nav-link.active::after {
                opacity: 1;
                transform: scaleX(1);
            }

        .nav-link i {
            color: var(--brand-light);
        }

    .nav-tag {
        position: absolute;
        top: 0;
        right: -21px;
        padding: 2px 5px;
        border-radius: 5px;
        background: var(--danger);
        color: #fff;
        font-size: 7px;
    }

    .mobile-profile-link {
        display: none;
    }

    .page-content {
        width: 100%;
        min-height: 50vh;
        flex: 1;
    }

    .site-footer {
        margin-top: auto;
        background: var(--brand-deep);
    }

    .service-strip {
        border-bottom: 1px solid rgba(255, 255, 255, 0.09);
        background: #251811;
    }

    .service-strip-inner {
        width: min(calc(100% - 48px), var(--content-width));
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin: 0 auto;
    }

    .service-item {
        min-height: 105px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        padding: 20px 30px;
        color: #fff;
    }

        .service-item + .service-item {
            border-left: 1px solid rgba(255, 255, 255, 0.1);
        }

    .service-icon {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border: 1px solid rgba(229, 180, 123, 0.28);
        border-radius: 14px;
        background: rgba(229, 180, 123, 0.1);
        color: var(--accent);
    }

    .service-item > span:last-child {
        display: flex;
        flex-direction: column;
    }

    .service-item strong {
        font-size: 13px;
    }

    .service-item small {
        margin-top: 4px;
        color: rgba(255, 255, 255, 0.55);
        font-size: 10px;
    }

    .footer-content {
        width: min(calc(100% - 48px), var(--content-width));
        margin: 0 auto;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: minmax(260px, 1.4fr) repeat(3, minmax(145px, 0.7fr));
        gap: clamp(30px, 5vw, 75px);
        padding: 58px 0 43px;
    }

    .footer-logo {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        color: #fff;
        font-family: "Playfair Display", serif;
        font-size: 23px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-decoration: none;
    }

        .footer-logo img {
            width: 51px;
            height: 51px;
            object-fit: contain;
            border-radius: 13px;
            background: #fff;
        }

    .footer-brand > p {
        max-width: 350px;
        margin: 18px 0 22px;
        color: rgba(255, 255, 255, 0.57);
        font-size: 12px;
        line-height: 1.75;
    }

    .social-links {
        display: flex;
        gap: 8px;
    }

        .social-links a {
            width: 35px;
            height: 35px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 10px;
            color: rgba(255, 255, 255, 0.75);
            text-decoration: none;
        }

            .social-links a:hover {
                border-color: var(--accent);
                background: var(--accent);
                color: var(--brand-deep);
            }

    .footer-column {
        display: flex;
        align-items: flex-start;
        flex-direction: column;
        gap: 12px;
    }

        .footer-column h3 {
            margin: 0 0 7px;
            color: #fff;
            font-size: 13px;
            text-transform: uppercase;
        }

        .footer-column a,
        .footer-column p {
            margin: 0;
            color: rgba(255, 255, 255, 0.56);
            font-size: 12px;
            line-height: 1.5;
            text-decoration: none;
        }

            .footer-column a:hover {
                color: var(--accent);
            }

        .footer-column p {
            display: flex;
            align-items: flex-start;
            gap: 8px;
        }

            .footer-column p i {
                margin-top: 3px;
                color: var(--accent);
            }

    .footer-bottom {
        min-height: 65px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.09);
        color: rgba(255, 255, 255, 0.4);
