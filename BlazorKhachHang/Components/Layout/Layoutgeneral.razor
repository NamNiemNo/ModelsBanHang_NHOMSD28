@code {
    private string? currentUsername;
    private string searchKeyword = string.Empty;
    private bool isMobileMenuOpen;

    protected override void OnInitialized()
    {
        CartState.OnChange += HandleStateChanged;
        FavoriteState.OnChange += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var token = await JS.InvokeAsync<string?>(
            "localStorage.getItem",
            "authToken");

        currentUsername = await JS.InvokeAsync<string?>(
            "localStorage.getItem",
            "username");

        if (string.IsNullOrWhiteSpace(token))
        {
            currentUsername = null;
            CartState.SetCount(0);
            FavoriteState.SetCount(0);
        }
        else
        {
            await LoadCartCountAsync();
            await LoadFavoriteCountAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CartState.OnChange -= HandleStateChanged;
        FavoriteState.OnChange -= HandleStateChanged;
    }

    private void OnSearchSubmit()
    {
        if (string.IsNullOrWhiteSpace(searchKeyword))
        {
            return;
        }

        var keyword =
            Uri.EscapeDataString(searchKeyword.Trim());

        isMobileMenuOpen = false;

        Nav.NavigateTo(
            $"/shoelist?search={keyword}");
    }

    private void ClearSearch()
    {
        searchKeyword = string.Empty;
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }

    private static string FormatBadge(int count)
    {
        return count > 99 ? "99+" : count.ToString();
    }

    private async Task HandleLogoutAsync()
    {
        await RemoveLocalStorageItemAsync("authToken");
        await RemoveLocalStorageItemAsync("khachHangId");
        await RemoveLocalStorageItemAsync("username");
        await RemoveLocalStorageItemAsync("currentRole");
        await RemoveLocalStorageItemAsync("customerName");

        CartState.SetCount(0);
        FavoriteState.SetCount(0);

        currentUsername = null;
        isMobileMenuOpen = false;

        await JS.InvokeVoidAsync(
            "alert",
            "Đăng xuất thành công.");

        Nav.NavigateTo("/", forceLoad: true);
    }

    private async Task RemoveLocalStorageItemAsync(
        string key)
    {
        await JS.InvokeVoidAsync(
            "localStorage.removeItem",
            key);
    }

    private async Task LoadCartCountAsync()
    {
        try
        {
            var customerIdText =
                await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    "khachHangId");

            if (!Guid.TryParse(
                    customerIdText,
                    out var customerId))
            {
                CartState.SetCount(0);
                return;
            }

            var cart =
                await GioHangService
                    .LayTheoTaiKhoanAsync(customerId);

            CartState.SetCount(
                cart?.DanhSachChiTiet?.Count ?? 0);
        }
        catch
        {
            CartState.SetCount(0);
        }
    }

    private async Task LoadFavoriteCountAsync()
    {
        try
        {
            var customerIdText =
                await JS.InvokeAsync<string?>(
                    "localStorage.getItem",
                    "khachHangId");

            if (!Guid.TryParse(
                    customerIdText,
                    out var customerId))
            {
                FavoriteState.SetCount(0);
                return;
            }

            var favorites =
                await GiayYeuThichService
                    .GetAllByKhachHangAsync(customerId);

            FavoriteState.SetCount(
                favorites?.Count() ?? 0);
        }
        catch
        {
            FavoriteState.SetCount(0);
        }
    }
}
