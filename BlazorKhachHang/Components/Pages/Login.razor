```razor
@page "/login"
@layout Layout.EmptyLayout

@using API.Models.DTO
@using BlazorKhachHang.Service.IService
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Text.Json

@inject NavigationManager Nav
@inject ITaiKhoanService TaiKhoanService
@inject IJSRuntime JS

<style>
    body {
        margin: 0;
        padding: 0;
        background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%);
    }

    .login-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        width: 100%;
        padding: 20px;
        background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%);
    }

    .login-card {
        background: white;
        padding: 2.5rem;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        width: 100%;
        max-width: 450px;
        text-align: center;
    }

        .login-card h3 {
            font-weight: 600;
            margin-bottom: 2rem;
            color: #333;
            font-size: 2rem;
        }

    .form-control {
        border-radius: 8px;
        padding: 12px 15px;
        border: 1px solid #dee2e6;
        margin-bottom: 1rem;
        font-size: 1rem;
        width: 100%;
    }

    .btn-submit {
        background-color: #198754;
        border: none;
        padding: 12px;
        font-weight: bold;
        border-radius: 8px;
        color: white;
        font-size: 1.1rem;
        margin-top: 1rem;
        width: 100%;
    }

        .btn-submit:disabled {
            background-color: #999;
            cursor: not-allowed;
        }

    .switch-link {
        margin-top: 1.5rem;
        display: block;
        color: #6c757d;
        text-decoration: none;
        font-size: 0.95rem;
        cursor: pointer;
    }

        .switch-link:hover {
            color: #a18cd1;
            text-decoration: underline;
        }

    .error-message {
        color: #dc3545;
        background: #fce8e8;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 15px;
        text-align: left;
        font-size: 14px;
    }

    .success-message {
        color: #198754;
        background: #e8f5e9;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    .validation-message {
        display: block;
        color: #dc3545;
        text-align: left;
        font-size: 13px;
        margin-top: -10px;
        margin-bottom: 10px;
    }
</style>

<div class="login-wrapper">
    <div class="login-card">

        <h3>@(IsLoginFormVisible ? "Đăng Nhập" : "Đăng Ký")</h3>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="error-message">
                @ErrorMessage
            </div>
        }

        @if (!IsLoginFormVisible)
        {
            <EditForm Model="@RegisterInput"
                      OnValidSubmit="@OnSignup">

                <DataAnnotationsValidator />

                <InputText class="form-control"
                           placeholder="Họ và tên"
                           @bind-Value="RegisterInput.HoTen" />

                <ValidationMessage For="@(() => RegisterInput.HoTen)"
                                   class="validation-message" />

                <InputText class="form-control"
                           placeholder="Số điện thoại"
                           @bind-Value="RegisterInput.SoDienThoai" />

                <ValidationMessage For="@(() => RegisterInput.SoDienThoai)"
                                   class="validation-message" />

                <InputText class="form-control"
                           placeholder="Email"
                           @bind-Value="RegisterInput.Email" />

                <ValidationMessage For="@(() => RegisterInput.Email)"
                                   class="validation-message" />

                <InputText class="form-control"
                           placeholder="Tên đăng nhập"
                           @bind-Value="RegisterInput.Username" />

                <ValidationMessage For="@(() => RegisterInput.Username)"
                                   class="validation-message" />

                <InputText type="password"
                           class="form-control"
                           placeholder="Mật khẩu"
                           @bind-Value="RegisterInput.Password" />

                <ValidationMessage For="@(() => RegisterInput.Password)"
                                   class="validation-message" />

                <InputText type="password"
                           class="form-control"
                           placeholder="Xác nhận mật khẩu"
                           @bind-Value="RegisterInput.ConfirmPassword" />

                <ValidationMessage For="@(() => RegisterInput.ConfirmPassword)"
                                   class="validation-message" />

                <button type="submit"
                        class="btn-submit"
                        disabled="@IsSubmitting">

                    @(IsSubmitting ? "Đang đăng ký..." : "Đăng Ký")
                </button>

            </EditForm>
        }
        else
        {
            <EditForm Model="@LoginInput"
                      OnValidSubmit="@OnLogin">

                <DataAnnotationsValidator />

                <InputText class="form-control"
                           placeholder="Tên đăng nhập"
                           @bind-Value="LoginInput.Username" />

                <ValidationMessage For="@(() => LoginInput.Username)"
                                   class="validation-message" />

                <InputText type="password"
                           class="form-control"
                           placeholder="Mật khẩu"
                           @bind-Value="LoginInput.Password" />

                <ValidationMessage For="@(() => LoginInput.Password)"
                                   class="validation-message" />

                <button type="submit"
                        class="btn-submit"
                        disabled="@IsSubmitting">

                    @(IsSubmitting ? "Đang đăng nhập..." : "Đăng Nhập")
                </button>

            </EditForm>
        }

        <a class="switch-link"
           @onclick="SwitchForm">

            @(IsLoginFormVisible
                        ? "Chưa có tài khoản? Đăng ký ngay"
                        : "Đã có tài khoản? Đăng nhập")
        </a>

    </div>
</div>

@code {
    private bool IsLoginFormVisible = true;
    private bool IsSubmitting = false;

    private string ErrorMessage = "";

    private LoginInputModel LoginInput = new();

    private RegisterCustomerDTO RegisterInput = new();

    // =========================
    // CHUYỂN ĐỔI ĐĂNG NHẬP / ĐĂNG KÝ
    // =========================

    private void SwitchForm()
    {
        IsLoginFormVisible = !IsLoginFormVisible;

        ErrorMessage = "";

        LoginInput = new LoginInputModel();
        RegisterInput = new RegisterCustomerDTO();
    }

    // =========================
    // ĐĂNG NHẬP
    // =========================

    private async Task OnLogin()
    {
        if (IsSubmitting) return;

        try
        {
            IsSubmitting = true;
            ErrorMessage = "";

            var result = await TaiKhoanService.GetKhachHang(
                LoginInput.Username.Trim(),
                LoginInput.Password);

            if (result == null || !result.IsSuccess)
            {
                ErrorMessage = result?.Message
                    ?? "Tên đăng nhập hoặc mật khẩu không chính xác.";

                return;
            }

            await SaveCustomerInfo(
                result.Id,
                result.Username,
                result.HoTen,
                result.Email,
                result.SoDienThoai);

            Nav.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            ErrorMessage = "Lỗi đăng nhập: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    // =========================
    // ĐĂNG KÝ
    // =========================

    private async Task OnSignup()
    {
        if (IsSubmitting) return;

        try
        {
            IsSubmitting = true;
            ErrorMessage = "";

            RegisterInput.HoTen = RegisterInput.HoTen.Trim();
            RegisterInput.Username = RegisterInput.Username.Trim();
            RegisterInput.Email = RegisterInput.Email.Trim();
            RegisterInput.SoDienThoai = RegisterInput.SoDienThoai.Trim();

            // Gọi API đăng ký
            var response = await TaiKhoanService.RegisterCustomerAsync(
                RegisterInput);

            if (!response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();

                ErrorMessage = ExtractApiError(content);

                return;
            }

            // Đăng ký thành công, tiến hành đăng nhập
            var loginResult = await TaiKhoanService.GetKhachHang(
                RegisterInput.Username,
                RegisterInput.Password);

            if (loginResult == null || !loginResult.IsSuccess)
            {
                ErrorMessage =
                    "Đăng ký thành công nhưng đăng nhập tự động thất bại. " +
                    "Vui lòng chuyển sang đăng nhập bằng tài khoản vừa tạo.";

                return;
            }

            await SaveCustomerInfo(
                loginResult.Id,
                loginResult.Username,
                loginResult.HoTen,
                loginResult.Email,
                loginResult.SoDienThoai);

            await JS.InvokeVoidAsync(
                "alert",
                "Đăng ký tài khoản thành công!");

            Nav.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            ErrorMessage = "Không thể đăng ký tài khoản: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    // =========================
    // LƯU THÔNG TIN KHÁCH HÀNG
    // =========================

    private async Task SaveCustomerInfo(
        Guid id,
        string username,
        string name,
        string email,
        string phone)
    {
        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "khachHangId",
            id.ToString());

        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "username",
            username);

        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "name",
            name ?? "");

        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "email",
            email ?? "");

        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "phone",
            phone ?? "");
    }

    // =========================
    // HIỂN THỊ LỖI API
    // =========================

    private string ExtractApiError(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return "Đăng ký thất bại. Vui lòng thử lại.";

        try
        {
            using var document = JsonDocument.Parse(content);

            var root = document.RootElement;

            if (root.TryGetProperty("message", out var message))
            {
                return message.GetString()
                    ?? "Đăng ký thất bại.";
            }

            if (root.TryGetProperty("errors", out var errors))
            {
                var messages = new List<string>();

                foreach (var item in errors.EnumerateObject())
                {
                    foreach (var error in item.Value.EnumerateArray())
                    {
                        messages.Add(error.GetString() ?? "");
                    }
                }

                if (messages.Count > 0)
                    return string.Join(" ", messages);
            }

            if (root.TryGetProperty("title", out var title))
            {
                return title.GetString()
                    ?? "Dữ liệu đăng ký không hợp lệ.";
            }
        }
        catch
        {
            return content;
        }

        return content;
    }

    // =========================
    // MODEL ĐĂNG NHẬP
    // =========================

    public class LoginInputModel
    {
        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "Vui lòng nhập tên đăng nhập.")]
        public string Username { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "Vui lòng nhập mật khẩu.")]
        public string Password { get; set; } = "";
    }
}
