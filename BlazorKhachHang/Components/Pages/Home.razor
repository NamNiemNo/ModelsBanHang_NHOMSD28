@page "/"

@inject IGiayService GiayService
@inject IAnhService AnhService
@inject NavigationManager Nav

@using API.Models.DTO
@using BlazorKhachHang.Service.IService

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="home-page">

    <!-- ================= HERO ================= -->
    <section class="hero">
        <div class="hero-left">
            <span class="badge-new">NEW COLLECTION 2025</span>
            <h1>
                Sneakers That<br />
                Defy Your Every<br />
                Day Look
            </h1>
            <p>
                Discover the newest sneaker collection with premium quality and outstanding comfort.
            </p>
            <div class="hero-actions">
                <button class="shop-btn">Shop Now</button>
                <a href="#" class="explore-link">
                    Explore All <i class="fa fa-arrow-right"></i>
                </a>
            </div>
        </div>
        <div class="hero-right">
            <div class="hero-img-wrap">
                <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=900"
                     class="hero-shoe" alt="Hero Shoe" />
                <div class="hero-badge-float">
                    <span class="hbf-label">New Drop</span>
                    <span class="hbf-price">from 1.290.000 VND</span>
                </div>
            </div>
        </div>
        <div class="hero-dots">
            <span class="dot active"></span>
            <span class="dot"></span>
            <span class="dot"></span>
        </div>
    </section>

    <!-- ================= PROMOTION — 3 cot ngang ================= -->
    <section class="promo-section">
        <div class="promo-card">
            <img src="https://images.unsplash.com/photo-1543508282-6319a3e2621f?w=1200" alt="Promo 1" />
            <div class="overlay">
                <span class="promo-tag">PUMA</span>
                <h3>Sneakers That Move With You, Comfortable, Durable, And Always In Style.</h3>
                <button>Find Your Fit</button>
            </div>
        </div>
        <div class="promo-card">
            <img src="https://images.unsplash.com/photo-1460353581641-37baddab0fa2?w=900" alt="Promo 2" />
            <div class="overlay">
                <span class="promo-tag">NIKE</span>
                <h3>Fresh Drops. Iconic Silhouettes. Sneakers That Speak Before You Do.</h3>
                <button>Get Your Pair</button>
            </div>
        </div>
        <div class="promo-card">
            <img src="https://images.unsplash.com/photo-1491553895911-0055eca6402d?w=900" alt="Promo 3" />
            <div class="overlay style-stack">
                <h2>STYLE-STACK</h2>
                <button>Shop Sneakers</button>
            </div>
        </div>
    </section>

    <!-- ================= NEW ARRIVALS ================= -->
    <section class="collection-title">
        <span class="section-tag">NEW ARRIVALS</span>
        <h2>Newly Dropped Collections</h2>
        <p>These sneakers drops to timeless classics, we bring you authentic kicks built for style and comfort.</p>
    </section>

    <section class="product-grid">
        @foreach (var g in giayNew)
        {
            <div class="product-card"
                 @onclick="@(() => Nav.NavigateTo($"/detailShoeCategory/{g.GiayId}"))">
                <div class="card-top">
                    <span class="badge-discount">New Arrival</span>
                    <button class="wish-btn" @onclick:stopPropagation="true">
                        <i class="fa fa-heart"></i>
                    </button>
                    <div class="product-img-wrap">
                        <img src="@GetProductImage(g)"
                             onerror="this.src='/images/no-image.png'"
                             alt="@g.TenGiay" />
                    </div>
                </div>
                <div class="product-info">
                    <div class="price-row">
                        <span class="price">@string.Format("{0:N0} VND", g.ChiTietGiays.FirstOrDefault()?.Gia ?? 0)</span>
                        <span class="stock-tag">@(g.ChiTietGiays.FirstOrDefault()?.SoLuongCon ?? 0) in stock</span>
                    </div>
                    <h4>@g.TenGiay</h4>
                    <div class="stars">
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star-half-stroke"></i>
                    </div>
                    <p class="prod-desc">Bold style meets everyday comfort with premium craftsmanship.</p>
                    <div class="button-group">
                        <button class="cart-btn" @onclick:stopPropagation="true">
                            <i class="fa fa-cart-shopping"></i> Add to Cart
                        </button>
                        <button class="buy-btn" @onclick:stopPropagation="true">Buy Now</button>
                    </div>
                </div>
            </div>
        }
    </section>

    <!-- ================= BEST SELLER ================= -->
    <section class="collection-title">
        <span class="section-tag">FEATURED</span>
        <h2>Most Recommend Collections For You</h2>
        <p>These sneakers drops to timeless classics, we bring you authentic kicks built for style and comfort.</p>
    </section>

    <section class="product-grid">
        @foreach (var g in giayDeals)
        {
            <div class="product-card"
                 @onclick="@(() => Nav.NavigateTo($"/detailShoeCategory/{g.GiayId}"))">
                <div class="card-top">
                    <span class="badge-discount sale">Early Access</span>
                    <button class="wish-btn" @onclick:stopPropagation="true">
                        <i class="fa fa-heart"></i>
                    </button>
                    <div class="product-img-wrap">
                        <img src="@GetProductImage(g)"
                             onerror="this.src='/images/no-image.png'"
                             alt="@g.TenGiay" />
                    </div>
                </div>
                <div class="product-info">
                    <div class="price-row">
                        <span class="price">@string.Format("{0:N0} VND", g.ChiTietGiays.FirstOrDefault()?.Gia ?? 0)</span>
                    </div>
                    <h4>@g.TenGiay</h4>
                    <div class="stars">
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                    </div>
                    <p class="prod-desc">Bold style meets everyday comfort with premium craftsmanship.</p>
                    <div class="button-group">
                        <button class="cart-btn" @onclick:stopPropagation="true">
                            <i class="fa fa-cart-shopping"></i> Add to Cart
                        </button>
                        <button class="buy-btn" @onclick:stopPropagation="true">Buy Now</button>
                    </div>
                </div>
            </div>
        }
    </section>

    <div class="see-more-wrap">
        <button class="see-more-btn">See More Collections</button>
    </div>

    <!-- ================= RECOMMENDED COLLECTION ================= -->
    <section class="collection-title">
        <span class="section-tag">DISCOVER</span>
        <h2>Most Recommend Collections For You</h2>
        <p>These sneakers drops to timeless classics, we bring you authentic kicks built for style and comfort.</p>
    </section>

    <section class="recommend-grid">
        <div class="recommend-big">
            <img src="https://images.unsplash.com/photo-1514989940723-e8e51635b782?w=1200" alt="Urban" />
            <div class="recommend-content">
                <span class="rec-label">Urban Collection</span>
                <button>View all sneakers</button>
            </div>
        </div>
        <div class="recommend-small">
            <div class="recommend-card">
                <img src="https://images.unsplash.com/photo-1549298916-b41d501d3772?w=900" alt="Running" />
                <div class="recommend-content">
                    <span class="rec-label">Running</span>
                    <button>View</button>
                </div>
            </div>
            <div class="recommend-card">
                <img src="https://images.unsplash.com/photo-1600185365483-26d7a4cc7519?w=900" alt="Casual" />
                <div class="recommend-content">
                    <span class="rec-label">Casual</span>
                    <button>View</button>
                </div>
            </div>
        </div>
    </section>

    

 

</div>

@code {
    private List<GiayDTO> giayDeals = new();
    private List<GiayDTO> giayNew = new();
    private List<GiayDTO> giayBest = new();

    protected override async Task OnInitializedAsync()
    {
        var all = await GiayService.GetAllAsync();
        giayNew = all.Take(6).ToList();
        giayDeals = all.Where(x => x.ChiTietGiays.Any()).Take(6).ToList();
        giayBest = all.Skip(6).Take(6).ToList();
    }

    private string GetProductImage(GiayDTO g)
    {
        var path = g.ChiTietGiays.FirstOrDefault()?.AnhGiay;
        if (string.IsNullOrWhiteSpace(path)) return "/images/no-image.png";
        return $"https://localhost:7246{path}";
    }
}

<style>
    /* ============================================================
               TOKENS
               ============================================================ */
    :root {
        --cream: #f5f0e8;
        --cream-2: #ede7d9;
        --brown: #3d2c1e;
        --brown-mid: #6b4c35;
        --gold: #c49a6c;
        --warm-gray: #9e8f82;
        --white: #ffffff;
        --black: #1a1209;
        --font-display: 'Playfair Display', Georgia, serif;
        --font-body: 'DM Sans', sans-serif;
        --radius-sm: 8px;
        --radius-md: 16px;
        --shadow: 0 4px 24px rgba(61,44,30,0.10);
        --shadow-lg: 0 12px 48px rgba(61,44,30,0.18);
        --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Reset SCOPED to .home-page — không đè CSS trang khác (vd: login) */
    .home-page,
    .home-page *,
    .home-page *::before,
    .home-page *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .home-page {
        width: 100%;
        overflow-x: hidden;

        font-family: var(--font-body);
        background: var(--cream);
        color: var(--black);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
    }

        .home-page button {
            font-family: inherit;
        }

        .home-page a,
        .home-page button,
        .home-page input {
            outline-offset: 2px;
        }

            .home-page a:focus-visible,
            .home-page button:focus-visible,
            .home-page input:focus-visible {
                outline: 2px solid var(--gold);
            }

    /* ============================================================
               HERO
               ============================================================ */
    .hero {
        position: relative;
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 560px;
        max-height: 720px;
        background: linear-gradient(135deg, #b5916a 0%, #8b6748 40%, #5c3d2a 100%);
        padding: 0 48px 0 64px;
        overflow: hidden;
    }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 60% 80% at 70% 50%, rgba(245,240,232,0.08) 0%, transparent 70%);
            pointer-events: none;
        }

    .hero-left {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 20px;
        z-index: 2;
        padding: 60px 0;
    }

   
    .badge-new {
        display: inline-block;
        background: rgba(255,255,255,0.15);
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.25);
        color: var(--cream);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        padding: 6px 14px;
        border-radius: 50px;
        width: fit-content;
    }

    .hero-left h1 {
        font-family: var(--font-display);
        font-size: clamp(2.4rem, 4vw, 4rem);
        font-weight: 900;
        line-height: 1.1;
        color: var(--cream);
        letter-spacing: -0.03em;
    }

    .hero-left p {
        color: rgba(245,240,232,0.75);
        font-size: 0.975rem;
        line-height: 1.7;
        max-width: 340px;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 24px;
        margin-top: 8px;
    }

    .shop-btn {
        background: var(--cream);
        color: var(--brown);
        border: none;
        padding: 14px 32px;
        border-radius: var(--radius-sm);
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        letter-spacing: 0.02em;
        transition: all var(--transition);
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    }

        .shop-btn:hover {
            background: var(--brown);
            color: var(--cream);
            transform: translateY(-2px);
        }

    .explore-link {
        color: rgba(245,240,232,0.85);
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: gap var(--transition), color var(--transition);
    }

        .explore-link:hover {
            gap: 12px;
            color: var(--cream);
        }

    .hero-right {
        display: flex;
        align-items: flex-end;
        justify-content: center;
        z-index: 2;
        position: relative;
    }

    .hero-img-wrap {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    .hero-shoe {
        width: 90%;
        max-width: 520px;
        object-fit: contain;
        transform: rotate(-8deg) translateY(20px);
        filter: drop-shadow(0 24px 48px rgba(0,0,0,0.4));
        transition: transform 0.6s ease;
    }

        .hero-shoe:hover {
            transform: rotate(-4deg) translateY(10px) scale(1.02);
        }

    .hero-badge-float {
        position: absolute;
        bottom: 80px;
        right: 32px;
        background: rgba(245,240,232,0.95);
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        border-radius: var(--radius-md);
        padding: 12px 18px;
        box-shadow: var(--shadow-lg);
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .hbf-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--warm-gray);
        text-transform: uppercase;
    }

    .hbf-price {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
        color: var(--brown);
    }

    .hero-dots {
        position: absolute;
        bottom: 32px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 8px;
        z-index: 5;
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255,255,255,0.4);
        transition: all var(--transition);
    }

        .dot.active {
            background: var(--cream);
            width: 24px;
            border-radius: 4px;
        }

    /* ============================================================
               PROMO SECTION — 3 COT NGANG CO DINH
               ============================================================ */
    .promo-section {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        grid-template-rows: 360px;
        gap: 0;
        width: 100%;
    }

    .promo-card {
        position: relative;
        overflow: hidden;
        cursor: pointer;
    }

        .promo-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.6s ease;
        }

        .promo-card:hover img {
            transform: scale(1.06);
        }

        .promo-card .overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(30,18,8,0.85) 0%, rgba(30,18,8,0.15) 55%, transparent 100%);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 28px 24px;
            gap: 10px;
        }

    .promo-tag {
        display: inline-block;
        background: var(--cream);
        color: var(--brown);
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.15em;
        padding: 4px 10px;
        border-radius: 4px;
        width: fit-content;
    }

    .promo-card .overlay h3 {
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--cream);
        line-height: 1.4;
    }

    .promo-card .overlay button {
        background: var(--cream);
        color: var(--brown);
        border: none;
        padding: 9px 20px;
        border-radius: var(--radius-sm);
        font-weight: 700;
        font-size: 0.8rem;
        cursor: pointer;
        width: fit-content;
        transition: all var(--transition);
    }

        .promo-card .overlay button:hover {
            background: var(--brown);
            color: var(--cream);
        }

    .overlay.style-stack {
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(61,44,30,0.72) 0%, rgba(107,76,53,0.55) 100%);
    }

        .overlay.style-stack h2 {
            font-family: var(--font-display);
            font-size: 2.4rem;
            font-weight: 900;
            color: var(--cream);
            letter-spacing: -0.02em;
            text-align: center;
            line-height: 1;
            margin-bottom: 14px;
        }

    /* ============================================================
               SECTION TITLE
               ============================================================ */
    .collection-title {
        text-align: center;
        padding: 72px 48px 40px;
    }

    .section-tag {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        color: var(--gold);
        text-transform: uppercase;
        margin-bottom: 12px;
    }

        .section-tag.light {
            color: rgba(245,240,232,0.7);
        }

    .collection-title h2 {
        font-family: var(--font-display);
        font-size: clamp(1.8rem, 3vw, 2.6rem);
        font-weight: 900;
        color: var(--brown);
        letter-spacing: -0.03em;
        line-height: 1.2;
        margin-bottom: 12px;
    }

    .collection-title p {
        color: var(--warm-gray);
        font-size: 0.9rem;
        max-width: 480px;
        margin: 0 auto;
        line-height: 1.7;
    }

    /* ============================================================
               PRODUCT GRID
               ============================================================ */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        padding: 0 48px 48px;
    }

    .product-card {
        background: var(--white);
        border-radius: var(--radius-md);
        overflow: hidden;
        cursor: pointer;
        transition: transform var(--transition), box-shadow var(--transition);
        box-shadow: var(--shadow);
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-lg);
        }

    .card-top {
        position: relative;
        background: var(--cream);
        padding: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 220px;
    }

    .product-img-wrap {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .product-img-wrap img {
            max-width: 85%;
            max-height: 160px;
            object-fit: contain;
            transition: transform 0.5s ease;
        }

    .product-card:hover .product-img-wrap img {
        transform: scale(1.07) rotate(-2deg);
    }

    .badge-discount {
        position: absolute;
        top: 14px;
        left: 14px;
        background: var(--brown);
        color: var(--cream);
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        padding: 4px 10px;
        border-radius: 4px;
    }

        .badge-discount.sale {
            background: #d4522a;
        }

    .wish-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--white);
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--warm-gray);
        font-size: 0.85rem;
        transition: all var(--transition);
        box-shadow: 0 2px 8px rgba(61,44,30,0.12);
    }

        .wish-btn:hover {
            color: #d4522a;
            transform: scale(1.1);
        }

    .product-info {
        padding: 18px 20px 20px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .price-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .price {
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--brown);
    }

    .stock-tag {
        font-size: 0.7rem;
        color: #4caf50;
        font-weight: 600;
        background: rgba(76,175,80,0.08);
        padding: 3px 8px;
        border-radius: 4px;
        white-space: nowrap;
    }

    .product-info h4 {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
        color: var(--brown);
        line-height: 1.3;
    }

    .stars {
        color: #f59e0b;
        font-size: 0.75rem;
        letter-spacing: 2px;
    }

    .prod-desc {
        font-size: 0.78rem;
        color: var(--warm-gray);
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .button-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-top: 6px;
    }

    .cart-btn {
        background: var(--cream-2);
        color: var(--brown);
        border: none;
        padding: 10px 12px;
        border-radius: var(--radius-sm);
        font-weight: 600;
        font-size: 0.78rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all var(--transition);
    }

        .cart-btn:hover {
            background: var(--brown);
            color: var(--cream);
        }

    .buy-btn {
        background: var(--brown);
        color: var(--cream);
        border: none;
        padding: 10px 12px;
        border-radius: var(--radius-sm);
        font-weight: 700;
        font-size: 0.78rem;
        cursor: pointer;
        transition: all var(--transition);
    }

        .buy-btn:hover {
            background: var(--brown-mid);
            transform: translateY(-1px);
        }

    /* ============================================================
               SEE MORE
               ============================================================ */
    .see-more-wrap {
        display: flex;
        justify-content: center;
        padding: 0 0 64px;
    }

    .see-more-btn {
        background: none;
        border: 2px solid var(--brown);
        color: var(--brown);
        padding: 13px 40px;
        border-radius: var(--radius-sm);
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        letter-spacing: 0.04em;
        transition: all var(--transition);
    }

