@page "/checkout"
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@using API.Models.DTO
@using API.Models.DTO.BanHang
@using BlazorKhachHang.Service.IService
@using Data.Models
@using static BlazorKhachHang.Components.Pages.TaiKhoan.KhachHang
@inject IXuLyDiaChi xuLyDiaChi
@inject NavigationManager Nav
@inject IHoaDonService HoaDonService
@inject IJSRuntime JS
@inject IGioHangService GioHangService
@inject IVoucherService VoucherService
@inject HttpClient Http
<PageTitle>Checkout - Đặt hàng</PageTitle>

<style>
    .checkout-page {
        --cream: #f5f0e8;
        --cream-2: #ede7d9;
        --brown: #3d2c1e;
        --brown-mid: #6b4c35;
        --gold: #c49a6c;
        --warm-gray: #9e8f82;
        --border-color: #e5ddd0;
        background: var(--cream);
        font-family: 'DM Sans', sans-serif;
        color: #222;
        min-height: 100vh;
        padding: 30px 0;
    }

        .checkout-page .container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 30px;
            align-items: flex-start;
        }

        .checkout-page .checkout-form {
            background: #fff;
            padding: 30px 30px 20px 30px;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(61,44,30, 0.08);
            border: 1px solid var(--border-color);
        }

        .checkout-page .form-title {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 18px;
            color: var(--brown);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .checkout-page .freeship-box {
            background: #fff8e1;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 14px;
        }

        .checkout-page .text-success {
            color: #28a745;
            font-weight: 500;
        }

        .checkout-page .text-warning {
            color: #ff9800;
        }

        .checkout-page .address-btn {
            background: var(--brown);
            color: white;
            border: none;
            padding: 7px 18px;
            border-radius: 6px;
            font-size: 13px;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .checkout-page .address-btn:hover {
                background: var(--brown-mid);
                transform: translateY(-1px);
            }

        .checkout-page .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 0;
        }

        .checkout-page .form-group {
            margin-bottom: 0;
        }

            .checkout-page .form-group.full-width {
                grid-column: 1 / -1;
                margin-top: 15px;
            }

        .checkout-page .form-row.address-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 0;
        }

        .checkout-page label {
            display: block;
            margin-bottom: 6px;
            font-weight: 500;
            color: #222;
            font-size: 15px;
        }

        .checkout-page .required {
            color: #e74c3c;
            margin-right: 3px;
        }

        .checkout-page input,
        .checkout-page select,
        .checkout-page textarea {
            width: 100%;
            min-width: 0;
            box-sizing: border-box;
            padding: 11px 12px;
            border: 2px solid var(--border-color);
            border-radius: 8px;
            font-size: 15px;
            transition: all 0.3s ease;
            background: white;
            height: 44px;
            appearance: none;
        }

            .checkout-page input:focus,
            .checkout-page select:focus,
            .checkout-page textarea:focus {
                outline: none;
                border-color: var(--gold);
                box-shadow: 0 0 0 2px rgba(196, 154, 108, 0.15);
            }

        .checkout-page textarea {
            height: auto;
            min-height: 44px;
            resize: vertical;
        }

        .checkout-page .payment-section {
            margin-top: 18px;
            padding-top: 18px;
            border-top: 2px solid #f2f2f2;
        }

        .checkout-page .payment-title {
            font-size: 17px;
            font-weight: 600;
            margin-bottom: 12px;
            color: var(--brown);
        }

        .checkout-page .payment-options {
            display: flex;
            gap: 15px;
        }

        .checkout-page .payment-option {
            flex: 1 1 0;
            border: 2px solid var(--border-color);
            border-radius: 10px;
            padding: 14px 18px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 12px;
            background: #fff;
            min-width: 0;
            justify-content: center;
            height: 60px;
            box-sizing: border-box;
        }

            .checkout-page .payment-option:hover {
                border-color: var(--gold);
                background: var(--cream);
            }

            .checkout-page .payment-option.selected {
                border-color: var(--brown);
                background: var(--cream-2);
            }

        .checkout-page .payment-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: white;
            font-size: 20px;
            flex-shrink: 0;
        }

            .checkout-page .payment-icon.cod {
                background: var(--gold);
            }

            .checkout-page .payment-icon.vnpay {
                background: linear-gradient(45deg, var(--brown), var(--brown-mid));
            }

        .checkout-page .submit-btn {
            width: 100%;
            background: var(--brown);
            color: white;
            border: none;
            padding: 15px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 22px;
            transition: all 0.3s ease;
            letter-spacing: 1px;
        }

            .checkout-page .submit-btn:hover:not(:disabled) {
                background: var(--brown-mid);
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(61,44,30, 0.2);
            }

            .checkout-page .submit-btn:disabled {
                background: var(--warm-gray);
                cursor: not-allowed;
            }

        .checkout-page .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--brown-mid);
            text-decoration: none;
            margin-top: 18px;
            font-weight: 500;
            font-size: 15px;
            transition: all 0.3s ease;
        }

            .checkout-page .back-link:hover {
                color: var(--brown);
                transform: translateX(-3px);
            }

        .checkout-page .order-summary {
            background: #fff;
            padding: 25px 20px;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(61,44,30, 0.08);
            border: 1px solid var(--border-color);
            height: fit-content;
            position: sticky;
            top: 20px;
            min-width: 340px;
        }

        .checkout-page .product-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px 0;
            border-bottom: 1px solid #ecf0f1;
            position: relative;
        }

        .checkout-page .product-image {
            width: 70px;
            height: 70px;
            border-radius: 8px;
            object-fit: cover;
        }

        .checkout-page .product-info h4 {
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 3px;
            color: #222;
        }

        .checkout-page .product-size {
            background: var(--gold);
            color: white;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
            margin-top: 2px;
            display: inline-block;
        }

        .checkout-page .product-price {
            font-size: 15px;
            font-weight: 700;
            color: #e74c3c;
            margin-left: auto;
        }

        .checkout-page .quantity-badge {
            position: absolute;
            top: 8px;
            left: -10px;
            background: var(--brown);
            color: white;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: bold;
        }

        .checkout-page .discount-section {
            margin: 18px 0;
            display: flex;
            gap: 10px;
        }

        .checkout-page .discount-wrapper {
            display: flex;
            gap: 10px;
            width: 100%;
            position: relative;
        }

        .checkout-page .discount-input {
            flex: 1;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 15px;
        }

        .checkout-page .apply-btn {
            background: var(--brown);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 15px;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

            .checkout-page .apply-btn:hover {
                background: var(--brown-mid);
            }

        .checkout-page .voucher-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            margin-top: 8px;
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(61,44,30,0.15);
            padding: 15px;
            z-index: 20;
        }

        .checkout-page .voucher-item.active-voucher {
            background: var(--cream-2);
            border-left-color: var(--brown) !important;
        }

        .checkout-page .summary-row {
            display: flex;
            justify-content: space-between;
            margin: 10px 0;
            font-size: 14px;
        }

            .checkout-page .summary-row.shipping {
                color: #e74c3c;
            }

            .checkout-page .summary-row.discount {
                color: #27ae60;
            }

            .checkout-page .summary-row.total {
                border-top: 2px solid #ecf0f1;
                padding-top: 15px;
                margin-top: 20px;
                font-size: 18px;
                font-weight: 700;
                color: #e74c3c;
            }

        .checkout-page .delivery-date {
            text-align: center;
            margin: 15px 0;
            font-size: 14px;
            color: #7f8c8d;
        }

            .checkout-page .delivery-date strong {
                color: #e74c3c;
            }

        .checkout-page .alert {
            padding: 15px;
            margin: 15px 0;
            border-radius: 8px;
            font-weight: 500;
        }

        .checkout-page .alert-success {
            background-color: #d4edda;
            border: 1px solid #c3e6cb;
            color: #155724;
        }

        .checkout-page .alert-info {
            background-color: #cce7ff;
            border: 1px solid #b3d9ff;
            color: #004085;
        }

        .checkout-page input[type="radio"] {
            width: auto;
            height: auto;
            padding: 0;
            border: none;
            appearance: auto;
            transform: scale(1.2);
            cursor: pointer;
        }
</style>

<div class="checkout-page">
    <div class="container">
        <div class="checkout-form">
            <div class="form-title">
                Thông tin giao hàng
                <button type="button" class="address-btn" @onclick="() => IsAddressModalVisible = true">CHỌN ĐỊA CHỈ</button>
            </div>

            <EditForm Model="checkoutModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="form-row">
                    <div class="form-group">
                        <label><span class="required">*</span>Họ và tên</label>
                        <InputText @bind-Value="checkoutModel.FullName" required />
                        <ValidationMessage For="@(() => checkoutModel.FullName)" />
                    </div>
                    <div class="form-group">
                        <label><span class="required">*</span>Số điện thoại</label>
                        <InputText @bind-Value="checkoutModel.PhoneNumber" required />
                        <ValidationMessage For="@(() => checkoutModel.PhoneNumber)" />
                    </div>
                </div>

                <div class="form-row address-row">
                    <div class="form-group">
                        <label><span class="required">*</span>Tỉnh/thành phố</label>
                        <InputSelect Value="@Tinh"
                                     ValueChanged="@((string value) => OnTinhChanged(value))"
                                     ValueExpression="() => Tinh">
                            <option value="">Chọn Tỉnh</option>
                            @foreach (var t in TinhThanh)
                            {
                                <option value="@t.Ten">@t.Ten</option>
                            }
                        </InputSelect>

                        <ValidationMessage For="@(() => checkoutModel.Province)" />
                    </div>
                    <div class="form-group">
                        <label><span class="required">*</span>Quận/huyện</label>
                        <InputSelect Value="@Huyen"
                                     ValueChanged="@((string value) => OnHuyenChanged(value))"
                                     ValueExpression="() => Huyen">
                            <option value="">Chọn quận/huyện</option>
                            @foreach (var h in HuyenXa)
                            {
                                <option value="@h.Ten">@h.Ten</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => checkoutModel.District)" />
                    </div>
                    <div class="form-group">
                        <label><span class="required">*</span>Xã/thị trấn</label>
                        <InputSelect Value="@Phuong"
                                     ValueChanged="@((string value) => OnXaPhuongChanged(value))"
                                     ValueExpression="() => Phuong">
                            <option value="">Chọn xã/thị trấn</option>
                            @foreach (var x in XaPhuong)
                            {
                                <option value="@x.Ten">@x.Ten</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => checkoutModel.Ward)" />
                    </div>
                </div>

                <div class="form-group full-width">
                    <label><span class="required">*</span>Địa chỉ cụ thể</label>
                    <InputText @bind-Value="checkoutModel.SpecificAddress" required />
                    <ValidationMessage For="@(() => checkoutModel.SpecificAddress)" />
                </div>

                <div class="form-group full-width">
                    <label>Ghi chú</label>
                    <InputTextArea @bind-Value="checkoutModel.Notes" placeholder="Nhập ghi chú đơn hàng..." />
                </div>

                <div class="payment-section">
                    <div class="payment-title">Phương thức thanh toán</div>
                    <div class="payment-options">
                        <div class="payment-option @(checkoutModel.PaymentMethod == "cod" ? "selected" : "")"
                             @onclick='() => SelectPayment("cod")'>
                            <div class="payment-icon cod">📦</div>
                            <span>Thanh toán khi nhận hàng</span>
                        </div>
                        <div class="payment-option @(checkoutModel.PaymentMethod == "momo" ? "selected" : "")"
                             @onclick='() => SelectPayment("momo")'>
                            <div class="payment-icon"></div>
                            <span>Thanh toán online</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success">@successMessage</div>
                }

                @if (!string.IsNullOrEmpty(infoMessage))
                {
                    <div class="alert alert-info">@infoMessage</div>
                }

                <button type="submit" class="submit-btn" disabled="@isSubmitting">
                    HOÀN THÀNH ĐẶT HÀNG
                </button>
            </EditForm>

            <a href="/cart" class="back-link">
                ← Quay lại giỏ hàng
            </a>
        </div>

        <div class="order-summary">

            @* ====== MUA NGAY ====== *@
            @if (isBuyNow && buyNowItem != null)
            {
                <div class="product-item">
                    <div class="quantity-badge">@buyNowItem.SoLuong</div>

                    <img src="@GetFullImageUrl(buyNowItem.HinhAnh)"
                         class="product-image"
                         onerror="this.onerror=null;this.src='/images/no-image.png';" />

                    <div class="product-info">
                        <h4>@buyNowItem.TenGiay</h4>

                        <div class="product-size">
                            Size: @buyNowItem.Size
                        </div>

                        @if (!string.IsNullOrEmpty(buyNowItem.MauSac))
                        {
                            <div class="product-size" style="background:var(--brown-mid);margin-top:4px">
                                Màu: @buyNowItem.MauSac
                            </div>
                        }
                    </div>

                    <div class="product-price">
                        @((buyNowItem.Gia).ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))) VNĐ
                    </div>
                </div>
            }
            @* ====== THANH TOÁN TỪ GIỎ HÀNG ====== *@
            else if (checkoutItems.Any())
            {
                @foreach (var item in checkoutItems)
                {
                    <div class="product-item" @key="item.GioHangChiTietId">
                        <div class="quantity-badge">@item.SoLuong</div>

                        <img src="@GetFullImageUrl(item.HinhAnh)"
                             class="product-image"
                             onerror="this.onerror=null;this.src='/images/no-image.png';" />

                        <div class="product-info">
                            <h4>@item.TenGiay</h4>

                            <div class="product-size">
                                Size: @item.Size
                            </div>

                            @if (!string.IsNullOrEmpty(item.MauSac))
                            {
                                <div class="product-size" style="background:var(--brown-mid);margin-top:4px">
                                    Màu: @item.MauSac
                                </div>
                            }
                        </div>

                        <div class="product-price">
                            @item.Gia.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) VNĐ
                        </div>
                    </div>
                }
            }

            <div class="discount-section">
                <div class="discount-wrapper">
                    <input type="text"
                           placeholder="Mã giảm giá"
                           class="discount-input"
                           @bind="discountCode"
                           @bind:event="oninput"
                           @onkeydown="OnDiscountInputKeyDown">

                    <button type="button"
                            class="apply-btn"
                            @onclick="OnDiscountButtonClick"
                            style="@(selectedVoucherId != null ? "background:var(--brown-mid)" : "")">
                        @(selectedVoucherId == null && string.IsNullOrEmpty(discountCode) ? "Áp dụng" : "Đổi")
                    </button>

                    @if (showVoucherModal)
                    {
                        <div class="voucher-dropdown">
                            <div class="form-title" style="font-size: 15px; margin-bottom: 10px; display: flex; justify-content: space-between;">
                                Chọn mã giảm giá
                                <span style="cursor:pointer; color:#999" @onclick="() => showVoucherModal = false">×</span>
                            </div>

                            <div class="voucher-list" style="max-height: 250px; overflow-y: auto;">
                                @if (vouchers == null || !vouchers.Any())
                                {
                                    <p style="font-size:13px; color:#999; text-align:center">Không có mã giảm giá</p>
                                }
                                else
                                {
                                    @foreach (var v in vouchers)
                                    {
                                        var isDisabled = SubTotal < (decimal)v.DieuKienToiThieu;

                                        <div @key="v.VoucherId"
                                             class="voucher-item @(selectedVoucherId == v.VoucherId ? "active-voucher" : "")"
                                             style="
                                                         display:flex;
                                                         align-items:center;
                                                         gap:10px;
                                                         padding:10px;
                                                         border-bottom:1px solid #eee;
                                                         border-left:4px solid var(--gold);
                                                         margin-bottom:5px;
                                                         cursor:@(isDisabled ? "not-allowed" : "pointer");
                                                         opacity:@(isDisabled ? "0.4" : "1");
                                                     "
                                             @onclick="() => { if (!isDisabled) ToggleVoucher(v); }">

                                            <input type="radio"
                                                   checked="@(selectedVoucherId == v.VoucherId)"
                                                   disabled="@isDisabled"
                                                   @onclick:stopPropagation />

                                            <div style="flex:1">
                                                <div style="font-weight:600">
                                                    @v.TenVoucher
                                                </div>

                                                <div style="font-size:12px;color:#27ae60">
                                                    Giảm:
                                                    @(v.PhanTram > 0
                                                                                            ? $"{v.PhanTram}%"
                                                                                            : $"{v.SoTienGiam:N0} VNĐ")
                                    </div>

                                                <div style="font-size:11px;color:#999">
                                                    Đơn tối thiểu:
                                                    @v.DieuKienToiThieu.ToString("N0") VNĐ
                                                </div>

                                    @if (isDisabled)
                                                {
                                                    <div style="color:red;font-size:11px">
                                                        Cần thêm
                                                        @Math.Max(
                                                        0, ((decimal)v.DieuKienToiThieu - SubTotal)  ).ToString("N0")  VNĐ
                                    </div>
                                                                        }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <button type="button" class="apply-btn" style="width: 100%; margin-top: 10px; background: #f8f9fa; color: #333; border: 1px solid #ddd;"
                                    @onclick="() => showVoucherModal = false">
                                Đóng
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="summary-row shipping">
                <span>Phí vận chuyển</span>

                <span>
                    @shippingFee.ToString(
                             "N0",
                             CultureInfo.GetCultureInfo("vi-VN"))
                    VNĐ
                </span>
            </div>

            <div class="summary-row discount">
                <span>Giảm giá</span>

                <span>
                    @discountAmount.ToString(
                             "N0",
                             CultureInfo.GetCultureInfo("vi-VN"))
                    VNĐ
                </span>
            </div>

            <div class="delivery-date">
                Ngày nhận dự kiến:

                <strong>
                    @deliveryDate.ToString("dd-MM-yyyy")
                </strong>
            </div>

            <div class="summary-row total">
                <span>Tổng số tiền</span>

                <span>
                    @TotalAmount.ToString(
                             "N0",
                             CultureInfo.GetCultureInfo("vi-VN"))
                    VNĐ
                </span>
            </div>

            <div class="freeship-box mt-2">
                @if (SubTotal < freeShippingThreshold)
                {
                    <small class="text-warning">
                        🚚 Mua thêm
                        <b>
                            @amountToFreeShipping.ToString("N0")đ
                        </b>
                        để được miễn phí vận chuyển
                    </small>
                }
                else
                {
                    <small class="text-success">
                        🎉 Bạn đã được miễn phí vận chuyển
                    </small>
                }
            </div>
        </div>
    </div>
</div>

<ChonDiaChi IsAddressModalVisible="@IsAddressModalVisible"
            OnAddressSelected="HandleAddressSelected"
            OnClose="CloseAddressModal" />

@code {
    private string BaseApiUrl = "https://localhost:7246";
    private CheckoutModel checkoutModel = new();
    private string discountCode = "";
    private decimal shippingFee = 0m;

    private decimal freeShippingThreshold =
    2_000_000m;

    private decimal amountToFreeShipping =
    2_000_000m;

    private decimal discountAmount = 0m;

    private DateTime deliveryDate =
    DateTime.Today.AddDays(3);
    private string successMessage = "";
    private string infoMessage = "";
    private bool IsAddressModalVisible = false;
    private List<DiaChi> TinhThanh = new();
    private List<DiaChi> HuyenXa = new();
    private List<DiaChi> XaPhuong = new();
    private GioHangDTO? gioHang;
    private BuyNowItem? buyNowItem;
    private bool isBuyNow = false;
    private List<GioHangChiTietDTO> checkoutItems = new();
    private bool isSubmitting = false;
    private Guid? appliedVoucherId;
    private List<Voucher> vouchers = new();
    private bool showVoucherModal = false;
    private Guid? selectedVoucherId;

    private bool _loaded = false;

    protected override async Task OnInitializedAsync()
    {
        TinhThanh = await xuLyDiaChi.ParseDiaChiAsync("wwwroot/Files/ThanhPho.txt");
        deliveryDate = DateTime.Now.AddDays(3);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_loaded)
        {
            _loaded = true;

            vouchers = (await VoucherService.GetAll())
                .Where(v =>
                    v.TrangThai &&
                    v.NgayBatDau <= DateTime.Now &&
                    v.NgayKetThuc >= DateTime.Now &&
                    v.SoLuong > 0)
                .ToList();

            var buyNowJson = await JS.InvokeAsync<string>("localStorage.getItem", "buyNowItem");
            var checkoutJson = await JS.InvokeAsync<string>("localStorage.getItem", "checkoutItems");

            if (!string.IsNullOrEmpty(buyNowJson))
            {
                buyNowItem = System.Text.Json.JsonSerializer.Deserialize<BuyNowItem>(buyNowJson);
                isBuyNow = true;
            }
            else if (!string.IsNullOrEmpty(checkoutJson))
            {
                checkoutItems = System.Text.Json.JsonSerializer
                    .Deserialize<List<GioHangChiTietDTO>>(checkoutJson) ?? new();
            }
            else
            {
                var khachHangIdStr =
                    await JS.InvokeAsync<string>("localStorage.getItem", "khachHangId");

                if (!string.IsNullOrEmpty(khachHangIdStr))
                {
                    gioHang = await GioHangService.LayTheoTaiKhoanAsync(
                        Guid.Parse(khachHangIdStr)
                    );
                }
            }

            StateHasChanged();
        }
    }

        private string Tinh = "";

        private async Task OnTinhChanged(string value)
        {
            Tinh = value?.Trim() ?? "";

            var tinh = TinhThanh.FirstOrDefault(
            item => item.Ten == Tinh);

            HuyenXa =
            tinh?.Con ?? new List<DiaChi>();

            XaPhuong =
            new List<DiaChi>();

            Huyen = "";
            Phuong = "";

            checkoutModel.Province = Tinh;
            checkoutModel.District = "";
            checkoutModel.Ward = "";

            await RefreshShippingFeeAsync();

            StateHasChanged();
        }

        private string Huyen = "";
    void OnHuyenChanged(string value)
    {
        Huyen = value;

        var huyen = HuyenXa.FirstOrDefault(h => h.Ten == Huyen);
        XaPhuong = huyen?.Con ?? new();

        Phuong = "";
        checkoutModel.District = Huyen;
    }

    private string Phuong = "";
    void OnXaPhuongChanged(string value)
    {
        Phuong = value;
        checkoutModel.Ward = Phuong;
    }

    private void SelectPayment(string paymentType)
    {
        checkoutModel.PaymentMethod = paymentType;
        StateHasChanged();
