    // Gõ Enter trong ô mã giảm giá -> tự động áp dụng
    private async Task OnDiscountInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(discountCode))
        {
            await ApplyDiscount();
        }
    }

    // Bấm nút cạnh ô input: nếu đã gõ mã tay thì áp dụng luôn,
    // ngược lại mở danh sách voucher để chọn
    private async Task OnDiscountButtonClick()
    {
        if (!string.IsNullOrWhiteSpace(discountCode) && selectedVoucherId == null)
        {
            await ApplyDiscount();
        }
        else
        {
            showVoucherModal = !showVoucherModal;
        }
    }

    private async Task ApplyDiscount()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(discountCode))
                return;

            var voucher = await VoucherService.GetByCodeAsync(discountCode);

            if (voucher == null)
            {
                discountAmount = 0;
                appliedVoucherId = null;
                selectedVoucherId = null;
                infoMessage = "❌ Voucher không tồn tại";
                return;
            }

            var tongTien = SubTotal;

            if (DateTime.Now < voucher.NgayBatDau || DateTime.Now > voucher.NgayKetThuc)
            {
                discountAmount = 0;
                appliedVoucherId = null;
                selectedVoucherId = null;
                infoMessage = "❌ Voucher hết hạn";
                return;
            }

            if (tongTien < (decimal)voucher.DieuKienToiThieu)
            {
                discountAmount = 0;
                appliedVoucherId = null;
                selectedVoucherId = null;
                infoMessage = $"❌ Đơn tối thiểu {voucher.DieuKienToiThieu:N0} VNĐ";
                return;
            }

            decimal discount = 0;

            if (voucher.PhanTram > 0)
            {
                discount = tongTien * (decimal)voucher.PhanTram / 100;
            }
            else
            {
                discount = (decimal)voucher.SoTienGiam;
            }
                // GiamToiDa bằng 0 được hiểu là không giới hạn.
            if (voucher.GiamToiDa > 0)
                {
                    discount = Math.Min(
                    discount,
                    (decimal)voucher.GiamToiDa);
            }
                // Không cho tiền giảm âm hoặc lớn hơn tiền hàng.
            discount = Math.Min(tongTien, Math.Max(0m, discount));
            discountAmount = discount;
            appliedVoucherId = voucher.VoucherId;
            selectedVoucherId = voucher.VoucherId;
            discountCode = voucher.TenVoucher;

            infoMessage = $"✅ Áp dụng voucher {voucher.TenVoucher} thành công";
            successMessage = "";

            StateHasChanged();
        }
        catch
        {
            discountAmount = 0;
            appliedVoucherId = null;
            selectedVoucherId = null;
            infoMessage = "❌ Lỗi khi áp dụng voucher";
        }
    }

        private decimal SubTotal =>
        isBuyNow && buyNowItem != null
        ? buyNowItem.SoLuong * buyNowItem.Gia
        : checkoutItems.Any()
        ? checkoutItems.Sum(
        item =>
        item.SoLuong * item.Gia)
        : gioHang?.DanhSachChiTiet?
        .Where(item => item.IsSelected)
        .Sum(item =>
        item.SoLuong * item.Gia)
        ?? 0m;

        private decimal TotalAmount =>
        Math.Max(
        0m,
        SubTotal +
        shippingFee -
        discountAmount);

        private async Task HandleSubmit()
        {
            // Ngăn người dùng bấm nút đặt hàng nhiều lần.
            if (isSubmitting)
            {
                return;
            }

            successMessage = "";
            infoMessage = "";

            // =====================================================
            // 1. KIỂM TRA THÔNG TIN GIAO HÀNG
            // =====================================================

            if (string.IsNullOrWhiteSpace(
            checkoutModel.FullName))
            {
                infoMessage =
                "❌ Vui lòng nhập họ tên người nhận.";

                return;
            }

            if (string.IsNullOrWhiteSpace(
            checkoutModel.PhoneNumber))
            {
                infoMessage =
                "❌ Vui lòng nhập số điện thoại.";

                return;
            }

            if (string.IsNullOrWhiteSpace(
            checkoutModel.Province) ||
            string.IsNullOrWhiteSpace(
            checkoutModel.District) ||
            string.IsNullOrWhiteSpace(
            checkoutModel.Ward))
            {
                infoMessage =
                "❌ Vui lòng chọn đầy đủ tỉnh, " +
                "quận/huyện và xã/phường.";

                return;
            }

            if (string.IsNullOrWhiteSpace(
            checkoutModel.SpecificAddress))
            {
                infoMessage =
                "❌ Vui lòng nhập địa chỉ cụ thể.";

                return;
            }

            // Đồng bộ lại biến tỉnh trước khi gọi API.
            Tinh = checkoutModel.Province.Trim();

            // =====================================================
            // 2. LẤY PHÍ SHIP MỚI NHẤT TỪ API
            // =====================================================

            bool shippingLoaded =
            await RefreshShippingFeeAsync();

            if (!shippingLoaded)
            {
                infoMessage =
                "❌ Chưa lấy được phí vận chuyển. " +
                "Vui lòng kiểm tra lại tỉnh/thành phố.";

                return;
            }

            // =====================================================
            // 3. TẠO DANH SÁCH SẢN PHẨM ĐẶT HÀNG
            // =====================================================

            var orderItems =
            new List<DatHang.DatHangItem>();

            // Trường hợp mua ngay.
            if (isBuyNow && buyNowItem != null)
            {
                orderItems.Add(
                new DatHang.DatHangItem
                {
                    GioHangChiTietId =
                Guid.Empty,

                    GiayChiTietId =
                buyNowItem.GiayChiTietId,

                    SoLuong =
                buyNowItem.SoLuong,

                    Gia =
                buyNowItem.Gia
                });
            }
            // Trường hợp thanh toán sản phẩm
            // được lưu trong checkoutItems.
            else if (checkoutItems.Any())
            {
                orderItems = checkoutItems
                .Where(item =>
                item.IsSelected ||
                checkoutItems.All(x => !x.IsSelected))
                .Select(item =>
                new DatHang.DatHangItem
                {
                    GioHangChiTietId =
                item.GioHangChiTietId,

                    GiayChiTietId =
                item.GiayChiTietId,

                    SoLuong =
                item.SoLuong,

                    Gia =
                item.Gia
                })
                .ToList();
            }
            // Trường hợp lấy sản phẩm trực tiếp từ giỏ hàng.
            else if (gioHang?.DanhSachChiTiet != null)
            {
                orderItems = gioHang.DanhSachChiTiet
                .Where(item => item.IsSelected)
                .Select(item =>
                new DatHang.DatHangItem
                {
                    GioHangChiTietId =
                item.GioHangChiTietId,

                    GiayChiTietId =
                item.GiayChiTietId,

                    SoLuong =
                item.SoLuong,

                    Gia =
                item.Gia
                })
                .ToList();
            }

            if (orderItems.Count == 0)
            {
                infoMessage =
                "❌ Bạn chưa chọn sản phẩm để thanh toán.";

                return;
            }

            if (orderItems.Any(item =>
            item.GiayChiTietId == Guid.Empty ||
            item.SoLuong <= 0 ||
            item.Gia < 0))
            {
                infoMessage =
                "❌ Sản phẩm hoặc số lượng không hợp lệ.";

                return;
            }

            // =====================================================
            // 4. LẤY ID KHÁCH HÀNG
            // =====================================================

            string khachHangIdStr =
            await JS.InvokeAsync<string>(
            "localStorage.getItem",
            "khachHangId");

            if (string.IsNullOrWhiteSpace(
            khachHangIdStr) ||
            !Guid.TryParse(
            khachHangIdStr,
            out Guid khachHangId))
            {
                infoMessage =
                "❌ Không xác định được khách hàng. " +
                "Vui lòng đăng nhập lại.";

                return;
            }

            // =====================================================
            // 5. XÁC NHẬN ĐẶT HÀNG
            // =====================================================

            bool confirm =
            await JS.InvokeAsync<bool>(
            "confirm",
            $"Tiền hàng: {SubTotal:N0} VNĐ\n" +
            $"Phí vận chuyển: {shippingFee:N0} VNĐ\n" +
            $"Giảm giá: {discountAmount:N0} VNĐ\n" +
            $"Tổng thanh toán: {TotalAmount:N0} VNĐ\n\n" +
            "Bạn có chắc muốn đặt hàng không?");

            if (!confirm)
            {
                infoMessage =
                "❌ Bạn đã hủy đặt hàng.";

                return;
            }

            isSubmitting = true;

            try
            {
                // =====================================================
                // 6. XÁC ĐỊNH HÌNH THỨC THANH TOÁN
                // =====================================================

                Guid hinhThucThanhToanId =
                checkoutModel.PaymentMethod == "cod"
                ? Guid.Parse(
                "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa")
                : Guid.Parse(
                "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb");

                // =====================================================
                // 7. TẠO REQUEST ĐẶT HÀNG
                // =====================================================

                var request =
                new DatHang.DatHangRequest
                {
                    KhachHangId =
                khachHangId,

                    TenNguoiNhan =
                checkoutModel.FullName.Trim(),

                    SoDienThoai =
                checkoutModel.PhoneNumber.Trim(),

                    DiaChi =
                $"{checkoutModel.SpecificAddress.Trim()}, " +
                $"{checkoutModel.Ward.Trim()}, " +
                $"{checkoutModel.District.Trim()}, " +
                $"{checkoutModel.Province.Trim()}",

                    // Gửi riêng tỉnh/thành phố
                    // để API tính phí ship.
                    TinhThanhPho =
                checkoutModel.Province.Trim(),

                    // Hai giá trị này chỉ dùng để giao diện
                    // hiển thị. API sẽ tự tính lại.
                    PhiShip =
                (float)shippingFee,

                    TongTienSauKhiGiam =
                (float)TotalAmount,

                    VoucherId =
                appliedVoucherId,

                    GhiChu =
                checkoutModel.Notes?.Trim(),

                    HinhThucThanhToanId =
                hinhThucThanhToanId,

                    PaymentMethod =
                checkoutModel.PaymentMethod,

                    Items =
                orderItems
                };

                // =====================================================
                // 8. THANH TOÁN MOMO HOẶC THẺ
                // =====================================================

                if (checkoutModel.PaymentMethod == "momo" ||
                checkoutModel.PaymentMethod == "card")
                {
                    var response =
                    await Http.PostAsJsonAsync(
                    "api/Payment/CreateMomoPayment",
                    request);

                    if (!response.IsSuccessStatusCode)
                    {
                        string error =
                        await response.Content
                        .ReadAsStringAsync();

                        infoMessage =
                        string.IsNullOrWhiteSpace(error)
                        ? "❌ Không tạo được thanh toán MoMo."
                        : $"❌ {error}";

                        return;
                    }

                    var momoResponse =
                    await response.Content
                    .ReadFromJsonAsync<
                    API.Models.Momo.MomoPaymentResponse>();

                    if (momoResponse == null ||
                    string.IsNullOrWhiteSpace(
                    momoResponse.PayUrl))
                    {
                        infoMessage =
                        "❌ Không lấy được đường dẫn " +
                        "thanh toán MoMo.";

                        return;
                    }

                    // Xóa dữ liệu thanh toán tạm.
                    await JS.InvokeVoidAsync(
                    "localStorage.removeItem",
                    "buyNowItem");

                    await JS.InvokeVoidAsync(
                    "localStorage.removeItem",
                    "checkoutItems");

                    // Chuyển khách hàng sang trang MoMo.
                    Nav.NavigateTo(
                    momoResponse.PayUrl,
                    forceLoad: true);

                    return;
                }

                // =====================================================
                // 9. THANH TOÁN COD
                // =====================================================

                bool orderSuccess =
                await HoaDonService.DatHangAsync(
                request);

                if (!orderSuccess)
                {
                    infoMessage =
                    "❌ Đặt hàng thất bại. " +
                    "Vui lòng kiểm tra lại thông tin.";

                    return;
                }

                // =====================================================
                // 10. XÓA DỮ LIỆU TẠM SAU KHI ĐẶT HÀNG
                // =====================================================

                await JS.InvokeVoidAsync(
                "localStorage.removeItem",
                "buyNowItem");

                await JS.InvokeVoidAsync(
                "localStorage.removeItem",
                "checkoutItems");

                successMessage =
                "✅ Đặt hàng thành công.";

                infoMessage = "";

                StateHasChanged();

                await Task.Delay(1200);

                Nav.NavigateTo(
                "/Oder",
                forceLoad: true);
            }
            catch (HttpRequestException exception)
            {
                infoMessage =
                "❌ Không kết nối được với API. " +
                "Vui lòng kiểm tra lại API.";

                Console.WriteLine(
                $"Lỗi kết nối API: {exception.Message}");
            }
            catch (Exception exception)
            {
                infoMessage =
                "❌ Có lỗi xảy ra khi đặt hàng. " +
                "Vui lòng thử lại.";

                Console.WriteLine(
                $"Lỗi đặt hàng: {exception.Message}");
            }
            finally
            {
                isSubmitting = false;
            }
        }

        private async Task<bool> RefreshShippingFeeAsync()
        {
            if (string.IsNullOrWhiteSpace(Tinh))
            {
                shippingFee = 0m;

                amountToFreeShipping = Math.Max(
                0m,
                freeShippingThreshold - SubTotal);

                deliveryDate =
                DateTime.Today.AddDays(3);

                return false;
            }

            try
            {
                var request =
                new DatHang.TinhPhiShipRequest
                {
                    TinhThanhPho = Tinh,
                    TamTinh = SubTotal
                };

                var result =
                await HoaDonService.TinhPhiShipAsync(
                request);

                shippingFee =
                result.PhiShip;

                freeShippingThreshold =
                result.MienPhiTu;

                amountToFreeShipping =
                result.ConThieuDeMienPhi;

                deliveryDate =
                result.NgayGiaoDuKien;

                return true;
            }
            catch (Exception exception)
            {
                shippingFee = 0m;

                amountToFreeShipping = Math.Max(
                0m,
                freeShippingThreshold - SubTotal);

                deliveryDate =
                DateTime.Today.AddDays(3);

                infoMessage =
                "❌ Không lấy được phí vận chuyển " +
                "từ API. Vui lòng thử lại.";

                Console.WriteLine(
                $"Lỗi tính phí ship: {exception.Message}");

                return false;
            }
        }

        private async Task HandleAddressSelected(
        DiaChiKhachHang diaChi)
        {
            var khachHangIdStr =
            await JS.InvokeAsync<string>(
            "localStorage.getItem",
            "khachHangId");

            if (!string.IsNullOrWhiteSpace(
            khachHangIdStr) &&
            Guid.TryParse(
            khachHangIdStr,
            out Guid khachHangId))
            {
                var khachHang =
                await Http.GetFromJsonAsync<
                KhachHangUpdateDTO>(
                $"api/KhachHang/{khachHangId}");

                if (khachHang != null)
                {
                    checkoutModel.FullName =
                    khachHang.HoTen;

                    checkoutModel.PhoneNumber =
                    khachHang.SoDienThoai;
                }
            }

            checkoutModel.SpecificAddress =
            diaChi.DiaChiCuThe;

            Tinh =
            diaChi.ThanhPho?.Trim() ?? "";

            Huyen =
            diaChi.QuanHuyen?.Trim() ?? "";

            Phuong =
            diaChi.PhuongXa?.Trim() ?? "";

            var tinh = TinhThanh.FirstOrDefault(
            item => item.Ten == Tinh);

            HuyenXa =
            tinh?.Con ?? new List<DiaChi>();

            var huyen = HuyenXa.FirstOrDefault(
            item => item.Ten == Huyen);

            XaPhuong =
            huyen?.Con ?? new List<DiaChi>();

            checkoutModel.Province = Tinh;
            checkoutModel.District = Huyen;
            checkoutModel.Ward = Phuong;

            await RefreshShippingFeeAsync();

            StateHasChanged();
        }

        public class CheckoutModel
    {
        [Required(ErrorMessage = "Họ và tên là bắt buộc")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Số điện thoại là bắt buộc")]
        [Phone(ErrorMessage = "Số điện thoại không hợp lệ")]
        public string PhoneNumber { get; set; } = "";

        [Required(ErrorMessage = "Tỉnh/thành phố là bắt buộc")]
        public string Province { get; set; } = "";

        [Required(ErrorMessage = "Quận/huyện là bắt buộc")]
        public string District { get; set; } = "";

        [Required(ErrorMessage = "Xã/thị trấn là bắt buộc")]
        public string Ward { get; set; } = "";

        [Required(ErrorMessage = "Địa chỉ cụ thể là bắt buộc")]
        public string SpecificAddress { get; set; } = "";

        public string Notes { get; set; } = "";

        [Required]
        public string PaymentMethod { get; set; } = "cod";
    }

