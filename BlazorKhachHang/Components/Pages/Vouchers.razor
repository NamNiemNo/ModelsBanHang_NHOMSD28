@page "/vouchers"
@using Data.Models
@using BlazorKhachHang.Service.IService
@inject IVoucherService voucherService

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<div class="voucher-page">
    <h2 class="text-center my-4">🎁 Voucher khuyến mãi</h2>

    <div class="container">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border" role="status" style="color: var(--brown, #3d2c1e);">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
            </div>
        }
        else if (danhSachVoucher.Any())
        {
            <div class="row g-4">
                @foreach (var item in danhSachVoucher)
                {
                    var conHan = item.NgayKetThuc > DateTime.Now;
                    <div class="col-md-4" @key="item.VoucherId">
                        <div class="card voucher-card h-100 border-0 shadow-sm">
                            <span class="status-badge badge @(conHan ? "badge-active" : "badge-expired")">
                                @(conHan ? "Còn hiệu lực" : "Hết hạn")
                            </span>
                            <div class="voucher-header text-center">
                                <h1 class="mb-0">@item.PhanTram%</h1>
                                <small>GIẢM GIÁ</small>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="fw-bold">@item.TenVoucher</h5>
                                <p class="text-muted">
                                    Ưu đãi dành riêng cho bạn
                                </p>
                                <div class="flex-grow-1">
                                    <p>
                                        <b>Giảm tối đa:</b>
                                        @item.GiamToiDa.ToString("N0") đ
                                    </p>
                                    <p>
                                        <b>Đơn tối thiểu:</b>
                                        @item.DieuKienToiThieu.ToString("N0") đ
                                    </p>
                                    <p>
                                        <b>Hết hạn:</b>
                                        @item.NgayKetThuc.ToString("dd/MM/yyyy")
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5>Hiện chưa có voucher nào</h5>
            </div>
        }
    </div>
</div>

<style>
    .voucher-page {
        --cream: #f5f0e8;
        --brown: #3d2c1e;
        --brown-mid: #6b4c35;
        --gold: #c49a6c;
        --warm-gray: #9e8f82;
        background-color: var(--cream);
        min-height: 100vh;
        padding-bottom: 40px;
        font-family: 'DM Sans', sans-serif;
    }

        .voucher-page h2 {
            font-family: 'Playfair Display', serif;
            color: var(--brown);
        }

    .voucher-card {
        position: relative;
        transition: .3s;
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
    }

        .voucher-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(61,44,30,.15);
        }

    .voucher-header {
        background: linear-gradient(135deg, var(--brown) 0%, var(--brown-mid) 100%);
        color: var(--cream);
        padding: 35px;
    }

        .voucher-header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 50px;
            font-weight: bold;
            color: var(--gold);
        }

    .status-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 10;
    }

    .badge-active {
        background-color: #2e7d32;
        color: #fff;
    }

    .badge-expired {
        background-color: #a71d2a;
        color: #fff;
    }

    .voucher-page .card-body b {
        color: var(--brown);
    }
</style>

@code {
    private List<Voucher> danhSachVoucher = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await voucherService.GetAll() ?? new List<Voucher>();
            danhSachVoucher = all.Where(x => x.TrangThai).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }
}