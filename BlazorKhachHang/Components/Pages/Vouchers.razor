@page "/vouchers"
@using Data.Models
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS

<div class="voucher-page">
    <h2 class="text-center my-4">🎁 Voucher của tôi</h2>
    <div class="container">
        @if (isLoading)
        {
            <div class="text-center py-5"><div class="spinner-border" role="status"><span class="visually-hidden">Đang tải...</span></div></div>
        }
        else if (khachHangId == Guid.Empty)
        {
            <div class="text-center py-5"><h5>Vui lòng đăng nhập để xem voucher được cấp cho bạn.</h5></div>
        }
        else if (danhSachVoucher.Any())
        {
            <div class="row g-4">
                @foreach (var assigned in danhSachVoucher)
                {
                    var item = assigned.Voucher;
                    if (item is null) { continue; }
                    var conHan = item.NgayBatDau <= DateTime.Now && item.NgayKetThuc >= DateTime.Now && item.TrangThai && item.SoLuong > 0;
                    <div class="col-md-4" @key="assigned.Id">
                        <div class="card voucher-card h-100 border-0 shadow-sm">
                            <span class="status-badge badge @(assigned.DaSuDung ? "badge-expired" : conHan ? "badge-active" : "badge-expired")">
                                @(assigned.DaSuDung ? "Đã sử dụng" : conHan ? "Có thể sử dụng" : item.SoLuong <= 0 ? "Đã hết lượt" : "Chưa đến hạn / hết hạn")
                            </span>
                            <div class="voucher-header text-center">
                                <h1 class="mb-0">@(item.PhanTram > 0 ? $"{item.PhanTram:0.##}%" : item.SoTienGiam.ToString("N0") + "đ")</h1>
                                <small>ƯU ĐÃI NIVO</small>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="fw-bold">@item.TenVoucher</h5>
                                <div class="flex-grow-1">
                                    <p><b>Giảm tối đa:</b> @item.GiamToiDa.ToString("N0") đ</p>
                                    <p><b>Đơn tối thiểu:</b> @item.DieuKienToiThieu.ToString("N0") đ</p>
                                    <p><b>Hiệu lực:</b> @item.NgayBatDau.ToString("dd/MM/yyyy HH:mm") – @item.NgayKetThuc.ToString("dd/MM/yyyy HH:mm")</p>
                                    <p><b>Lượt còn lại:</b> @item.SoLuong</p>
                                    <p><b>Ngày nhận:</b> @assigned.NgayTao.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5"><h5>Bạn chưa được cấp voucher nào.</h5><p class="text-muted">Voucher sẽ xuất hiện tại đây sau khi NIVO gửi tặng bạn.</p></div>
        }
    </div>
</div>

<style>
    .voucher-page {
        --cream: #f5f0e8;
        --brown: #3d2c1e;
        --brown-mid: #6b4c35;
        --gold: #c49a6c;
        --warm-gray: #9e8f82;
        background-color: var(--cream);
        min-height: 100vh;
        padding-bottom: 40px;
        font-family: 'DM Sans', sans-serif;
    }

        .voucher-page h2 {
            font-family: 'Playfair Display', serif;
            color: var(--brown);
        }

    .voucher-card {
        position: relative;
        transition: .3s;
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
    }

        .voucher-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(61,44,30,.15);
        }

    .voucher-header {
        background: linear-gradient(135deg, var(--brown) 0%, var(--brown-mid) 100%);
        color: var(--cream);
        padding: 35px;
    }

        .voucher-header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 50px;
            font-weight: bold;
            color: var(--gold);
        }

    .status-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 10;
    }

    .badge-active {
        background-color: #2e7d32;
        color: #fff;
    }

    .badge-expired {
        background-color: #a71d2a;
        color: #fff;
    }

    .voucher-page .card-body b {
        color: var(--brown);
    }
</style>

@code {
    private List<KhachHangVoucher> danhSachVoucher = new();
    private bool isLoading = true;
    private Guid khachHangId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var id = await JS.InvokeAsync<string>("localStorage.getItem", "khachHangId");
            if (!Guid.TryParse(id, out khachHangId)) return;
            danhSachVoucher = await Http.GetFromJsonAsync<List<KhachHangVoucher>>($"api/KhachHangVoucher/by-khachhang/{khachHangId}") ?? new();
        }
        catch
        {
            danhSachVoucher = new();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
