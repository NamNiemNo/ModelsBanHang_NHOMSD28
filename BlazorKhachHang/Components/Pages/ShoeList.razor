@page "/shoelist"
@rendermode InteractiveServer
@using Data.Models
@using BlazorKhachHang.Service.IService
@using API.Models.DTO
@inject IGiayChiTietService chiTietService
@inject IGiayService service
@inject IGiayYeuThichService giayYeuThichService
@inject IGioHangService gioHangService
@inject NavigationManager manager
@inject IJSRuntime JS
@inject FavoriteState FavoriteState

<style>
    /* Dùng đúng bảng màu của trang Home để đồng bộ toàn site */
    .shoelist-page {
        --cream: #f5f0e8;
        --cream-2: #ede7d9;
        --brown: #3d2c1e;
        --brown-mid: #6b4c35;
        --gold: #c49a6c;
        --warm-gray: #9e8f82;
        --white: #ffffff;
        --black: #1a1209;
        --border-color: #e5ddd0;
        background-color: var(--cream);
        color: var(--black);
        font-family: 'DM Sans', sans-serif;
        min-height: 100vh;
        padding-bottom: 40px;
    }

    /* Breadcrumb & Tiêu đề */
    .breadcrumb-wrapper {
        background-color: var(--cream);
        padding: 30px 0;
        text-align: center;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 30px;
    }

    .breadcrumb h2 {
        font-family: 'Playfair Display', serif;
        color: var(--brown);
        font-size: 36px;
        font-weight: 700;
        margin: 0;
    }

    /* Layout chính */
    .container-layout {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 40px;
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* Aside Filter */
    .filter-sidebar {
        background: var(--white);
        padding: 25px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        height: fit-content;
    }

        .filter-sidebar strong {
            display: block;
            font-family: 'Playfair Display', serif;
            font-size: 18px;
            color: var(--brown);
            margin-bottom: 15px;
            margin-top: 10px;
        }

        .filter-sidebar label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            cursor: pointer;
            color: var(--black);
        }

        .filter-sidebar input[type="checkbox"] {
            accent-color: var(--gold);
            margin-right: 10px;
        }

    .filter-group {
        margin-top: 25px;
        border-top: 1px solid var(--border-color);
        padding-top: 20px;
    }

    .color-options {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    /* Swatch màu — CHỈ dùng background qua inline style, viền xử lý hoàn toàn bằng class */
    .color {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        cursor: pointer;
        border: 3px solid transparent;
        box-sizing: border-box;
        transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
    }

        .color:hover {
            transform: scale(1.08);
        }

        /* Viền xám mặc định cho màu trắng để không "biến mất" trên nền trắng */
        .color.white-swatch {
            border-color: #ddd;
        }

        /* Đánh dấu màu đang được chọn — viền đỏ nổi bật, ưu tiên cao nhất */
        .color.selected {
            border-color: #e53935 !important;
            box-shadow: 0 0 0 2px rgba(229, 57, 53, 0.18);
        }

    /* Section header */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--white);
        padding: 15px 25px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        margin-bottom: 30px;
    }

    .search-input {
        padding: 10px 15px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        width: 300px;
        font-size: 14px;
        background: var(--cream);
        color: var(--black);
    }

        .search-input:focus-visible {
            outline: 2px solid var(--gold);
        }

    .sort-dropdown {
        padding: 10px 15px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-size: 14px;
        cursor: pointer;
        background: var(--white);
        color: var(--black);
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
    }

    /* Product Card */
    .product-card {
        background: var(--white);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
        position: relative;
        text-align: left;
        cursor: pointer;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(61,44,30,0.10);
        }

    .product-img-container {
        position: relative;
        background-color: var(--cream);
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 250px;
    }

        .product-img-container img {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
        }

    .sale-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        background: var(--brown);
        color: var(--cream);
        font-size: 11px;
        font-weight: 700;
        padding: 5px 10px;
        border-radius: 5px;
    }

    .favorite-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(255, 255, 255, 0.85);
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s;
    }

        .favorite-btn:hover {
            background: var(--white);
        }

        .favorite-btn i.fas {
            color: #c0392b;
        }

        .favorite-btn i.far {
            color: var(--warm-gray);
        }

    .product-info {
        padding: 20px;
    }

    .product-title {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        color: var(--brown);
        margin-bottom: 8px;
        font-weight: 600;
        margin-top: 0;
    }

    .price-row {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-top: 10px;
    }

    .main-price {
        color: var(--brown);
        font-weight: bold;
        font-size: 18px;
    }

    .old-price {
        text-decoration: line-through;
        color: var(--warm-gray);
        font-size: 14px;
    }

    .saving {
        font-size: 12px;
        color: var(--warm-gray);
        margin-top: 5px;
        font-style: italic;
    }

    .rating {
        margin-top: 15px;
        border-top: 1px solid var(--cream-2);
        padding-top: 10px;
    }

    .stars {
        color: var(--gold);
        font-size: 13px;
    }

    .rating-count {
        color: var(--warm-gray);
        font-size: 12px;
    }

    /* Responsive */
    @@media (max-width: 900px) {
        .container-layout {
            grid-template-columns: 1fr;
        }

        .search-input {
            width: 200px;
        }
    }
</style>

<div class="shoelist-page">
    <main class="container-layout">
        <aside class="filter-sidebar">
            <strong>Thương Hiệu</strong>
            @foreach (var brand in brandList)
            {
                <label @key="brand">
                    <input type="checkbox"
                           checked="@(IsBrandSelected.ContainsKey(brand) && IsBrandSelected[brand])"
                           @onchange="(e) => OnBrandChanged(brand, (bool)e.Value!)" />
                    @brand
                </label>
            }

            <div class="filter-group">
                <strong>Khoảng Giá</strong>
                @foreach (var range in priceRanges)
                {
                    <label @key="range.Label">
                        <input type="checkbox"
                               @onchange="@(() => OnPriceRangeChanged(range.Label))"
                               checked="@selectedPriceLabels.Contains(range.Label)" />
                        @range.Label
                    </label>
                }
            </div>

            <div class="filter-group">
                <strong>Màu Sắc</strong>
                <div class="color-options">
                    @foreach (var color in colorList)
                    {
                        bool isSelected = selectedColors.Contains(color);
                        bool isWhite = color.Equals("White", StringComparison.OrdinalIgnoreCase);

                        <span @key="color"
                              class="color @(isWhite ? "white-swatch" : "") @(isSelected ? "selected" : "")"
                              style="background: @color"
                              title="@color"
                              @onclick="() => OnColorFilterChanged(color)">
                        </span>
                    }
                </div>
            </div>
        </aside>

        <section class="product-section">
            <div class="section-header">
                <input type="text" class="search-input"
                       placeholder="Tìm theo tên giày..."
                       @bind="searchKeyword"
                       @bind:event="oninput" />

                <select class="sort-dropdown">
                    <option>Best selling</option>
                    <option>Price: Low to High</option>
                    <option>Price: High to Low</option>
                </select>
            </div>

            <div class="product-grid">
                @if (giayList != null && giayList.Count > 0)
                {
                    @foreach (var giay in giayList.Where(g => g.TrangThai && g.ChiTietGiays != null && g.ChiTietGiays.Any()))
                    {
                        var bestVariant = giay.ChiTietGiays
                        .OrderBy(ct => ct.Gia)
                        .First();

                        decimal giaHienTai = (decimal)bestVariant.Gia;
                        decimal giaGoc = (decimal)bestVariant.GiaGoc;

                        int phanTramGiam = 0;
                        if (bestVariant.DaGiamGia && giaGoc > 0)
                        {
                            phanTramGiam = (int)Math.Round((double)(giaGoc - giaHienTai) * 100 / (double)giaGoc);
                        }

                        <div @key="giay.GiayId" class="product-card" @onclick="@(() => NavigateToDetail(giay.GiayId))">
                            <div class="product-img-container">

                                <img src="@GetFullImageUrl(bestVariant.AnhGiay)" alt="@giay.TenGiay" />

                                @if (bestVariant.DaGiamGia)
                                {
                                    <div class="sale-badge">
                                        -@phanTramGiam%
                                    </div>
                                }

                                <div class="favorite-btn"
                                     @onclick:stopPropagation="true"
                                     @onclick="async () => await ToggleFavorite(giay.GiayId)">

                                    <i class="@(IsFavorite(giay.GiayId) ? "fas fa-heart" : "far fa-heart")"></i>

                                </div>

                            </div>

                            <div class="product-info">
                                <h4 class="product-title">@giay.TenGiay</h4>

                                <div class="price-row">
                                    <span class="main-price">
                                        @giaHienTai.ToString("N0")đ
                                    </span>

                                    @if (bestVariant.DaGiamGia)
                                    {
                                        <span class="old-price">
                                            @giaGoc.ToString("N0")đ
                                        </span>
                                    }
                                </div>

                                @if (bestVariant.DaGiamGia)
                                {
                                    <div class="saving">
                                        Tiết kiệm @((giaGoc - giaHienTai).ToString("N0"))đ
                                    </div>
                                }
                                <div class="rating">
                                    <span class="stars">★★★★★</span>
                                    <span class="rating-count">(12,500 đánh giá)</span>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; padding: 50px; background: var(--white); border-radius: 12px; grid-column: 1/-1;">
                        <i class="far fa-frown" style="font-size: 48px; color: var(--warm-gray); margin-bottom: 15px;"></i>
                        <p style="color: var(--warm-gray); font-size: 16px;">Không tìm thấy sản phẩm nào phù hợp...</p>
                    </div>
                }
            </div>
        </section>
    </main>
</div>

@code {
    private string BaseApiUrl = "https://localhost:7246";
    private List<GiayDTO> giayList = new();
    private List<GiayDTO> allGiayList = new();
    private List<GiayYeuThichDTO> danhSachYeuThich = new();

    private Guid khachHangId;
    private HashSet<string> selectedBrands = new();
    private Dictionary<string, bool> IsBrandSelected = new();
    private List<string> brandList = new();
    private HashSet<string> favoriteIds = new();

    private List<(string Label, decimal? Min, decimal? Max)> priceRanges = new()
    {
        ("Dưới 200.000đ", null, 200_000),
        ("200.000đ - 500.000đ", 200_000, 500_000),
        ("500.000đ - 1.000.000đ", 500_000, 1_000_000),
        ("1.000.000đ - 2.000.000đ", 1_000_000, 2_000_000),
        ("Trên 2.000.000đ", 2_000_000, null)
    };

    private HashSet<string> selectedPriceLabels = new();
    private List<string> colorList = new() { "Red", "Green", "Blue", "Yellow", "Black", "White", "Beige", "Brown" };
    private HashSet<string> selectedColors = new();

    private string _searchKeyword = "";
    private string searchKeyword
    {
        get => _searchKeyword;
        set
        {
            _searchKeyword = value;
            FilterGiayList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var khachId = await JS.InvokeAsync<string>(
                "localStorage.getItem",
                "khachHangId");

            if (!string.IsNullOrEmpty(khachId))
            {
                khachHangId = Guid.Parse(khachId);

                danhSachYeuThich =
                    (await giayYeuThichService
                    .GetAllByKhachHangAsync(khachHangId))
                    .ToList();
            }

            var giayListFromApi =
                await service.GetAllAsync()
                ?? new List<GiayDTO>();

            var chiTietList =
                await chiTietService.GetAllAsync()
                ?? new List<GiayChiTietDTO>();

            allGiayList = giayListFromApi.Select(g => new GiayDTO
            {
                GiayId = g.GiayId,
                TenGiay = g.TenGiay,

                TenThuongHieu =
                    string.IsNullOrEmpty(g.TenThuongHieu)
                    ? "Chưa có thương hiệu"
                    : g.TenThuongHieu,

                TrangThai = g.TrangThai,

                ChiTietGiays = chiTietList
                    .Where(ct => ct.GiayId == g.GiayId)
                    .ToList()

            }).ToList();

            brandList = allGiayList
                .Where(x => !string.IsNullOrWhiteSpace(x.TenThuongHieu))
                .Select(x => x.TenThuongHieu!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();

            IsBrandSelected =
                brandList.ToDictionary(b => b, b => false);

            FilterGiayList();

            StateHasChanged();
        }
    }

    private void FilterGiayList()
    {
        IEnumerable<GiayDTO> query = allGiayList;

        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            query = query.Where(g =>
                !string.IsNullOrEmpty(g.TenGiay) &&
                g.TenGiay.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase));
        }

        selectedBrands = IsBrandSelected
            .Where(x => x.Value)
            .Select(x => x.Key.Trim())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (selectedBrands.Any())
        {
            query = query.Where(g =>
                !string.IsNullOrWhiteSpace(g.TenThuongHieu) &&
                selectedBrands.Contains(g.TenThuongHieu.Trim(), StringComparer.OrdinalIgnoreCase));
        }

        if (selectedPriceLabels.Any())
        {
            query = query.Where(g =>
                g.ChiTietGiays != null && g.ChiTietGiays.Any() &&
                priceRanges.Any(range =>
                {
                    var minPrice = (decimal)g.ChiTietGiays.Min(ct => ct.Gia);
                    return selectedPriceLabels.Contains(range.Label) &&
                           (!range.Min.HasValue || minPrice >= range.Min.Value) &&
                           (!range.Max.HasValue || minPrice <= range.Max.Value);
                }));
        }

        if (selectedColors.Any())
        {
            query = query.Where(g =>
                g.ChiTietGiays != null &&
                g.ChiTietGiays.Any(ct =>
                    !string.IsNullOrEmpty(ct.TenMau) &&
                    selectedColors.Contains(ConvertTenMauToColor(ct.TenMau))
                ));
        }

        giayList = query.OrderByDescending(g => IsFavorite(g.GiayId)).ToList();
    }

    private void OnBrandChanged(string brand, bool isChecked)
    {
        IsBrandSelected[brand] = isChecked;
        FilterGiayList();
        StateHasChanged();
    }

    private void OnPriceRangeChanged(string label)
    {
        if (selectedPriceLabels.Contains(label))
            selectedPriceLabels.Remove(label);
        else
            selectedPriceLabels.Add(label);

        FilterGiayList();
        StateHasChanged();
    }

    private void OnColorFilterChanged(string color)
    {
        // Single-select: bấm màu đang chọn -> bỏ chọn; bấm màu khác -> thay thế hoàn toàn
        if (selectedColors.Contains(color))
        {
            selectedColors.Clear();
        }
        else
        {
            selectedColors.Clear();
            selectedColors.Add(color);
        }

        FilterGiayList();
        StateHasChanged();
    }

    private bool IsFavorite(Guid giayId) => danhSachYeuThich.Any(f => f.GiayId == giayId);

    private void NavigateToDetail(Guid giayId) => manager.NavigateTo($"/detailShoeCategory/{giayId}");

    private string ConvertTenMauToColor(string tenMau)
    {
        return tenMau.ToLower() switch
        {
            "đen" => "Black",
            "đỏ" => "Red",
            "trắng" => "White",
            "vàng" => "Yellow",
            "xanh dương" => "Blue",
            "xanh lá" => "Green",
            "kem" => "Beige",
            "nâu" => "Brown",
            _ => "Grey"
        };
    }

    private async Task ToggleFavorite(Guid giayId)
    {
        try
        {
            if (khachHangId == Guid.Empty)
            {
                await JS.InvokeVoidAsync("alert", "Bạn cần đăng nhập");
                return;
            }

            bool isFav = IsFavorite(giayId);

            await giayYeuThichService.ToggleFavoriteAsync(giayId, khachHangId);

            if (isFav)
            {
                var item = danhSachYeuThich.FirstOrDefault(x => x.GiayId == giayId);
                if (item != null)
                    danhSachYeuThich.Remove(item);

                FavoriteState.Decrease();
            }
            else
            {
                danhSachYeuThich.Add(new GiayYeuThichDTO { GiayId = giayId });
                FavoriteState.Increase();
            }

            FilterGiayList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            await JS.InvokeVoidAsync("alert", "❌ Lỗi khi cập nhật yêu thích");
        }
    }

    private string GetFullImageUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return "/images/no-image.png";

        if (path.StartsWith("http"))
            return path;

        return $"{BaseApiUrl.TrimEnd('/')}/{path.TrimStart('/')}";
    }
}