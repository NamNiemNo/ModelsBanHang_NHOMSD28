@page "/detailShoeCategory/{giayId:guid}"
@rendermode InteractiveServer
@using API.Models.DTO.BanHang
@using Data.Models
@using BlazorKhachHang.Service.IService
@using API.Models.DTO
@inject IGiayChiTietService chiTietService
@inject IGioHangService gioHangService
@inject NavigationManager manager
@inject IJSRuntime JS
@inject CartState CartState

<style>
    .detail-page {
        --cream: #f5f0e8;
        --cream-2: #ede7d9;
        --brown: #3d2c1e;
        --brown-mid: #6b4c35;
        --gold: #c49a6c;
        --warm-gray: #9e8f82;
        --white: #ffffff;
        --black: #1a1209;
        --border-color: #e5ddd0;
        background-color: var(--cream);
        min-height: 100vh;
        font-family: 'DM Sans', sans-serif;
        color: var(--black);
        padding: 40px 0 60px;
    }

        /* Ẩn nút mũi tên tăng giảm mặc định của input number */
        .detail-page input::-webkit-outer-spin-button,
        .detail-page input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .detail-page input[type=number] {
            -moz-appearance: textfield;
        }

    .product-panel {
        background: var(--white);
        border-radius: 16px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 24px rgba(61,44,30,0.08);
        padding: 32px;
    }

    .image-box {
        background: var(--cream);
        border-radius: 12px;
        border: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        min-height: 420px;
    }

        .image-box img {
            max-height: 420px;
            object-fit: contain;
        }

    .product-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 28px;
        color: var(--brown);
        text-transform: uppercase;
        letter-spacing: -0.02em;
    }

    .price-box {
        background: var(--cream);
        border-radius: 12px;
        padding: 20px 24px;
        margin: 20px 0;
        border: 1px solid var(--border-color);
    }

    .price-current {
        color: var(--brown);
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 28px;
        margin: 0;
    }

    .price-old {
        text-decoration: line-through;
        color: var(--warm-gray);
        font-size: 16px;
    }

    .discount-tag {
        background: #c0392b;
        color: white;
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 700;
    }

    .saving-text {
        color: #2e7d32;
        font-size: 14px;
        margin-top: 6px;
    }

    .section-label {
        color: var(--warm-gray);
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 10px;
        display: block;
    }

    .variant-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .variant-item {
        padding: 9px 18px;
        border: 1.5px solid var(--border-color);
        border-radius: 8px;
        cursor: pointer;
        background: var(--white);
        transition: all 0.2s;
        min-width: 64px;
        text-align: center;
        position: relative;
        font-size: 14px;
        color: var(--black);
    }

        .variant-item:hover {
            border-color: var(--gold);
            color: var(--brown);
        }

        .variant-item.active {
            border-color: var(--brown);
            color: var(--brown);
            background-color: var(--cream-2);
            font-weight: 700;
        }

            .variant-item.active::after {
                content: "✓";
                position: absolute;
                top: -8px;
                right: -8px;
                background: var(--brown);
                color: var(--cream);
                font-size: 10px;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
            }

    .out-of-stock-note {
        font-size: 11px;
        color: var(--warm-gray);
        margin-top: 2px;
    }

    .detail-page select.form-select {
        border-radius: 8px;
        padding: 8px 12px;
        border: 1.5px solid var(--border-color);
        width: 160px;
        font-size: 14px;
        height: 42px;
        background: var(--white);
        color: var(--black);
    }

        .detail-page select.form-select:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(196,154,108,0.2);
            outline: none;
        }

    .stock-text {
        font-size: 13px;
        color: var(--warm-gray);
        font-weight: 600;
    }

    .qty-group {
        display: flex;
        align-items: center;
        border: 1.5px solid var(--border-color);
        border-radius: 8px;
        overflow: hidden;
        width: 140px;
    }

        .qty-group button {
            background: var(--cream);
            border: none;
            width: 40px;
            height: 42px;
            font-size: 18px;
            font-weight: 700;
            color: var(--brown);
            cursor: pointer;
            transition: background 0.2s;
        }

            .qty-group button:hover {
                background: var(--cream-2);
            }

        .qty-group input {
            border: none;
            text-align: center;
            font-weight: 700;
            width: 60px;
            height: 42px;
            color: var(--black);
            background: var(--white);
        }

            .qty-group input:focus {
                outline: none;
            }

    .btn-add-cart {
        background: var(--white);
        border: 1.5px solid var(--brown);
        color: var(--brown);
        padding: 14px 36px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 15px;
        transition: all 0.2s;
    }

        .btn-add-cart:hover {
            background: var(--cream-2);
            color: var(--brown);
        }

    .btn-buy-now {
        background: var(--brown);
        border: 1.5px solid var(--brown);
        color: var(--cream);
        padding: 14px 36px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 15px;
        transition: all 0.2s;
    }

        .btn-buy-now:hover {
            background: var(--brown-mid);
            color: var(--cream);
            transform: translateY(-1px);
        }

    .loading-box {
        text-align: center;
        padding: 80px 0;
        color: var(--warm-gray);
    }

        .loading-box .spinner-border {
            color: var(--gold) !important;
        }
</style>

<div class="detail-page">
    <div class="container">
        @if (giay == null)
        {
            <div class="loading-box">
                <div class="spinner-border"></div>
                <p class="mt-3">Đang tải...</p>
            </div>
        }
        else
        {
            <div class="product-panel row">
                <div class="col-md-5">
                    <div class="image-box">
                        <img src="@GetImageUrl(currentVariant?.AnhGiay)"
                             class="img-fluid"
                             onerror="this.onerror=null;this.src='/images/no-image.png';" />
                    </div>
                </div>

                <div class="col-md-7 ps-md-5">
                    <h1 class="product-title">@giay.TenGiay</h1>

                    <div class="price-box">
                        @{
                            decimal giaHienTai = (decimal)(currentVariant?.Gia ?? 0);
                            decimal giaGoc = (decimal)(currentVariant?.GiaGoc ?? 0);

                            int phanTramGiam = 0;
                            if (currentVariant?.DaGiamGia == true && giaGoc > 0)
                            {
                                phanTramGiam = (int)Math.Round((double)(giaGoc - giaHienTai) * 100 / (double)giaGoc);
                            }
                        }

                        <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                            <h2 class="price-current">@giaHienTai.ToString("N0") VNĐ</h2>

                            @if (currentVariant?.DaGiamGia == true)
                            {
                                <span class="price-old">@giaGoc.ToString("N0") VNĐ</span>
                                <span class="discount-tag">-@phanTramGiam%</span>
                            }
                        </div>

                        @if (currentVariant?.DaGiamGia == true)
                        {
                            <div class="saving-text">
                                Tiết kiệm @((giaGoc - giaHienTai).ToString("N0")) VNĐ
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <span class="section-label">Màu Sắc</span>
                        <div class="variant-container">
                            @foreach (var color in giay.ChiTietGiays.Select(c => c.TenMau).Distinct())
                            {
                                var hasStock = giay.ChiTietGiays
                                .Where(x => x.TenMau == color)
                                .Any(x => GetAvailableStock(x) > 0);

                                <div @key="color"
                                     class="variant-item @(selectedColor == color ? "active" : "")"
                                     style="@(hasStock ? "" : "opacity:0.5; cursor:not-allowed; pointer-events:none;")"
                                     @onclick="() => { if (hasStock) OnColorSelected(color); }">

                                    @color

                                    @if (!hasStock)
                                    {
                                        <div class="out-of-stock-note">(Hết hàng)</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <span class="section-label">Kích Cỡ</span>
                        <select class="form-select" value="@selectedSize" @onchange="OnSizeChanged">
                            @foreach (var s in giay.ChiTietGiays.Where(c => c.TenMau == selectedColor).OrderBy(c => c.size))
                            {
                                <option @key="s.GiayChiTietId" value="@s.size" disabled="@(GetAvailableStock(s) <= 0)">
                                    Size @s.size @(GetAvailableStock(s) <= 0 ? "(Hết hàng)" : "")
                                </option>
                            }
                        </select>

                        @if (currentVariant != null && GetAvailableStock(currentVariant) > 0)
                        {
                            <div class="stock-text mt-2">
                                Số lượng còn: @GetAvailableStock(currentVariant)
                            </div>
                        }
                    </div>

                    <div class="mb-4 d-flex align-items-center gap-4">
                        <span class="section-label mb-0">Số Lượng</span>
                        <div class="qty-group">
                            <button @onclick="DecreaseQuantity" type="button">-</button>
                            <input type="number" @bind="quantity" @bind:event="oninput" />
                            <button @onclick="IncreaseQuantity" type="button">+</button>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-5">
                        <button class="btn-add-cart" @onclick="AddToCartAsync">
                            <i class="bi bi-cart-plus me-2"></i> Thêm Vào Giỏ Hàng
                        </button>
                        <button class="btn-buy-now" @onclick="BuyNowAsync">
                            Mua Ngay
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string BaseApiUrl = "https://localhost:7246";
    [Parameter] public Guid giayId { get; set; }
    private GiayDTO? giay;
    private GiayChiTietDTO? currentVariant;
    private string selectedColor = "";
    private int selectedSize = 0;
    private int quantity = 1;

    protected override async Task OnParametersSetAsync()
    {
        await ReloadData();
    }

    private async Task ReloadData()
    {
        var allChiTiet = await chiTietService.GetByGiayIdAsync(giayId);

        var chiTietList = allChiTiet
            .Where(x => x.TrangThai)
            .ToList();

        if (!chiTietList.Any())
        {
            giay = new GiayDTO
            {
                GiayId = giayId,
                TenGiay = allChiTiet.FirstOrDefault()?.TenGiay ?? "Sản phẩm",
                TrangThai = false,
                ChiTietGiays = new List<GiayChiTietDTO>()
            };

            currentVariant = null;
            return;
        }

        giay = new GiayDTO
        {
            GiayId = giayId,
            TenGiay = chiTietList.First().TenGiay,
            TrangThai = true,
            ChiTietGiays = chiTietList
        };

        currentVariant = giay.ChiTietGiays
            .Where(x => GetAvailableStock(x) > 0)
            .OrderBy(x => x.Gia)
            .FirstOrDefault()
            ?? giay.ChiTietGiays.FirstOrDefault();

        if (currentVariant != null)
        {
            selectedColor = currentVariant.TenMau;
            selectedSize = currentVariant.size;
        }
    }

    private string GetImageUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return "/images/no-image.png";

        path = path.Replace("\\", "/").Trim();

        if (path.StartsWith("http"))
            return path;

        return $"{BaseApiUrl}/{path.TrimStart('/')}";
    }

    private int GetAvailableStock(GiayChiTietDTO? v)
    {
        if (v == null) return 0;
        return v.SoLuongCon < 0 ? 0 : v.SoLuongCon;
    }

    private void OnColorSelected(string color)
    {
        selectedColor = color;

        var availableVariants = giay!.ChiTietGiays
            .Where(x =>
                x.TrangThai &&
                x.TenMau == selectedColor &&
                GetAvailableStock(x) > 0)
            .ToList();

        if (!availableVariants.Any())
            return;

        currentVariant = availableVariants
            .OrderByDescending(x => GetAvailableStock(x))
            .First();

        selectedSize = currentVariant.size;
        quantity = 1;
    }

    private void OnSizeChanged(ChangeEventArgs e)
    {
        selectedSize = int.Parse(e.Value!.ToString()!);

        currentVariant = giay!.ChiTietGiays.First(x =>
            x.TrangThai &&
            x.TenMau == selectedColor &&
            x.size == selectedSize);

        quantity = 1;
    }

    private async Task IncreaseQuantity()
    {
        await RefreshCurrentStock();

        if (currentVariant == null)
            return;

        if (quantity < GetAvailableStock(currentVariant))
        {
            quantity++;
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Sản phẩm trong kho không đủ");
        }
    }

    private void DecreaseQuantity()
    {
        if (quantity > 1) quantity--;
    }

    private async Task AddToCartAsync()
    {
        await RefreshCurrentStock();

        if (currentVariant == null || quantity > GetAvailableStock(currentVariant))
        {
            await JS.InvokeVoidAsync("alert", "Sản phẩm không đủ hàng!");
            return;
        }

        var savedId = await JS.InvokeAsync<string>("localStorage.getItem", "khachHangId");

        if (string.IsNullOrEmpty(savedId))
        {
            manager.NavigateTo("/login");
            return;
        }

        try
        {
            await gioHangService.AddToCartAsync(
                Guid.Parse(savedId),
                currentVariant.GiayChiTietId,
                quantity);

            var gioHang = await gioHangService.LayTheoTaiKhoanAsync(Guid.Parse(savedId));

            CartState.SetCount(gioHang?.DanhSachChiTiet.Count ?? 0);

            await JS.InvokeVoidAsync("alert", "Đã thêm vào giỏ!");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
            await RefreshCurrentStock();
        }
    }

    private async Task BuyNowAsync()
    {
        await RefreshCurrentStock();

        // Đã gộp lại thành 1 lần kiểm tra duy nhất (trước đây bị lặp 2 lần)
        if (currentVariant == null || quantity > GetAvailableStock(currentVariant))
        {
            await JS.InvokeVoidAsync("alert", "Sản phẩm không đủ hàng!");
            return;
        }

        var savedId = await JS.InvokeAsync<string>("localStorage.getItem", "khachHangId");
        if (string.IsNullOrEmpty(savedId))
        {
            manager.NavigateTo("/login");
            return;
        }

        var buyNowItem = new
        {
            GiayChiTietId = currentVariant.GiayChiTietId,
            TenGiay = giay!.TenGiay,
            Size = selectedSize,
            MauSac = selectedColor,
            Gia = currentVariant.Gia,
            SoLuong = quantity,
            HinhAnh = currentVariant.AnhGiay,
            GiaGoc = currentVariant.GiaGoc
        };

        await JS.InvokeVoidAsync("localStorage.setItem", "buyNowItem", System.Text.Json.JsonSerializer.Serialize(buyNowItem));
        manager.NavigateTo("/checkout");
    }

    private async Task RefreshCurrentStock()
    {
        var latest = await chiTietService.GetByGiayIdAsync(giayId);

        if (latest == null) return;

        var updated = latest.FirstOrDefault(x => x.GiayChiTietId == currentVariant?.GiayChiTietId);

        if (updated != null)
        {
            currentVariant = updated;

            if (quantity > currentVariant.SoLuongCon)
            {
                quantity = currentVariant.SoLuongCon <= 0 ? 1 : currentVariant.SoLuongCon;
            }
        }

        StateHasChanged();
    }
}