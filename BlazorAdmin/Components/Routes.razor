@using Microsoft.AspNetCore.Components.Authorization
@using BlazorAdmin.Components.Layout
@using BlazorAdmin.Components.Pages

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly"
            AdditionalAssemblies="new[] { typeof(Components._Imports).Assembly }">

        <Found Context="routeData">

            <AuthorizeRouteView RouteData="@routeData"
                                DefaultLayout="@ResolveLayout(routeData)">

                <Authorizing>
                    <LayoutView Layout="@typeof(MainLayout)">
                        <div class="container py-5 text-center">
                            <div class="spinner-border text-primary"
                                 role="status">
                                <span class="visually-hidden">
                                    Đang kiểm tra quyền...
                                </span>
                            </div>

                            <p class="mt-3 text-muted">
                                Đang kiểm tra quyền truy cập...
                            </p>
                        </div>
                    </LayoutView>
                </Authorizing>

                <NotAuthorized Context="authenticationState">

                    @if (authenticationState.User.Identity?.IsAuthenticated == true)
                    {
                        <LayoutView Layout="@typeof(MainLayout)">
                            <div class="container py-5">
                                <div class="card border-0 shadow-sm mx-auto"
                                     style="max-width: 600px; border-radius: 18px;">

                                    <div class="card-body text-center p-5">
                                        <div class="text-danger mb-3"
                                             style="font-size: 64px;">
                                            <i class="bi bi-shield-lock-fill"></i>
                                        </div>

                                        <h2 class="fw-bold text-danger">
                                            Không có quyền truy cập
                                        </h2>

                                        <p class="text-muted mt-3">
                                            Tài khoản của bạn không được phép
                                            truy cập chức năng này.
                                        </p>

                                        <a href="/"
                                           class="btn btn-primary px-4 mt-3">
                                            <i class="bi bi-house-door me-2"></i>
                                            Quay về trang chủ
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </LayoutView>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }

                </NotAuthorized>

            </AuthorizeRouteView>

            <FocusOnNavigate RouteData="@routeData"
                             Selector="h1" />

        </Found>

        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="container py-5 text-center">
                    <h1 class="display-4 fw-bold text-warning">
                        404
                    </h1>

                    <h3>Trang không tồn tại</h3>

                    <p class="text-muted">
                        Vui lòng kiểm tra lại đường dẫn.
                    </p>

                    <a href="/"
                       class="btn btn-primary mt-3">
                        Quay về trang chủ
                    </a>
                </div>
            </LayoutView>
        </NotFound>

    </Router>
</CascadingAuthenticationState>

@code {
    private static Type ResolveLayout(RouteData routeData)
    {
        var path = routeData.PageType?.FullName
                   ?? string.Empty;

        if (path.Contains(
                ".Admin.",
                StringComparison.OrdinalIgnoreCase))
        {
            return typeof(AdminLayout);
        }

        if (path.Contains(
                ".NhanVien.",
                StringComparison.OrdinalIgnoreCase))
        {
            return typeof(NhanVienLayout);
        }

        return typeof(MainLayout);
    }
}