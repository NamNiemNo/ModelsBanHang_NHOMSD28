@using API.Models.DTO
@using Data.Models
@inject IGiayChiTietService GiayChiTietService
@inject IGiayService GiayService
@inject IJSRuntime JS

@if (Visible)
{
    <button type="button"
            class="ps-backdrop"
            aria-label="Đóng cửa sổ chọn sản phẩm"
            @onclick="Close">
    </button>

    <section class="ps-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="product-modal-title">

        <header class="ps-header">
            <div class="ps-heading">
                <span class="ps-heading-icon"
                      aria-hidden="true">
                    ◇
                </span>

                <div>
                    <span class="ps-eyebrow">
                        SẢN PHẨM TẠI QUẦY
                    </span>

                    <h3 id="product-modal-title">
                        Thêm sản phẩm vào đơn
                    </h3>

                    <p>
                        Chọn màu sắc, kích cỡ và số lượng trước khi thêm.
                    </p>
                </div>
            </div>

            <button type="button"
                    class="ps-close-icon"
                    title="Đóng"
                    aria-label="Đóng"
                    @onclick="Close">
                ×
            </button>
        </header>

        <div class="ps-toolbar">
            <label class="ps-search">
                <span aria-hidden="true">⌕</span>

                <input type="search"
                       placeholder="Tìm theo tên, mã, màu hoặc kích cỡ..."
                       autocomplete="off"
                       @bind="SearchKeyword"
                       @bind:event="oninput" />

                @if (!string.IsNullOrWhiteSpace(SearchKeyword))
                {
                    <button type="button"
                            title="Xóa tìm kiếm"
                            aria-label="Xóa nội dung tìm kiếm"
                            @onclick="ClearSearch">
                        ×
                    </button>
                }
            </label>

            <div class="ps-toolbar-stats">
                <span>
                    <strong>@FilteredProducts.Count</strong>
                    sản phẩm
                </span>

                <span class="ps-selected-count">
                    <strong>@SelectedProducts.Count</strong>
                    đã chọn
                </span>
            </div>
        </div>

        <div class="ps-body">
            @if (isLoading)
            {
                <div class="ps-state">
                    <span class="ps-spinner"></span>

                    <strong>Đang tải sản phẩm...</strong>

                    <p>
                        Đang đồng bộ giá bán và số lượng tồn kho.
                    </p>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="ps-state ps-error-state">
                    <span class="ps-state-icon"
                          aria-hidden="true">
                        !
                    </span>

                    <strong>
                        Không tải được sản phẩm
                    </strong>

                    <p>@errorMessage</p>

                    <button type="button"
                            class="ps-retry-button"
                            @onclick="LoadProductsAsync">
                        Thử lại
                    </button>
                </div>
            }
            else if (FilteredProducts.Count == 0)
            {
                <div class="ps-state">
                    <span class="ps-state-icon"
                          aria-hidden="true">
                        ⌕
                    </span>

                    <strong>
                        Không tìm thấy sản phẩm
                    </strong>

                    <p>
                        Hãy thử từ khóa khác hoặc kiểm tra trạng thái
                        kinh doanh và tồn kho.
                    </p>
                </div>
            }
            else
            {
                <div class="ps-product-list">
                    @foreach (var product in FilteredProducts)
                    {
                        var variant = product.SelectedVariant;

                        var isSelected =
                        SelectedProducts.Contains(
                        variant.GiayChiTietId);

                        <article class="ps-product-card @(isSelected ? "is-selected" : "")"
                                 @key="product.GiayId">

                            <div class="ps-image-wrap">
                                <img src="@GetImageUrl(variant.AnhGiay)"
                                     alt="@GetProductName(product)"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='/images/no-image.png';" />

                                <span class="ps-stock-badge @(variant.SoLuongCon <= 5 ? "is-low" : "")">
                                    Còn @variant.SoLuongCon
                                </span>
                            </div>

                            <div class="ps-product-main">
                                <div class="ps-product-title-row">
                                    <div>
                                        <h4>
                                            @GetProductName(product)
                                        </h4>

                                        <span class="ps-product-code">
                                            Mã:
                                            @GetShortId(
                                                     variant.GiayChiTietId)
                                        </span>
                                    </div>

                                    @if (isSelected)
                                    {
                                        <span class="ps-selected-badge">
                                            Đã chọn
                                        </span>
                                    }
                                </div>

                                <div class="ps-price-row">
                                    @if (variant.GiaGoc > variant.Gia)
                                    {
                                        <span class="ps-old-price">
                                            @FormatMoney(variant.GiaGoc)
                                        </span>
                                    }

                                    <strong class="ps-new-price">
                                        @FormatMoney(variant.Gia)
                                    </strong>
                                </div>

                                <div class="ps-variant-grid">
                                    <label>
                                        <span>Màu sắc</span>

                                        <select value="@product.SelectedColor"
                                                @onchange="eventArgs => ChangeColor(product, eventArgs.Value?.ToString())">

                                            @foreach (
                                           var color in product.Variants
                                           .Select(item => item.TenMau)
                                           .Where(color =>
                                           !string.IsNullOrWhiteSpace(color))
                                           .Distinct()
                                           .OrderBy(color => color))
                                            {
                                                <option value="@color">
                                                    @color
                                                </option>
                                            }
                                        </select>
                                    </label>

                                    <label>
                                        <span>Kích cỡ</span>

                                        <select value="@product.SelectedSize"
                                                @onchange="eventArgs => ChangeSize(product, eventArgs.Value?.ToString())">

                                            @foreach (
                                           var size in GetAvailableSizes(product))
                                            {
                                                <option value="@size">
                                                    Size @size
                                                </option>
                                            }
                                        </select>
                                    </label>
                                </div>
                            </div>

                            <div class="ps-purchase-panel">
                                <span class="ps-panel-label">
                                    Số lượng
                                </span>

                                <div class="ps-quantity">
                                    <button type="button"
                                            aria-label="Giảm số lượng"
                                            @onclick="() => ChangeQty(variant, -1)">
                                        −
                                    </button>

                                    <input type="number"
                                           min="1"
                                           max="@variant.SoLuongCon"
                                           value="@variant.SoLuongDat"
                                           aria-label="Số lượng sản phẩm"
                                           @onchange="eventArgs => ValidateQtyInput(variant, eventArgs.Value?.ToString())" />

                                    <button type="button"
                                            aria-label="Tăng số lượng"
                                            @onclick="() => ChangeQty(variant, 1)">
                                        +
                                    </button>
                                </div>

                                <div class="ps-line-total">
                                    <span>Thành tiền</span>

                                    <strong>
                                        @FormatMoney(
                                                 variant.Gia
                                                 * variant.SoLuongDat)
                                    </strong>
                                </div>

                                <label class="ps-select-control">
                                    <input type="checkbox"
                                           checked="@isSelected"
                                           @onchange="eventArgs => ToggleSelect(variant, eventArgs.Value is true)" />

                                    <span>
                                        @(isSelected
                                            ? "Đã chọn sản phẩm"
                                            : "Chọn sản phẩm")
                                    </span>
                                </label>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <footer class="ps-footer">
            <div class="ps-footer-summary">
                <span>Sản phẩm đã chọn</span>
                ản <strong>@SelectedProducts.Count</strong>
            </div>

            <button type="button"
                    class="ps-cancel-button"
                    @onclick="Close">
                Hủy
            </button>

            <button type="button"
                    class="ps-add-button"
                    disabled="@(SelectedProducts.Count == 0 || isAdding)"
                    @onclick="AddSelectedProducts">

                @(isAdding
                    ? "ĐANG THÊM..."
                    : $"THÊM {SelectedProducts.Count} SẢN PHẨM")
            </button>
        </footer>
    </section>
}

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<GiayChiTietDTO> OnAddProduct { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private const string BaseApiUrl =
        "https://localhost:7246";

    private readonly HashSet<Guid> SelectedProducts = new();

    private List<ProductGroup> Products = new();

    private string SearchKeyword = "";
    private string errorMessage = "";

    private bool isLoading;
    private bool isAdding;
    private bool wasVisible;

    private List<ProductGroup> FilteredProducts =>
        Products
            .Where(MatchesSearch)
            .OrderBy(product => product.TenGiay ?? "")
            .ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !wasVisible)
        {
            SearchKeyword = "";
            SelectedProducts.Clear();

            await LoadProductsAsync();
        }

        wasVisible = Visible;
    }

    private async Task LoadProductsAsync()
    {
        isLoading = true;
        errorMessage = "";

        try
        {
            var variants =
                await GiayChiTietService.GetAllAsync()
                ?? new List<GiayChiTietDTO>();

            var shoes =
                await GiayService.GetAllAsync();

            var activeShoeIds = shoes
                .Where(shoe => shoe.TrangThai)
                .Select(shoe => shoe.GiayId)
                .ToHashSet();

            var availableVariants = variants
                .Where(variant =>
                    activeShoeIds.Contains(variant.GiayId)
                    && variant.TrangThai
                    && variant.SoLuongCon > 0)
                .ToList();

            foreach (var variant in availableVariants)
            {
                variant.SoLuongDat = Math.Clamp(
                    variant.SoLuongDat <= 0
                        ? 1
                        : variant.SoLuongDat,
                    1,
                    variant.SoLuongCon);
            }

            Products = availableVariants
                .GroupBy(variant => variant.GiayId)
                .Select(CreateProductGroup)
                .ToList();
        }
        catch (Exception ex)
        {
            Products = new List<ProductGroup>();
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static ProductGroup CreateProductGroup(
        IGrouping<Guid, GiayChiTietDTO> group)
    {
        var variants = group
            .OrderBy(variant => variant.TenMau ?? "")
            .ThenBy(variant => variant.size)
            .ToList();

        var firstVariant = variants[0];

        return new ProductGroup
            {
                GiayId = group.Key,

                TenGiay =
                    firstVariant.TenGiay
                    ?? "Sản phẩm chưa có tên",

                Variants = variants,

                SelectedVariant = firstVariant,

                SelectedSize = firstVariant.size,

                SelectedColor =
                    firstVariant.TenMau
                    ?? ""
            };
    }

    private bool MatchesSearch(
        ProductGroup product)
    {
        if (string.IsNullOrWhiteSpace(SearchKeyword))
        {
            return true;
        }

        var keyword = SearchKeyword.Trim();

        return (product.TenGiay ?? "")
                   .Contains(
                       keyword,
                       StringComparison.OrdinalIgnoreCase)

               || product.GiayId
                   .ToString()
                   .Contains(
                       keyword,
                       StringComparison.OrdinalIgnoreCase)

               || product.Variants.Any(variant =>
                   variant.GiayChiTietId
                       .ToString()
                       .Contains(
                           keyword,
                           StringComparison.OrdinalIgnoreCase)

                   || variant.size
                       .ToString()
                       .Contains(keyword)

                   || (variant.TenMau ?? "")
                       .Contains(
                           keyword,
                           StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<int> GetAvailableSizes(
        ProductGroup product)
    {
        return product.Variants
            .Where(variant =>
                string.Equals(
                    variant.TenMau,
                    product.SelectedColor,
                    StringComparison.OrdinalIgnoreCase))
            .Select(variant => variant.size)
            .Distinct()
            .OrderBy(size => size);
    }

    private void ChangeColor(
        ProductGroup product,
        string? color)
    {
        if (string.IsNullOrWhiteSpace(color))
        {
            return;
        }

        var nextVariant = product.Variants
            .Where(variant =>
                string.Equals(
                    variant.TenMau,
                    color,
                    StringComparison.OrdinalIgnoreCase))
            .OrderBy(variant => variant.size)
            .FirstOrDefault();

        if (nextVariant == null)
        {
            return;
        }

        product.SelectedColor = color;
        product.SelectedSize = nextVariant.size;

        ChangeSelectedVariant(
            product,
            nextVariant);
    }

    private void ChangeSize(
        ProductGroup product,
        string? value)
    {
        if (!int.TryParse(value, out var size))
        {
            return;
        }

        var nextVariant =
            product.Variants.FirstOrDefault(
                variant =>
                    variant.size == size
                    && string.Equals(
                        variant.TenMau,
                        product.SelectedColor,
                        StringComparison.OrdinalIgnoreCase));

        if (nextVariant == null)
        {
            return;
        }

        product.SelectedSize = size;

        ChangeSelectedVariant(
            product,
            nextVariant);
    }

    private void ChangeSelectedVariant(
        ProductGroup product,
        GiayChiTietDTO nextVariant)
    {
        var oldVariantId =
            product.SelectedVariant.GiayChiTietId;

        var wasSelected =
            SelectedProducts.Remove(oldVariantId);

        product.SelectedVariant = nextVariant;

        if (nextVariant.SoLuongDat <= 0)
        {
            nextVariant.SoLuongDat = 1;
        }

        if (wasSelected)
        {
            SelectedProducts.Add(
                nextVariant.GiayChiTietId);
        }
    }

    private async Task ChangeQty(
        GiayChiTietDTO variant,
        int delta)
    {
        var nextQuantity =
            variant.SoLuongDat + delta;

        if (nextQuantity > variant.SoLuongCon)
        {
            variant.SoLuongDat =
                variant.SoLuongCon;

            await ShowToast(
                "info",
                $"Sản phẩm chỉ còn " +
                $"{variant.SoLuongCon} trong kho");

            return;
        }

        variant.SoLuongDat =
            Math.Max(1, nextQuantity);
    }

    private async Task ValidateQtyInput(
        GiayChiTietDTO variant,
        string? value)
    {
        if (!int.TryParse(value, out var quantity))
        {
            variant.SoLuongDat = 1;

            await ShowToast(
                "warning",
                "Số lượng không hợp lệ");

            return;
        }

        if (quantity < 1)
        {
            variant.SoLuongDat = 1;

            await ShowToast(
                "warning",
                "Số lượng tối thiểu là 1");

            return;
        }

        if (quantity > variant.SoLuongCon)
        {
            variant.SoLuongDat =
                variant.SoLuongCon;

            await ShowToast(
                "info",
                $"Sản phẩm chỉ còn " +
                $"{variant.SoLuongCon} trong kho");

            return;
        }

        variant.SoLuongDat = quantity;
    }

    private void ToggleSelect(
        GiayChiTietDTO variant,
        bool isChecked)
    {
        if (isChecked)
        {
            SelectedProducts.Add(
                variant.GiayChiTietId);
        }
        else
        {
            SelectedProducts.Remove(
                variant.GiayChiTietId);
        }
    }

    private async Task AddSelectedProducts()
    {
        if (SelectedProducts.Count == 0 ||
            isAdding)
        {
            return;
        }

        isAdding = true;

        try
        {
            var selectedVariants = Products
                .Select(product =>
                    product.SelectedVariant)
                .Where(variant =>
                    SelectedProducts.Contains(
                        variant.GiayChiTietId))
                .ToList();

            foreach (var variant in selectedVariants)
            {
                await OnAddProduct.InvokeAsync(
                    CloneForOrder(variant));
            }

            SelectedProducts.Clear();

            await OnClose.InvokeAsync();
        }
        finally
        {
            isAdding = false;
        }
    }

    private static GiayChiTietDTO CloneForOrder(
        GiayChiTietDTO variant)
    {
        return new GiayChiTietDTO
            {
                GiayChiTietId =
                    variant.GiayChiTietId,

                GiayId = variant.GiayId,

                Gia = variant.Gia,

                GiaGoc = variant.GiaGoc,

                size = variant.size,

                MauSacId = variant.MauSacId,

                SoLuongCon = variant.SoLuongCon,

                SoLuongDat = Math.Clamp(
                    variant.SoLuongDat,
                    1,
                    variant.SoLuongCon),

                TrangThai = variant.TrangThai,

                AnhGiay = variant.AnhGiay,

                TenGiay = variant.TenGiay
            };
    }

    private Task Close()
    {
        return OnClose.InvokeAsync();
    }

    private void ClearSearch()
    {
        SearchKeyword = "";
    }

    private async Task ShowToast(
        string icon,
        string title)
    {
        await JS.InvokeVoidAsync(
            "Swal.fire",
            new
            {
                toast = true,
                position = "top-end",
                icon,
                title,
                showConfirmButton = false,
                timer = 2500,
                timerProgressBar = true
            });
    }

    private static string GetProductName(
        ProductGroup product)
    {
        return string.IsNullOrWhiteSpace(
            product.TenGiay)
                ? "Sản phẩm chưa có tên"
                : product.TenGiay;
    }

    private static string GetShortId(Guid id)
    {
        return id
            .ToString("N")
            .Substring(0, 8)
            .ToUpperInvariant();
    }

    private static string FormatMoney(
        float amount)
    {
        return string.Format(
            "{0:N0} ₫",
            amount);
    }

    private static string GetImageUrl(
        string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "/images/no-image.png";
        }

        if (path.StartsWith(
            "http",
            StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        if (!path.StartsWith("/"))
        {
            path = "/" + path;
        }

        return BaseApiUrl.TrimEnd('/') + path;
    }

    public sealed class ProductGroup
    {
        public Guid GiayId { get; set; }

        public string TenGiay { get; set; } = "";

        public List<GiayChiTietDTO> Variants { get; set; } =
            new();

        public GiayChiTietDTO SelectedVariant { get; set; } =
            null!;

        public int SelectedSize { get; set; }

        public string SelectedColor { get; set; } = "";
    }
}
