    private bool IsAddressModalVisible;

    private async Task HandleAddressSelected(
        DiaChiKhachHang diaChi)
    {
        if (CurrentOrder == null)
            return;

        CurrentOrder.Address = diaChi;

        Tinh = ReadAddressValue(
            diaChi,
            "ThanhPho",
            "TinhThanhPho");

        Huyen = ReadAddressValue(
            diaChi,
            "QuanHuyen",
            "Huyen");

        Phuong = ReadAddressValue(
            diaChi,
            "PhuongXa",
            "XaPhuongThiTran");

        CurrentOrder.ThongTinHoaDon.TinhThanhPho =
            Tinh;

        CurrentOrder.ThongTinHoaDon.QuanHuyen =
            Huyen;

        CurrentOrder.ThongTinHoaDon.XaPhuongThiTran =
            Phuong;

        CurrentOrder.ThongTinHoaDon.DiaChiCuThe =
            ReadAddressValue(
                diaChi,
                "DiaChiCuThe",
                "DiaChi");

        var tinh = TinhThanh.FirstOrDefault(
            x => x.Ten == Tinh);

        HuyenXa = tinh?.Con ?? new();

        var huyen = HuyenXa.FirstOrDefault(
            x => x.Ten == Huyen);

        XaPhuong = huyen?.Con ?? new();

        await RefreshShippingFeeAsync();
        await SaveOrdersToStorage();
    }

    private static string ReadAddressValue(
        object source,
        params string[] propertyNames)
    {
        foreach (var propertyName in propertyNames)
        {
            var property =
                source.GetType().GetProperty(
                    propertyName);

            var value =
                property?.GetValue(source)?.ToString();

            if (!string.IsNullOrWhiteSpace(value))
                return value;
        }

        return "";
    }

    protected override async Task OnInitializedAsync()
    {
        TinhThanh =
            await xuLyDiaChi.ParseDiaChiAsync(
                "wwwroot/Files/ThanhPho.txt");

        vouchers =
            await voucherService.GetAll();

        vouchers =
            vouchers.Where(
                x => x.TrangThai).ToList();

        var allKhachHang =
            await khachHangService.GetAll();

        var khachLe =
            allKhachHang.FirstOrDefault(
                x => x.HoTen == "Khách lẻ");

        if (khachLe != null)
        {
            KhachLeId =
                khachLe.KhachHangId;
        }
    }

    private string Tinh = "";

    private async Task OnTinhChanged(
        ChangeEventArgs e)
    {
        if (CurrentOrder == null)
            return;

        Tinh = e.Value?.ToString() ?? "";

        CurrentOrder.ThongTinHoaDon.TinhThanhPho =
            Tinh;

        CurrentOrder.Address = null;

        var tinh = TinhThanh.FirstOrDefault(
            t => t.Ten == Tinh);

        HuyenXa = tinh?.Con ?? new();
        XaPhuong = new();

        Huyen = "";
        Phuong = "";

        CurrentOrder.ThongTinHoaDon.QuanHuyen = "";
        CurrentOrder.ThongTinHoaDon.XaPhuongThiTran = "";

        await RefreshShippingFeeAsync();
        await SaveOrdersToStorage();
    }

    private string Huyen = "";

    private async Task OnHuyenChanged(
        ChangeEventArgs e)
    {
        if (CurrentOrder == null)
            return;

        Huyen = e.Value?.ToString() ?? "";

        CurrentOrder.ThongTinHoaDon.QuanHuyen =
