@code {
    private readonly List<string> TrangThaiList = new()
    {
        "TẤT CẢ",
        "Chờ xác nhận",
        "Chờ giao hàng",
        "Đang giao hàng",
        "Hoàn thành",
        "Đã hủy"
    };

    private List<HoaDon> TatCaHoaDon = new();
    private List<HoaDon> DanhSachHoaDon = new();
    private List<HoaDonChiTiet> DanhSachChiTiet = new();
    private Dictionary<Guid, List<HoaDonChiTiet>> ChiTietTheoHoaDon = new();

    private string TuKhoa = string.Empty;
    private string TrangThai = "TẤT CẢ";
    private string LoiTaiDuLieu = string.Empty;
    private bool DangTai;
    private Guid? HoaDonDangXuLy;
    private DateTime? LanCapNhat;

    private int CurrentPage = 1;
    private const int PageSize = 10;
    private int TotalPages = 1;
    private int TongKetQua;

    private int SoDonChoXacNhan => TatCaHoaDon.Count(hd => hd.TrangThai == "Chờ xác nhận");
    private int SoDonDangGiao => TatCaHoaDon.Count(hd => hd.TrangThai == "Đang giao hàng");
    private decimal TongDoanhThu => TatCaHoaDon
        .Where(hd => hd.TrangThai == "Hoàn thành")
        .Sum(TinhTongTien);

    protected override async Task OnInitializedAsync()
    {
        await TaiLai();
    }

    private async Task TaiLai()
    {
        DangTai = true;
        LoiTaiDuLieu = string.Empty;

        try
        {
            TatCaHoaDon = await HoaDonService.GetAll() ?? new List<HoaDon>();
            DanhSachChiTiet = await HoaDonChiTietService.GetAllAsync() ?? new List<HoaDonChiTiet>();

            ChiTietTheoHoaDon = DanhSachChiTiet
                .GroupBy(ct => ct.HoaDonId)
                .ToDictionary(group => group.Key, group => group.ToList());

            LanCapNhat = DateTime.Now;
            ApDungBoLoc();
        }
        catch (Exception ex)
        {
            TatCaHoaDon.Clear();
            DanhSachHoaDon.Clear();
            TongKetQua = 0;
            TotalPages = 1;
            LoiTaiDuLieu = "Không thể tải dữ liệu đơn hàng. " + ex.Message;
        }
        finally
        {
            DangTai = false;
        }
    }

    private void ApDungBoLoc()
    {
        IEnumerable<HoaDon> query = TatCaHoaDon;
        var tuKhoa = TuKhoa.Trim();

        if (!string.IsNullOrWhiteSpace(tuKhoa))
        {
            query = query.Where(hd =>
                hd.HoaDonId.ToString().Contains(tuKhoa, StringComparison.OrdinalIgnoreCase) ||
                (hd.khachHang?.HoTen?.Contains(tuKhoa, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (hd.SoDienThoai?.Contains(tuKhoa, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (hd.DiaChi?.Contains(tuKhoa, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (TrangThai != "TẤT CẢ")
        {
            query = query.Where(hd => hd.TrangThai == TrangThai);
        }

        query = query.OrderByDescending(hd => hd.NgayTao);
        TongKetQua = query.Count();
        TotalPages = Math.Max(1, (int)Math.Ceiling(TongKetQua / (double)PageSize));
        CurrentPage = Math.Clamp(CurrentPage, 1, TotalPages);

        DanhSachHoaDon = query
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void TimKiem(ChangeEventArgs e)
    {
        TuKhoa = e.Value?.ToString() ?? string.Empty;
        CurrentPage = 1;
        ApDungBoLoc();
    }

    private void XoaTimKiem()
    {
        TuKhoa = string.Empty;
        CurrentPage = 1;
        ApDungBoLoc();
    }

    private void LocTheoTrangThai(string trangThai)
    {
        TrangThai = trangThai;
        CurrentPage = 1;
        ApDungBoLoc();
    }

    private void DatLaiBoLoc()
    {
        TuKhoa = string.Empty;
        TrangThai = "TẤT CẢ";
        CurrentPage = 1;
        ApDungBoLoc();
    }

    private int DemTheoTrangThai(string trangThai)
    {
        return trangThai == "TẤT CẢ"
            ? TatCaHoaDon.Count
            : TatCaHoaDon.Count(hd => hd.TrangThai == trangThai);
    }

    private decimal TinhTongTien(HoaDon hoaDon)
    {
        if (hoaDon.TongTienSauKhiGiam > 0)
        {
            return (decimal)hoaDon.TongTienSauKhiGiam;
        }

        var tongSanPham = ChiTietTheoHoaDon
            .GetValueOrDefault(hoaDon.HoaDonId)?
            .Sum(ct => ct.Gia) ?? 0m;

        return tongSanPham + (decimal)hoaDon.PhiShip;
    }

    private static string LayMaDon(Guid hoaDonId)
    {
        var maDon = hoaDonId.ToString("N");
        return maDon[..Math.Min(8, maDon.Length)].ToUpperInvariant();
    }

    private static string GetBadgeClass(string trangThai) => trangThai switch
    {
        "Chờ xác nhận" => "badge-pending",
        "Chờ giao hàng" => "badge-ready",
        "Đang giao hàng" => "badge-shipping",
        "Hoàn thành" => "badge-complete",
        "Đã hủy" => "badge-cancelled",
        _ => "badge-default"
    };

    private static string LayThoiGianTrangThai(HoaDon hoaDon)
    {
        DateTime? thoiGian = hoaDon.TrangThai switch
        {
            "Chờ xác nhận" => hoaDon.NgayTao,
            "Chờ giao hàng" => hoaDon.TGXacNhan,
            "Đang giao hàng" => hoaDon.DangGiao,
            "Hoàn thành" => hoaDon.HoanThanh,
            "Đã hủy" => hoaDon.NgayHuy,
            _ => null
        };

        return thoiGian?.ToString("dd/MM HH:mm") ?? "Chưa cập nhật";
    }

    private IEnumerable<int> LayDanhSachTrang()
    {
        var batDau = Math.Max(1, CurrentPage - 2);
        var ketThuc = Math.Min(TotalPages, batDau + 4);
        batDau = Math.Max(1, ketThuc - 4);

        return Enumerable.Range(batDau, ketThuc - batDau + 1);
    }

    private void XemChiTiet(Guid hoaDonId)
    {
        NavigationManager.NavigateTo($"/admin/hoadonchitiet/{hoaDonId}");
    }

    private void ChuyenTrang(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage)
        {
            return;
        }

        CurrentPage = page;
        ApDungBoLoc();
    }

    private async Task HuyDon(Guid hoaDonId)
    {
        var xacNhan = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc muốn hủy đơn hàng này không?");
        if (!xacNhan)
        {
            return;
        }

        HoaDonDangXuLy = hoaDonId;
        try
        {
            await HoaDonService.HuyDon(hoaDonId);
            await TaiLai();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Hủy đơn thất bại: " + ex.Message);
        }
        finally
        {
            HoaDonDangXuLy = null;
        }
    }

    private async Task XacNhanDon(Guid hoaDonId)
    {
        var xacNhan = await JS.InvokeAsync<bool>("confirm", "Xác nhận đơn hàng này?");
        if (!xacNhan)
        {
            return;
        }

        HoaDonDangXuLy = hoaDonId;
        try
        {
            var result = await HoaDonService.XacNhanDon(hoaDonId);
            await JS.InvokeVoidAsync("alert", result.Message);

            if (result.Success)
            {
                await TaiLai();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Xác nhận đơn thất bại: " + ex.Message);
        }
        finally
        {
            HoaDonDangXuLy = null;
        }
    }

