@page "/admin/hoadon"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@inject IHoaDonService HoaDonService
@inject IHoaDonChiTietService HoaDonChiTietService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

@using Data.Models

<PageTitle>Quản lý đơn hàng</PageTitle>

<div class="orders-page">
    <header class="page-header">
        <div>
            <div class="page-eyebrow">BÁN HÀNG</div>
            <h1>Quản lý đơn hàng</h1>
            <p>Theo dõi, xác nhận và xử lý các đơn hàng tại một nơi.</p>
        </div>

        <button type="button" class="refresh-button" @onclick="TaiLai" disabled="@DangTai">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 4v5h5M4 13a8.1 8.1 0 0 0 15.5 2M20 20v-5h-5" />
            </svg>
            <span>@(DangTai ? "Đang tải..." : "Tải lại dữ liệu")</span>
        </button>
    </header>

    <section class="stats-grid" aria-label="Thống kê đơn hàng">
        <article class="stat-card stat-all">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 3h10l2 4v14H5V7l2-4Z" />
                    <path d="M5 8h14M9 12h6" />
                </svg>
            </div>
            <div>
                <span class="stat-label">Tổng đơn hàng</span>
                <strong>@TatCaHoaDon.Count</strong>
                <small>Tất cả đơn trong hệ thống</small>
            </div>
        </article>

        <article class="stat-card stat-pending">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                </svg>
            </div>
            <div>
                <span class="stat-label">Chờ xác nhận</span>
                <strong>@SoDonChoXacNhan</strong>
                <small>Cần được xử lý sớm</small>
            </div>
        </article>

        <article class="stat-card stat-shipping">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z" />
                    <circle cx="7" cy="18" r="2" />
                    <circle cx="18" cy="18" r="2" />
                </svg>
            </div>
            <div>
                <span class="stat-label">Đang giao hàng</span>
                <strong>@SoDonDangGiao</strong>
                <small>Đơn đang trên đường giao</small>
            </div>
        </article>

        <article class="stat-card stat-revenue">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="M3 10h18M7 15h2" />
                </svg>
            </div>
            <div>
                <span class="stat-label">Doanh thu hoàn thành</span>
                <strong class="revenue-value">@TongDoanhThu.ToString("N0") ₫</strong>
                <small>Từ các đơn đã hoàn thành</small>
            </div>
        </article>
    </section>

    <section class="content-card">
        <div class="filter-area">
            <div class="search-box">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-4-4" />
                </svg>
                <input value="@TuKhoa"
                       @oninput="TimKiem"
                       placeholder="Tìm mã đơn, tên khách, số điện thoại, địa chỉ..."
                       aria-label="Tìm kiếm đơn hàng" />

                @if (!string.IsNullOrWhiteSpace(TuKhoa))
                {
                    <button type="button" class="clear-search" @onclick="XoaTimKiem" title="Xóa nội dung tìm kiếm">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m7 7 10 10M17 7 7 17" />
                        </svg>
                    </button>
                }
            </div>

            <div class="result-summary">
                <span class="result-dot"></span>
                Hiển thị <strong>@TongKetQua</strong> kết quả
                @if (LanCapNhat.HasValue)
                {
                    <span class="updated-time">· Cập nhật @LanCapNhat.Value.ToString("HH:mm")</span>
                }
            </div>
        </div>

        <div class="status-tabs" role="tablist" aria-label="Lọc theo trạng thái">
            @foreach (var trangThaiItem in TrangThaiList)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@(TrangThai == trangThaiItem)"
                        class="status-tab @(TrangThai == trangThaiItem ? "active" : string.Empty)"
                        @onclick="() => LocTheoTrangThai(trangThaiItem)">
                    <span>@trangThaiItem</span>
                    <span class="tab-count">@DemTheoTrangThai(trangThaiItem)</span>
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(LoiTaiDuLieu))
        {
            <div class="error-message" role="alert">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 8v5M12 17h.01" />
                </svg>
                <span>@LoiTaiDuLieu</span>
                <button type="button" @onclick="TaiLai">Thử lại</button>
            </div>
        }
        else if (DangTai)
        {
            <div class="loading-state">
                <span class="spinner"></span>
                <strong>Đang tải danh sách đơn hàng...</strong>
                <small>Vui lòng chờ trong giây lát</small>
            </div>
        }
        else if (DanhSachHoaDon.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 3h10l2 4v14H5V7l2-4Z" />
                        <path d="M9 13h6M10 17h4" />
                    </svg>
                </div>
                <h3>Không tìm thấy đơn hàng</h3>
                <p>Hãy thử từ khóa khác hoặc chọn lại trạng thái đơn hàng.</p>
                @if (!string.IsNullOrWhiteSpace(TuKhoa) || TrangThai != "TẤT CẢ")
                {
                    <button type="button" class="reset-filter" @onclick="DatLaiBoLoc">Đặt lại bộ lọc</button>
                }
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th class="column-number">#</th>
                            <th>Đơn hàng</th>
                            <th>Khách hàng</th>
                            <th class="text-center">Sản phẩm</th>
                            <th>Tổng tiền</th>
                            <th>Địa chỉ nhận hàng</th>
                            <th>Ngày tạo</th>
                            <th>Thanh toán</th>
                            <th>Trạng thái</th>
                            <th class="text-center action-column">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hoaDon in DanhSachHoaDon.Select((value, index) => new { value, index }))
                        {
                            var item = hoaDon.value;
                            var chiTiets = ChiTietTheoHoaDon.GetValueOrDefault(item.HoaDonId);
                            var tongSoSP = chiTiets?.Sum(c => c.SoLuongSanPham) ?? 0;
                            var tongTien = TinhTongTien(item);
                            var tenKhachHang = string.IsNullOrWhiteSpace(item.khachHang?.HoTen)
                            ? "Khách lẻ"
                            : item.khachHang.HoTen;

                            <tr>
                                <td class="row-number">@((CurrentPage - 1) * PageSize + hoaDon.index + 1)</td>
                                <td>
                                    <div class="order-code" title="@item.HoaDonId.ToString()">#@LayMaDon(item.HoaDonId)</div>
                                    <div class="order-kind">Đơn bán hàng</div>
                                </td>
                                <td>
                                    <div class="customer-cell">
                                        <span class="customer-avatar">
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <circle cx="12" cy="8" r="4" />
                                                <path d="M4 21a8 8 0 0 1 16 0" />
                                            </svg>
                                        </span>
                                        <span>
                                            <strong>@tenKhachHang</strong>
                                            <small>@(string.IsNullOrWhiteSpace(item.SoDienThoai) ? "Chưa có SĐT" : item.SoDienThoai)</small>
                                        </span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="product-count">@tongSoSP</span>
                                </td>
                                <td>
                                    <strong class="money">@tongTien.ToString("N0") ₫</strong>
                                </td>
                                <td>
                                    <div class="address-cell" title="@item.DiaChi">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                                            <circle cx="12" cy="10" r="2.5" />
                                        </svg>
                                        <span>@(string.IsNullOrWhiteSpace(item.DiaChi) ? "Chưa cập nhật" : item.DiaChi)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="date-cell">
                                        <strong>@item.NgayTao.ToString("dd/MM/yyyy")</strong>
                                        <small>@item.NgayTao.ToString("HH:mm")</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="payment-method">
                                        @(string.IsNullOrWhiteSpace(item.hinhThucThanhToan?.TenHinhThuc)
                                            ? "Chưa xác định"
                                            : item.hinhThucThanhToan.TenHinhThuc)
                                    </span>
                                </td>
                                <td>
                                    <div class="status-cell">
                                        <span class="status-badge @GetBadgeClass(item.TrangThai)">
                                            <span class="status-dot"></span>
                                            @item.TrangThai
                                        </span>
                                        <small>@LayThoiGianTrangThai(item)</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="action-group">
                                        @switch (item.TrangThai)
                                        {
                                            case "Chờ xác nhận":
                                                <button type="button" class="action-button action-confirm"
                                                        disabled="@(HoaDonDangXuLy == item.HoaDonId)"
                                                        @onclick="() => XacNhanDon(item.HoaDonId)">
                                                    Xác nhận
                                                </button>
                                                <button type="button" class="action-button action-cancel"
                                                        disabled="@(HoaDonDangXuLy == item.HoaDonId)"
                                                        @onclick="() => HuyDon(item.HoaDonId)">
                                                    Hủy
                                                </button>
                                                break;

                                            case "Chờ giao hàng":
                                                <button type="button" class="action-button action-ship"
                                                        disabled="@(HoaDonDangXuLy == item.HoaDonId)"
                                                        @onclick="() => BatDauGiao(item.HoaDonId)">
                                                    Giao hàng
                                                </button>
                                                break;

                                            case "Đang giao hàng":
                                                <button type="button" class="action-button action-complete"
                                                        disabled="@(HoaDonDangXuLy == item.HoaDonId)"
                                                        @onclick="() => GiaoThanhCong(item.HoaDonId)">
                                                    Hoàn thành
                                                </button>
                                                break;
                                        }

                                        <button type="button" class="action-button action-detail"
                                                @onclick="() => XemChiTiet(item.HoaDonId)">
                                            Chi tiết
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="m9 18 6-6-6-6" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="table-footer">
                <div>
                    Trang <strong>@CurrentPage</strong> / <strong>@TotalPages</strong>
                    <span>· @TongKetQua đơn hàng</span>
                </div>

                <nav class="pagination" aria-label="Phân trang">
                    <button type="button" class="page-button page-arrow"
                            @onclick="() => ChuyenTrang(1)"
                            disabled="@(CurrentPage == 1)"
                            aria-label="Trang đầu">
                        «
                    </button>
                    <button type="button" class="page-button page-arrow"
                            @onclick="() => ChuyenTrang(CurrentPage - 1)"
                            disabled="@(CurrentPage == 1)"
                            aria-label="Trang trước">
                        ‹
                    </button>

                    @foreach (var pageNumber in LayDanhSachTrang())
                    {
                        <button type="button"
                                class="page-button @(CurrentPage == pageNumber ? "active" : string.Empty)"
                                aria-current="@(CurrentPage == pageNumber ? "page" : null)"
                                @onclick="() => ChuyenTrang(pageNumber)">
                            @pageNumber
                        </button>
                    }

                    <button type="button" class="page-button page-arrow"
                            @onclick="() => ChuyenTrang(CurrentPage + 1)"
                            disabled="@(CurrentPage == TotalPages)"
                            aria-label="Trang sau">
                        ›
                    </button>
                    <button type="button" class="page-button page-arrow"
                            @onclick="() => ChuyenTrang(TotalPages)"
                            disabled="@(CurrentPage == TotalPages)"
                            aria-label="Trang cuối">
                        »
                    </button>
                </nav>
            </footer>
        }
    </section>
</div>

<style>
    /* ==============================
           CẤU HÌNH CHUNG
        ============================== */

    .orders-page,
    .orders-page * {
        box-sizing: border-box;
    }

    .orders-page {
        --primary: #f97316;
        --primary-dark: #ea580c;
        --primary-soft: #fff7ed;
        --text-dark: #0f172a;
        --text: #334155;
        --text-muted: #64748b;
        --border: #e8edf3;
        --background: #f6f8fb;
        --white: #ffffff;
        min-height: 100%;
        padding: 28px;
        background: var(--background);
        color: var(--text-dark);
        font-family: inherit;
    }

    button,
    input {
        font-family: inherit;
    }


    /* ==============================
           TIÊU ĐỀ TRANG
        ============================== */

    .page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 24px;
    }

    .page-eyebrow {
        margin-bottom: 7px;
        color: var(--primary-dark);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.13em;
    }

    .page-header h1 {
        margin: 0;
        color: var(--text-dark);
        font-size: 30px;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.03em;
    }

    .page-header p {
        margin: 8px 0 0;
        color: var(--text-muted);
        font-size: 14px;
    }


    /* ==============================
           NÚT TẢI LẠI
        ============================== */

    .refresh-button,
    .reset-filter {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 16px;
        border: 1px solid #fed7aa;
        border-radius: 11px;
        background: var(--white);
        color: var(--primary-dark);
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }

        .refresh-button:hover:not(:disabled),
        .reset-filter:hover {
            border-color: var(--primary);
            background: var(--primary-soft);
            transform: translateY(-1px);
        }

        .refresh-button:disabled {
            opacity: 0.6;
            cursor: wait;
        }

        .refresh-button svg {
            width: 17px;
            height: 17px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }


    /* ==============================
           THẺ THỐNG KÊ
        ============================== */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .stat-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
        padding: 20px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--white);
        box-shadow: 0 6px 24px rgba(15, 23, 42, 0.045);
    }

        .stat-card::after {
            position: absolute;
            top: 0;
            right: 0;
            width: 74px;
            height: 74px;
            border-radius: 0 0 0 74px;
            background: currentColor;
            content: "";
            opacity: 0.055;
        }

        .stat-card > div:last-child {
            min-width: 0;
        }

    .stat-icon {
        display: grid;
        place-items: center;
        flex: 0 0 48px;
        width: 48px;
        height: 48px;
        border-radius: 13px;
        background: currentColor;
    }

        .stat-icon svg {
            width: 23px;
            height: 23px;
            fill: none;
            stroke: #ffffff;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .stat-label {
        display: block;
        margin-bottom: 4px;
        color: var(--text-muted);
        font-size: 12px;
        font-weight: 700;
    }

    .stat-card strong {
        display: block;
        margin-bottom: 3px;
        color: var(--text-dark);
        font-size: 24px;
        line-height: 1.15;
    }

    .stat-card small {
        display: block;
        overflow: hidden;
        color: #94a3b8;
        font-size: 11px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .stat-card .revenue-value {
        overflow: hidden;
        font-size: 21px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .stat-all {
        color: #6366f1;
    }

    .stat-pending {
        color: #f59e0b;
    }

    .stat-shipping {
        color: #0ea5e9;
    }

    .stat-revenue {
        color: #10b981;
    }


    /* ==============================
           KHUNG DANH SÁCH CỐ ĐỊNH
        ============================== */

    .content-card {
        /* Thay đổi chiều cao khung tại đây */
        height: 650px;
        min-height: 500px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--white);
        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.05);
    }


    /* ==============================
           KHU VỰC TÌM KIẾM
        ============================== */

    .filter-area {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 20px 22px 14px;
        background: var(--white);
    }

    .search-box {
        position: relative;
        width: min(100%, 650px);
    }

        .search-box > svg {
            position: absolute;
            top: 50%;
            left: 15px;
            width: 19px;
            height: 19px;
            transform: translateY(-50%);
            fill: none;
            stroke: #94a3b8;
            stroke-width: 2;
            stroke-linecap: round;
            pointer-events: none;
        }

        .search-box input {
            width: 100%;
            height: 54px;
            padding: 0 46px;
            border: 1px solid #dce3ec;
            border-radius: 15px;
            outline: none;
            background: #f8fafc;
            color: var(--text-dark);
            font-size: 14px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        }

            .search-box input::placeholder {
                color: #94a3b8;
            }

            .search-box input:focus {
                border-color: #fb923c;
                background: #ffffff;
                box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.11);
            }

    .clear-search {
        position: absolute;
        top: 50%;
        right: 12px;
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        padding: 0;
        transform: translateY(-50%);
        border: none;
        border-radius: 8px;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
    }

        .clear-search:hover {
            background: #eef2f7;
            color: #475569;
        }

        .clear-search svg {
            width: 15px;
            height: 15px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
        }

    .result-summary {
        flex: 0 0 auto;
        color: var(--text-muted);
        font-size: 12px;
        white-space: nowrap;
    }

    .result-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        margin-right: 6px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 3px #dcfce7;
    }

    .updated-time {
        color: #94a3b8;
    }


    /* ==============================
           TAB TRẠNG THÁI
        ============================== */

    .status-tabs {
        display: flex;
        flex-shrink: 0;
        gap: 4px;
        padding: 0 22px;
        overflow-x: auto;
        overflow-y: hidden;
        border-bottom: 1px solid var(--border);
        background: var(--white);
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 #f8fafc;
    }

    .status-tab {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        flex: 0 0 auto;
        min-height: 56px;
        padding: 0 14px;
        border: none;
        background: transparent;
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
    }

        .status-tab::after {
            position: absolute;
            right: 9px;
            bottom: 0;
            left: 9px;
            height: 3px;
            border-radius: 3px 3px 0 0;
            background: var(--primary);
            content: "";
            opacity: 0;
            transform: scaleX(0.5);
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .status-tab:hover {
            color: var(--text-dark);
        }

        .status-tab.active {
            color: var(--primary-dark);
        }

            .status-tab.active::after {
                opacity: 1;
                transform: scaleX(1);
            }

    .tab-count {
        min-width: 22px;
        padding: 3px 7px;
        border-radius: 999px;
        background: #eef2f7;
        color: #64748b;
        font-size: 10px;
        text-align: center;
    }

    .status-tab.active .tab-count {
        background: #ffedd5;
        color: var(--primary-dark);
    }


    /* ==============================
           KHUNG CUỘN BẢNG
        ============================== */

    .table-wrapper {
        position: relative;
        flex: 1;
        min-height: 0;
        width: 100%;
        /*
