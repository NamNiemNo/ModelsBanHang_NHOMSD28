@page "/Admin/AddVoucher"
@rendermode InteractiveServer

@using Data.Models
@using BlazorAdmin.Service.IService
@using System.ComponentModel.DataAnnotations

@inject IVoucherService service
@inject IKhachHangService khachHangService
@inject IKhachHangVoucherService khachHangVoucherService
@inject NavigationManager manager

<div class="voucher-form-page">

    <!-- HEADER -->
    <div class="page-header">

        <div class="header-left">
            <button type="button"
                    class="back-button"
                    @onclick="NavigateBack">
                ←
            </button>

            <div class="header-icon">🎁</div>

            <div>
                <h2>Thêm Voucher mới</h2>
                <p>Tạo mã giảm giá và phân phối cho khách hàng</p>
            </div>
        </div>

    </div>

    <!-- CÁC BƯỚC -->
    <div class="step-bar">

        <div class="step-item active">
            <span>1</span>
            <div>
                <strong>Thông tin Voucher</strong>
                <small>Thời gian và giá trị giảm</small>
            </div>
        </div>

        <div class="step-line"></div>

        <div class="step-item @(Input.KhachHangIds.Any() ? "active" : "")">
            <span>2</span>
            <div>
                <strong>Chọn khách hàng</strong>
                <small>Phân phối Voucher</small>
            </div>
        </div>

        <div class="step-line"></div>

        <div class="step-item @(CanPreviewComplete ? "active" : "")">
            <span>3</span>
            <div>
                <strong>Hoàn tất</strong>
                <small>Kiểm tra và lưu</small>
            </div>
        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="global-error">
            <span>!</span>

            <div>
                <strong>Không thể tạo Voucher</strong>
                <small>@ErrorMessage</small>
            </div>

            <button type="button"
                    @onclick="CloseError">
                ×
            </button>
        </div>
    }

    @if (IsLoading)
    {
        <div class="loading-card">
            <div class="loading-spinner"></div>
            <strong>Đang tải danh sách khách hàng...</strong>
        </div>
    }
    else
    {
        <EditForm Model="@Input"
                  OnValidSubmit="@SubmitFormCreate"
                  FormName="AddVoucherForm">

            <DataAnnotationsValidator />

            <div class="form-layout">

                <!-- CỘT THÔNG TIN VOUCHER -->
                <div class="main-form">

                    <div class="form-card">

                        <div class="card-heading">
                            <div class="card-icon">🎟️</div>

                            <div>
                                <h4>Thông tin Voucher</h4>
                                <p>Thiết lập tên, thời gian và số lượng</p>
                            </div>
                        </div>

                        <div class="form-grid">

                            <!-- TÊN -->
                            <div class="form-group full-width">
                                <label>
                                    Tên Voucher
                                    <span>*</span>
                                </label>

                                <div class="input-with-icon">
                                    <span>🎟️</span>

                                    <InputText class="form-control-custom"
                                               @bind-Value="Input.TenVoucher"
                                               placeholder="Ví dụ: Giảm giá mùa hè" />
                                </div>

                                <ValidationMessage For="@(() => Input.TenVoucher)" />
                            </div>

                            <!-- NGÀY BẮT ĐẦU -->
                            <div class="form-group">
                                <label>
                                    Ngày bắt đầu
                                    <span>*</span>
                                </label>

                                <InputDate class="form-control-custom"
                                           @bind-Value="Input.NgayBatDau" />

                                <ValidationMessage For="@(() => Input.NgayBatDau)" />
                            </div>

                            <!-- NGÀY KẾT THÚC -->
                            <div class="form-group">
                                <label>
                                    Ngày kết thúc
                                    <span>*</span>
                                </label>

                                <InputDate class="form-control-custom"
                                           @bind-Value="Input.NgayKetThuc" />

                                <ValidationMessage For="@(() => Input.NgayKetThuc)" />
                            </div>

                            <!-- SỐ LƯỢNG -->
                            <div class="form-group full-width">
                                <label>
                                    Số lượng Voucher
                                    <span>*</span>
                                </label>

                                <InputNumber class="form-control-custom"
                                             @bind-Value="VoucherQuantity"
                                             min="1"
                                             placeholder="Nhập số lượng Voucher" />

                                <ValidationMessage For="@(() => Input.SoLuong)" />

                                <small class="field-note">
                                    Số khách được gán không được vượt quá số lượng Voucher.
                                </small>
                            </div>

                        </div>

                    </div>

                    <!-- GIÁ TRỊ GIẢM -->
                    <div class="form-card">

                        <div class="card-heading">
                            <div class="card-icon discount">%</div>

                            <div>
                                <h4>Giá trị giảm</h4>
                                <p>Chọn giảm theo phần trăm hoặc số tiền</p>
                            </div>
                        </div>

                        <div class="discount-type">

                            <button type="button"
                                    class="discount-type-button @(IsPhanTram ? "active" : "")"
                                    @onclick="() => DoiKieuGiamGia(true)">

                                <span class="discount-type-icon">%</span>

                                <div>
                                    <strong>Giảm phần trăm</strong>
                                    <small>Giảm theo tỷ lệ đơn hàng</small>
                                </div>

                                <i>@(IsPhanTram ? "✓" : "")</i>
                            </button>

                            <button type="button"
                                    class="discount-type-button @(!IsPhanTram ? "active" : "")"
                                    @onclick="() => DoiKieuGiamGia(false)">

                                <span class="discount-type-icon">₫</span>

                                <div>
                                    <strong>Giảm tiền trực tiếp</strong>
                                    <small>Trừ một số tiền cố định</small>
                                </div>

                                <i>@(!IsPhanTram ? "✓" : "")</i>
                            </button>

                        </div>

                        <div class="form-grid discount-input-grid">

                            <!-- GIÁ TRỊ GIẢM -->
                            <div class="form-group full-width">
                                <label>
                                    @(IsPhanTram
                                        ? "Phần trăm giảm"
                                        : "Số tiền giảm")
                                    <span>*</span>
                                </label>

                                <div class="money-input">
                                    <InputNumber class="form-control-custom"
                                                 @bind-Value="GiaTriGiam"
                                                 min="0"
                                                 step="1"
                                                 placeholder="Nhập giá trị giảm" />

                                    <span>
                                        @(IsPhanTram ? "%" : "₫")
                                    </span>
                                </div>

                                @if (IsPhanTram)
                                {
                                    <ValidationMessage For="@(() => Input.PhanTram)" />
                                }
                                else
                                {
                                    <ValidationMessage For="@(() => Input.SoTienGiam)" />
                                }
                            </div>

                            <!-- ĐIỀU KIỆN TỐI THIỂU -->
                            <div class="form-group">
                                <label>Giá trị đơn tối thiểu</label>

                                <div class="money-input">
                                    <InputNumber class="form-control-custom"
                                                 @bind-Value="Input.DieuKienToiThieu"
                                                 min="0"
                                                 step="1000" />

                                    <span>₫</span>
                                </div>

                                <ValidationMessage For="@(() => Input.DieuKienToiThieu)" />
                            </div>

                            <!-- GIẢM TỐI ĐA -->
                            <div class="form-group">
                                <label>Giảm tối đa</label>

                                <div class="money-input">
                                    <InputNumber class="form-control-custom"
                                                 @bind-Value="Input.GiamToiDa"
                                                 min="0"
                                                 step="1000" />

                                    <span>₫</span>
                                </div>

                                <ValidationMessage For="@(() => Input.GiamToiDa)" />
                            </div>

                        </div>

                        <div class="discount-note">
                            <span>💡</span>

                            <p>
                                Nếu giảm theo phần trăm, mức giảm thực tế
                                sẽ không vượt quá giá trị “Giảm tối đa”.
                            </p>
                        </div>

                    </div>

                </div>

                <!-- CỘT KHÁCH HÀNG -->
                <div class="side-content">

                    <div class="customer-card">

                        <div class="customer-heading">
                            <div>
                                <h4>Gán cho khách hàng</h4>
                                <p>Chọn khách hàng nhận Voucher</p>
                            </div>

                            <span class="selected-count">
                                @Input.KhachHangIds.Count/@Input.SoLuong
                            </span>
                        </div>

                        <div class="customer-search">
                            <span>⌕</span>

                            <input placeholder="Tìm tên, email, số điện thoại..."
                                   @bind="CustomerSearch"
                                   @bind:event="oninput" />

                            @if (!string.IsNullOrWhiteSpace(CustomerSearch))
                            {
                                <button type="button"
                                        @onclick="() => CustomerSearch = string.Empty">
                                    ×
                                </button>
                            }
                        </div>

                        <div class="select-all-row">

                            <label>
                                <input type="checkbox"
                                       @bind="IsAllChecked" />

                                <span class="custom-checkbox"></span>

                                <div>
                                    <strong>Chọn tối đa có thể</strong>

                                    <small>
                                        Tối đa @MaximumSelectableCustomers khách
                                    </small>
                                </div>
                            </label>

                            @if (Input.KhachHangIds.Any())
                            {
                                <button type="button"
                                        @onclick="ClearSelectedCustomers">
                                    Bỏ chọn
                                </button>
                            }

                        </div>

                        <!-- THANH TIẾN ĐỘ -->
                        <div class="selection-progress">

                            <div>
                                <span>Đã phân phối</span>

                                <strong>
                                    @Input.KhachHangIds.Count /
                                    @(Input.SoLuong <= 0 ? 0 : Input.SoLuong)
                                </strong>
                            </div>

                            <div class="progress-track">
                                <div class="progress-value"
                                     style="@($"width:{SelectionPercentage}%")">
                                </div>
                            </div>

                        </div>

                        <!-- DANH SÁCH KHÁCH -->
                        <div class="customer-list">

                            @if (!FilteredCustomers.Any())
                            {
                                <div class="empty-customer">
                                    <span>🔎</span>
                                    <strong>Không tìm thấy khách hàng</strong>
                                </div>
                            }
                            else
                            {
                                @foreach (var customer in FilteredCustomers)
                                {
                                    var isSelected =
                                    Input.KhachHangIds.Contains(
                                    customer.KhachHangId);

                                    <label class="customer-item @(isSelected ? "selected" : "") @(!customer.TrangThai ? "disabled" : "")">

                                        <input type="checkbox"
                                               checked="@isSelected"
                                               disabled="@(!customer.TrangThai)"
                                               @onchange="e => ToggleKhachHang(
                                                   customer.KhachHangId,
                                                   e.Value is bool value && value)" />

                                        <span class="customer-checkbox">
                                            @(isSelected ? "✓" : "")
                                        </span>

                                        <span class="customer-avatar">
                                            @GetInitials(customer.HoTen)
                                        </span>

                                        <span class="customer-details">
                                            <strong>
                                                @(string.IsNullOrWhiteSpace(customer.HoTen)
                                                    ? "Khách hàng"
                                                    : customer.HoTen)
                                            </strong>

                                            <small>
                                                @(string.IsNullOrWhiteSpace(customer.Email)
                                                    ? "Chưa có email"
                                                    : customer.Email)
                                            </small>

                                            <small>
                                                @(string.IsNullOrWhiteSpace(customer.SoDienThoai)
                                                    ? "Chưa có số điện thoại"
                                                    : customer.SoDienThoai)
                                            </small>
                                        </span>

                                        @if (!customer.TrangThai)
                                        {
                                            <span class="inactive-label">
                                                Đã khóa
                                            </span>
                                        }

                                    </label>
                                }
                            }

                        </div>

                    </div>

                    <!-- XEM TRƯỚC -->
                    <div class="preview-card">

                        <div class="preview-title">
                            <span>◉</span>
                            Xem trước Voucher
                        </div>

                        <div class="voucher-preview">

                            <div class="voucher-preview-left">
                                <span>VOUCHER</span>
                                <strong>@DiscountDisplay</strong>
                                <small>
                                    Đơn tối thiểu
                                    @Input.DieuKienToiThieu.ToString("N0") ₫
                                </small>
                            </div>

                            <div class="voucher-preview-right">
                                <strong>
                                    @(string.IsNullOrWhiteSpace(Input.TenVoucher)
                                        ? "TÊN VOUCHER"
                                        : Input.TenVoucher)
                                </strong>

                                <small>
                                    HSD:
                                    @Input.NgayKetThuc.ToString("dd/MM/yyyy")
                                </small>

                                <span>
                                    SL: @Input.SoLuong
                                </span>
                            </div>

                        </div>

                        <div class="preview-information">

                            <div>
                                <span>Thời gian</span>
                                <strong>
                                    @Input.NgayBatDau.ToString("dd/MM/yyyy")
                                    -
                                    @Input.NgayKetThuc.ToString("dd/MM/yyyy")
                                </strong>
                            </div>

                            <div>
                                <span>Giảm tối đa</span>
                                <strong>
                                    @Input.GiamToiDa.ToString("N0") ₫
                                </strong>
                            </div>

                            <div>
                                <span>Khách được chọn</span>
                                <strong>
                                    @Input.KhachHangIds.Count khách
                                </strong>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- BUTTON -->
            <div class="bottom-actions">

                <div>
                    <strong>Sẵn sàng tạo Voucher?</strong>

                    <span>
                        @Input.SoLuong Voucher,
                        @Input.KhachHangIds.Count khách hàng
                    </span>
                </div>

                <section>
                    <button type="button"
                            class="cancel-button"
                            disabled="@IsSubmitting"
                            @onclick="NavigateBack">
                        Hủy
                    </button>

                    <button type="submit"
                            class="save-button"
                            disabled="@IsSubmitting">

                        @if (IsSubmitting)
                        {
                            <span class="button-spinner"></span>
                            <span>Đang tạo Voucher...</span>
                        }
                        else
                        {
                            <span>✓</span>
                            <span>Tạo Voucher</span>
                        }

                    </button>
                </section>

            </div>

        </EditForm>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="success-toast">
            <span>✓</span>

            <div>
                <strong>Thành công</strong>
                <small>@SuccessMessage</small>
            </div>
        </div>
    }

</div>

@code {
    private InputModel Input { get; set; } = new();

    private bool IsPhanTram = true;
    private bool IsLoading = true;
    private bool IsSubmitting;

    private List<KhachHang> DanhSachKhachHang = new();

    private bool _isAllChecked;

    private string CustomerSearch = string.Empty;
    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;

    private float? GiaTriGiam
    {
        get => IsPhanTram
            ? Input.PhanTram
            : Input.SoTienGiam;

        set
        {
            if (IsPhanTram)
            {
                Input.PhanTram = value ?? 0;
                Input.SoTienGiam = 0;
            }
            else
            {
                Input.SoTienGiam = value ?? 0;
                Input.PhanTram = 0;
            }
        }
    }

    // Dùng property này thay cho @bind-Value + @onchange.
    private int VoucherQuantity
    {
        get => Input.SoLuong;
        set
        {
            Input.SoLuong = Math.Max(0, value);

            AdjustCustomerSelectionToQuantity();
        }
    }

    private List<KhachHang> ActiveCustomers =>
        DanhSachKhachHang
            .Where(x => x.TrangThai)
            .ToList();

    private List<KhachHang> FilteredCustomers =>
        DanhSachKhachHang
            .Where(x =>
                string.IsNullOrWhiteSpace(CustomerSearch)
                || (x.HoTen ?? string.Empty)
                    .Contains(
                        CustomerSearch,
                        StringComparison.OrdinalIgnoreCase)
                || (x.Email ?? string.Empty)
                    .Contains(
                        CustomerSearch,
                        StringComparison.OrdinalIgnoreCase)
                || (x.SoDienThoai ?? string.Empty)
                    .Contains(
                        CustomerSearch,
                        StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.TrangThai)
            .ThenBy(x => x.HoTen)
            .ToList();

    private int MaximumSelectableCustomers =>
        Math.Min(
            Math.Max(Input.SoLuong, 0),
            ActiveCustomers.Count);

    private bool IsAllChecked
    {
        get
        {
            var maximum = MaximumSelectableCustomers;

            return maximum > 0
                   && Input.KhachHangIds.Count == maximum;
        }

        set
        {
            _isAllChecked = value;

            ToggleAllKhachHang(value);
        }
    }

    private int SelectionPercentage
    {
        get
        {
            if (Input.SoLuong <= 0)
                return 0;

            return Math.Min(
                100,
                (int)Math.Round(
                    (double)Input.KhachHangIds.Count
                    / Input.SoLuong
                    * 100));
        }
    }

    private bool CanPreviewComplete =>
        !string.IsNullOrWhiteSpace(Input.TenVoucher)
        && Input.SoLuong > 0
        && GiaTriGiam > 0;

    private string DiscountDisplay =>
        IsPhanTram
            ? $"{Input.PhanTram:N0}%"
            : $"{Input.SoTienGiam:N0} ₫";

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = string.Empty;

            DanhSachKhachHang =
                (await khachHangService.GetAll())
                .OrderBy(x => x.HoTen)
                .ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                "Không thể tải danh sách khách hàng: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void DoiKieuGiamGia(bool percentage)
    {
        if (IsPhanTram == percentage)
            return;

        IsPhanTram = percentage;

        Input.PhanTram = 0;
        Input.SoTienGiam = 0;

        ErrorMessage = string.Empty;
    }

    private void ToggleKhachHang(
        Guid customerId,
        bool isChecked)
    {
        ErrorMessage = string.Empty;

        if (isChecked)
        {
            if (Input.SoLuong <= 0)
            {
                ErrorMessage =
                    "Vui lòng nhập số lượng Voucher trước.";
                return;
            }

            if (Input.KhachHangIds.Count >= Input.SoLuong)
            {
                ErrorMessage =
                    $"Chỉ được chọn tối đa {Input.SoLuong} khách hàng.";
                return;
            }

            if (!Input.KhachHangIds.Contains(customerId))
            {
                Input.KhachHangIds.Add(customerId);
            }
        }
        else
        {
            Input.KhachHangIds.Remove(customerId);
        }

        _isAllChecked = IsAllChecked;
    }

    private void ToggleAllKhachHang(bool isChecked)
    {
        ErrorMessage = string.Empty;

        if (!isChecked)
        {
            Input.KhachHangIds.Clear();
            return;
        }

        if (Input.SoLuong <= 0)
        {
            _isAllChecked = false;

            ErrorMessage =
                "Vui lòng nhập số lượng Voucher trước.";
            return;
        }

        Input.KhachHangIds = ActiveCustomers
            .Take(MaximumSelectableCustomers)
            .Select(x => x.KhachHangId)
            .ToList();
    }

    private void ClearSelectedCustomers()
    {
        Input.KhachHangIds.Clear();
        _isAllChecked = false;
    }

    private void AdjustCustomerSelectionToQuantity()
    {
        var validIds = ActiveCustomers
            .Select(x => x.KhachHangId)
            .ToHashSet();

        Input.KhachHangIds = Input.KhachHangIds
            .Where(validIds.Contains)
            .Take(Math.Max(Input.SoLuong, 0))
            .ToList();

        _isAllChecked = IsAllChecked;
    }

    private async Task SubmitFormCreate()
    {
        if (IsSubmitting)
            return;

        try
        {
            IsSubmitting = true;
            ErrorMessage = string.Empty;
            SuccessMessage = string.Empty;

            Input.TenVoucher =
                Input.TenVoucher?.Trim() ?? string.Empty;

            if (!ValidateBusinessRules())
                return;

            var allVoucher =
                await service.GetAll();

            var exists = allVoucher.Any(x =>
                string.Equals(
                    x.TenVoucher?.Trim(),
                    Input.TenVoucher,
                    StringComparison.OrdinalIgnoreCase));

            if (exists)
            {
                ErrorMessage =
                    "Tên Voucher đã tồn tại.";
                return;
            }

            var newVoucher = new Voucher
                {
                    VoucherId = Guid.NewGuid(),
                    TenVoucher = Input.TenVoucher,
                    NgayBatDau = Input.NgayBatDau,
                    NgayKetThuc = Input.NgayKetThuc,
                    PhanTram = Input.PhanTram,
                    SoTienGiam = Input.SoTienGiam,
                    GiamToiDa = Input.GiamToiDa,
                    DieuKienToiThieu = Input.DieuKienToiThieu,
                    TrangThai = true,
                    SoLuong = Input.SoLuong
                };

            // Chỉ await, không gán kết quả vào bool.
            await service.Add(newVoucher);

            if (Input.KhachHangIds.Any())
            {
                await khachHangVoucherService.AssignMultipleAsync(
                    newVoucher.VoucherId,
                    Input.KhachHangIds);
            }

            SuccessMessage =
                "Voucher đã được tạo thành công.";

            await InvokeAsync(StateHasChanged);
            await Task.Delay(700);

            manager.NavigateTo("/Admin/voucher");
        }
        catch (Exception ex)
        {
            ErrorMessage =
                "Không thể tạo Voucher: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private bool ValidateBusinessRules()
    {
        if (string.IsNullOrWhiteSpace(Input.TenVoucher))
        {
            ErrorMessage =
                "Tên Voucher không được để trống.";
            return false;
        }

        if (Input.NgayBatDau.Date < DateTime.Today)
        {
            ErrorMessage =
                "Ngày bắt đầu không được nhỏ hơn hôm nay.";
            return false;
        }

        if (Input.NgayKetThuc <= Input.NgayBatDau)
        {
            ErrorMessage =
                "Ngày kết thúc phải lớn hơn ngày bắt đầu.";
            return false;
        }

        if (Input.SoLuong <= 0)
        {
            ErrorMessage =
                "Số lượng Voucher phải lớn hơn 0.";
            return false;
        }

        if (Input.DieuKienToiThieu < 0)
        {
            ErrorMessage =
                "Điều kiện tối thiểu không hợp lệ.";
            return false;
        }

        if (Input.GiamToiDa < 0)
        {
            ErrorMessage =
                "Giảm tối đa không hợp lệ.";
            return false;
        }

        if (IsPhanTram)
        {
            if (Input.PhanTram <= 0
                || Input.PhanTram > 100)
            {
                ErrorMessage =
                    "Phần trăm giảm phải từ 1 đến 100.";
                return false;
            }

            Input.SoTienGiam = 0;
        }
        else
        {
            if (Input.SoTienGiam <= 0)
            {
                ErrorMessage =
                    "Số tiền giảm phải lớn hơn 0.";
                return false;
            }

            if (Input.GiamToiDa > 0
                && Input.SoTienGiam > Input.GiamToiDa)
            {
                ErrorMessage =
                    "Số tiền giảm không được vượt quá giảm tối đa.";
                return false;
            }

            Input.PhanTram = 0;
        }

        if (Input.KhachHangIds.Count > Input.SoLuong)
        {
            ErrorMessage =
                $"Có {Input.SoLuong} Voucher nhưng đã chọn " +
                $"{Input.KhachHangIds.Count} khách hàng.";
            return false;
        }

        return true;
    }

    private void NavigateBack()
    {
        manager.NavigateTo("/Admin/voucher");
    }

    private void CloseError()
    {
        ErrorMessage = string.Empty;
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "KH";

        var words = name.Trim()
            .Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
        {
            return words[0][0]
                .ToString()
                .ToUpperInvariant();
        }

        return string.Concat(
            words.First()[0],
            words.Last()[0])
            .ToUpperInvariant();
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Tên Voucher không được để trống")]
        [StringLength(
            100,
            ErrorMessage = "Tên Voucher tối đa 100 ký tự")]
        public string TenVoucher { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ngày bắt đầu không được để trống")]
        public DateTime NgayBatDau { get; set; } = DateTime.Today;

        [Required(ErrorMessage = "Ngày kết thúc không được để trống")]
        public DateTime NgayKetThuc { get; set; }
            = DateTime.Today.AddDays(7);

        [Range(
            0,
            100,
            ErrorMessage = "Phần trăm giảm phải từ 0 đến 100")]
        public float PhanTram { get; set; }

        [Range(
            0,
            double.MaxValue,
            ErrorMessage = "Số tiền giảm không hợp lệ")]
        public float SoTienGiam { get; set; }

        [Range(
            0,
            double.MaxValue,
            ErrorMessage = "Giảm tối đa không hợp lệ")]
        public float GiamToiDa { get; set; }

        [Range(
            0,
            double.MaxValue,
            ErrorMessage = "Điều kiện tối thiểu không hợp lệ")]
        public float DieuKienToiThieu { get; set; }

        [Range(
            1,
            int.MaxValue,
            ErrorMessage = "Số lượng phải lớn hơn 0")]
        public int SoLuong { get; set; } = 1;

        public List<Guid> KhachHangIds { get; set; } = new();
    }
}

