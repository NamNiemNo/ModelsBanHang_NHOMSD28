@page "/Admin/voucher"
@rendermode InteractiveServer

@using Data.Models
@using BlazorAdmin.Service.IService

@inject IVoucherService service
@inject NavigationManager manager

<div class="voucher-page">

    <!-- HEADER -->
    <div class="page-header">

        <div class="header-left">
            <div class="header-icon">🎟️</div>

            <div>
                <h2>Quản lý Voucher</h2>
                <p>Quản lý mã giảm giá, thời gian và số lượng sử dụng</p>
            </div>
        </div>

        <button class="add-button"
                @onclick="NavigateToCreate">
            <span>＋</span>
            Tạo Voucher
        </button>

    </div>

    <!-- THỐNG KÊ -->
    <div class="stat-grid">

        <div class="stat-card">
            <div class="stat-icon total">▦</div>

            <div>
                <span>Tổng Voucher</span>
                <strong>@Vouchers.Count</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon active">✓</div>

            <div>
                <span>Đang diễn ra</span>
                <strong>@Vouchers.Count(IsActive)</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon inactive">⏸</div>

            <div>
                <span>Ngừng hoạt động</span>
                <strong>@Vouchers.Count(x => !x.TrangThai)</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon expired">◷</div>

            <div>
                <span>Đã hết hạn</span>
                <strong>@Vouchers.Count(IsExpired)</strong>
            </div>
        </div>

    </div>

    <!-- DANH SÁCH -->
    <div class="voucher-panel">

        <!-- TOOLBAR -->
        <div class="panel-toolbar">

            <div class="search-box">
                <span>⌕</span>

                <input placeholder="Tìm kiếm tên Voucher..."
                       @bind="SearchText"
                       @bind:event="oninput" />

                @if (!string.IsNullOrWhiteSpace(SearchText))
                {
                    <button @onclick="ClearSearch">×</button>
                }
            </div>

            <div class="filter-controls">

                <select class="status-select"
                        @bind="SelectedTrangThai">
                    <option value="">Tất cả trạng thái</option>
                    <option value="hoatdong">Đang diễn ra</option>
                    <option value="sapdienra">Sắp diễn ra</option>
                    <option value="ngung">Ngừng hoạt động</option>
                    <option value="hethan">Hết hạn</option>
                </select>

                @if (!string.IsNullOrWhiteSpace(SelectedTrangThai))
                {
                    <button class="reset-filter"
                            @onclick="ResetStatusFilter">
                        Đặt lại
                    </button>
                }

            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(PageError))
        {
            <div class="page-error">
                <span>!</span>
                <div>@PageError</div>
                <button @onclick="() => PageError = string.Empty">×</button>
            </div>
        }

        <!-- BẢNG CUỘN NGANG + DỌC -->
        <div class="table-wrapper">

            <table class="voucher-table">
                <thead>
                    <tr>
                        <th class="col-stt">STT</th>
                        <th>Voucher</th>
                        <th>Thời gian áp dụng</th>
                        <th>Giá trị giảm</th>
                        <th>Trạng thái</th>
                        <th class="center">Số lượng</th>
                        <th>Giảm tối đa</th>
                        <th>Đơn tối thiểu</th>
                        <th class="col-action">Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="9">
                                <div class="loading-state">
                                    <div class="loading-spinner"></div>
                                    <span>Đang tải danh sách Voucher...</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (!PagedList.Any())
                    {
                        <tr>
                            <td colspan="9">
                                <div class="empty-state">
                                    <div>🔎</div>
                                    <strong>Không tìm thấy Voucher</strong>
                                    <span>
                                        Hãy thử thay đổi từ khóa hoặc trạng thái
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in PagedList.Select((item, index) => new
                        {
                            Item = item,
                            Index = index
                        }))
                        {
                            var item = row.Item;
                            var expired = IsExpired(item);

                            <tr>
                                <td class="stt-cell">
                                    @((CurrentPage - 1) * PageSize
                                        + row.Index + 1)
                                </td>

                                <td>
                                    <div class="voucher-info">

                                        <div class="voucher-icon">
                                            %
                                        </div>

                                        <div>
                                            <strong>@item.TenVoucher</strong>

                                            <small title="@item.VoucherId">
                                                @ShortId(item.VoucherId)
                                            </small>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <div class="date-range">

                                        <div>
                                            <span>Bắt đầu</span>

                                            <strong>
                                                @item.NgayBatDau.ToString("dd/MM/yyyy")
                                            </strong>

                                            <small>
                                                @item.NgayBatDau.ToString("HH:mm")
                                            </small>
                                        </div>

                                        <span class="date-arrow">→</span>

                                        <div>
                                            <span>Kết thúc</span>

                                            <strong>
                                                @item.NgayKetThuc.ToString("dd/MM/yyyy")
                                            </strong>

                                            <small>
                                                @item.NgayKetThuc.ToString("HH:mm")
                                            </small>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <div class="discount-value">
                                        @if (item.PhanTram > 0)
                                        {
                                            <strong>
                                                @item.PhanTram%
                                            </strong>
                                            <small>Giảm theo phần trăm</small>
                                        }
                                        else if (item.SoTienGiam > 0)
                                        {
                                            <strong>
                                                @item.SoTienGiam.ToString("N0") ₫
                                            </strong>
                                            <small>Giảm tiền trực tiếp</small>
                                        }
                                        else
                                        {
                                            <span>Chưa thiết lập</span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <button class="voucher-status @GetStatusClass(item)"
                                            title="Nhấn để chuyển trạng thái"
                                            disabled="@(expired || TogglingId == item.VoucherId)"
                                            @onclick="() => ToggleTrangThai(item.VoucherId)">

                                        @if (TogglingId == item.VoucherId)
                                        {
                                            <span class="mini-spinner"></span>
                                        }
                                        else
                                        {
                                            <span class="status-dot"></span>
                                        }

                                        @GetStatusText(item)
                                    </button>
                                </td>

                                <td class="center">
                                    <span class="@GetQuantityClass(item.SoLuong)">
                                        @item.SoLuong
                                    </span>
                                </td>

                                <td>
                                    <strong class="maximum-value">
                                        @item.GiamToiDa.ToString("N0") ₫
                                    </strong>
                                </td>

                                <td>
                                    <strong class="minimum-value">
                                        @item.DieuKienToiThieu.ToString("N0") ₫
                                    </strong>
                                </td>

                                <td>
                                    <div class="action-group">

                                        <button class="action-button edit"
                                                title="Chỉnh sửa Voucher"
                                                @onclick="() => NavigateToEdit(item.VoucherId)">
                                            ✎
                                        </button>

                                        <button class="action-button delete"
                                                title="Xóa Voucher"
                                                @onclick="() => AskDelete(item)">
                                            ⌫
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>

        <!-- PHÂN TRANG -->
        <div class="pagination-bar">

            <div class="page-size">
                <span>Hiển thị</span>

                <select value="@PageSize"
                        @onchange="OnPageSizeChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>

                <span>Voucher</span>
            </div>

            <div class="result-info">
                Hiển thị
                <strong>@FirstDisplayedItem</strong>
                -
                <strong>@LastDisplayedItem</strong>
                trong
                <strong>@Filtered.Count</strong>
                kết quả
            </div>

            <div class="pagination">

                <button disabled="@(CurrentPage == 1)"
                        @onclick="PreviousPage">
                    ‹
                </button>

                @foreach (var page in VisiblePages)
                {
                    var pageNumber = page;

                    <button class="@(pageNumber == CurrentPage ? "active" : "")"
                            @onclick="() => ChangePage(pageNumber)">
                        @pageNumber
                    </button>
                }

                <button disabled="@(CurrentPage == TotalPages)"
                        @onclick="NextPage">
                    ›
                </button>

            </div>

        </div>

    </div>

    <!-- MODAL XÓA -->
    @if (ShowDeleteModal && SelectedVoucher != null)
    {
        <div class="delete-overlay"
             @onclick="CloseDeleteModal">

            <div class="delete-modal"
                 @onclick:stopPropagation="true">

                <div class="delete-icon">!</div>

                <h3>Xóa Voucher?</h3>

                <p>
                    Bạn có chắc chắn muốn xóa Voucher
                    <strong>@SelectedVoucher.TenVoucher</strong> không?
                </p>

                <div class="delete-warning">
                    Voucher đã được sử dụng trong hóa đơn có thể không xóa được.
                </div>

                <div class="delete-actions">

                    <button class="cancel-delete"
                            disabled="@IsDeleting"
                            @onclick="CloseDeleteModal">
                        Hủy
                    </button>

                    <button class="confirm-delete"
                            disabled="@IsDeleting"
                            @onclick="DeleteVoucher">

                        @if (IsDeleting)
                        {
                            <span class="mini-spinner"></span>
                            <span>Đang xóa...</span>
                        }
                        else
                        {
                            <span>⌫</span>
                            <span>Xóa Voucher</span>
                        }

                    </button>

                </div>

            </div>

        </div>
    }

    <!-- TOAST -->
    @if (!string.IsNullOrWhiteSpace(ToastMessage))
    {
        <div class="custom-toast @(ToastSuccess ? "success" : "error")">

            <span class="toast-icon">
                @(ToastSuccess ? "✓" : "!")
            </span>

            <div>
                <strong>
                    @(ToastSuccess ? "Thành công" : "Có lỗi xảy ra")
                </strong>

                <small>@ToastMessage</small>
            </div>

            <button @onclick="CloseToast">×</button>

        </div>
    }

</div>

@code {
    private List<Voucher> Vouchers = new();

    private string searchText = string.Empty;
    private string selectedTrangThai = string.Empty;

    private bool IsLoading = true;
    private bool IsDeleting;

    private Guid? TogglingId;

    private bool ShowDeleteModal;
    private Voucher? SelectedVoucher;

    private string PageError = string.Empty;

    private string ToastMessage = string.Empty;
    private bool ToastSuccess;

    private int CurrentPage = 1;
    private int PageSize = 10;

    private string SearchText
    {
        get => searchText;
        set
        {
            searchText = value;
            CurrentPage = 1;
        }
    }

    private string SelectedTrangThai
    {
        get => selectedTrangThai;
        set
        {
            selectedTrangThai = value;
            CurrentPage = 1;
        }
    }

    private List<Voucher> Filtered =>
        Vouchers
            .Where(v =>
                string.IsNullOrWhiteSpace(searchText)
                || (v.TenVoucher ?? string.Empty)
                    .Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase))
            .Where(v =>
                selectedTrangThai switch
                {
                    "hoatdong" => IsActive(v),
                    "sapdienra" => IsUpcoming(v),
                    "ngung" => !v.TrangThai,
                    "hethan" => IsExpired(v),
                    _ => true
                })
            .ToList();

    private List<Voucher> PagedList =>
        Filtered
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                (double)Filtered.Count / PageSize));

    private IEnumerable<int> VisiblePages
    {
        get
        {
            const int maxVisible = 5;

            var start = Math.Max(
                1,
                CurrentPage - maxVisible / 2);

            var end = Math.Min(
                TotalPages,
                start + maxVisible - 1);

            start = Math.Max(
                1,
                end - maxVisible + 1);

            return Enumerable.Range(
                start,
                end - start + 1);
        }
    }

    private int FirstDisplayedItem =>
        Filtered.Count == 0
            ? 0
            : (CurrentPage - 1) * PageSize + 1;

    private int LastDisplayedItem =>
        Math.Min(
            CurrentPage * PageSize,
            Filtered.Count);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            IsLoading = true;
            PageError = string.Empty;

            Vouchers = (await service.GetAll())
                .OrderByDescending(x => x.NgayBatDau)
                .ToList();

            EnsureValidPage();
        }
        catch (Exception ex)
        {
            PageError =
                "Không thể tải danh sách Voucher: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void NavigateToCreate()
    {
        manager.NavigateTo("/Admin/AddVoucher");
    }

    private void NavigateToEdit(Guid id)
    {
        manager.NavigateTo($"/Admin/updatevoucher/{id}");
    }

    private async Task ToggleTrangThai(Guid id)
    {
        if (TogglingId.HasValue)
            return;

        var voucher =
            Vouchers.FirstOrDefault(x => x.VoucherId == id);

        if (voucher == null)
            return;

        if (IsExpired(voucher))
        {
            ShowToast(
                "Voucher đã hết hạn nên không thể chuyển trạng thái.",
                false);
            return;
        }

        var oldStatus = voucher.TrangThai;

        try
        {
            TogglingId = id;

            voucher.TrangThai = !voucher.TrangThai;

            // Chỉ await, không gán vào bool.
            await service.Update(voucher);

            await LoadData();

            ShowToast(
                voucher.TrangThai
                    ? "Đã kích hoạt Voucher."
                    : "Đã ngừng hoạt động Voucher.",
                true);
        }
        catch (Exception ex)
        {
            voucher.TrangThai = oldStatus;

            ShowToast(
                "Không thể cập nhật trạng thái: " + ex.Message,
                false);
        }
        finally
        {
            TogglingId = null;
        }
    }

    private void AskDelete(Voucher voucher)
    {
        SelectedVoucher = voucher;
        ShowDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        if (IsDeleting)
            return;

        SelectedVoucher = null;
        ShowDeleteModal = false;
    }

    private async Task DeleteVoucher()
    {
        if (SelectedVoucher == null || IsDeleting)
            return;

        try
        {
            IsDeleting = true;

            // Dùng được khi Delete trả Task hoặc Task<bool>.
            await service.Delete(SelectedVoucher.VoucherId);

            SelectedVoucher = null;
            ShowDeleteModal = false;

            await LoadData();

            ShowToast(
                "Xóa Voucher thành công.",
                true);
        }
        catch (Exception ex)
        {
            ShowToast(
                "Không thể xóa Voucher: " + ex.Message,
                false);
        }
        finally
        {
            IsDeleting = false;
        }
    }

    private static bool IsExpired(Voucher voucher)
    {
        return voucher.NgayKetThuc < DateTime.Now;
    }

    private static bool IsUpcoming(Voucher voucher)
    {
        return voucher.TrangThai
               && voucher.NgayBatDau > DateTime.Now
               && voucher.NgayKetThuc >= DateTime.Now;
    }

    private static bool IsActive(Voucher voucher)
    {
        var now = DateTime.Now;

        return voucher.TrangThai
               && voucher.NgayBatDau <= now
               && voucher.NgayKetThuc >= now;
    }

    private static string GetStatusText(Voucher voucher)
    {
        if (IsExpired(voucher))
            return "Hết hạn";

        if (!voucher.TrangThai)
            return "Ngừng hoạt động";

        if (IsUpcoming(voucher))
            return "Sắp diễn ra";

        return "Đang diễn ra";
    }

    private static string GetStatusClass(Voucher voucher)
    {
        if (IsExpired(voucher))
            return "voucher-status expired";

        if (!voucher.TrangThai)
            return "voucher-status inactive";

        if (IsUpcoming(voucher))
            return "voucher-status upcoming";

        return "voucher-status active";
    }

    private static string GetQuantityClass(int quantity)
    {
        if (quantity <= 0)
            return "quantity-badge empty";

        if (quantity <= 10)
            return "quantity-badge low";

        return "quantity-badge available";
    }

    private void ClearSearch()
    {
        SearchText = string.Empty;
    }

    private void ResetStatusFilter()
    {
        SelectedTrangThai = string.Empty;
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(
            e.Value?.ToString(),
            out var newSize))
        {
            PageSize = newSize;
            CurrentPage = 1;
        }
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void PreviousPage()
    {
        ChangePage(CurrentPage - 1);
    }

    private void NextPage()
    {
        ChangePage(CurrentPage + 1);
    }

    private void EnsureValidPage()
    {
        if (CurrentPage > TotalPages)
        {
            CurrentPage = TotalPages;
        }

        if (CurrentPage < 1)
        {
            CurrentPage = 1;
        }
    }

    private static string ShortId(Guid id)
    {
        return "#" + id
            .ToString()[..8]
            .ToUpperInvariant();
    }

    private void ShowToast(string message, bool success)
    {
        ToastMessage = message;
        ToastSuccess = success;
    }

    private void CloseToast()
    {
        ToastMessage = string.Empty;
    }
}

<style>
    .voucher-page {
        --primary: #f97316;
        --primary-dark: #ea580c;
        --primary-light: #fff7ed;
        --text: #172033;
        --muted: #718096;
        --border: #e7ebf1;
        min-height: 100vh;
        padding: 28px;
        background: #f6f8fc;
        color: var(--text);
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 21px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .header-icon {
        width: 50px;
        height: 50px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 14px;
        background: linear-gradient(135deg, #fb923c, #ea580c);
        font-size: 21px;
        box-shadow: 0 8px 20px rgba(249, 115, 22, .24);
    }

    .page-header h2 {
        margin: 0 0 4px;
        font-size: 25px;
        font-weight: 800;
    }

    .page-header p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
    }

    .add-button {
        min-height: 43px;
        padding: 0 17px;
        border: 0;
        border-radius: 11px;
        background: linear-gradient(135deg, #fb923c, #ea580c);
        color: white;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(249, 115, 22, .23);
        transition: .2s;
    }

        .add-button:hover {
            transform: translateY(-2px);
        }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 19px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 96px;
        padding: 16px;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: white;
        box-shadow: 0 5px 17px rgba(15, 23, 42, .04);
    }

    .stat-icon {
        width: 45px;
        height: 45px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 12px;
        font-size: 17px;
        font-weight: 800;
    }

        .stat-icon.total {
            background: #eff6ff;
            color: #2563eb;
        }

        .stat-icon.active {
            background: #ecfdf5;
            color: #059669;
        }

        .stat-icon.inactive {
            background: #f1f5f9;
            color: #64748b;
        }

        .stat-icon.expired {
            background: #fff1f2;
            color: #dc2626;
        }

    .stat-card span,
    .stat-card strong {
        display: block;
    }

    .stat-card span {
        margin-bottom: 4px;
        color: var(--muted);
        font-size: 10px;
    }

    .stat-card strong {
        font-size: 21px;
    }

    .voucher-panel {
        display: flex;
        flex-direction: column;
        height: 640px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 17px;
        background: white;
        box-shadow: 0 8px 27px rgba(15, 23, 42, .05);
    }

    .panel-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-shrink: 0;
        padding: 17px 19px;
        border-bottom: 1px solid var(--border);
    }

    .search-box {
        position: relative;
        width: min(470px, 100%);
    }

        .search-box > span {
            position: absolute;
            top: 50%;
            left: 14px;
            color: #94a3b8;
            font-size: 20px;
            transform: translateY(-50%);
        }

        .search-box input {
            width: 100%;
            height: 42px;
            padding: 0 42px;
            border: 1px solid #dce3ec;
            border-radius: 10px;
            outline: none;
            font-size: 12px;
        }

            .search-box input:focus,
            .status-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(249, 115, 22, .1);
            }

        .search-box button {
            position: absolute;
            top: 50%;
            right: 10px;
            width: 26px;
            height: 26px;
            padding: 0;
            border: 0;
            border-radius: 50%;
            background: #f1f5f9;
            color: #64748b;
            transform: translateY(-50%);
        }

    .filter-controls {
        display: flex;
