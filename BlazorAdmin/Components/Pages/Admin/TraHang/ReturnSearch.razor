@page "/TraHang"
@attribute [Authorize(Roles = "Admin,NhanVien")]
@layout AdminLayout
@rendermode InteractiveServer

@using API.Models.DTO.TraHang

@inject IReturnService ReturnService
@inject NavigationManager NavigationManager

<div class="return-page">

    <!-- HEADER -->
    <div class="page-header">
        <div class="header-left">
            <div class="header-icon">
                <i class="bi bi-arrow-return-left"></i>
            </div>

            <div>
                <h2>Quản lý trả hàng</h2>
                <p>Tìm kiếm hóa đơn và xử lý yêu cầu trả sản phẩm</p>
            </div>
        </div>
    </div>

    <!-- THỐNG KÊ -->
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-icon total">
                <i class="bi bi-receipt"></i>
            </div>

            <div>
                <span>Tổng hóa đơn</span>
                <strong>@HoaDons.Count</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon result">
                <i class="bi bi-search"></i>
            </div>

            <div>
                <span>Kết quả tìm kiếm</span>
                <strong>@FilteredInvoices.Count</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon money">
                <i class="bi bi-cash-stack"></i>
            </div>

            <div>
                <span>Tổng giá trị hóa đơn</span>
                <strong>@TotalInvoiceAmount.ToString("N0") ₫</strong>
            </div>
        </div>
    </div>

    <!-- TÌM KIẾM -->
    <div class="search-panel">
        <div class="search-heading">
            <div>
                <h4>Tìm kiếm hóa đơn</h4>
                <p>Nhập mã hóa đơn hoặc sử dụng bộ lọc nâng cao</p>
            </div>

            <button type="button"
                    class="advanced-toggle @(ShowAdvancedSearch ? "active" : "")"
                    @onclick="ToggleAdvancedSearch">
                <i class="bi bi-sliders"></i>

                @(ShowAdvancedSearch
                    ? "Ẩn bộ lọc"
                    : "Tìm kiếm nâng cao")
            </button>
        </div>

        <div class="main-search-row">
            <div class="invoice-search">
                <i class="bi bi-search search-icon"></i>

                <InputText @bind-Value="MaHoaDon"
                           @bind-Value:event="oninput"
                           list="invoice-code-list"
                           placeholder="Nhập hoặc chọn mã hóa đơn..." />

                <datalist id="invoice-code-list">
                    @foreach (var invoice in HoaDons)
                    {
                        <option value="@invoice.HoaDonId"></option>
                    }
                </datalist>

                @if (!string.IsNullOrWhiteSpace(MaHoaDon))
                {
                    <button type="button"
                            class="clear-input"
                            title="Xóa mã hóa đơn"
                            @onclick="ClearInvoiceCode">
                        <i class="bi bi-x"></i>
                    </button>
                }
            </div>

            <button type="button"
                    class="search-button"
                    disabled="@IsLoading"
                    @onclick="SearchAsync">
                @if (IsLoading)
                {
                    <span class="mini-spinner"></span>
                    <span>Đang tìm...</span>
                }
                else
                {
                    <i class="bi bi-search"></i>
                    <span>Tìm kiếm</span>
                }
            </button>

            <button type="button"
                    class="clear-button"
                    disabled="@IsLoading"
                    @onclick="ClearSearch">
                <i class="bi bi-arrow-counterclockwise"></i>
                Đặt lại
            </button>
        </div>

        @if (ShowAdvancedSearch)
        {
            <div class="advanced-search">
                <div class="filter-group">
                    <label>Tên khách hàng</label>

                    <InputText @bind-Value="TenKhachHang"
                               @bind-Value:event="oninput"
                               placeholder="Nhập tên khách hàng" />
                </div>

                <div class="filter-group">
                    <label>Số điện thoại</label>

                    <InputText @bind-Value="Sdt"
                               @bind-Value:event="oninput"
                               placeholder="Nhập số điện thoại" />
                </div>

                <div class="filter-group">
                    <label>Ngày tạo</label>

                    <InputDate @bind-Value="NgayTao" />
                </div>

                <div class="filter-group">
                    <label>Tổng tiền</label>

                    <InputText @bind-Value="TongTien"
                               @bind-Value:event="oninput"
                               placeholder="Ví dụ: 500000" />
                </div>

                <div class="filter-group">
                    <label>Trạng thái</label>

                    <InputText @bind-Value="TrangThai"
                               @bind-Value:event="oninput"
                               placeholder="Nhập trạng thái" />
                </div>

                <div class="filter-group">
                    <label>Hình thức thanh toán</label>

                    <InputText @bind-Value="HinhThucThanhToan"
                               @bind-Value:event="oninput"
                               placeholder="Tiền mặt, chuyển khoản..." />
                </div>
            </div>
        }
    </div>

    <!-- DANH SÁCH HÓA ĐƠN -->
    <div class="invoice-panel">
        <div class="table-heading">
            <div>
                <h4>Danh sách hóa đơn</h4>
                <p>Các hóa đơn có thể kiểm tra yêu cầu trả hàng</p>
            </div>

            <span class="result-badge">
                @FilteredInvoices.Count kết quả
            </span>
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="page-error">
                <span>
                    <i class="bi bi-exclamation"></i>
                </span>

                <div>@ErrorMessage</div>

                <button type="button"
                        @onclick="ClearError">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }

        <!-- BẢNG CÓ CUỘN NGANG VÀ DỌC -->
        <div class="table-wrapper">
            <table class="invoice-table">
                <thead>
                    <tr>
                        <th>Mã hóa đơn</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Ngày tạo</th>
                        <th>Tổng thanh toán</th>
                        <th>Trạng thái</th>
                        <th>Thanh toán</th>
                        <th class="col-action">Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="8">
                                <div class="loading-state">
                                    <div class="loading-spinner"></div>
                                    <span>Đang tải danh sách hóa đơn...</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (!PagedInvoices.Any())
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="empty-icon">
                                        <i class="bi bi-search"></i>
                                    </div>

                                    <strong>Không tìm thấy hóa đơn</strong>

                                    <span>
                                        Hãy kiểm tra lại mã hóa đơn hoặc bộ lọc.
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in PagedInvoices)
                        {
                            <tr>
                                <td>
                                    <div class="invoice-code">
                                        <strong>
                                            #@ShortId(item.HoaDonId)
                                        </strong>

                                        <small title="@item.HoaDonId">
                                            @item.HoaDonId
                                        </small>
                                    </div>
                                </td>

                                <td>
                                    <div class="customer-info">
                                        <div class="customer-avatar">
                                            @GetInitials(item.TenCuaKhachHang)
                                        </div>

                                        <strong>
                                            @(string.IsNullOrWhiteSpace(item.TenCuaKhachHang)
                                                ? "Khách lẻ"
                                                : item.TenCuaKhachHang)
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    <span class="phone-value">
                                        @(string.IsNullOrWhiteSpace(item.SDTCuaKhachHang)
                                            ? "Chưa cập nhật"
                                            : item.SDTCuaKhachHang)
                                    </span>
                                </td>

                                <td>
                                    <div class="date-value">
                                        <strong>
                                            @item.NgayTao.ToString("dd/MM/yyyy")
                                        </strong>

                                        <small>
                                            @item.NgayTao.ToString("HH:mm")
                                        </small>
                                    </div>
                                </td>

                                <td>
                                    <strong class="money-value">
                                        @ToDecimal(item.TongTienSauKhiGiam).ToString("N0") ₫
                                    </strong>
                                </td>

                                <td>
                                    <span class="invoice-status @GetStatusClass(item.TrangThai)">
                                        <i></i>

                                        @(string.IsNullOrWhiteSpace(item.TrangThai)
                                            ? "Không xác định"
                                            : item.TrangThai)
                                    </span>
                                </td>

                                <td>
                                    <span class="payment-badge">
                                        @(string.IsNullOrWhiteSpace(item.TenHinhThuc)
                                            ? "Chưa xác định"
                                            : item.TenHinhThuc)
                                    </span>
                                </td>

                                <td class="action-cell">
                                    <button type="button"
                                            class="return-button"
                                            @onclick="() => NavigateToDetail(item.HoaDonId)">
                                        <i class="bi bi-arrow-return-left"></i>
                                        Trả hàng
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- PHÂN TRANG -->
        <div class="pagination-bar">
            <div class="page-size">
                <span>Hiển thị</span>

                <select value="@PageSize"
                        @onchange="OnPageSizeChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>

                <span>hóa đơn</span>
            </div>

            <div class="result-info">
                Hiển thị
                <strong>@FirstDisplayedItem</strong>
                -
                <strong>@LastDisplayedItem</strong>
                trong
                <strong>@FilteredInvoices.Count</strong>
                kết quả
            </div>

            <div class="pagination">
                <button type="button"
                        disabled="@(CurrentPage <= 1)"
                        @onclick="PreviousPage">
                    <i class="bi bi-chevron-left"></i>
                </button>

                @foreach (var page in VisiblePages)
                {
                    var pageNumber = page;

                    <button type="button"
                            class="@(pageNumber == CurrentPage ? "active" : "")"
                            @onclick="() => ChangePage(pageNumber)">
                        @pageNumber
                    </button>
                }

                <button type="button"
                        disabled="@(CurrentPage >= TotalPages)"
                        @onclick="NextPage">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ReturnDTO> HoaDons { get; set; } = new();

    private string MaHoaDon { get; set; } = string.Empty;
    private string TenKhachHang { get; set; } = string.Empty;
    private string Sdt { get; set; } = string.Empty;
    private DateTime? NgayTao { get; set; }
    private string TrangThai { get; set; } = string.Empty;
    private string TongTien { get; set; } = string.Empty;
    private string HinhThucThanhToan { get; set; } = string.Empty;

    private bool ShowAdvancedSearch;
    private bool IsLoading = true;

    private string ErrorMessage = string.Empty;

    private int CurrentPage = 1;
    private int PageSize = 10;

    /*
     * Chuyển toàn bộ giá tiền sang decimal.
     * Hàm này xử lý lỗi float so sánh với decimal.
     */
    private static decimal ToDecimal(float value)
    {
        return Convert.ToDecimal(value);
    }

    private decimal TotalInvoiceAmount =>
        HoaDons.Sum(x => ToDecimal(x.TongTienSauKhiGiam));

    private List<ReturnDTO> FilteredInvoices
    {
        get
        {
            var result = HoaDons
                .Where(x =>
                    string.IsNullOrWhiteSpace(MaHoaDon)
                    || x.HoaDonId.ToString().Contains(
                        MaHoaDon.Trim(),
                        StringComparison.OrdinalIgnoreCase))

                .Where(x =>
                    string.IsNullOrWhiteSpace(TenKhachHang)
                    || (x.TenCuaKhachHang ?? string.Empty).Contains(
                        TenKhachHang.Trim(),
                        StringComparison.OrdinalIgnoreCase))

                .Where(x =>
                    string.IsNullOrWhiteSpace(Sdt)
                    || (x.SDTCuaKhachHang ?? string.Empty).Contains(
                        Sdt.Trim(),
                        StringComparison.OrdinalIgnoreCase))

                .Where(x =>
                    !NgayTao.HasValue
                    || x.NgayTao.Date == NgayTao.Value.Date)

                .Where(MatchesMoney)

                .Where(x =>
                    string.IsNullOrWhiteSpace(TrangThai)
                    || (x.TrangThai ?? string.Empty).Contains(
                        TrangThai.Trim(),
                        StringComparison.OrdinalIgnoreCase))

                .Where(x =>
                    string.IsNullOrWhiteSpace(HinhThucThanhToan)
                    || (x.TenHinhThuc ?? string.Empty).Contains(
                        HinhThucThanhToan.Trim(),
                        StringComparison.OrdinalIgnoreCase))

                .ToList();

            return result;
        }
    }

    private List<ReturnDTO> PagedInvoices
    {
        get
        {
            var validPage = Math.Clamp(CurrentPage, 1, TotalPages);

            return FilteredInvoices
                .Skip((validPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();
        }
    }

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                (double)FilteredInvoices.Count / PageSize));

    private IEnumerable<int> VisiblePages
    {
        get
        {
            const int maxVisiblePages = 5;

            var start = Math.Max(
                1,
                CurrentPage - maxVisiblePages / 2);

            var end = Math.Min(
                TotalPages,
                start + maxVisiblePages - 1);

            start = Math.Max(
                1,
                end - maxVisiblePages + 1);

            return Enumerable.Range(
                start,
                end - start + 1);
        }
    }

    private int FirstDisplayedItem =>
        FilteredInvoices.Count == 0
            ? 0
            : (CurrentPage - 1) * PageSize + 1;

    private int LastDisplayedItem =>
        Math.Min(
            CurrentPage * PageSize,
            FilteredInvoices.Count);

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoices();
    }

    private async Task LoadInvoices()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;

        try
        {
            HoaDons =
                await ReturnService.SearchHoaDonAsync()
                ?? new List<ReturnDTO>();

            CurrentPage = 1;
            EnsureValidPage();
        }
        catch
        {
            HoaDons = new();

            ErrorMessage =
                "Không thể tải danh sách hóa đơn. Vui lòng thử lại.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        if (IsLoading)
            return;

        IsLoading = true;
        ErrorMessage = string.Empty;
        CurrentPage = 1;

        try
        {
            HoaDons =
                await ReturnService.SearchHoaDonAsync(
                    MaHoaDon,
                    TenKhachHang,
                    Sdt,
                    NgayTao,
                    TrangThai)
                ?? new List<ReturnDTO>();

            EnsureValidPage();
        }
        catch
        {
            HoaDons = new();

            ErrorMessage =
                "Không thể tìm kiếm hóa đơn. Vui lòng thử lại.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ClearSearch()
    {
        if (IsLoading)
            return;

        MaHoaDon = string.Empty;
        TenKhachHang = string.Empty;
        Sdt = string.Empty;
        NgayTao = null;
        TongTien = string.Empty;
        TrangThai = string.Empty;
        HinhThucThanhToan = string.Empty;

        ShowAdvancedSearch = false;
        CurrentPage = 1;

        await LoadInvoices();
    }

    /*
     * FIX LỖI:
     * Không so sánh trực tiếp float == decimal.
     * Chuyển TongTienSauKhiGiam sang decimal trước.
     */
    private bool MatchesMoney(ReturnDTO invoice)
    {
        if (string.IsNullOrWhiteSpace(TongTien))
            return true;

        var normalizedSearch = new string(
            TongTien
                .Where(char.IsDigit)
                .ToArray());

        var invoiceAmount =
            ToDecimal(invoice.TongTienSauKhiGiam);

        if (decimal.TryParse(
            normalizedSearch,
            out var searchedAmount))
        {
            if (invoiceAmount == searchedAmount)
                return true;

            var normalizedInvoiceAmount = new string(
                invoiceAmount
                    .ToString("N0")
                    .Where(char.IsDigit)
                    .ToArray());

            return normalizedInvoiceAmount.Contains(
                normalizedSearch,
                StringComparison.OrdinalIgnoreCase);
        }

        return invoiceAmount
            .ToString("N0")
            .Contains(
                TongTien.Trim(),
                StringComparison.OrdinalIgnoreCase);
    }

    private void ClearInvoiceCode()
    {
        MaHoaDon = string.Empty;
        CurrentPage = 1;
    }

    private void ClearError()
    {
        ErrorMessage = string.Empty;
    }

    private void ToggleAdvancedSearch()
    {
        ShowAdvancedSearch = !ShowAdvancedSearch;
    }

    private void NavigateToDetail(Guid invoiceId)
    {
        NavigationManager.NavigateTo(
            $"/TraHang/{invoiceId}");
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(
            e.Value?.ToString(),
            out var newSize))
        {
            PageSize = newSize;
            CurrentPage = 1;
            EnsureValidPage();
        }
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > TotalPages)
            return;

        CurrentPage = page;
    }

    private void PreviousPage()
    {
        ChangePage(CurrentPage - 1);
    }

    private void NextPage()
    {
        ChangePage(CurrentPage + 1);
    }

    private void EnsureValidPage()
    {
        CurrentPage = Math.Clamp(
            CurrentPage,
            1,
            TotalPages);
    }

    private static string ShortId(Guid id)
    {
        return id.ToString()[..8].ToUpperInvariant();
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "KL";

        var words = name.Trim().Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
        {
            return words[0][0]
                .ToString()
                .ToUpperInvariant();
        }

        return string.Concat(
                words.First()[0],
                words.Last()[0])
            .ToUpperInvariant();
    }

    private static string GetStatusClass(string? status)
    {
        var value =
            status?.Trim().ToLowerInvariant()
            ?? string.Empty;

        if (value.Contains("hoàn thành")
            || value.Contains("hoanthanh"))
        {
            return "completed";
        }

        if (value.Contains("hủy")
            || value.Contains("huy"))
        {
            return "cancelled";
        }

        if (value.Contains("trả")
            || value.Contains("tra"))
        {
            return "returned";
        }

        return "pending";
    }
}

<style>
    .return-page {
        --primary: #f97316;
        --primary-dark: #ea580c;
        --primary-light: #fff7ed;
        --text: #172033;
        --muted: #718096;
        --border: #e7ebf1;
        min-height: 100vh;
        padding: 28px;
        background: #f6f8fc;
        color: var(--text);
    }

    .page-header {
        margin-bottom: 21px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .header-icon {
        width: 50px;
        height: 50px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: linear-gradient(135deg, #fb923c, #ea580c);
        color: white;
        font-size: 21px;
        box-shadow: 0 8px 20px rgba(249, 115, 22, .24);
    }

    .page-header h2 {
        margin: 0 0 4px;
        font-size: 25px;
        font-weight: 800;
    }

    .page-header p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
    }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 19px;
    }

    .stat-card {
        min-height: 98px;
        padding: 17px;
        display: flex;
        align-items: center;
        gap: 13px;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: white;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .04);
    }

    .stat-icon {
        width: 47px;
        height: 47px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 13px;
        font-size: 18px;
    }

        .stat-icon.total {
            background: #eff6ff;
            color: #2563eb;
        }

        .stat-icon.result {
            background: #ecfdf5;
            color: #059669;
        }

        .stat-icon.money {
            background: var(--primary-light);
            color: var(--primary-dark);
        }

    .stat-card span,
    .stat-card strong {
        display: block;
    }

    .stat-card span {
        margin-bottom: 5px;
        color: var(--muted);
        font-size: 11px;
    }

    .stat-card strong {
        font-size: 22px;
    }

    .search-panel,
    .invoice-panel {
        border: 1px solid var(--border);
        border-radius: 17px;
        background: white;
        box-shadow: 0 7px 25px rgba(15, 23, 42, .045);
    }

    .search-panel {
        padding: 20px;
        margin-bottom: 19px;
    }

    .search-heading,
    .table-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .search-heading {
        margin-bottom: 17px;
    }

        .search-heading h4,
        .table-heading h4 {
            margin: 0 0 3px;
            font-size: 16px;
            font-weight: 800;
        }

        .search-heading p,
        .table-heading p {
            margin: 0;
            color: var(--muted);
            font-size: 10px;
        }

    .advanced-toggle {
        min-height: 37px;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: 1px solid #dce3ec;
        border-radius: 9px;
        background: white;
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
    }

        .advanced-toggle.active {
            border-color: #fed7aa;
            background: var(--primary-light);
            color: var(--primary-dark);
        }

    .main-search-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        gap: 9px;
    }

    .invoice-search {
        position: relative;
    }

        .invoice-search .search-icon {
            position: absolute;
            top: 50%;
            left: 14px;
            z-index: 2;
            color: #94a3b8;
            transform: translateY(-50%);
        }

        .invoice-search input {
            width: 100%;
            height: 44px;
            padding: 0 43px;
            border: 1px solid #dce3ec;
            border-radius: 10px;
            outline: none;
            font-size: 12px;
        }

