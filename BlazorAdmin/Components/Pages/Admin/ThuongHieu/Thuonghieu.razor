@page "/ThuongHieu"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode InteractiveServer

@using Data.Models
@using BlazorAdmin.Service.IService
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions

@inject IThuongHieuService ThuongHieuService

<div class="brand-page">

    <!-- HEADER -->
    <div class="page-header">

        <div class="header-left">
            <div class="header-icon">🏢</div>

            <div>
                <h2>Quản lý thương hiệu</h2>
                <p>Quản lý thông tin và trạng thái thương hiệu sản phẩm</p>
            </div>
        </div>

        <button class="add-button"
                @onclick="ShowAddModal">
            <span>＋</span>
            Thêm thương hiệu
        </button>

    </div>

    <!-- THỐNG KÊ -->
    <div class="stat-grid">

        <div class="stat-card">
            <div class="stat-icon total">▦</div>

            <div>
                <span>Tổng thương hiệu</span>
                <strong>@ThuongHieus.Count</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon active">✓</div>

            <div>
                <span>Đang hoạt động</span>
                <strong>
                    @ThuongHieus.Count(x => x.TrangThai)
                </strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon inactive">⏸</div>

            <div>
                <span>Ngừng hoạt động</span>
                <strong>
                    @ThuongHieus.Count(x => !x.TrangThai)
                </strong>
            </div>
        </div>

    </div>

    <!-- DANH SÁCH -->
    <div class="brand-panel">

        <!-- TOOLBAR -->
        <div class="panel-toolbar">

            <div class="search-box">
                <span>⌕</span>

                <input placeholder="Tìm tên, email, số điện thoại, địa chỉ..."
                       @bind="SearchText"
                       @bind:event="oninput" />

                @if (!string.IsNullOrWhiteSpace(SearchText))
                {
                    <button @onclick="ClearSearch">
                        ×
                    </button>
                }
            </div>

            <div class="status-filter">

                <button class="filter-button @(StatusFilter == "all" ? "active" : "")"
                        @onclick='() => ChangeStatusFilter("all")'>
                    Tất cả
                    <span>@ThuongHieus.Count</span>
                </button>

                <button class="filter-button @(StatusFilter == "active" ? "active" : "")"
                        @onclick='() => ChangeStatusFilter("active")'>
                    Hoạt động
                    <span>@ThuongHieus.Count(x => x.TrangThai)</span>
                </button>

                <button class="filter-button @(StatusFilter == "inactive" ? "active" : "")"
                        @onclick='() => ChangeStatusFilter("inactive")'>
                    Ngừng hoạt động
                    <span>@ThuongHieus.Count(x => !x.TrangThai)</span>
                </button>

            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(PageError))
        {
            <div class="page-error">
                <span>!</span>
                <div>@PageError</div>
                <button @onclick="() => PageError = string.Empty">×</button>
            </div>
        }

        <!-- BẢNG CÓ THANH CUỘN -->
        <div class="table-wrapper">

            <table class="brand-table">
                <thead>
                    <tr>
                        <th class="col-stt">STT</th>
                        <th>Thương hiệu</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Địa chỉ</th>
                        <th>Trạng thái</th>
                        <th class="col-action">Chức năng</th>
                    </tr>
                </thead>

                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="loading-state">
                                    <div class="loading-spinner"></div>
                                    <span>Đang tải danh sách thương hiệu...</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (!PagedBrands.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div>🔎</div>
                                    <strong>Không tìm thấy thương hiệu</strong>
                                    <span>
                                        Hãy thử thay đổi từ khóa hoặc bộ lọc
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in PagedBrands.Select((item, index) => new
                        {
                            Item = item,
                            Index = index
                        }))
                        {
                            var item = row.Item;

                            <tr>
                                <td class="stt-cell">
                                    @((CurrentPage - 1) * PageSize
                                        + row.Index + 1)
                                </td>

                                <td>
                                    <div class="brand-info">

                                        <div class="brand-avatar">
                                            @GetInitials(item.TenThuongHieu)
                                        </div>

                                        <div>
                                            <strong>@item.TenThuongHieu</strong>

                                            <small title="@item.ThuongHieuId">
                                                @ShortId(item.ThuongHieuId)
                                            </small>

                                            @if (!string.IsNullOrWhiteSpace(item.MoTa))
                                            {
                                                <p title="@item.MoTa">
                                                    @item.MoTa
                                                </p>
                                            }
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <span class="empty-value">
                                            Chưa cập nhật
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="contact-value">
                                            ✉ @item.Email
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.SDT))
                                    {
                                        <span class="empty-value">
                                            Chưa cập nhật
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="contact-value">
                                            ☎ @item.SDT
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="address-value"
                                         title="@item.DiaChi">
                                        @(string.IsNullOrWhiteSpace(item.DiaChi)
                                            ? "Chưa cập nhật"
                                            : item.DiaChi)
                                    </div>
                                </td>

                                <td>
                                    <span class="status-badge @(item.TrangThai ? "status-active" : "status-inactive")">
                                        <i></i>

                                        @(item.TrangThai
                                            ? "Đang hoạt động"
                                            : "Ngừng hoạt động")
                                    </span>
                                </td>

                                <td>
                                    <div class="action-group">

                                        <button class="action-button edit"
                                                title="Chỉnh sửa thương hiệu"
                                                @onclick="() => Edit(item)">
                                            ✎
                                        </button>

                                        <button class="action-button delete"
                                                title="Xóa thương hiệu"
                                                @onclick="() => AskDelete(item)">
                                            ⌫
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>

        <!-- PHÂN TRANG -->
        <div class="pagination-bar">

            <div class="page-size">
                <span>Hiển thị</span>

                <select value="@PageSize"
                        @onchange="OnPageSizeChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>

                <span>thương hiệu</span>
            </div>

            <div class="result-info">
                Hiển thị
                <strong>@FirstDisplayedItem</strong>
                -
                <strong>@LastDisplayedItem</strong>
                trong
                <strong>@FilteredThuongHieus.Count</strong>
                kết quả
            </div>

            <div class="pagination">

                <button disabled="@(CurrentPage == 1)"
                        @onclick="PreviousPage">
                    ‹
                </button>

                @foreach (var page in VisiblePages)
                {
                    var pageNumber = page;

                    <button class="@(pageNumber == CurrentPage ? "active" : "")"
                            @onclick="() => ChangePage(pageNumber)">
                        @pageNumber
                    </button>
                }

                <button disabled="@(CurrentPage == TotalPages)"
                        @onclick="NextPage">
                    ›
                </button>

            </div>

        </div>

    </div>

    <!-- MODAL THÊM/SỬA -->
    @if (IsModalVisible && FormEditContext != null)
    {
        <div class="modal-overlay"
             @onclick="CloseModal">

            <div class="brand-modal"
                 @onclick:stopPropagation="true">

                <div class="modal-header">

                    <div class="modal-heading">
                        <div class="modal-icon">
                            @(IsEditMode ? "✎" : "＋")
                        </div>

                        <div>
                            <span>
                                @(IsEditMode ? "CHỈNH SỬA" : "THÊM MỚI")
                            </span>

                            <h3>
                                @(IsEditMode
                                    ? "Cập nhật thương hiệu"
                                    : "Thêm thương hiệu")
                            </h3>

                            <p>
                                @(IsEditMode
                                    ? "Thay đổi thông tin của thương hiệu"
                                    : "Nhập thông tin thương hiệu mới")
                            </p>
                        </div>
                    </div>

                    <button class="close-modal"
                            type="button"
                            disabled="@IsSubmitting"
                            @onclick="CloseModal">
                        ×
                    </button>

                </div>

                <EditForm EditContext="@FormEditContext"
                          OnValidSubmit="@HandleValidSubmit"
                          FormName="ThuongHieuForm">

                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        <div class="form-grid">

                            <!-- TÊN THƯƠNG HIỆU -->
                            <div class="form-group full-width">
                                <label>
                                    Tên thương hiệu
                                    <span>*</span>
                                </label>

                                <div class="input-with-icon">
                                    <span>🏢</span>

                                    <InputText class="@GetInputClass(nameof(Model.TenThuongHieu))"
                                               @bind-Value="Model.TenThuongHieu"
                                               placeholder="Ví dụ: Nike" />
                                </div>

                                <ValidationMessage For="@(() => Model.TenThuongHieu)" />
                            </div>

                            <!-- EMAIL -->
                            <div class="form-group">
                                <label>Email</label>

                                <InputText type="email"
                                           class="@GetInputClass(nameof(Model.Email))"
                                           @bind-Value="Model.Email"
                                           placeholder="example@gmail.com" />

                                <ValidationMessage For="@(() => Model.Email)" />
                            </div>

                            <!-- SỐ ĐIỆN THOẠI -->
                            <div class="form-group">
                                <label>Số điện thoại</label>

                                <InputText class="@GetInputClass(nameof(Model.SDT))"
                                           @bind-Value="Model.SDT"
                                           placeholder="Ví dụ: 0912345678" />

                                <ValidationMessage For="@(() => Model.SDT)" />
                            </div>

                            <!-- ĐỊA CHỈ -->
                            <div class="form-group full-width">
                                <label>Địa chỉ</label>

                                <InputText class="@GetInputClass(nameof(Model.DiaChi))"
                                           @bind-Value="Model.DiaChi"
                                           placeholder="Nhập địa chỉ thương hiệu" />

                                <ValidationMessage For="@(() => Model.DiaChi)" />
                            </div>

                            <!-- MÔ TẢ -->
                            <div class="form-group full-width">
                                <label>Mô tả</label>

                                <InputTextArea class="@GetInputClass(nameof(Model.MoTa), true)"
                                               @bind-Value="Model.MoTa"
                                               placeholder="Nhập mô tả thương hiệu..."
                                               maxlength="500" />

                                <div class="character-count">
                                    @((Model.MoTa ?? string.Empty).Length)/500 ký tự
                                </div>

                                <ValidationMessage For="@(() => Model.MoTa)" />
                            </div>

                        </div>

                        <!-- TRẠNG THÁI -->
                        <div class="status-section">

                            <div class="status-content">
                                <div class="status-icon">
                                    @(Model.TrangThai ? "✓" : "⏸")
                                </div>

                                <div>
                                    <strong>
                                        @(Model.TrangThai
                                            ? "Đang hoạt động"
                                            : "Ngừng hoạt động")
                                    </strong>

                                    <small>
                                        @(Model.TrangThai
                                            ? "Thương hiệu được sử dụng khi tạo sản phẩm"
                                            : "Thương hiệu tạm thời không được sử dụng")
                                    </small>
                                </div>
                            </div>

                            <label class="custom-switch">
                                <InputCheckbox @bind-Value="Model.TrangThai" />
                                <span class="switch-slider"></span>
                            </label>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(FormError))
                        {
                            <div class="form-error">
                                <span>!</span>
                                <div>@FormError</div>
                            </div>
                        }

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="cancel-modal"
                                disabled="@IsSubmitting"
                                @onclick="CloseModal">
                            Hủy
                        </button>

                        <button type="submit"
                                class="save-modal"
                                disabled="@IsSubmitting">

                            @if (IsSubmitting)
                            {
                                <span class="mini-spinner"></span>
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <span>✓</span>
                                <span>
                                    @(IsEditMode
                                        ? "Lưu thay đổi"
                                        : "Thêm thương hiệu")
                                </span>
                            }

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>
    }

    <!-- MODAL XÓA -->
    @if (ShowDeleteModal && SelectedBrand != null)
    {
        <div class="delete-overlay"
             @onclick="CloseDeleteModal">

            <div class="delete-modal"
                 @onclick:stopPropagation="true">

                <div class="delete-icon">!</div>

                <h3>Xóa thương hiệu?</h3>

                <p>
                    Bạn có chắc chắn muốn xóa thương hiệu
                    <strong>@SelectedBrand.TenThuongHieu</strong> không?
                </p>

                <div class="delete-warning">
                    Thương hiệu đang được sản phẩm sử dụng có thể không xóa được.
                </div>

                <div class="delete-actions">

                    <button class="cancel-delete"
                            disabled="@IsDeleting"
                            @onclick="CloseDeleteModal">
                        Hủy
                    </button>

                    <button class="confirm-delete"
                            disabled="@IsDeleting"
                            @onclick="ConfirmDelete">

                        @if (IsDeleting)
                        {
                            <span class="mini-spinner"></span>
                            <span>Đang xóa...</span>
                        }
                        else
                        {
                            <span>⌫</span>
                            <span>Xóa thương hiệu</span>
                        }

                    </button>

                </div>

            </div>

        </div>
    }

    <!-- TOAST -->
    @if (!string.IsNullOrWhiteSpace(ToastMessage))
    {
        <div class="custom-toast @(ToastSuccess ? "success" : "error")">

            <span class="toast-icon">
                @(ToastSuccess ? "✓" : "!")
            </span>

            <div>
                <strong>
                    @(ToastSuccess ? "Thành công" : "Có lỗi xảy ra")
                </strong>

                <small>@ToastMessage</small>
            </div>

            <button @onclick="CloseToast">×</button>

        </div>
    }

</div>

@code {
    private List<ThuongHieu> ThuongHieus = new();

    private ThuongHieu Model = new();

    private EditContext? FormEditContext;
    private ValidationMessageStore? MessageStore;

    private bool IsLoading = true;
    private bool IsModalVisible;
    private bool IsEditMode;
    private bool IsSubmitting;

    private bool ShowDeleteModal;
    private bool IsDeleting;
    private ThuongHieu? SelectedBrand;

    private string SearchValue = string.Empty;
    private string StatusFilter = "all";

    private string PageError = string.Empty;
    private string FormError = string.Empty;

    private string ToastMessage = string.Empty;
    private bool ToastSuccess;

    private int CurrentPage = 1;
    private int PageSize = 10;

    private string SearchText
    {
        get => SearchValue;
        set
        {
            SearchValue = value;
            CurrentPage = 1;
        }
    }

    private List<ThuongHieu> FilteredThuongHieus =>
        ThuongHieus
            .Where(x =>
                StatusFilter == "all"
                || (StatusFilter == "active" && x.TrangThai)
                || (StatusFilter == "inactive" && !x.TrangThai))
            .Where(x =>
                string.IsNullOrWhiteSpace(SearchValue)
                || (x.TenThuongHieu ?? string.Empty)
                    .Contains(
                        SearchValue,
                        StringComparison.OrdinalIgnoreCase)
                || (x.Email ?? string.Empty)
                    .Contains(
                        SearchValue,
                        StringComparison.OrdinalIgnoreCase)
                || (x.SDT ?? string.Empty)
                    .Contains(
                        SearchValue,
                        StringComparison.OrdinalIgnoreCase)
                || (x.DiaChi ?? string.Empty)
                    .Contains(
                        SearchValue,
                        StringComparison.OrdinalIgnoreCase))
            .ToList();

    private List<ThuongHieu> PagedBrands =>
        FilteredThuongHieus
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                (double)FilteredThuongHieus.Count / PageSize));

    private IEnumerable<int> VisiblePages
    {
        get
        {
            const int maxVisiblePages = 5;

            var start = Math.Max(
                1,
                CurrentPage - maxVisiblePages / 2);

            var end = Math.Min(
                TotalPages,
                start + maxVisiblePages - 1);

            start = Math.Max(
                1,
                end - maxVisiblePages + 1);

            return Enumerable.Range(
                start,
                end - start + 1);
        }
    }

    private int FirstDisplayedItem =>
        FilteredThuongHieus.Count == 0
            ? 0
            : (CurrentPage - 1) * PageSize + 1;

    private int LastDisplayedItem =>
        Math.Min(
            CurrentPage * PageSize,
            FilteredThuongHieus.Count);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            IsLoading = true;
            PageError = string.Empty;

            ThuongHieus =
                (await ThuongHieuService.GetAllAsync())
                .OrderBy(x => x.TenThuongHieu)
                .ToList();

            EnsureValidPage();
        }
        catch (Exception ex)
        {
            PageError =
                "Không thể tải danh sách thương hiệu: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ShowAddModal()
    {
        Model = new ThuongHieu
            {
                TrangThai = true
            };

        IsEditMode = false;
        FormError = string.Empty;

        CreateEditContext();

        IsModalVisible = true;
    }

    private void Edit(ThuongHieu item)
    {
        Model = new ThuongHieu
            {
                ThuongHieuId = item.ThuongHieuId,
                TenThuongHieu = item.TenThuongHieu,
                Email = item.Email,
                SDT = item.SDT,
                DiaChi = item.DiaChi,
                MoTa = item.MoTa,
                TrangThai = item.TrangThai
            };

        IsEditMode = true;
        FormError = string.Empty;

        CreateEditContext();

        IsModalVisible = true;
    }

    private void CreateEditContext()
    {
        FormEditContext = new EditContext(Model);

        MessageStore =
            new ValidationMessageStore(FormEditContext);
    }

    private void CloseModal()
    {
        if (IsSubmitting)
            return;

        IsModalVisible = false;
        FormError = string.Empty;
    }

    private async Task HandleValidSubmit()
    {
        if (IsSubmitting
            || FormEditContext == null
            || MessageStore == null)
        {
            return;
        }

        try
        {
            IsSubmitting = true;
            FormError = string.Empty;

            NormalizeModel();

            if (!ValidateModel())
                return;

            // Chỉ await, không gán vào bool để dùng được
            // với service trả về Task hoặc Task<T>.
            if (Model.ThuongHieuId == Guid.Empty)
            {
                await ThuongHieuService.CreateAsync(Model);
            }
            else
            {
                await ThuongHieuService.UpdateAsync(Model);
            }

            var successMessage =
                Model.ThuongHieuId == Guid.Empty
                    ? "Thêm thương hiệu thành công."
                    : "Cập nhật thương hiệu thành công.";

            IsModalVisible = false;

            await LoadDataAsync();

            ShowToast(successMessage, true);
        }
        catch (Exception ex)
        {
            FormError =
                "Không thể lưu thương hiệu: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void NormalizeModel()
    {
        Model.TenThuongHieu =
            Model.TenThuongHieu?.Trim() ?? string.Empty;

        Model.Email =
            Model.Email?.Trim() ?? string.Empty;

        Model.SDT =
            Model.SDT?.Trim() ?? string.Empty;

        Model.DiaChi =
            Model.DiaChi?.Trim() ?? string.Empty;

        Model.MoTa =
            Model.MoTa?.Trim() ?? string.Empty;
    }

    private bool ValidateModel()
    {
        if (FormEditContext == null || MessageStore == null)
            return false;

        MessageStore.Clear();

        var nameField = new FieldIdentifier(
            Model,
            nameof(Model.TenThuongHieu));

        var emailField = new FieldIdentifier(
            Model,
            nameof(Model.Email));

        var phoneField = new FieldIdentifier(
            Model,
            nameof(Model.SDT));

        var addressField = new FieldIdentifier(
            Model,
            nameof(Model.DiaChi));

        var descriptionField = new FieldIdentifier(
            Model,
            nameof(Model.MoTa));

        if (string.IsNullOrWhiteSpace(Model.TenThuongHieu))
        {
            MessageStore.Add(
                nameField,
                "Tên thương hiệu không được để trống.");
        }
        else
        {
            if (Model.TenThuongHieu.Length < 2)
            {
                MessageStore.Add(
                    nameField,
                    "Tên thương hiệu phải có ít nhất 2 ký tự.");
            }

            if (Model.TenThuongHieu.Length > 100)
            {
                MessageStore.Add(
                    nameField,
                    "Tên thương hiệu không vượt quá 100 ký tự.");
            }

            var duplicatedName = ThuongHieus.Any(x =>
                x.ThuongHieuId != Model.ThuongHieuId
                && string.Equals(
                    x.TenThuongHieu?.Trim(),
                    Model.TenThuongHieu,
                    StringComparison.OrdinalIgnoreCase));

            if (duplicatedName)
            {
                MessageStore.Add(
                    nameField,
                    "Tên thương hiệu đã tồn tại.");
            }
        }

        if (!string.IsNullOrWhiteSpace(Model.Email))
        {
            var emailValidator = new EmailAddressAttribute();

            if (!emailValidator.IsValid(Model.Email))
            {
                MessageStore.Add(
                    emailField,
                    "Email không đúng định dạng.");
            }

            var duplicatedEmail = ThuongHieus.Any(x =>
                x.ThuongHieuId != Model.ThuongHieuId
                && string.Equals(
                    x.Email?.Trim(),
                    Model.Email,
                    StringComparison.OrdinalIgnoreCase));

            if (duplicatedEmail)
            {
                MessageStore.Add(
                    emailField,
                    "Email đã được thương hiệu khác sử dụng.");
            }
        }

        if (!string.IsNullOrWhiteSpace(Model.SDT))
        {
            if (!Regex.IsMatch(
                Model.SDT,
                @"^(0\d{9}|\+84\d{9})$"))
            {
                MessageStore.Add(
                    phoneField,
                    "Số điện thoại phải gồm 10 số hoặc bắt đầu bằng +84.");
            }

            var duplicatedPhone = ThuongHieus.Any(x =>
                x.ThuongHieuId != Model.ThuongHieuId
                && string.Equals(
                    x.SDT?.Trim(),
                    Model.SDT,
                    StringComparison.OrdinalIgnoreCase));

            if (duplicatedPhone)
            {
                MessageStore.Add(
                    phoneField,
                    "Số điện thoại đã được thương hiệu khác sử dụng.");
            }
        }

        if (Model.DiaChi.Length > 250)
        {
            MessageStore.Add(
                addressField,
                "Địa chỉ không vượt quá 250 ký tự.");
        }

        if (Model.MoTa.Length > 500)
        {
            MessageStore.Add(
                descriptionField,
                "Mô tả không vượt quá 500 ký tự.");
        }

        FormEditContext.NotifyValidationStateChanged();

        return !FormEditContext
            .GetValidationMessages()
            .Any();
    }

    private string GetInputClass(
        string fieldName,
        bool isTextarea = false)
    {
        var baseClass = isTextarea
            ? "form-control-custom textarea-control"
            : "form-control-custom";

        if (FormEditContext == null)
            return baseClass;

        var fieldIdentifier = new FieldIdentifier(
            Model,
            fieldName);

        var hasError = FormEditContext
            .GetValidationMessages(fieldIdentifier)
            .Any();

        return hasError
            ? baseClass + " invalid"
            : baseClass;
    }

    private void AskDelete(ThuongHieu item)
    {
        SelectedBrand = item;
        ShowDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        if (IsDeleting)
            return;

        SelectedBrand = null;
        ShowDeleteModal = false;
    }

    private async Task ConfirmDelete()
    {
        if (SelectedBrand == null || IsDeleting)
            return;

        try
        {
            IsDeleting = true;

            await ThuongHieuService.DeleteAsync(
                SelectedBrand.ThuongHieuId);

            SelectedBrand = null;
            ShowDeleteModal = false;

            await LoadDataAsync();

            ShowToast(
                "Xóa thương hiệu thành công.",
                true);
        }
        catch (Exception ex)
        {
            ShowToast(
                "Không thể xóa thương hiệu: " + ex.Message,
                false);
        }
        finally
        {
            IsDeleting = false;
        }
    }

    private void ChangeStatusFilter(string value)
    {
        StatusFilter = value;
        CurrentPage = 1;
    }

    private void ClearSearch()
    {
        SearchText = string.Empty;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void PreviousPage()
    {
        ChangePage(CurrentPage - 1);
    }

    private void NextPage()
    {
        ChangePage(CurrentPage + 1);
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(
            e.Value?.ToString(),
            out var newSize))
        {
            PageSize = newSize;
            CurrentPage = 1;
        }
    }

    private void EnsureValidPage()
    {
        if (CurrentPage > TotalPages)
        {
            CurrentPage = TotalPages;
        }

        if (CurrentPage < 1)
        {
            CurrentPage = 1;
        }
    }

    private static string ShortId(Guid id)
    {
        return "#" + id
            .ToString()[..8]
            .ToUpperInvariant();
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "TH";

        var words = name.Trim()
            .Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
        {
            return words[0][0]
                .ToString()
                .ToUpperInvariant();
        }

        return string.Concat(
            words.First()[0],
            words.Last()[0])
            .ToUpperInvariant();
    }

    private void ShowToast(string message, bool success)
    {
        ToastMessage = message;
        ToastSuccess = success;
    }

    private void CloseToast()
    {
        ToastMessage = string.Empty;
    }
}

