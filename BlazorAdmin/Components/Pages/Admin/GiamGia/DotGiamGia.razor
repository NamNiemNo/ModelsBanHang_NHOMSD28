@page "/dotgiamgia"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@using Data.Models
@using BlazorAdmin.Service.IService

@inject IGiamGiaService GiamGiaService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Quản lý đợt khuyến mại</PageTitle>

<div class="promotion-page">

    <!-- Tiêu đề -->
    <header class="promotion-header">
        <div>
            <span class="page-eyebrow">KHUYẾN MẠI</span>

            <h1>Quản lý đợt khuyến mại</h1>

            <p>
                Quản lý thời gian, mức giảm giá và các sản phẩm áp dụng.
            </p>
        </div>

        <button type="button"
                class="add-promotion-button"
                @onclick="GoToAddPage">

            <svg viewBox="0 0 24 24">
                <path d="M12 5v14M5 12h14" />
            </svg>

            Thêm đợt giảm giá
        </button>
    </header>

    <!-- Thống kê -->
    <section class="promotion-statistics">

        <article class="promotion-stat-card statistic-total">
            <div class="statistic-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M5 4h14v16H5z" />
                    <path d="M8 8h8M8 12h8M8 16h5" />
                </svg>
            </div>

            <div>
                <span>Tổng số đợt</span>
                <strong>@all.Count</strong>
                <small>Tất cả chương trình khuyến mại</small>
            </div>
        </article>

        <article class="promotion-stat-card statistic-visible">
            <div class="statistic-icon">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9" />
                    <path d="m8 12 3 3 5-6" />
                </svg>
            </div>

            <div>
                <span>Đang hiển thị</span>

                <strong>
                    @all.Count(x => x.TrangThai)
                </strong>

                <small>Chương trình đang được hiển thị</small>
            </div>
        </article>

        <article class="promotion-stat-card statistic-hidden">
            <div class="statistic-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M3 12s3-5 9-5 9 5 9 5-3 5-9 5-9-5-9-5Z" />
                    <path d="m4 4 16 16" />
                </svg>
            </div>

            <div>
                <span>Đang ẩn</span>

                <strong>
                    @all.Count(x => !x.TrangThai)
                </strong>

                <small>Chương trình đã tạm ngừng</small>
            </div>
        </article>

        <article class="promotion-stat-card statistic-products">
            <div class="statistic-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M4 16c4 0 7-2 9-7l2 5 5 2v4H4z" />
                </svg>
            </div>

            <div>
                <span>Tổng giày áp dụng</span>

                <strong>
                    @all.Sum(x => x.GiayDotGiamGias?.Count ?? 0)
                </strong>

                <small>Chi tiết giày được áp dụng</small>
            </div>
        </article>
    </section>

    <!-- Thông báo lỗi -->
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="page-error-message">
            <span>@ErrorMessage</span>

            <button type="button" @onclick="LoadDataAsync">
                Thử lại
            </button>
        </div>
    }

    <!-- Khung danh sách -->
    <section class="promotion-panel">

        <!-- Toolbar -->
        <div class="promotion-toolbar">

            <!-- Tìm kiếm -->
            <div class="promotion-search">
                <svg viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-4-4" />
                </svg>

                <input type="text"
                       value="@searchTerm"
                       @oninput="HandleSearch"
                       placeholder="Tìm tên đợt, tên giày, màu, size, ID..." />

                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <button type="button"
                            class="clear-search-button"
                            title="Xóa tìm kiếm"
                            @onclick="ClearSearch">
                        ×
                    </button>
                }
            </div>

            <!-- Lọc trạng thái -->
            <div class="promotion-filter-buttons">

                <button type="button"
                        class="filter-button @(StatusFilter == "all" ? "active" : "")"
                        @onclick='() => SetStatusFilter("all")'>

                    Tất cả

                    <span>@all.Count</span>
                </button>

                <button type="button"
                        class="filter-button @(StatusFilter == "visible" ? "active" : "")"
                        @onclick='() => SetStatusFilter("visible")'>

                    Đang hiển thị

                    <span>
                        @all.Count(x => x.TrangThai)
                    </span>
                </button>

                <button type="button"
                        class="filter-button @(StatusFilter == "hidden" ? "active" : "")"
                        @onclick='() => SetStatusFilter("hidden")'>

                    Đang ẩn

                    <span>
                        @all.Count(x => !x.TrangThai)
                    </span>
                </button>
            </div>
        </div>

        <!-- Bảng dữ liệu -->
        <div class="promotion-table-wrapper">
            <table class="promotion-table">
                <thead>
                    <tr>
                        <th class="number-column">STT</th>
                        <th>Tên đợt</th>
                        <th>Thời gian</th>
                        <th class="text-center">Giảm giá</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Giày áp dụng</th>
                        <th class="action-column">Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="loading-state">
                                    <span class="loading-spinner"></span>
                                    <strong>Đang tải dữ liệu...</strong>
                                    <small>Vui lòng chờ trong giây lát</small>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (PagedList.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div class="empty-icon">
                                        <svg viewBox="0 0 24 24">
                                            <path d="M5 4h14v16H5z" />
                                            <path d="M8 9h8M8 13h5" />
                                        </svg>
                                    </div>

                                    <strong>
                                        Không tìm thấy đợt khuyến mại
                                    </strong>

                                    <small>
                                        Hãy thử từ khóa hoặc bộ lọc khác.
                                    </small>

                                    <button type="button"
                                            @onclick="ResetFilter">
                                        Đặt lại bộ lọc
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in PagedList
                            .Select((item, index) => new
                            {
                                Item = item,
                                Number =
                                    (CurrentPage - 1) * PageSize
                                    + index + 1
                            }))
                        {
                            var item = row.Item;

                            <tr>
                                <td class="table-number">
                                    @row.Number
                                </td>

                                <!-- Tên chương trình -->
                                <td>
                                    <div class="promotion-name-cell">
                                        <span class="promotion-avatar">
                                            @GetFirstLetter(item.TenGiamGia)
                                        </span>

                                        <div>
                                            <strong title="@item.TenGiamGia">
                                                @item.TenGiamGia
                                            </strong>

                                            <small title="@item.GiamGiaId">
                                                #@GetShortId(item.GiamGiaId)
                                            </small>
                                        </div>
                                    </div>
                                </td>

                                <!-- Thời gian -->
                                <td>
                                    <div class="promotion-time-cell">
                                        <div class="date-range">
                                            <svg viewBox="0 0 24 24">
                                                <rect x="3"
                                                      y="5"
                                                      width="18"
                                                      height="16"
                                                      rx="2" />

                                                <path d="M7 3v4M17 3v4M3 10h18" />
                                            </svg>

                                            <div>
                                                <strong>
                                                    @item.NgayBatDau.ToString("dd/MM/yyyy")
                                                </strong>

                                                <span>
                                                    đến @item.NgayKetThuc.ToString("dd/MM/yyyy")
                                                </span>
                                            </div>
                                        </div>

                                        <span class="time-status @GetTimeStatusClass(item)">
                                            @GetTimeStatus(item)
                                        </span>
                                    </div>
                                </td>

                                <!-- Phần trăm -->
                                <td class="text-center">
                                    <span class="discount-badge">
                                        @item.PhanTramKhuyenMai.ToString("0.##")%
                                    </span>
                                </td>

                                <!-- Trạng thái -->
                                <td>
                                    <span class="promotion-status @(item.TrangThai ? "status-visible" : "status-hidden")">

                                        <span class="status-dot"></span>

                                        @(item.TrangThai
                                            ? "Đang hiển thị"
                                            : "Đang ẩn")
                                    </span>
                                </td>

                                <!-- Số giày -->
                                <td class="text-center">
                                    <span class="product-count">
                                        @(item.GiayDotGiamGias?.Count ?? 0)
                                    </span>
                                </td>

                                <!-- Thao tác -->
                                <td>
                                    <div class="table-actions">

                                        <button type="button"
                                                class="action-button edit-button"
                                                title="Chỉnh sửa đợt giảm giá"
                                                @onclick="() => EditPromotion(item.GiamGiaId)">

                                            <svg viewBox="0 0 24 24">
                                                <path d="M4 20h4L19 9l-4-4L4 16v4Z" />
                                                <path d="m13 7 4 4" />
                                            </svg>

                                            Sửa
                                        </button>

                                        <button type="button"
                                                class="action-button assign-button"
                                                title="Gán giày vào đợt giảm giá"
                                                @onclick="() => AssignProducts(item.GiamGiaId)">

                                            <svg viewBox="0 0 24 24">
                                                <path d="M10 13a5 5 0 0 0 7.5.5l2-2a5 5 0 0 0-7-7l-1 1" />
                                                <path d="M14 11a5 5 0 0 0-7.5-.5l-2 2a5 5 0 0 0 7 7l1-1" />
                                            </svg>

                                            Gán giày
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        <footer class="promotion-table-footer">

            <div class="page-size-control">
                <span>Hiển thị</span>

                <select value="@PageSize"
                        @onchange="OnPageSizeChanged">

                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                </select>

                <span>
                    / @Filtered.Count đợt khuyến mại
                </span>
            </div>

            <nav class="promotion-pagination">

                <button type="button"
                        class="pagination-button pagination-arrow"
                        disabled="@(CurrentPage == 1)"
                        @onclick="() => ChangePage(1)">
                    «
                </button>

                <button type="button"
                        class="pagination-button pagination-arrow"
                        disabled="@(CurrentPage == 1)"
                        @onclick="PreviousPage">
                    ‹
                </button>

                @foreach (var page in VisiblePages)
                {
                    <button type="button"
                            class="pagination-button @(CurrentPage == page ? "active" : "")"
                            @onclick="() => ChangePage(page)">
                    </button>
                }

                <button type="button"
                        class="pagination-button pagination-arrow"
                        disabled="@(CurrentPage == TotalPages)"
                        @onclick="NextPage">
                    ›
                </button>

                <button type="button"
                        class="pagination-button pagination-arrow"
                        disabled="@(CurrentPage == TotalPages)"
                        @onclick="() => ChangePage(TotalPages)">
                    »
                </button>
            </nav>
        </footer>
    </section>
</div>

<style>
    .promotion-page,
    .promotion-page * {
        box-sizing: border-box;
    }

    .promotion-page {
        --primary: #f97316;
        --primary-dark: #ea580c;
        --primary-light: #fff7ed;
        --text-dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --border: #e8edf3;

        min-height: 100vh;
        padding: 28px;
        background: #f6f8fb;
        color: var(--text-dark);
    }

    /* Tiêu đề */

    .promotion-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 24px;
    }

    .page-eyebrow {
        display: block;
        margin-bottom: 6px;

        color: var(--primary-dark);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.14em;
    }

    .promotion-header h1 {
        margin: 0;

        color: var(--text-dark);
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .promotion-header p {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 13px;
    }

    .add-promotion-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        min-height: 44px;
        padding: 0 18px;

        border: none;
        border-radius: 11px;
        background: var(--primary);
        color: #ffffff;

        font-size: 12px;
        font-weight: 800;
        cursor: pointer;

        box-shadow: 0 6px 15px rgba(249, 115, 22, 0.22);

        transition:
            background 0.2s ease,
            transform 0.2s ease;
    }

    .add-promotion-button:hover {
        background: var(--primary-dark);
        transform: translateY(-1px);
    }

    .add-promotion-button svg {
        width: 18px;
        height: 18px;

        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
    }

    /* Thống kê */

    .promotion-statistics {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .promotion-stat-card {
        display: flex;
        align-items: center;
        gap: 14px;

        min-width: 0;
        padding: 19px;

        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;

        box-shadow: 0 6px 24px rgba(15, 23, 42, 0.045);
    }

    .statistic-icon {
        display: grid;
        flex: 0 0 48px;
        width: 48px;
        height: 48px;
        place-items: center;

        border-radius: 13px;
        background: currentColor;
    }

    .statistic-icon svg {
        width: 23px;
        height: 23px;

        fill: none;
        stroke: #ffffff;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .promotion-stat-card > div:last-child {
        min-width: 0;
    }

    .promotion-stat-card span,
    .promotion-stat-card small {
        display: block;
    }

    .promotion-stat-card span {
        margin-bottom: 4px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
    }

    .promotion-stat-card strong {
        display: block;
        margin-bottom: 3px;

        color: var(--text-dark);
        font-size: 24px;
    }

    .promotion-stat-card small {
        overflow: hidden;

        color: #94a3b8;
        font-size: 9px;

        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .statistic-total {
        color: #6366f1;
    }

    .statistic-visible {
        color: #10b981;
    }

    .statistic-hidden {
        color: #94a3b8;
    }

    .statistic-products {
        color: #f59e0b;
    }

    /* Panel */

    .promotion-panel {
        display: flex;
        height: 650px;
        min-height: 500px;
        flex-direction: column;
        overflow: hidden;

        border: 1px solid var(--border);
        border-radius: 18px;
        background: #ffffff;

        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.05);
    }

    /* Toolbar */

    .promotion-toolbar {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: space-between;
        gap: 20px;

        padding: 18px 20px;
        border-bottom: 1px solid var(--border);
    }

    .promotion-search {
        position: relative;
        width: min(100%, 510px);
    }

    .promotion-search > svg {
        position: absolute;
        top: 50%;
        left: 14px;

        width: 18px;
        height: 18px;

        transform: translateY(-50%);

        fill: none;
        stroke: #94a3b8;
        stroke-width: 2;

        pointer-events: none;
    }

    .promotion-search input {
        width: 100%;
        height: 44px;
        padding: 0 43px;

        border: 1px solid #dce3ec;
        border-radius: 11px;
        outline: none;

        background: #f8fafc;
        color: var(--text-dark);

        font-size: 12px;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .promotion-search input:focus {
        border-color: #fb923c;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.1);
    }

    .clear-search-button {
        position: absolute;
        top: 50%;
        right: 10px;

        display: grid;
        width: 28px;
        height: 28px;
        padding: 0;

        transform: translateY(-50%);
        place-items: center;

        border: none;
        border-radius: 8px;
        background: transparent;
        color: #94a3b8;

        font-size: 19px;
        cursor: pointer;
    }

    .clear-search-button:hover {
        background: #eef2f7;
        color: #475569;
    }

    /* Bộ lọc */

    .promotion-filter-buttons {
        display: flex;
        gap: 6px;
        overflow-x: auto;
    }

    .filter-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        min-height: 38px;
        padding: 0 11px;

        border: 1px solid #e2e8f0;
        border-radius: 9px;
        background: #ffffff;
        color: #64748b;

        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
    }

    .filter-button span {
        min-width: 20px;
        padding: 2px 6px;

        border-radius: 999px;
        background: #f1f5f9;

        font-size: 9px;
        text-align: center;
    }

    .filter-button.active {
        border-color: #fdba74;
        background: #fff7ed;
        color: #ea580c;
    }

    .filter-button.active span {
        background: #ffedd5;
    }

    /* Khung cuộn bảng */

    .promotion-table-wrapper {
        flex: 1;
        min-height: 0;

        overflow-x: auto;
        overflow-y: auto;

        scrollbar-width: thin;
        scrollbar-color: #94a3b8 #f1f5f9;
    }

    .promotion-table-wrapper::-webkit-scrollbar {
        width: 10px;
        height: 10px;
    }

    .promotion-table-wrapper::-webkit-scrollbar-track {
        background: #f1f5f9;
    }

    .promotion-table-wrapper::-webkit-scrollbar-thumb {
        border: 2px solid #f1f5f9;
        border-radius: 10px;
        background: #94a3b8;
    }

    /* Bảng */

    .promotion-table {
        width: 100%;
        min-width: 1120px;

        border-collapse: separate;
        border-spacing: 0;

        color: #334155;
        font-size: 12px;
    }

    .promotion-table th {
        position: sticky;
        top: 0;
        z-index: 5;

        padding: 14px;

        border-bottom: 1px solid var(--border);
        background: #f8fafc;
        color: #64748b;

        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.04em;

        text-align: left;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .promotion-table td {
        padding: 14px;

        border-bottom: 1px solid #edf1f5;
        background: #ffffff;

        vertical-align: middle;
    }

    .promotion-table tbody tr:hover td {
        background: #fffaf5;
    }

    .number-column {
        width: 65px;
        text-align: center !important;
    }

    .action-column {
        width: 210px;
        text-align: center !important;
    }

    .text-center {
        text-align: center !important;
    }

    .table-number {
        color: #94a3b8;
        font-weight: 800;
        text-align: center;
    }

    /* Tên chương trình */

    .promotion-name-cell {
        display: flex;
        align-items: center;
        gap: 10px;

        min-width: 210px;
    }

    .promotion-avatar {
        display: grid;
        flex: 0 0 42px;

        width: 42px;
        height: 42px;

        place-items: center;

        border-radius: 12px;
        background: #fff7ed;
        color: #ea580c;

        font-size: 16px;
        font-weight: 900;
    }

    .promotion-name-cell > div {
        min-width: 0;
    }

    .promotion-name-cell strong {
        display: block;
        max-width: 220px;
        overflow: hidden;

        color: #1e293b;
        font-size: 12px;

        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .promotion-name-cell small {
        display: block;
        margin-top: 4px;

        color: #94a3b8;
        font-size: 9px;
    }

    /* Thời gian */

    .promotion-time-cell {
        min-width: 195px;
    }

    .date-range {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .date-range svg {
        flex: 0 0 17px;
        width: 17px;
        height: 17px;

        fill: none;
        stroke: #94a3b8;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .date-range strong,
    .date-range span {
        display: block;
        white-space: nowrap;
    }

    .date-range strong {
        color: #334155;
        font-size: 10px;
    }

    .date-range span {
        margin-top: 3px;
        color: #94a3b8;
        font-size: 9px;
    }

    .time-status {
        display: inline-flex;
        margin-top: 7px;
        padding: 3px 7px;

        border-radius: 999px;

        font-size: 8px;
        font-weight: 800;
    }

    .time-upcoming {
        background: #eff6ff;
        color: #2563eb;
    }

    .time-running {
        background: #f0fdf4;
        color: #15803d;
    }

    .time-ended {
        background: #f1f5f9;
        color: #64748b;
    }

    /* Giảm giá */

    .discount-badge {
        display: inline-grid;
        min-width: 52px;
        height: 36px;
        padding: 0 9px;

        place-items: center;

        border-radius: 10px;
        background: #fff7ed;
        color: #ea580c;

        font-size: 13px;
        font-weight: 900;
    }

    /* Trạng thái */

    .promotion-status {
        display: inline-flex;
