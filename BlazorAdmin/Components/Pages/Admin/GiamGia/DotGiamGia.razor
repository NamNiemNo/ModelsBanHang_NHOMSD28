@code {
    private List<GiamGia> all = new();

    private string searchTerm = string.Empty;
    private string StatusFilter = "all";
    private string ErrorMessage = string.Empty;

    private int CurrentPage = 1;
    private int PageSize = 10;

    private bool IsLoading;

    private List<GiamGia> Filtered
    {
        get
        {
            IEnumerable<GiamGia> query = all;

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var keyword = searchTerm.Trim();

                query = query.Where(item =>
                    MatchesSearch(item, keyword)
                );
            }

            query = StatusFilter switch
            {
                "visible" =>
                    query.Where(x => x.TrangThai),

                "hidden" =>
                    query.Where(x => !x.TrangThai),

                _ => query
            };

            return query
                .OrderByDescending(x => x.NgayBatDau)
                .ToList();
        }
    }

    private List<GiamGia> PagedList =>
        Filtered
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                Filtered.Count / (double)PageSize
            )
        );

    private IEnumerable<int> VisiblePages
    {
        get
        {
            var start =
                Math.Max(1, CurrentPage - 2);

            var end =
                Math.Min(TotalPages, start + 4);

            start =
                Math.Max(1, end - 4);

            return Enumerable.Range(
                start,
                end - start + 1
            );
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;

        try
        {
            all = (
                await GiamGiaService.GetAllAsync()
            )?.ToList()
            ?? new List<GiamGia>();

            CurrentPage =
                Math.Clamp(
                    CurrentPage,
                    1,
                    TotalPages
                );
        }
        catch (Exception ex)
        {
            all.Clear();

            ErrorMessage =
                "Không thể tải danh sách khuyến mại: "
                + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private static bool MatchesSearch(
        GiamGia item,
        string keyword)
    {
        if (item.GiamGiaId
            .ToString()
            .Contains(
                keyword,
                StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if ((item.TenGiamGia ?? string.Empty)
            .Contains(
                keyword,
                StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return item.GiayDotGiamGias?
            .Any(detail =>
                detail.GiayChiTiet?
                    .GiayChiTietId
                    .ToString()
                    .Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase)
                == true

                ||

                detail.GiayChiTiet?
                    .Giay?
                    .TenGiay?
                    .Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase)
                == true

                ||

                detail.GiayChiTiet?
                    .MauSac?
                    .MauSacId
                    .ToString()
                    .Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase)
                == true

                ||

                detail.GiayChiTiet?
                    .MauSac?
                    .TenMau?
                    .Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase)
                == true

                ||

                detail.GiayChiTiet?
                    .KichCo?
                    .KichCoId
                    .ToString()
                    .Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase)
                == true

                ||

                detail.GiayChiTiet?
                    .KichCo?
                    .TenKichCo?
                    .Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase)
                == true
            )
            ?? false;
    }

    private void HandleSearch(ChangeEventArgs e)
    {
        searchTerm =
            e.Value?.ToString()
            ?? string.Empty;

        CurrentPage = 1;
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        CurrentPage = 1;
    }

    private void SetStatusFilter(string status)
    {
        StatusFilter = status;
        CurrentPage = 1;
    }

    private void ResetFilter()
    {
        searchTerm = string.Empty;
        StatusFilter = "all";
        CurrentPage = 1;
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(
            e.Value?.ToString(),
            out var newPageSize))
        {
            PageSize = newPageSize;
            CurrentPage = 1;
        }
    }

    private void PreviousPage()
    {
        ChangePage(CurrentPage - 1);
    }

    private void NextPage()
    {
        ChangePage(CurrentPage + 1);
    }

    private void ChangePage(int page)
    {
        if (page >= 1 &&
            page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void GoToAddPage()
    {
        Navigation.NavigateTo(
            "/ThemDotGiamGia"
        );
    }

    private void EditPromotion(Guid id)
    {
        Navigation.NavigateTo(
            $"/ThemDotGiamGia/{id}"
        );
    }

    private void AssignProducts(Guid id)
    {
        Navigation.NavigateTo(
            $"/ThemDotGiamGia/{id}"
        );
    }

    private static string GetFirstLetter(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "%";
        }

        return name.Trim()[0]
            .ToString()
            .ToUpperInvariant();
    }

    private static string GetShortId(Guid id)
    {
        var value = id.ToString("N");

        return value[..Math.Min(8, value.Length)]
            .ToUpperInvariant();
    }

    private static string GetTimeStatus(GiamGia item)
    {
        var today = DateTime.Now.Date;

        if (today < item.NgayBatDau.Date)
        {
            return "Sắp diễn ra";
        }

        if (today > item.NgayKetThuc.Date)
        {
            return "Đã kết thúc";
        }

        return "Đang diễn ra";
    }

    private static string GetTimeStatusClass(
        GiamGia item)
    {
        var today = DateTime.Now.Date;

        if (today < item.NgayBatDau.Date)
        {
            return "time-upcoming";
        }

        if (today > item.NgayKetThuc.Date)
        {
            return "time-ended";
        }

        return "time-running";
    }
}