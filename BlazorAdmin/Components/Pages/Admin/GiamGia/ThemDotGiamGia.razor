@code {
    [Parameter]
    public Guid? Id { get; set; }

    private GiamGiaCreateDTO dot = new();

    private string? errorMessage;

    private string searchTerm = string.Empty;
    private string ProductFilter = "all";

    private List<GiayChiTietDTO> danhSachChiTiet = new();
    private List<Guid> chiTietChon = new();
    private List<GiamGia> allDotGiamGia = new();

    private bool IsLoading = true;
    private bool IsSaving;

    private int SoNgayApDung =>
        Math.Max(
            0,
            (dot.NgayKetThuc.Date -
             dot.NgayBatDau.Date).Days + 1
        );

    private int SoSanPhamBiTrung =>
        danhSachChiTiet.Count(sp =>
            IsInOtherPromotion(sp.GiayChiTietId)
        );

    private int SoSanPhamCoTheChon =>
        danhSachChiTiet.Count(sp =>
            !IsInOtherPromotion(sp.GiayChiTietId)
        );

    private List<GiayChiTietDTO> FilteredDanhSachChiTiet
    {
        get
        {
            IEnumerable<GiayChiTietDTO> query =
                danhSachChiTiet;

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var keyword = searchTerm.Trim();

                query = query.Where(sp =>
                    sp.GiayChiTietId
                        .ToString()
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase
                        )
                    ||
                    (sp.TenGiay ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase
                        )
                    ||
                    (sp.TenMau ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase
                        )
                    ||
                    sp.size
                        .ToString()
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase
                        )
                );
            }

            query = ProductFilter switch
            {
                "selected" =>
                    query.Where(sp =>
                        chiTietChon.Contains(
                            sp.GiayChiTietId
                        )
                    ),

                "available" =>
                    query.Where(sp =>
                        !IsInOtherPromotion(
                            sp.GiayChiTietId
                        )
                    ),

                "conflict" =>
                    query.Where(sp =>
                        IsInOtherPromotion(
                            sp.GiayChiTietId
                        )
                    ),

                _ => query
            };

            return query
                .OrderByDescending(sp =>
                    chiTietChon.Contains(
                        sp.GiayChiTietId
                    )
                )
                .ThenBy(sp =>
                    IsInOtherPromotion(
                        sp.GiayChiTietId
                    )
                )
                .ThenBy(sp => sp.TenGiay)
                .ThenBy(sp => sp.TenMau)
                .ThenBy(sp => sp.size)
                .ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        errorMessage = null;

        try
        {
            var productTask =
                GiayChiTietService.GetAllAsync();

            var promotionTask =
                GiamGiaService.GetAllAsync();

            await Task.WhenAll(
                productTask,
                promotionTask
            );

            danhSachChiTiet =
                await productTask
                ?? new List<GiayChiTietDTO>();

            allDotGiamGia = (
                await promotionTask
            )?.ToList()
            ?? new List<GiamGia>();

            if (Id.HasValue)
            {
                var existing =
                    await GiamGiaService
                        .GetByIdAsync(Id.Value);

                if (existing == null)
                {
                    errorMessage =
                        "Không tìm thấy đợt giảm giá.";

                    return;
                }

                dot = new GiamGiaCreateDTO
                    {
                        GiamGiaId =
                            existing.GiamGiaId,

                        TenGiamGia =
                            existing.TenGiamGia,

                        SanPhamKhuyenMai =
                            existing.SanPhamKhuyenMai,

                        PhanTramKhuyenMai =
                            existing.PhanTramKhuyenMai,

                        NgayBatDau =
                            existing.NgayBatDau,

                        NgayKetThuc =
                            existing.NgayKetThuc,

                        TrangThai =
                            existing.TrangThai,

                        GiayChiTietIds =
                            existing.GiayDotGiamGias?
                                .Where(x =>
                                    x.GiayChiTietId.HasValue
                                )
                                .Select(x =>
                                    x.GiayChiTietId!.Value
                                )
                                .ToList()
                            ?? new List<Guid>()
                    };

                chiTietChon =
                    dot.GiayChiTietIds.ToList();
            }
            else
            {
                dot = new GiamGiaCreateDTO
                    {
                        TenGiamGia = string.Empty,
                        NgayBatDau = DateTime.Today,
                        NgayKetThuc =
                            DateTime.Today.AddDays(7),
                        TrangThai = true,
                        SanPhamKhuyenMai =
                            "Nhiều sản phẩm",
                        GiayChiTietIds =
                            new List<Guid>()
                    };

                chiTietChon.Clear();
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                "Không thể tải dữ liệu: "
                + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private bool IsInOtherPromotion(Guid productId)
    {
        return allDotGiamGia.Any(promotion =>
            promotion.TrangThai
            &&
            promotion.NgayKetThuc.Date
                >= DateTime.Today
            &&
            promotion.GiamGiaId
                != dot.GiamGiaId
            &&
            (
                promotion.GiayDotGiamGias?
                    .Any(detail =>
                        detail.GiayChiTietId
                            == productId
                    )
                ?? false
            )
        );
    }

    private void ToggleChiTiet(Guid id)
    {
        if (IsInOtherPromotion(id))
        {
            return;
        }

        if (chiTietChon.Contains(id))
        {
            chiTietChon.Remove(id);
        }
        else
        {
            chiTietChon.Add(id);
        }
    }

    private void HandleProductSearch(
        ChangeEventArgs e)
    {
        searchTerm =
            e.Value?.ToString()
            ?? string.Empty;
    }

    private void ClearProductSearch()
    {
        searchTerm = string.Empty;
    }

    private void SetProductFilter(string filter)
    {
        ProductFilter = filter;
    }

    private void ResetProductFilter()
    {
        searchTerm = string.Empty;
        ProductFilter = "all";
    }

    private void SelectAllVisible()
    {
        foreach (var product in
                 FilteredDanhSachChiTiet)
        {
            if (!IsInOtherPromotion(
                    product.GiayChiTietId)
                &&
                !chiTietChon.Contains(
                    product.GiayChiTietId))
            {
                chiTietChon.Add(
                    product.GiayChiTietId
                );
            }
        }
    }

    private void ClearSelection()
    {
        chiTietChon.Clear();
    }

    private void ClearError()
    {
        errorMessage = null;
    }

    private void GoBack()
    {
        Navigation.NavigateTo(
            "/DotGiamGia"
        );
    }

    private async Task HandleSubmit()
    {
        if (IsSaving)
        {
            return;
        }

        errorMessage = null;

        dot.TenGiamGia =
            dot.TenGiamGia?.Trim()
            ?? string.Empty;

        if (string.IsNullOrWhiteSpace(
            dot.TenGiamGia))
        {
            errorMessage =
                "Tên đợt giảm giá không được để trống.";

            return;
        }

        if (dot.PhanTramKhuyenMai <= 0 ||
            dot.PhanTramKhuyenMai > 100)
        {
            errorMessage =
                "Phần trăm giảm giá phải lớn hơn 0 và không vượt quá 100.";

            return;
        }

        if (dot.NgayKetThuc.Date <
            dot.NgayBatDau.Date)
        {
            errorMessage =
                "Ngày kết thúc phải bằng hoặc sau ngày bắt đầu.";

            return;
        }

        if (chiTietChon.Count == 0)
        {
            errorMessage =
                "Bạn phải chọn ít nhất một sản phẩm áp dụng.";

            return;
        }

        IsSaving = true;

        try
        {
            var promotionList =
                await GiamGiaService.GetAllAsync();

            var isDuplicate =
                promotionList.Any(x =>
                    (x.TenGiamGia ?? string.Empty)
                        .Trim()
                        .Equals(
                            dot.TenGiamGia,
                            StringComparison.OrdinalIgnoreCase
                        )
                    &&
                    x.GiamGiaId != dot.GiamGiaId
                );

            if (isDuplicate)
            {
                errorMessage =
                    "Tên đợt giảm giá đã tồn tại.";

                return;
            }

            if (!Id.HasValue)
            {
                dot.GiayChiTietIds =
                    chiTietChon.ToList();

                var response =
                    await GiamGiaService
                        .AddAsync(dot);

                if (response.IsSuccessStatusCode)
                {
                    GoBack();
                    return;
                }

                var content =
                    await response.Content
                        .ReadAsStringAsync();

                errorMessage =
                    "Không thể tạo khuyến mại: "
                    + content;

                return;
            }

            var basicDto =
                new GiamGiaCreateDTO
                    {
                        GiamGiaId =
                            dot.GiamGiaId,

                        TenGiamGia =
                            dot.TenGiamGia,

                        SanPhamKhuyenMai =
                            dot.SanPhamKhuyenMai,

                        PhanTramKhuyenMai =
                            dot.PhanTramKhuyenMai,

                        NgayBatDau =
                            dot.NgayBatDau,

                        NgayKetThuc =
                            dot.NgayKetThuc,

                        TrangThai =
                            dot.TrangThai,

                        GiayChiTietIds =
                            new List<Guid>()
                    };

            var updateResponse =
                await GiamGiaService
                    .UpdateAsyncReturnResponse(
                        basicDto
                    );

            if (!updateResponse.IsSuccessStatusCode)
            {
                var content =
                    await updateResponse.Content
                        .ReadAsStringAsync();

                errorMessage =
                    "Không thể cập nhật: "
                    + content;

                return;
            }

            var oldIds =
                dot.GiayChiTietIds
                ?? new List<Guid>();

            var newIds =
                chiTietChon.ToList();

            var idsToRemove =
                oldIds.Except(newIds).ToList();

            var idsToAdd =
                newIds.Except(oldIds).ToList();

            foreach (var productId in idsToRemove)
            {
                await GiamGiaService
                    .RemoveGiayFromDotGiamGia(
                        dot.GiamGiaId,
                        productId
                    );
            }

            foreach (var productId in idsToAdd)
            {
                await GiamGiaService
                    .AddGiayToDotGiamGia(
                        dot.GiamGiaId,
                        productId
                    );
            }

            GoBack();
        }
        catch (Exception ex)
        {
            errorMessage =
                "Đã xảy ra lỗi khi lưu: "
                + ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private static string GetProductFirstLetter(
        string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        return name.Trim()[0]
            .ToString()
            .ToUpperInvariant();
    }

    private static string GetShortId(Guid id)
    {
        var value = id.ToString("N");

        return value[..Math.Min(8, value.Length)]
            .ToUpperInvariant();
    }
}