@page "/ThemDotGiamGia"
@page "/ThemDotGiamGia/{Id:guid}"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@using Data.Models
@using API.Models.DTO
@using BlazorAdmin.Service.IService
@rendermode InteractiveServer

@inject IGiamGiaService GiamGiaService
@inject IGiayChiTietService GiayChiTietService
@inject NavigationManager Navigation

<PageTitle>
    @(Id.HasValue ? "Chỉnh sửa khuyến mại" : "Thêm khuyến mại")
</PageTitle>

<div class="promotion-form-page">

    <!-- Tiêu đề -->
    <header class="form-page-header">
        <div>
            <button type="button"
                    class="back-link"
                    @onclick="GoBack">

                <svg viewBox="0 0 24 24">
                    <path d="m15 18-6-6 6-6" />
                </svg>

                Quay lại danh sách
            </button>

            <span class="page-eyebrow">
                @(Id.HasValue
                    ? "CẬP NHẬT KHUYẾN MẠI"
                    : "TẠO KHUYẾN MẠI")
            </span>

            <h1>
                @(Id.HasValue
                    ? "Chỉnh sửa đợt khuyến mại"
                    : "Thêm đợt khuyến mại")
            </h1>

            <p>
                Thiết lập thông tin, thời gian và sản phẩm được áp dụng.
            </p>
        </div>

        <div class="header-status">
            <span class="header-status-dot"></span>

            @(Id.HasValue
                ? "Đang chỉnh sửa"
                : "Đang tạo mới")
        </div>
    </header>

    @if (IsLoading)
    {
        <div class="page-loading">
            <span class="page-spinner"></span>
            <strong>Đang tải dữ liệu...</strong>
            <small>Vui lòng chờ trong giây lát</small>
        </div>
    }
    else
    {
        <EditForm Model="dot"
                  OnValidSubmit="HandleSubmit">

            <DataAnnotationsValidator />

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="form-error-message">
                    <div class="error-icon">!</div>

                    <div>
                        <strong>Không thể lưu dữ liệu</strong>
                        <span>@errorMessage</span>
                    </div>

                    <button type="button"
                            title="Đóng"
                            @onclick="ClearError">
                        ×
                    </button>
                </div>
            }

            <div class="promotion-form-layout">

                <!-- Thông tin cơ bản -->
                <section class="form-section basic-information-section">
                    <div class="section-header">
                        <div class="section-icon information-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M5 4h14v16H5z" />
                                <path d="M8 8h8M8 12h8M8 16h5" />
                            </svg>
                        </div>

                        <div>
                            <h2>Thông tin khuyến mại</h2>
                            <p>Nhập tên và phần trăm giảm giá.</p>
                        </div>
                    </div>

                    <!-- Tên đợt -->
                    <div class="form-group">
                        <label for="promotion-name">
                            Tên đợt khuyến mại
                            <span class="required-mark">*</span>
                        </label>

                        <InputText id="promotion-name"
                                   class="form-control-custom"
                                   placeholder="Ví dụ: Khuyến mại mùa hè 2026"
                                   maxlength="100"
                                   @bind-Value="dot.TenGiamGia" />

                        <ValidationMessage For="@(() => dot.TenGiamGia)"
                                           class="validation-message" />
                    </div>

                    <!-- Phần trăm -->
                    <div class="form-group">
                        <label for="promotion-percent">
                            Phần trăm giảm giá
                            <span class="required-mark">*</span>
                        </label>

                        <div class="percentage-input">
                            <InputNumber id="promotion-percent"
                                         class="form-control-custom"
                                         @bind-Value="dot.PhanTramKhuyenMai" />

                            <span>%</span>
                        </div>

                        <small class="form-help-text">
                            Giá trị giảm phải lớn hơn 0 và không vượt quá 100%.
                        </small>

                        <ValidationMessage For="@(() => dot.PhanTramKhuyenMai)"
                                           class="validation-message" />
                    </div>

                    <!-- Trạng thái -->
                    <div class="status-form-card">
                        <div>
                            <strong>Trạng thái hiển thị</strong>

                            <span>
                                @(dot.TrangThai
                                    ? "Khuyến mại đang được hiển thị"
                                    : "Khuyến mại đang bị ẩn")
                            </span>
                        </div>

                        <label class="promotion-switch">
                            <InputCheckbox @bind-Value="dot.TrangThai" />
                            <span class="switch-slider"></span>
                        </label>
                    </div>
                </section>

                <!-- Thời gian -->
                <section class="form-section time-information-section">
                    <div class="section-header">
                        <div class="section-icon time-icon">
                            <svg viewBox="0 0 24 24">
                                <rect x="3"
                                      y="5"
                                      width="18"
                                      height="16"
                                      rx="2" />

                                <path d="M7 3v4M17 3v4M3 10h18" />
                            </svg>
                        </div>

                        <div>
                            <h2>Thời gian áp dụng</h2>
                            <p>Chọn ngày bắt đầu và kết thúc.</p>
                        </div>
                    </div>

                    <div class="date-fields">

                        <div class="form-group">
                            <label for="start-date">
                                Ngày bắt đầu
                                <span class="required-mark">*</span>
                            </label>

                            <InputDate id="start-date"
                                       class="form-control-custom"
                                       @bind-Value="dot.NgayBatDau" />

                            <ValidationMessage For="@(() => dot.NgayBatDau)"
                                               class="validation-message" />
                        </div>

                        <div class="date-arrow">
                            <svg viewBox="0 0 24 24">
                                <path d="M5 12h14M14 7l5 5-5 5" />
                            </svg>
                        </div>

                        <div class="form-group">
                            <label for="end-date">
                                Ngày kết thúc
                                <span class="required-mark">*</span>
                            </label>

                            <InputDate id="end-date"
                                       class="form-control-custom"
                                       @bind-Value="dot.NgayKetThuc" />

                            <ValidationMessage For="@(() => dot.NgayKetThuc)"
                                               class="validation-message" />
                        </div>
                    </div>

                    <!-- Xem trước -->
                    <div class="promotion-preview">
                        <div class="preview-item">
                            <span>Thời gian áp dụng</span>
                            <strong>@SoNgayApDung ngày</strong>
                        </div>

                        <div class="preview-divider"></div>

                        <div class="preview-item">
                            <span>Mức giảm</span>
                            <strong class="discount-preview">
                                @dot.PhanTramKhuyenMai.ToString("0.##")%
                            </strong>
                        </div>

                        <div class="preview-divider"></div>

                        <div class="preview-item">
                            <span>Sản phẩm đã chọn</span>
                            <strong>@chiTietChon.Count</strong>
                        </div>
                    </div>
                </section>
            </div>

            <!-- Chọn sản phẩm -->
            <section class="form-section product-selection-section">

                <div class="section-header product-section-header">
                    <div class="section-title-group">
                        <div class="section-icon product-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M4 16c4 0 7-2 9-7l2 5 5 2v4H4z" />
                            </svg>
                        </div>

                        <div>
                            <h2>Sản phẩm được áp dụng</h2>

                            <p>
                                Chọn chi tiết giày theo màu sắc và kích cỡ.
                            </p>
                        </div>
                    </div>

                    <div class="selected-counter">
                        Đã chọn
                        <strong>@chiTietChon.Count</strong>
                        sản phẩm
                    </div>
                </div>

                <!-- Tìm kiếm sản phẩm -->
                <div class="product-toolbar">

                    <div class="product-search">
                        <svg viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="7" />
                            <path d="m20 20-4-4" />
                        </svg>

                        <input type="text"
                               value="@searchTerm"
                               @oninput="HandleProductSearch"
                               placeholder="Tìm tên giày, màu sắc, size hoặc ID..." />

                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <button type="button"
                                    title="Xóa tìm kiếm"
                                    @onclick="ClearProductSearch">
                                ×
                            </button>
                        }
                    </div>

                    <div class="product-filter-buttons">

                        <button type="button"
                                class="product-filter-button @(ProductFilter == "all" ? "active" : "")"
                                @onclick='() => SetProductFilter("all")'>

                            Tất cả

                            <span>@danhSachChiTiet.Count</span>
                        </button>

                        <button type="button"
                                class="product-filter-button @(ProductFilter == "selected" ? "active" : "")"
                                @onclick='() => SetProductFilter("selected")'>

                            Đã chọn

                            <span>@chiTietChon.Count</span>
                        </button>

                        <button type="button"
                                class="product-filter-button @(ProductFilter == "available" ? "active" : "")"
                                @onclick='() => SetProductFilter("available")'>

                            Có thể chọn

                            <span>@SoSanPhamCoTheChon</span>
                        </button>

                        <button type="button"
                                class="product-filter-button conflict-filter @(ProductFilter == "conflict" ? "active" : "")"
                                @onclick='() => SetProductFilter("conflict")'>

                            Đã có khuyến mại

                            <span>@SoSanPhamBiTrung</span>
                        </button>
                    </div>
                </div>

                <!-- Thao tác chọn -->
                <div class="selection-actions">
                    <span>
                        Hiển thị
                        <strong>@FilteredDanhSachChiTiet.Count</strong>
                        kết quả
                    </span>

                    <div>
                        <button type="button"
                                class="select-visible-button"
                                @onclick="SelectAllVisible">
                            Chọn tất cả đang hiển thị
                        </button>

                        <button type="button"
                                class="clear-selection-button"
                                disabled="@(chiTietChon.Count == 0)"
                                @onclick="ClearSelection">
                            Bỏ chọn tất cả
                        </button>
                    </div>
                </div>

                <!-- Danh sách sản phẩm -->
                <div class="product-list-wrapper">

                    @if (FilteredDanhSachChiTiet.Count == 0)
                    {
                        <div class="product-empty-state">
                            <div class="empty-product-icon">
                                <svg viewBox="0 0 24 24">
                                    <path d="M4 16c4 0 7-2 9-7l2 5 5 2v4H4z" />
                                </svg>
                            </div>

                            <strong>Không tìm thấy sản phẩm</strong>

                            <span>
                                Hãy thử từ khóa hoặc bộ lọc khác.
                            </span>

                            <button type="button"
                                    @onclick="ResetProductFilter">
                                Đặt lại bộ lọc
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="product-option-grid">

                            @foreach (var sp in FilteredDanhSachChiTiet)
                            {
                                var isChecked =
                                chiTietChon.Contains(
                                sp.GiayChiTietId
                                );

                                var hasConflict =
                                IsInOtherPromotion(
                                sp.GiayChiTietId
                                );

                                <label class="product-option-card
                                              @(isChecked ? "selected" : "")
                                              @(hasConflict ? "conflict" : "")">

                                    <input type="checkbox"
                                           checked="@isChecked"
                                           disabled="@hasConflict"
                                           @onchange="() => ToggleChiTiet(sp.GiayChiTietId)" />

                                    <span class="custom-checkbox">
                                        <svg viewBox="0 0 24 24">
                                            <path d="m6 12 4 4 8-9" />
                                        </svg>
                                    </span>

                                    <div class="product-card-content">

                                        <div class="product-card-header">
                                            <span class="product-avatar">
                                                @GetProductFirstLetter(
                                                         sp.TenGiay
                                                         )
                                            </span>

                                            <div>
                                                <strong title="@sp.TenGiay">
                                                    @(string.IsNullOrWhiteSpace(
                                                        sp.TenGiay)
                                                        ? "Sản phẩm chưa xác định"
                                                        : sp.TenGiay)
                                                </strong>

                                                <small title="@sp.GiayChiTietId">
                                                    #@GetShortId(
                                                            sp.GiayChiTietId
                                                            )
                                                </small>
                                            </div>
                                        </div>

                                        <div class="product-variants">
                                            <span>
                                                Màu:
                                                <strong>
                                                    @(string.IsNullOrWhiteSpace(
                                                        sp.TenMau)
                                                        ? "—"
                                                        : sp.TenMau)
                                                </strong>
                                            </span>

                                            <span>
                                                Size:
                                                <strong>@sp.size</strong>
                                            </span>
                                        </div>

                                        <div class="product-price">
                                            @if (sp.DaGiamGia)
                                            {
                                                <del>
                                                    @sp.GiaGoc.ToString("N0") ₫
                                                </del>

                                                <strong>
                                                    @sp.Gia.ToString("N0") ₫
                                                </strong>
                                            }
                                            else
                                            {
                                                <span>Giá bán</span>

                                                <strong>
                                                    @sp.Gia.ToString("N0") ₫
                                                </strong>
                                            }
                                        </div>

                                        @if (hasConflict)
                                        {
                                            <div class="conflict-message">
                                                <svg viewBox="0 0 24 24">
                                                    <circle cx="12"
                                                            cy="12"
                                                            r="9" />

                                                    <path d="M12 8v5M12 17h.01" />
                                                </svg>

                                                Đã nằm trong đợt giảm giá khác
                                            </div>
                                        }
                                    </div>
                                </label>
                            }
                        </div>
                    }
                </div>
            </section>

            <!-- Thanh nút -->
            <footer class="form-action-bar">
                <div class="action-summary">
                    <span>
                        @(Id.HasValue
                            ? "Cập nhật đợt khuyến mại"
                            : "Tạo đợt khuyến mại mới")
                    </span>

                    <strong>
                        @chiTietChon.Count sản phẩm được chọn
                    </strong>
                </div>

                <div class="form-buttons">
                    <button type="button"
                            class="cancel-button"
                            disabled="@IsSaving"
                            @onclick="GoBack">
                        Quay lại
                    </button>

                    <button type="submit"
                            class="save-button"
                            disabled="@IsSaving">

                        @if (IsSaving)
                        {
                            <span class="button-spinner"></span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24">
                                <path d="M5 4h12l2 2v14H5z" />
                                <path d="M8 4v6h8V4M8 20v-6h8v6" />
                            </svg>

                            <span>
                                @(Id.HasValue
                                    ? "Lưu thay đổi"
                                    : "Tạo khuyến mại")
                            </span>
                        }
                    </button>
                </div>
            </footer>
        </EditForm>
    }
</div>

<style>
    .promotion-form-page,
    .promotion-form-page * {
        box-sizing: border-box;
    }

    .promotion-form-page {
        --primary: #f97316;
        --primary-dark: #ea580c;
        --primary-soft: #fff7ed;
        --text-dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --border: #e8edf3;
        min-height: 100vh;
        padding: 28px;
        padding-bottom: 110px;
        background: #f6f8fb;
        color: var(--text-dark);
    }

    /* Header */

    .form-page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 22px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-bottom: 12px;
        padding: 0;
        border: none;
        background: transparent;
        color: #64748b;
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
    }

        .back-link:hover {
            color: #ea580c;
        }

        .back-link svg {
            width: 15px;
            height: 15px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .page-eyebrow {
        display: block;
        margin-bottom: 5px;
        color: #ea580c;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.14em;
    }

    .form-page-header h1 {
        margin: 0;
        color: #0f172a;
        font-size: 29px;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .form-page-header p {
        margin: 7px 0 0;
        color: #64748b;
        font-size: 12px;
    }

    .header-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border: 1px solid #fed7aa;
        border-radius: 999px;
        background: #fff7ed;
        color: #c2410c;
        font-size: 9px;
        font-weight: 800;
    }

    .header-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #f97316;
        box-shadow: 0 0 0 3px #ffedd5;
    }

    /* Layout */

    .promotion-form-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        gap: 18px;
        margin-bottom: 18px;
    }

    .form-section {
        padding: 21px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 6px 25px rgba(15, 23, 42, 0.04);
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #edf1f5;
    }

        .section-header h2 {
            margin: 0;
            color: #1e293b;
            font-size: 14px;
            font-weight: 800;
        }

        .section-header p {
            margin: 4px 0 0;
            color: #94a3b8;
            font-size: 9px;
        }

    .section-icon {
        display: grid;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        place-items: center;
        border-radius: 12px;
        color: #ffffff;
    }

        .section-icon svg {
            width: 20px;
            height: 20px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .information-icon {
        background: #6366f1;
    }

    .time-icon {
        background: #0ea5e9;
    }

    .product-icon {
        background: #f97316;
    }

    /* Form controls */

    .form-group {
        margin-bottom: 17px;
    }

        .form-group > label {
            display: block;
            margin-bottom: 7px;
            color: #334155;
            font-size: 10px;
            font-weight: 800;
        }

    .required-mark {
        color: #ef4444;
    }

    .form-control-custom {
        width: 100%;
        height: 43px;
        padding: 0 13px;
        border: 1px solid #dce3ec;
        border-radius: 10px;
        outline: none;
        background: #f8fafc;
        color: #334155;
        font-size: 11px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

        .form-control-custom:focus {
            border-color: #fb923c;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.1);
        }

    .percentage-input {
        position: relative;
    }

        .percentage-input .form-control-custom {
            padding-right: 47px;
        }

        .percentage-input > span {
            position: absolute;
            top: 50%;
            right: 14px;
            transform: translateY(-50%);
            color: #ea580c;
            font-size: 13px;
            font-weight: 900;
        }

    .form-help-text {
        display: block;
        margin-top: 6px;
        color: #94a3b8;
        font-size: 8px;
    }

    .validation-message {
        display: block;
        margin-top: 6px;
        color: #dc2626;
        font-size: 9px;
    }

    /* Status switch */

    .status-form-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 14px;
        border: 1px solid #e8edf3;
        border-radius: 11px;
        background: #f8fafc;
    }

        .status-form-card strong,
        .status-form-card span {
            display: block;
        }

        .status-form-card strong {
            color: #334155;
            font-size: 10px;
        }

        .status-form-card > div > span {
            margin-top: 4px;
            color: #94a3b8;
            font-size: 8px;
        }

    .promotion-switch {
        position: relative;
        display: inline-block;
        flex: 0 0 46px;
        width: 46px;
        height: 25px;
    }

        .promotion-switch input {
            width: 0;
            height: 0;
            opacity: 0;
        }

    .switch-slider {
        position: absolute;
        inset: 0;
        border-radius: 999px;
        background: #cbd5e1;
        cursor: pointer;
        transition: 0.2s;
    }

        .switch-slider::before {
            position: absolute;
            bottom: 3px;
            left: 3px;
            width: 19px;
            height: 19px;
            border-radius: 50%;
            background: #ffffff;
            content: "";
            box-shadow: 0 2px 5px rgba(15, 23, 42, 0.2);
            transition: 0.2s;
        }

    .promotion-switch input:checked + .switch-slider {
        background: #22c55e;
    }

        .promotion-switch input:checked + .switch-slider::before {
            transform: translateX(21px);
        }

    /* Date */

    .date-fields {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 30px minmax(0, 1fr);
        align-items: center;
        gap: 8px;
    }

        .date-fields .form-group {
            margin-bottom: 0;
        }

    .date-arrow {
        display: grid;
        place-items: center;
        padding-top: 20px;
        color: #94a3b8;
    }

        .date-arrow svg {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .promotion-preview {
        display: grid;
        grid-template-columns: 1fr 1px 1fr 1px 1fr;
        align-items: center;
        margin-top: 21px;
        padding: 15px;
        border: 1px solid #e8edf3;
        border-radius: 12px;
        background: #f8fafc;
    }

    .preview-item {
        text-align: center;
