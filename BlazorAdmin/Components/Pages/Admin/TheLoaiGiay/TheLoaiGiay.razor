        border: 1px solid var(--border);
        border-radius: 9px;
        background: white;
        color: #64748b;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
        cursor: pointer;
    }

        .filter-button span {
            padding: 2px 6px;
            border-radius: 20px;
            background: #f1f5f9;
            font-size: 9px;
        }

        .filter-button.active {
            border-color: #fed7aa;
            background: var(--primary-light);
            color: var(--primary-dark);
        }

    .table-wrapper {
        flex: 1;
        min-height: 0;
        overflow-x: auto;
        overflow-y: auto;
    }

    .category-table {
        width: 100%;
        min-width: 900px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .category-table thead th {
            position: sticky;
            top: 0;
            z-index: 4;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            background: #f8fafc;
            color: #64748b;
            font-size: 10px;
            font-weight: 800;
            text-align: left;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .category-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid #edf1f6;
            color: #334155;
            font-size: 12px;
            vertical-align: middle;
        }

        .category-table tbody tr:hover {
            background: #fffaf5;
        }

    .col-stt {
        width: 70px;
        text-align: center !important;
    }

    .col-action {
        width: 130px;
        text-align: center !important;
    }

    .stt-cell {
        color: #94a3b8 !important;
        font-weight: 800;
        text-align: center;
    }

    .category-info {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 190px;
