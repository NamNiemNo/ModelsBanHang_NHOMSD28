@page "/TheLoaiGiay"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode InteractiveServer

@using API.Models.DTO

@inject ITheLoaiGiayService theLoaiGiayService

<div class="category-page">

    <!-- HEADER -->
    <div class="page-header">
        <div class="header-left">
            <div class="header-icon">📚</div>

            <div>
                <h2>Quản lý thể loại giày</h2>
                <p>Quản lý danh mục và trạng thái thể loại sản phẩm</p>
            </div>
        </div>

        <button class="add-button"
                @onclick="ShowAddForm">
            <span>＋</span>
            Thêm thể loại
        </button>
    </div>

    <!-- THỐNG KÊ -->
    <div class="stat-grid">

        <div class="stat-card">
            <div class="stat-icon total">▦</div>
            <div>
                <span>Tổng thể loại</span>
                <strong>@danhSach.Count</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon active">✓</div>
            <div>
                <span>Đang hoạt động</span>
                <strong>@danhSach.Count(x => x.TrangThai)</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon inactive">⏸</div>
            <div>
                <span>Ngừng hoạt động</span>
                <strong>@danhSach.Count(x => !x.TrangThai)</strong>
            </div>
        </div>

    </div>

    <!-- DANH SÁCH -->
    <div class="category-panel">

        <!-- TOOLBAR -->
        <div class="panel-toolbar">

            <div class="search-box">
                <span>⌕</span>

                <input placeholder="Tìm tên hoặc mô tả thể loại..."
                       @bind="SearchTerm"
                       @bind:event="oninput" />

                @if (!string.IsNullOrWhiteSpace(SearchTerm))
                {
                    <button @onclick="ClearSearch">×</button>
                }
            </div>

            <div class="status-filters">

                <button class="filter-button @(statusFilter == "all" ? "active" : "")"
                        @onclick='() => SetStatusFilter("all")'>
                    Tất cả
                    <span>@danhSach.Count</span>
                </button>

                <button class="filter-button @(statusFilter == "active" ? "active" : "")"
                        @onclick='() => SetStatusFilter("active")'>
                    Hoạt động
                    <span>@danhSach.Count(x => x.TrangThai)</span>
                </button>

                <button class="filter-button @(statusFilter == "inactive" ? "active" : "")"
                        @onclick='() => SetStatusFilter("inactive")'>
                    Ngừng hoạt động
                    <span>@danhSach.Count(x => !x.TrangThai)</span>
                </button>

            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(pageError))
        {
            <div class="page-error">
                <span>!</span>
                <div>@pageError</div>
                <button @onclick="() => pageError = string.Empty">×</button>
            </div>
        }

        <!-- BẢNG CUỘN NGANG + DỌC -->
        <div class="table-wrapper">

            <table class="category-table">
                <thead>
                    <tr>
                        <th class="col-stt">STT</th>
                        <th>Thể loại</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        <th class="col-action">Chức năng</th>
                    </tr>
                </thead>

                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="loading-state">
                                    <div class="loading-spinner"></div>
                                    <span>Đang tải danh sách thể loại...</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (!PagedData.Any())
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <div>🔎</div>
                                    <strong>Không tìm thấy thể loại</strong>
                                    <span>
                                        Hãy thử thay đổi từ khóa hoặc bộ lọc
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in PagedData.Select((item, index) => new
                        {
                            Item = item,
                            Index = index
                        }))
                        {
                            var item = row.Item;

                            <tr>
                                <td class="stt-cell">
                                    @((CurrentPage - 1) * PageSize
                                        + row.Index + 1)
                                </td>

                                <td>
                                    <div class="category-info">
                                        <div class="category-avatar">
                                            @GetInitial(item.TenTheLoai)
                                        </div>

                                        <div>
                                            <strong>@item.TenTheLoai</strong>
                                            <small title="@item.TheLoaiGiayId">
                                                @ShortId(item.TheLoaiGiayId)
                                            </small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="description"
                                         title="@item.MoTa">
                                        @(string.IsNullOrWhiteSpace(item.MoTa)
                                            ? "Chưa có mô tả"
                                            : item.MoTa)
                                    </div>
                                </td>

                                <td>
                                    <span class="status-badge @(item.TrangThai ? "status-active" : "status-inactive")">
                                        <i></i>

                                        @(item.TrangThai
                                            ? "Đang hoạt động"
                                            : "Ngừng hoạt động")
                                    </span>
                                </td>

                                <td>
                                    <div class="action-group">

                                        <button class="action-button edit"
                                                title="Chỉnh sửa"
                                                @onclick="() => ShowEditForm(item)">
                                            ✎
                                        </button>

                                        <button class="action-button delete"
                                                title="Xóa thể loại"
                                                @onclick="() => AskDelete(item)">
                                            ⌫
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>

        <!-- PHÂN TRANG -->
        <div class="pagination-bar">

            <div class="page-size">
                <span>Hiển thị</span>

                <select value="@PageSize"
                        @onchange="OnPageSizeChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>

                <span>thể loại</span>
            </div>

            <div class="result-info">
                Hiển thị
                <strong>@FirstDisplayedItem</strong>
                -
                <strong>@LastDisplayedItem</strong>
                trong
                <strong>@FilteredList.Count</strong>
                kết quả
            </div>

            <div class="pagination">

                <button disabled="@(CurrentPage == 1)"
                        @onclick="PreviousPage">
                    ‹
                </button>

                @foreach (var page in VisiblePages)
                {
                    var pageNumber = page;

                    <button class="@(pageNumber == CurrentPage ? "active" : "")"
                            @onclick="() => ChangePage(pageNumber)">
                        @pageNumber
                    </button>
                }

                <button disabled="@(CurrentPage == TotalPages)"
                        @onclick="NextPage">
                    ›
                </button>

            </div>

        </div>

    </div>

    <!-- COMPONENT THÊM/SỬA -->
    <CreateOrUpdateTheLoaiGiay FormData="@FormData"
                               ExistingItems="@danhSach"
                               IsVisible="@IsPopupVisible"
                               IsEdit="@IsEdit"
                               IsSubmitting="@IsSubmitting"
                               ErrorMessage="@FormError"
                               OnSubmit="@SubmitForm"
                               OnClose="@ClosePopup" />

    <!-- MODAL XÓA -->
    @if (IsConfirmVisible && SelectedItem != null)
    {
        <div class="delete-overlay" @onclick="CloseDeleteModal">

            <div class="delete-modal"
                 @onclick:stopPropagation="true">

                <div class="delete-icon">!</div>

                <h3>Xóa thể loại?</h3>

                <p>
                    Bạn có chắc chắn muốn xóa thể loại
                    <strong>@SelectedItem.TenTheLoai</strong> không?
                </p>

                <div class="delete-warning">
                    Thể loại đang được sản phẩm sử dụng có thể không xóa được.
                </div>

                <div class="delete-actions">
                    <button class="cancel-delete"
                            disabled="@IsDeleting"
                            @onclick="CloseDeleteModal">
                        Hủy
                    </button>

                    <button class="confirm-delete"
                            disabled="@IsDeleting"
                            @onclick="ConfirmDelete">

                        @if (IsDeleting)
                        {
                            <span class="mini-spinner"></span>
                            <span>Đang xóa...</span>
                        }
                        else
                        {
                            <span>⌫</span>
                            <span>Xóa thể loại</span>
                        }

                    </button>
                </div>

            </div>
        </div>
    }

    <!-- TOAST -->
    @if (!string.IsNullOrWhiteSpace(ToastMessage))
    {
        <div class="custom-toast @(ToastSuccess ? "success" : "error")">
            <span class="toast-icon">
                @(ToastSuccess ? "✓" : "!")
            </span>

            <div>
                <strong>
                    @(ToastSuccess ? "Thành công" : "Có lỗi xảy ra")
                </strong>
                <small>@ToastMessage</small>
            </div>

            <button @onclick="CloseToast">×</button>
        </div>
    }

</div>

@code {
    private List<TheLoaiGiayDTO> danhSach = new();

    private string searchTerm = string.Empty;
    private string statusFilter = "all";

    private int CurrentPage = 1;
    private int PageSize = 10;

    private bool isLoading = true;

    private bool IsPopupVisible;
    private bool IsEdit;
    private bool IsSubmitting;

    private TheLoaiGiayDTO FormData = new();

    private string FormError = string.Empty;
    private string pageError = string.Empty;

    private bool IsConfirmVisible;
    private bool IsDeleting;
    private TheLoaiGiayDTO? SelectedItem;

    private string ToastMessage = string.Empty;
    private bool ToastSuccess;

    private string SearchTerm
    {
        get => searchTerm;
        set
        {
            searchTerm = value;
            CurrentPage = 1;
        }
    }

    private List<TheLoaiGiayDTO> FilteredList =>
        danhSach
            .Where(x =>
                statusFilter == "all"
                || (statusFilter == "active" && x.TrangThai)
                || (statusFilter == "inactive" && !x.TrangThai))
            .Where(x =>
                string.IsNullOrWhiteSpace(searchTerm)
                || (x.TenTheLoai ?? string.Empty)
                    .Contains(
                        searchTerm,
                        StringComparison.OrdinalIgnoreCase)
                || (x.MoTa ?? string.Empty)
                    .Contains(
                        searchTerm,
                        StringComparison.OrdinalIgnoreCase))
            .ToList();

    private List<TheLoaiGiayDTO> PagedData =>
        FilteredList
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                (double)FilteredList.Count / PageSize));

    private IEnumerable<int> VisiblePages
    {
        get
        {
            const int maxVisible = 5;

            var start = Math.Max(
                1,
                CurrentPage - maxVisible / 2);

            var end = Math.Min(
                TotalPages,
                start + maxVisible - 1);

            start = Math.Max(
                1,
                end - maxVisible + 1);

            return Enumerable.Range(
                start,
                end - start + 1);
        }
    }

    private int FirstDisplayedItem =>
        FilteredList.Count == 0
            ? 0
            : (CurrentPage - 1) * PageSize + 1;

    private int LastDisplayedItem =>
        Math.Min(
            CurrentPage * PageSize,
            FilteredList.Count);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            pageError = string.Empty;

            danhSach =
                (await theLoaiGiayService.GetAllAsync())
                .OrderBy(x => x.TenTheLoai)
                .ToList();

            EnsureValidPage();
        }
        catch (Exception ex)
        {
            pageError =
                "Không thể tải danh sách: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddForm()
    {
        IsEdit = false;
        FormError = string.Empty;

        FormData = new TheLoaiGiayDTO
            {
                TrangThai = true
            };

        IsPopupVisible = true;
    }

    private void ShowEditForm(TheLoaiGiayDTO item)
    {
        IsEdit = true;
        FormError = string.Empty;

        FormData = new TheLoaiGiayDTO
            {
                TheLoaiGiayId = item.TheLoaiGiayId,
                TenTheLoai = item.TenTheLoai,
                MoTa = item.MoTa,
                TrangThai = item.TrangThai
            };

        IsPopupVisible = true;
    }

    private void ClosePopup()
    {
        if (IsSubmitting)
            return;

        IsPopupVisible = false;
        FormError = string.Empty;
    }

    private async Task SubmitForm()
    {
        if (IsSubmitting)
            return;

        try
        {
            IsSubmitting = true;
            FormError = string.Empty;

            FormData.TenTheLoai =
                FormData.TenTheLoai?.Trim() ?? string.Empty;

            FormData.MoTa =
                FormData.MoTa?.Trim() ?? string.Empty;

            var duplicate = danhSach.Any(x =>
                x.TheLoaiGiayId != FormData.TheLoaiGiayId
                && string.Equals(
                    x.TenTheLoai?.Trim(),
                    FormData.TenTheLoai,
                    StringComparison.OrdinalIgnoreCase));

            if (duplicate)
            {
                FormError = "Tên thể loại đã tồn tại.";
                return;
            }

            // Chỉ await, không gán vào bool để tránh lỗi
            // Cannot implicitly convert type 'void' to 'bool'.
            if (IsEdit)
            {
                await theLoaiGiayService.UpdateAsync(FormData);
            }
            else
            {
                await theLoaiGiayService.AddAsync(FormData);
            }

            await LoadData();

            IsPopupVisible = false;

            ShowToast(
                IsEdit
                    ? "Cập nhật thể loại thành công."
                    : "Thêm thể loại thành công.",
                true);
        }
        catch (Exception ex)
        {
            FormError =
                "Không thể lưu thể loại: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void AskDelete(TheLoaiGiayDTO item)
    {
        SelectedItem = item;
        IsConfirmVisible = true;
    }

    private void CloseDeleteModal()
    {
        if (IsDeleting)
            return;

        IsConfirmVisible = false;
        SelectedItem = null;
    }

    private async Task ConfirmDelete()
    {
        if (SelectedItem == null || IsDeleting)
            return;

        try
        {
            IsDeleting = true;

            // Dùng được với cả Task và Task<bool>.
            await theLoaiGiayService.DeleteAsync(
                SelectedItem.TheLoaiGiayId);

            IsConfirmVisible = false;
            SelectedItem = null;

            await LoadData();

            ShowToast(
                "Xóa thể loại thành công.",
                true);
        }
        catch (Exception ex)
        {
            ShowToast(
                "Không thể xóa thể loại: " + ex.Message,
                false);
        }
        finally
        {
            IsDeleting = false;
        }
    }

    private void SetStatusFilter(string value)
    {
        statusFilter = value;
        CurrentPage = 1;
    }

    private void ClearSearch()
    {
        SearchTerm = string.Empty;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void PreviousPage()
    {
        ChangePage(CurrentPage - 1);
    }

    private void NextPage()
    {
        ChangePage(CurrentPage + 1);
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(
            e.Value?.ToString(),
            out var newSize))
        {
            PageSize = newSize;
            CurrentPage = 1;
        }
    }

    private void EnsureValidPage()
    {
        if (CurrentPage > TotalPages)
        {
            CurrentPage = TotalPages;
        }

        if (CurrentPage < 1)
        {
            CurrentPage = 1;
        }
    }

    private static string ShortId(Guid id)
    {
        return "#" + id
            .ToString()[..8]
            .ToUpperInvariant();
    }

    private static string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "TL";

        var words = name.Trim()
            .Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
        {
            return words[0][0]
                .ToString()
                .ToUpperInvariant();
        }

        return string.Concat(
            words.First()[0],
            words.Last()[0])
            .ToUpperInvariant();
    }

    private void ShowToast(string message, bool success)
    {
        ToastMessage = message;
        ToastSuccess = success;
    }

    private void CloseToast()
    {
        ToastMessage = string.Empty;
    }
}

<style>
    .category-page {
        --primary: #f97316;
        --primary-dark: #ea580c;
        --primary-light: #fff7ed;
        --text: #172033;
        --muted: #718096;
        --border: #e7ebf1;
        min-height: 100vh;
        padding: 28px;
        background: #f6f8fc;
        color: var(--text);
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .header-icon {
        width: 50px;
        height: 50px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 14px;
        background: linear-gradient(135deg, #fb923c, #ea580c);
        font-size: 21px;
        box-shadow: 0 8px 20px rgba(249, 115, 22, .24);
    }

    .page-header h2 {
        margin: 0 0 4px;
        font-size: 25px;
        font-weight: 800;
    }

    .page-header p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
    }

    .add-button {
        min-height: 43px;
        padding: 0 17px;
        border: 0;
        border-radius: 11px;
        background: linear-gradient(135deg, #fb923c, #ea580c);
        color: white;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(249, 115, 22, .23);
        transition: .2s;
    }

        .add-button:hover {
            transform: translateY(-2px);
        }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 19px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 13px;
        min-height: 100px;
        padding: 17px;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: white;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .04);
    }

    .stat-icon {
        width: 47px;
        height: 47px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 13px;
        font-size: 18px;
        font-weight: 800;
    }

        .stat-icon.total {
            background: #eff6ff;
            color: #2563eb;
        }

        .stat-icon.active {
            background: #ecfdf5;
            color: #059669;
        }

        .stat-icon.inactive {
            background: #f1f5f9;
            color: #64748b;
        }

    .stat-card span,
    .stat-card strong {
        display: block;
    }

    .stat-card span {
        margin-bottom: 5px;
        color: var(--muted);
        font-size: 12px;
    }

    .stat-card strong {
        font-size: 24px;
    }

    .category-panel {
        display: flex;
        flex-direction: column;
        height: 610px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 17px;
        background: white;
        box-shadow: 0 8px 27px rgba(15, 23, 42, .05);
    }

    .panel-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        flex-shrink: 0;
        padding: 18px 20px;
        border-bottom: 1px solid var(--border);
    }

    .search-box {
        position: relative;
        width: min(460px, 100%);
    }

        .search-box > span {
            position: absolute;
            top: 50%;
            left: 14px;
