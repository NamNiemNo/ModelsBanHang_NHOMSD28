    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if ((firstRender || chartNeedsRender)
            && !isLoading)
        {
            chartNeedsRender = false;

            try
            {
                chartErrorMessage = string.Empty;

                await JS.InvokeVoidAsync(
                    "thongKeChart.draw",
                    "bestSellingChart",
                    chartProducts
                        .Select(x => x.TenSanPham)
                        .ToArray(),
                    chartProducts
                        .Select(x => x.SoLuong)
                        .ToArray());
            }
            catch (Exception ex)
            {
                chartErrorMessage =
                    "Không thể vẽ biểu đồ: "
                    + ex.Message;

                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            hoaDons =
                await hoaDonService.GetAll()
                ?? new List<HoaDon>();

            hoaDonChiTiets =
                await chiTietHoaDonService.GetAllHDCTAsync()
                ?? new List<HoaDonChiTiet>();

            giayChiTiets =
                await giayChiTietService.GetAllAsync()
                ?? new List<GiayChiTietDTO>();

            BuildLowStockProducts();
            CalculateAllSummaryCards();
            ApplyFilter();
            BuildBestSellingChart();
        }
        catch (Exception ex)
        {
            errorMessage =
                "Không tải được dữ liệu: "
                + ex.Message;
        }
        finally
        {
            isLoading = false;
            chartNeedsRender = true;
        }
    }

    private void CalculateAllSummaryCards()
    {
        DateTime today = DateTime.Today;

        CalculateStatsForPeriod(
            today,
            today,
            out TongSoTienHomNay,
            out SoLuongSanPhamHomNay,
            out DonThanhCongHomNay,
            out DonHangHuyHomNay,
            out DonTraHomNay);

        DateTime startOfWeek =
            GetStartOfWeek(today);

        CalculateStatsForPeriod(
            startOfWeek,
            today,
            out TongSoTienTuanNay,
            out SoLuongSanPhamTuanNay,
            out DonThanhCongTuanNay,
            out DonHangHuyTuanNay,
            out DonTraTuanNay);

        DateTime startOfMonth =
            new DateTime(
                today.Year,
                today.Month,
                1);

        CalculateStatsForPeriod(
            startOfMonth,
            today,
            out TongSoTienThangNay,
            out SoLuongSanPhamThangNay,
            out DonThanhCongThangNay,
            out DonHangHuyThangNay,
            out DonTraThangNay);

        DateTime startOfYear =
            new DateTime(
                today.Year,
                1,
                1);

        CalculateStatsForPeriod(
            startOfYear,
            today,
            out TongSoTienNamNay,
            out SoLuongSanPhamNamNay,
            out DonThanhCongNamNay,
            out DonHangHuyNamNay,
            out DonTraNamNay);
    }

    private void CalculateStatsForPeriod(
        DateTime startDate,
        DateTime endDate,
        out decimal totalMoney,
        out int totalProducts,
        out int successfulOrders,
        out int cancelledOrders,
        out int returnedOrders)
    {
        List<HoaDon> invoicesInRange =
            hoaDons
                .Where(x =>
                    x.NgayTao.Date >= startDate.Date
                    && x.NgayTao.Date <= endDate.Date)
                .ToList();

        totalMoney =
            invoicesInRange
                .Where(x =>
                    IsStatus(
                        x.TrangThai,
                        "đã giao",
                        "đã giao hàng",
                        "đã thanh toán",
                        "hoàn thành"))
                .Sum(x =>
                    Convert.ToDecimal(
                        x.TongTienSauKhiGiam));

        List<Guid> completedIds =
            invoicesInRange
                .Where(x =>
                    IsStatus(
                        x.TrangThai,
                        "hoàn thành"))
                .Select(x => x.HoaDonId)
                .ToList();

        totalProducts =
            hoaDonChiTiets
                .Where(x =>
                    completedIds.Contains(x.HoaDonId)
                    && x.TrangThai == true)
                .Sum(x =>
                    Convert.ToInt32(
                        x.SoLuongSanPham));

        successfulOrders =
            completedIds.Count;

        cancelledOrders =
            invoicesInRange.Count(x =>
                IsStatus(
                    x.TrangThai,
                    "đã hủy"));

        returnedOrders =
            hoaDonChiTiets
                .Where(x =>
                    x.TrangThai == false
                    && invoicesInRange.Any(h =>
                        h.HoaDonId == x.HoaDonId))
                .Select(x => x.HoaDonId)
                .Distinct()
                .Count();
    }

    private void SetActiveFilter(string filter)
    {
        activeFilter = filter;
        errorMessage = string.Empty;

        if (filter != "TÙY CHỈNH")
        {
            ApplyFilter();
        }
    }

    private void ApplyCustomFilter()
    {
        errorMessage = string.Empty;

        if (StartDate.Date > EndDate.Date)
        {
            errorMessage =
                "Ngày bắt đầu phải nhỏ hơn hoặc bằng ngày kết thúc.";

            return;
        }

        ApplyFilter();
    }

    private void ApplyFilter()
    {
        GetSelectedDateRange(
            out SelectedStartDate,
            out SelectedEndDate);

        CalculateStatsForPeriod(
            SelectedStartDate,
            SelectedEndDate,
            out SelectedRevenue,
            out SelectedProducts,
            out SelectedSuccessOrders,
            out SelectedCancelledOrders,
            out SelectedReturnedOrders);

        BuildBestSellingProducts(
            SelectedStartDate,
            SelectedEndDate);

        CalculateOrderStatus(
            SelectedStartDate,
            SelectedEndDate);

        CurrentPage1 = 0;
    }

    private void GetSelectedDateRange(
        out DateTime startDate,
        out DateTime endDate)
    {
        DateTime today = DateTime.Today;

        switch (activeFilter)
        {
            case "TUẦN":
                startDate =
                    GetStartOfWeek(today);

                endDate = today;
                break;

            case "THÁNG":
                startDate =
                    new DateTime(
                        today.Year,
                        today.Month,
                        1);

                endDate = today;
                break;

            case "NĂM":
                startDate =
                    new DateTime(
                        today.Year,
                        1,
                        1);

                endDate = today;
                break;

            case "TÙY CHỈNH":
                startDate = StartDate.Date;
                endDate = EndDate.Date;
                break;

            default:
                startDate = today;
                endDate = today;
                break;
        }
    }

    private void BuildBestSellingProducts(
        DateTime startDate,
        DateTime endDate)
    {
        sanPhamBanChays =
            GetBestSellingProducts(
                startDate,
                endDate);
    }

    private void SetChartFilter(string filter)
    {
        chartFilter = filter;
        BuildBestSellingChart();
    }

    private void BuildBestSellingChart()
    {
        GetChartDateRange(
            out ChartStartDate,
            out ChartEndDate);

        chartProducts =
            GetBestSellingProducts(
                ChartStartDate,
                ChartEndDate)
            .Take(7)
            .ToList();

        chartErrorMessage = string.Empty;
        chartNeedsRender = true;
    }

    private void GetChartDateRange(
        out DateTime startDate,
        out DateTime endDate)
    {
        DateTime today = DateTime.Today;

        if (chartFilter == "THÁNG")
        {
            startDate =
                new DateTime(
                    today.Year,
                    today.Month,
                    1);

            endDate = today;
            return;
        }

        if (chartFilter == "NĂM")
        {
            startDate =
                new DateTime(
                    today.Year,
                    1,
                    1);

            endDate = today;
            return;
        }

        startDate = today;
        endDate = today;
    }

    private List<DanhSachSanPhamBanChay>
        GetBestSellingProducts(
            DateTime startDate,
            DateTime endDate)
    {
        return
            (from hd in hoaDons
             join hdct in hoaDonChiTiets
                 on hd.HoaDonId
                 equals hdct.HoaDonId
             join gct in giayChiTiets
                 on hdct.GiayChiTietId
                 equals gct.GiayChiTietId
             where hd.NgayTao.Date >= startDate.Date
                   && hd.NgayTao.Date <= endDate.Date
                   && IsStatus(
                       hd.TrangThai,
                       "hoàn thành")
                   && hdct.TrangThai == true
             select new
             {
                 TenGiay =
                     gct.TenGiay
                     ?? "Chưa rõ tên",

                 Anh =
                     gct.AnhGiay
                     ?? string.Empty,

                 Gia =
                     Convert.ToDecimal(
                         hdct.Gia),

                 KichCo =
                     Convert.ToString(
                         gct.size)
                     ?? "Không rõ",

                 MauSac =
                     gct.TenMau
                     ?? "Không rõ",

                 SoLuong =
                     Convert.ToInt32(
                         hdct.SoLuongSanPham)
             })
            .GroupBy(x => x.TenGiay)
            .Select(group =>
                new DanhSachSanPhamBanChay
                    {
                        TenSanPham =
                            group.Key,

                        Anh =
                            group
                                .Select(x => x.Anh)
                                .FirstOrDefault(x =>
                                    !string.IsNullOrWhiteSpace(x))
                            ?? string.Empty,

                        GiaTien =
                            group.Sum(x =>
                                x.Gia * x.SoLuong),

                        Size =
                            string.Join(
                                ", ",
                                group
                                    .Select(x => x.KichCo)
                                    .Distinct()),

                        MauSac =
                            string.Join(
                                ", ",
                                group
                                    .Select(x => x.MauSac)
                                    .Distinct()),

                        SoLuong =
                            group.Sum(x => x.SoLuong)
                    })
            .OrderByDescending(x => x.SoLuong)
            .ThenBy(x => x.TenSanPham)
            .ToList();
    }

    private void BuildLowStockProducts()
    {
        sanPhamSapHet =
            giayChiTiets
                .Where(x =>
                    Convert.ToInt32(
                        x.SoLuongCon)
                    <= LowStockThreshold)
                .Select(x =>
                    new DanhSachSanPhamBanChay
                        {
                            Anh =
                                x.AnhGiay
                                ?? string.Empty,

                            TenSanPham =
                                x.TenGiay
                                ?? "Chưa rõ tên",

                            MauSac =
                                x.TenMau
                                ?? "Không rõ",

                            Size =
                                Convert.ToString(x.size)
                                ?? "Không rõ",

                            SoLuong =
                                Convert.ToInt32(
                                    x.SoLuongCon),

                            GiaTien =
                                Convert.ToDecimal(x.Gia)
                        })
                .OrderBy(x => x.SoLuong)
                .ThenBy(x => x.TenSanPham)
                .ToList();
    }

    private void CalculateOrderStatus(
        DateTime startDate,
        DateTime endDate)
    {
        List<HoaDon> filteredOrders =
            hoaDons
                .Where(x =>
                    x.NgayTao.Date >= startDate.Date
                    && x.NgayTao.Date <= endDate.Date)
                .ToList();

        SelectedOrderCount =
            filteredOrders.Count;

        CountDaHuy =
            filteredOrders.Count(x =>
                IsStatus(
                    x.TrangThai,
                    "đã hủy"));

        CountChoXacNhan =
            filteredOrders.Count(x =>
                IsStatus(
                    x.TrangThai,
                    "chờ xác nhận"));

        CountChoGiaoHang =
            filteredOrders.Count(x =>
                IsStatus(
                    x.TrangThai,
                    "chờ giao hàng"));

        CountDangVanChuyen =
            filteredOrders.Count(x =>
                IsStatus(
                    x.TrangThai,
                    "đang vận chuyển",
                    "đang giao hàng"));

        CountDaGiaoHang =
            filteredOrders.Count(x =>
                IsStatus(
                    x.TrangThai,
                    "đã giao",
                    "đã giao hàng"));

        CountDaThanhToan =
            filteredOrders.Count(x =>
                IsStatus(
                    x.TrangThai,
                    "đã thanh toán"));

        CountChoThanhToan =
            filteredOrders.Count(x =>
                IsStatus(
                    x.TrangThai,
                    "chờ thanh toán"));

        CountHoanThanh =
            filteredOrders.Count(x =>
                IsStatus(
                    x.TrangThai,
                    "hoàn thành"));

        CountTraHang =
            filteredOrders.Count(hd =>
                hoaDonChiTiets.Any(ct =>
                    ct.HoaDonId == hd.HoaDonId
                    && ct.TrangThai == false));

        PercentDaHuy =
            CalculatePercent(
                CountDaHuy,
                SelectedOrderCount);

        PercentChoXacNhan =
            CalculatePercent(
                CountChoXacNhan,
                SelectedOrderCount);

        PercentChoGiaoHang =
            CalculatePercent(
                CountChoGiaoHang,
                SelectedOrderCount);

        PercentDangVanChuyen =
            CalculatePercent(
                CountDangVanChuyen,
                SelectedOrderCount);

        PercentDaGiaoHang =
            CalculatePercent(
                CountDaGiaoHang,
                SelectedOrderCount);

        PercentDaThanhToan =
            CalculatePercent(
                CountDaThanhToan,
                SelectedOrderCount);

        PercentChoThanhToan =
            CalculatePercent(
                CountChoThanhToan,
                SelectedOrderCount);

        PercentHoanThanh =
            CalculatePercent(
                CountHoanThanh,
                SelectedOrderCount);

        PercentTraHang =
            CalculatePercent(
                CountTraHang,
                SelectedOrderCount);
    }

    private decimal CalculatePercent(
        int value,
        int total)
    {
        if (total <= 0)
        {
            return 0;
        }

        return (decimal)value
               * 100m
               / total;
    }

    private string GetProgressStyle(
        decimal percent)
    {
        if (percent < 0)
        {
            percent = 0;
        }

        if (percent > 100)
        {
            percent = 100;
        }

        return "width:"
               + percent.ToString(
                   "0.##",
                   System.Globalization.CultureInfo.InvariantCulture)
               + "%;";
    }

    private DateTime GetStartOfWeek(DateTime date)
    {
        int difference =
            (7 + (
                date.DayOfWeek
                - DayOfWeek.Monday)) % 7;

        return date
            .AddDays(-difference)
            .Date;
    }

    private bool IsStatus(
        string currentStatus,
        params string[] expectedStatuses)
    {
        string normalized =
            NormalizeStatus(currentStatus);

        return expectedStatuses.Any(x =>
            normalized == NormalizeStatus(x));
    }

    private string NormalizeStatus(string status)
    {
        return (status ?? string.Empty)
            .Trim()
            .ToLowerInvariant()
            .Replace("huỷ", "hủy");
    }

    private string GetImageUrl(string imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath))
        {
            return "/images/no-image.png";
        }

        Uri absoluteUri;

        if (Uri.TryCreate(
            imagePath,
            UriKind.Absolute,
            out absoluteUri))
        {
            return absoluteUri.ToString();
        }

        return ApiBaseUrl.TrimEnd('/')
               + "/"
               + imagePath.TrimStart('/');
    }

    private void SetPage1(int page)
    {
        if (page >= 0 && page < TotalPages1)
        {
            CurrentPage1 = page;
        }
    }

    private void SetPage2(int page)
    {
        if (page >= 0 && page < TotalPages2)
        {
            CurrentPage2 = page;
        }
    }
