@using API.Models.DTO
@using Microsoft.AspNetCore.Components.Forms

@if (IsVisible && _editContext != null)
{
    <div class="style-modal-overlay"
         @onclick="CloseModal">

        <div class="style-modal"
             role="dialog"
             aria-modal="true"
             @onclick:stopPropagation="true">

            <EditForm EditContext="_editContext"
                      OnSubmit="HandleSubmit">

                <DataAnnotationsValidator />

                <!-- Tiêu đề -->
                <header class="style-modal-header">

                    <div class="modal-header-icon">
                        @if (IsEdit)
                        {
                            <svg viewBox="0 0 24 24">
                                <path d="M4 20h4L19 9l-4-4L4 16v4Z" />
                                <path d="m13 7 4 4" />
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                        }
                    </div>

                    <div class="modal-title">
                        <span>
                            @(IsEdit
                                ? "CẬP NHẬT DỮ LIỆU"
                                : "TẠO MỚI")
                        </span>

                        <h2>
                            @(IsEdit
                                ? "Chỉnh sửa kiểu dáng"
                                : "Thêm kiểu dáng")
                        </h2>

                        <p>
                            Nhập thông tin kiểu dáng sản phẩm bên dưới.
                        </p>
                    </div>

                    <button type="button"
                            class="modal-close-button"
                            title="Đóng"
                            disabled="@IsSubmitting"
                            @onclick="CloseModal">
                        ×
                    </button>
                </header>

                <!-- Nội dung -->
                <div class="style-modal-body">

                    @if (!string.IsNullOrWhiteSpace(SaveError))
                    {
                        <div class="modal-error-message">
                            <div class="error-icon">!</div>

                            <div>
                                <strong>Không thể lưu dữ liệu</strong>
                                <span>@SaveError</span>
                            </div>

                            <button type="button"
                                    @onclick="ClearError">
                                ×
                            </button>
                        </div>
                    }

                    <!-- Tên kiểu dáng -->
                    <div class="modal-form-group">
                        <div class="form-label-row">
                            <label for="style-name">
                                Tên kiểu dáng
                                <span>*</span>
                            </label>

                            <small>
                                @GetNameLength()/50
                            </small>
                        </div>

                        <div class="input-wrapper">
                            <svg viewBox="0 0 24 24">
                                <path d="M4 16c4 0 7-2 9-7l2 5 5 2v4H4z" />
                            </svg>

                            <InputText id="style-name"
                                       class="@GetInputClass(
                                           nameof(FormData.TenKieuDang))"
                                       placeholder="Ví dụ: Thể thao, Cổ điển, Sneaker..."
                                       maxlength="50"
                                       @bind-Value="FormData.TenKieuDang" />
                        </div>

                        <ValidationMessage For="@(() => FormData.TenKieuDang)"
                                           class="validation-message" />
                    </div>

                    <!-- Mô tả -->
                    <div class="modal-form-group">
                        <div class="form-label-row">
                            <label for="style-description">
                                Mô tả
                            </label>

                            <small>
                                @GetDescriptionLength()/250
                            </small>
                        </div>

                        <InputTextArea id="style-description"
                                       class="@GetInputClass(
                                           nameof(FormData.MoTa))"
                                       placeholder="Nhập mô tả về kiểu dáng..."
                                       maxlength="250"
                                       rows="5"
                                       @bind-Value="FormData.MoTa" />

                        <ValidationMessage For="@(() => FormData.MoTa)"
                                           class="validation-message" />

                        <span class="form-help-text">
                            Mô tả ngắn gọn đặc điểm của kiểu dáng.
                        </span>
                    </div>

                    <!-- Trạng thái -->
                    <div class="status-form-card">
                        <div class="status-information">
                            <div class="status-icon @(FormData.TrangThai ? "active" : "disabled")">
                                @if (FormData.TrangThai)
                                {
                                    <svg viewBox="0 0 24 24">
                                        <circle cx="12"
                                                cy="12"
                                                r="9" />

                                        <path d="m8 12 3 3 5-6" />
                                    </svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24">
                                        <circle cx="12"
                                                cy="12"
                                                r="9" />

                                        <path d="m8 8 8 8M16 8l-8 8" />
                                    </svg>
                                }
                            </div>

                            <div>
                                <strong>Trạng thái hoạt động</strong>

                                <span>
                                    @(FormData.TrangThai
                                        ? "Kiểu dáng đang được sử dụng"
                                        : "Kiểu dáng đã ngừng sử dụng")
                                </span>
                            </div>
                        </div>

                        <label class="style-switch"
                               title="Thay đổi trạng thái">

                            <InputCheckbox @bind-Value="FormData.TrangThai" />

                            <span class="switch-slider"></span>
                        </label>
                    </div>
                </div>

                <!-- Nút thao tác -->
                <footer class="style-modal-footer">

                    <button type="button"
                            class="modal-cancel-button"
                            disabled="@IsSubmitting"
                            @onclick="CloseModal">
                        Hủy
                    </button>

                    <button type="submit"
                            class="modal-save-button"
                            disabled="@IsSubmitting">

                        @if (IsSubmitting)
                        {
                            <span class="button-spinner"></span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24">
                                <path d="M5 4h12l2 2v14H5z" />
                                <path d="M8 4v6h8V4M8 20v-6h8v6" />
                            </svg>

                            <span>
                                @(IsEdit
                                    ? "Lưu thay đổi"
                                    : "Thêm kiểu dáng")
                            </span>
                        }
                    </button>
                </footer>
            </EditForm>
        </div>
    </div>
}

<style>
    .style-modal-overlay,
    .style-modal-overlay * {
        box-sizing: border-box;
    }

    .style-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(15, 23, 42, 0.64);
        backdrop-filter: blur(5px);
        animation: styleModalFadeIn 0.2s ease;
    }

    .style-modal {
        width: min(580px, 100%);
        max-height: 94vh;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 19px;
        background: #ffffff;
        box-shadow: 0 25px 70px rgba(15, 23, 42, 0.3), 0 8px 25px rgba(15, 23, 42, 0.1);
        animation: styleModalSlideUp 0.22s ease;
    }

        .style-modal form {
            display: flex;
            max-height: 94vh;
            flex-direction: column;
        }

    /* Tiêu đề */

    .style-modal-header {
        position: relative;
        display: flex;
        flex-shrink: 0;
        align-items: flex-start;
        gap: 13px;
        padding: 22px 65px 19px 22px;
        border-bottom: 1px solid #e8edf3;
        background: linear-gradient( 135deg, #ffffff 0%, #fff7ed 100% );
    }

    .modal-header-icon {
        display: grid;
        flex: 0 0 44px;
        width: 44px;
        height: 44px;
        place-items: center;
        border-radius: 13px;
        background: #f97316;
        color: #ffffff;
        box-shadow: 0 5px 12px rgba(249, 115, 22, 0.2);
    }

        .modal-header-icon svg {
            width: 21px;
            height: 21px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .modal-title {
        min-width: 0;
    }

        .modal-title > span {
            display: block;
            margin-bottom: 5px;
            color: #ea580c;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 0.13em;
        }

        .modal-title h2 {
            margin: 0;
            color: #0f172a;
            font-size: 19px;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .modal-title p {
            margin: 5px 0 0;
            color: #64748b;
            font-size: 10px;
        }

    .modal-close-button {
        position: absolute;
        top: 18px;
        right: 18px;
        display: grid;
        width: 34px;
        height: 34px;
        padding: 0;
        place-items: center;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        background: #ffffff;
        color: #64748b;
        font-size: 22px;
        line-height: 1;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease;
    }

        .modal-close-button:hover:not(:disabled) {
            background: #fef2f2;
            color: #dc2626;
        }

        .modal-close-button:disabled {
            opacity: 0.5;
            cursor: wait;
        }

    /* Nội dung */

    .style-modal-body {
        flex: 1;
        min-height: 0;
        padding: 22px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #94a3b8 #f1f5f9;
    }

        .style-modal-body::-webkit-scrollbar {
            width: 9px;
        }

        .style-modal-body::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        .style-modal-body::-webkit-scrollbar-thumb {
            border: 2px solid #f1f5f9;
            border-radius: 10px;
            background: #94a3b8;
        }

    /* Form */

    .modal-form-group {
        margin-bottom: 20px;
    }

    .form-label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
    }

        .form-label-row label {
            color: #334155;
            font-size: 11px;
            font-weight: 800;
        }

            .form-label-row label span {
                color: #ef4444;
            }

        .form-label-row small {
            color: #94a3b8;
            font-size: 9px;
        }

    .input-wrapper {
        position: relative;
    }

        .input-wrapper > svg {
            position: absolute;
            top: 50%;
            left: 13px;
            z-index: 2;
            width: 18px;
            height: 18px;
            transform: translateY(-50%);
            fill: none;
            stroke: #94a3b8;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
            pointer-events: none;
        }

    .modal-form-control {
        width: 100%;
        padding: 0 13px;
        border: 1px solid #dce3ec;
        border-radius: 10px;
        outline: none;
        background: #f8fafc;
        color: #334155;
        font-family: inherit;
        font-size: 12px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .input-wrapper input.modal-form-control {
        height: 44px;
        padding-left: 42px;
    }

    textarea.modal-form-control {
        min-height: 115px;
        padding-top: 12px;
        line-height: 1.5;
        resize: vertical;
    }

    .modal-form-control::placeholder {
        color: #94a3b8;
    }

    .modal-form-control:focus {
        border-color: #fb923c;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.1);
    }

    .modal-form-control.input-invalid {
        border-color: #ef4444;
        background: #fffafa;
    }

        .modal-form-control.input-invalid:focus {
            box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.1);
        }

    .validation-message {
        display: block;
        margin-top: 6px;
        color: #dc2626;
        font-size: 10px;
    }

    .form-help-text {
        display: block;
        margin-top: 6px;
        color: #94a3b8;
        font-size: 9px;
    }

    /* Trạng thái */

    .status-form-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 15px;
        border: 1px solid #e8edf3;
        border-radius: 12px;
        background: #f8fafc;
    }

    .status-information {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .status-icon {
        display: grid;
        flex: 0 0 35px;
        width: 35px;
        height: 35px;
        place-items: center;
        border-radius: 10px;
    }

        .status-icon.active {
            background: #dcfce7;
            color: #15803d;
        }

        .status-icon.disabled {
            background: #e2e8f0;
            color: #64748b;
        }

        .status-icon svg {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .status-information strong,
    .status-information span {
        display: block;
    }

    .status-information strong {
        color: #334155;
        font-size: 11px;
    }

    .status-information span {
        margin-top: 4px;
        color: #94a3b8;
        font-size: 9px;
    }

    /* Công tắc */

    .style-switch {
        position: relative;
        display: inline-block;
        flex: 0 0 46px;
        width: 46px;
        height: 25px;
    }

        .style-switch input {
            width: 0;
            height: 0;
            opacity: 0;
        }

    .switch-slider {
        position: absolute;
        inset: 0;
        border-radius: 999px;
        background: #cbd5e1;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .switch-slider::before {
            position: absolute;
            bottom: 3px;
            left: 3px;
            width: 19px;
            height: 19px;
            border-radius: 50%;
            background: #ffffff;
            content: "";
            box-shadow: 0 2px 5px rgba(15, 23, 42, 0.2);
            transition: transform 0.2s ease;
        }

    .style-switch input:checked + .switch-slider {
        background: #22c55e;
    }

        .style-switch input:checked + .switch-slider::before {
            transform: translateX(21px);
        }

    /* Lỗi lưu */

    .modal-error-message {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 17px;
        padding: 11px 12px;
        border: 1px solid #fecaca;
        border-radius: 10px;
        background: #fef2f2;
        color: #b91c1c;
    }

    .error-icon {
        display: grid;
        flex: 0 0 30px;
        width: 30px;
        height: 30px;
        place-items: center;
        border-radius: 8px;
        background: #fee2e2;
        font-size: 13px;
        font-weight: 900;
    }

    .modal-error-message > div:nth-child(2) {
        flex: 1;
    }

    .modal-error-message strong,
    .modal-error-message span {
        display: block;
    }

    .modal-error-message strong {
        font-size: 10px;
    }

    .modal-error-message span {
        margin-top: 3px;
        font-size: 9px;
    }

    .modal-error-message > button {
        border: none;
        background: transparent;
        color: #b91c1c;
        font-size: 18px;
        cursor: pointer;
    }

    /* Footer */

    .style-modal-footer {
        display: flex;
        flex-shrink: 0;
        justify-content: flex-end;
        gap: 9px;
        padding: 14px 22px;
        border-top: 1px solid #e8edf3;
        background: #fbfcfe;
    }

    .modal-cancel-button,
    .modal-save-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 40px;
        padding: 0 16px;
        border-radius: 9px;
        font-family: inherit;
        font-size: 11px;
        font-weight: 800;
        cursor: pointer;
    }

    .modal-cancel-button {
        border: 1px solid #dce3ec;
        background: #ffffff;
        color: #64748b;
    }

        .modal-cancel-button:hover:not(:disabled) {
            border-color: #cbd5e1;
            background: #f8fafc;
        }

    .modal-save-button {
        border: none;
        background: #f97316;
        color: #ffffff;
        box-shadow: 0 5px 12px rgba(249, 115, 22, 0.2);
    }

        .modal-save-button:hover:not(:disabled) {
            background: #ea580c;
        }

        .modal-cancel-button:disabled,
        .modal-save-button:disabled {
            opacity: 0.6;
            cursor: wait;
        }

        .modal-save-button svg {
            width: 16px;
            height: 16px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linejoin: round;
        }

    .button-spinner {
        width: 15px;
        height: 15px;
        border: 2px solid rgba(255, 255, 255, 0.45);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: styleButtonSpin 0.7s linear infinite;
    }

    @@keyframes styleModalFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes styleModalSlideUp {
        from {
            opacity: 0;
            transform: translateY(16px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes styleButtonSpin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 600px) {
        .style-modal-overlay {
            padding: 10px;
        }

        .style-modal {
            border-radius: 14px;
        }

        .style-modal-header {
            padding: 18px 55px 16px 17px;
        }

        .modal-header-icon {
            flex-basis: 39px;
            width: 39px;
            height: 39px;
        }

        .modal-title h2 {
            font-size: 16px;
        }

        .style-modal-body {
            padding: 17px;
        }

        .status-form-card {
            align-items: flex-start;
        }

        .style-modal-footer {
            padding: 12px 17px;
        }

        .modal-cancel-button,
        .modal-save-button {
            flex: 1;
        }
    }
</style>

@code {
    [Parameter]
    public KieuDangDTO FormData { get; set; } = new();

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }

    private EditContext? _editContext;
    private ValidationMessageStore? _messageStore;
    private KieuDangDTO? _currentModel;

    private bool IsSubmitting;
    private string SaveError = string.Empty;

    protected override void OnParametersSet()
    {
        if (!IsVisible)
        {
            return;
        }

        /*
         * Chỉ tạo lại EditContext khi FormData thay đổi,
         * tránh xóa dữ liệu khi người dùng đang nhập.
         */
        if (_editContext == null ||
            !ReferenceEquals(_currentModel, FormData))
        {
            _currentModel = FormData;

            FormData.TenKieuDang ??= string.Empty;
            FormData.MoTa ??= string.Empty;

            _editContext =
                new EditContext(FormData);

            _messageStore =
                new ValidationMessageStore(_editContext);

            SaveError = string.Empty;
            IsSubmitting = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (_editContext == null ||
            _messageStore == null)
        {
            return;
        }

        _messageStore.Clear();
        _editContext.NotifyValidationStateChanged();

        var isDataAnnotationValid =
            _editContext.Validate();

        FormData.TenKieuDang =
            FormData.TenKieuDang?.Trim()
            ?? string.Empty;

        FormData.MoTa =
            FormData.MoTa?.Trim()
            ?? string.Empty;

        var hasManualError = false;

        if (string.IsNullOrWhiteSpace(
            FormData.TenKieuDang))
        {
            AddFieldError(
                nameof(FormData.TenKieuDang),
                "Tên kiểu dáng không được để trống."
            );

            hasManualError = true;
        }
        else if (FormData.TenKieuDang.Length > 50)
        {
            AddFieldError(
                nameof(FormData.TenKieuDang),
                "Tên kiểu dáng không vượt quá 50 ký tự."
            );

            hasManualError = true;
        }

        if (FormData.MoTa.Length > 250)
        {
            AddFieldError(
                nameof(FormData.MoTa),
                "Mô tả không vượt quá 250 ký tự."
            );

            hasManualError = true;
        }

        if (!isDataAnnotationValid ||
            hasManualError)
        {
            _editContext.NotifyValidationStateChanged();
            return;
        }

        IsSubmitting = true;
        SaveError = string.Empty;

        try
        {
            await OnSubmit.InvokeAsync();
        }
        catch (Exception ex)
        {
            SaveError =
                "Không thể lưu kiểu dáng: "
                + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void AddFieldError(
        string fieldName,
        string message)
    {
        if (_messageStore == null)
        {
            return;
        }

        var fieldIdentifier =
            new FieldIdentifier(
                FormData,
                fieldName
            );

        _messageStore.Add(
            fieldIdentifier,
            message
        );
    }

    private async Task CloseModal()
    {
        if (!IsSubmitting)
        {
            await OnClose.InvokeAsync();
        }
    }

    private void ClearError()
    {
        SaveError = string.Empty;
    }

    private bool HasError(string fieldName)
    {
        if (_editContext == null)
        {
            return false;
        }

        var fieldIdentifier =
            new FieldIdentifier(
                FormData,
                fieldName
            );

        return _editContext
            .GetValidationMessages(fieldIdentifier)
            .Any();
    }

    private string GetInputClass(string fieldName)
    {
        return HasError(fieldName)
            ? "modal-form-control input-invalid"
            : "modal-form-control";
    }

    private int GetNameLength()
    {
        return FormData.TenKieuDang?.Length ?? 0;
    }

    private int GetDescriptionLength()
    {
        return FormData.MoTa?.Length ?? 0;
    }
}