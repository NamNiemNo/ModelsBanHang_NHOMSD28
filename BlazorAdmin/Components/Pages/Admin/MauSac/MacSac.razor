@code {
    private List<MauSacDTO> danhSach = new();

    private string searchTerm = string.Empty;
    private string StatusFilter = "all";
    private string ErrorMessage = string.Empty;

    private int CurrentPage = 1;
    private int PageSize = 5;

    private bool IsLoading;
    private bool IsPopupVisible;
    private bool IsEdit;

    private MauSacDTO FormData = new();

    private bool IsConfirmVisible;
    private MauSacDTO? SelectedItem;

    private string? ToastMessage;
    private bool ToastSuccess;
    private int ToastVersion;

    private List<MauSacDTO> Filtered
    {
        get
        {
            IEnumerable<MauSacDTO> query = danhSach;

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var keyword = searchTerm.Trim();

                query = query.Where(x =>
                    (x.TenMau ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase)
                    ||
                    (x.MoTa ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase)
                    ||
                    (x.Color ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase));
            }

            query = StatusFilter switch
            {
                "active" => query.Where(x => x.TrangThai),
                "disabled" => query.Where(x => !x.TrangThai),
                _ => query
            };

            return query
                .OrderByDescending(x => x.TrangThai)
                .ThenBy(x => x.TenMau)
                .ToList();
        }
    }

    private List<MauSacDTO> PagedData =>
        Filtered
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                Filtered.Count / (double)PageSize));

    private IEnumerable<int> VisiblePages
    {
        get
        {
            var start = Math.Max(1, CurrentPage - 2);
            var end = Math.Min(TotalPages, start + 4);

            start = Math.Max(1, end - 4);

            return Enumerable.Range(
                start,
                end - start + 1);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;

        try
        {
            danhSach =
                await mauSacService.GetAllAsync()
                ?? new List<MauSacDTO>();

            CurrentPage = Math.Clamp(
                CurrentPage,
                1,
                TotalPages);
        }
        catch (Exception ex)
        {
            danhSach.Clear();

            ErrorMessage =
                "Không thể tải danh sách màu sắc: "
                + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void HandleSearch(ChangeEventArgs e)
    {
        searchTerm =
            e.Value?.ToString()
            ?? string.Empty;

        CurrentPage = 1;
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        CurrentPage = 1;
    }

    private void SetStatusFilter(string status)
    {
        StatusFilter = status;
        CurrentPage = 1;
    }

    private void ResetFilter()
    {
        searchTerm = string.Empty;
        StatusFilter = "all";
        CurrentPage = 1;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            PageSize = size;
            CurrentPage = 1;
        }
    }

    private void ShowAddForm()
    {
        IsEdit = false;

        FormData = new MauSacDTO
        {
            TenMau = string.Empty,
            MoTa = string.Empty,
            TrangThai = true,
            Color = "#000000"
        };

        IsPopupVisible = true;
    }

    private void ShowEditForm(MauSacDTO item)
    {
        IsEdit = true;

        // Tạo bản sao để khi bấm hủy không làm đổi dữ liệu bảng.
        FormData = new MauSacDTO
        {
            MauSacId = item.MauSacId,
            TenMau = item.TenMau,
            MoTa = item.MoTa,
            TrangThai = item.TrangThai,
            Color = GetSafeColor(item.Color)
        };

        IsPopupVisible = true;
    }

    private void ClosePopup()
    {
        IsPopupVisible = false;
    }

    private async Task SubmitForm()
    {
        try
        {
            FormData.TenMau = FormData.TenMau?.Trim() ?? "";
            FormData.MoTa = FormData.MoTa?.Trim() ?? "";

            if (IsEdit)
            {
                await mauSacService.UpdateAsync(FormData);
            }
            else
            {
                await mauSacService.CreateAsync(FormData);
            }

            danhSach = await mauSacService.GetAllAsync();
            IsPopupVisible = false;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Không thể lưu màu sắc: " + ex.Message
            );
        }
    }

    private void AskDelete(MauSacDTO item)
    {
        SelectedItem = item;
        IsConfirmVisible = true;
    }

    private void CloseDeletePopup()
    {
        IsConfirmVisible = false;
        SelectedItem = null;
    }

    private async Task ConfirmDelete()
    {
        if (SelectedItem == null)
            return;

        try
        {
            await mauSacService.DeleteAsync(SelectedItem.MauSacId);

            danhSach = await mauSacService.GetAllAsync();
            IsConfirmVisible = false;
            SelectedItem = null;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Không thể xóa màu sắc: " + ex.Message
            );
        }
    }

    private void ShowToast(string message, bool success)
    {
        ToastMessage = message;
        ToastSuccess = success;

        var version = ++ToastVersion;

        _ = HideToastAsync(version);
    }

    private async Task HideToastAsync(int version)
    {
        await Task.Delay(3000);

        if (version == ToastVersion)
        {
            ToastMessage = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseToast()
    {
        ToastVersion++;
        ToastMessage = null;
    }

    private static string GetSafeColor(string? color)
    {
        if (!string.IsNullOrWhiteSpace(color) &&
            color.Length == 7 &&
            color.StartsWith("#") &&
            color.Skip(1).All(Uri.IsHexDigit))
        {
            return color;
        }

        return "#000000";
    }
}