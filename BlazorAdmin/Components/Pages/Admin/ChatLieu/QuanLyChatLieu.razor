@code {
    private List<ChatLieu> DanhSachChatLieu = new();

    private string SearchText = string.Empty;
    private string StatusFilter = "all";
    private string ErrorMessage = string.Empty;

    private bool IsLoading;
    private bool IsModalOpen;
    private bool IsEdit;

    private string TenChatLieu = string.Empty;
    private string MoTa = string.Empty;
    private bool TrangThai = true;

    private Guid? EditingId;

    /*
     * Thuộc tính trung gian này giúp sửa lỗi:
     * Component attributes do not support complex content.
     */
    private List<string> DanhSachTenChatLieu =>
        DanhSachChatLieu
            .Where(x => !string.IsNullOrWhiteSpace(x.TenChatLieu))
            .Select(x => x.TenChatLieu!)
            .ToList();

    private IEnumerable<ChatLieu> FilteredChatLieus
    {
        get
        {
            IEnumerable<ChatLieu> query = DanhSachChatLieu;

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var keyword = SearchText.Trim();

                query = query.Where(x =>
                    (x.TenChatLieu ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase
                        )
                    ||
                    (x.MoTa ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase
                        )
                );
            }

            query = StatusFilter switch
            {
                "active" => query.Where(x => x.TrangThai),

                "disabled" => query.Where(x => !x.TrangThai),

                _ => query
            };

            return query
                .OrderByDescending(x => x.TrangThai)
                .ThenBy(x => x.TenChatLieu);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;

        try
        {
            DanhSachChatLieu =
                await ChatLieuService.GetAllAsync()
                ?? new List<ChatLieu>();
        }
        catch (Exception ex)
        {
            DanhSachChatLieu.Clear();

            ErrorMessage =
                "Không thể tải danh sách chất liệu: "
                + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void HandleSearch(ChangeEventArgs e)
    {
        SearchText =
            e.Value?.ToString()
            ?? string.Empty;
    }

    private void ClearSearch()
    {
        SearchText = string.Empty;
    }

    private void SetStatusFilter(string status)
    {
        StatusFilter = status;
    }

    private void ResetFilter()
    {
        SearchText = string.Empty;
        StatusFilter = "all";
    }

    private void ShowModal()
    {
        IsEdit = false;
        EditingId = null;

        TenChatLieu = string.Empty;
        MoTa = string.Empty;
        TrangThai = true;

        IsModalOpen = true;
    }

    private void EditChatLieu(ChatLieu item)
    {
        IsEdit = true;
        EditingId = item.ChatLieuId;

        TenChatLieu =
            item.TenChatLieu
            ?? string.Empty;

        MoTa =
            item.MoTa
            ?? string.Empty;

        TrangThai = item.TrangThai;

        IsModalOpen = true;
    }

    private void CloseModal()
    {
        IsModalOpen = false;
    }

    private async Task HandleSave(
        (
            string TenChatLieu,
            string MoTa,
            bool TrangThai
        ) result)
    {
        if (IsEdit && EditingId.HasValue)
        {
            var updated = new ChatLieu
                {
                    ChatLieuId = EditingId.Value,
                    TenChatLieu = result.TenChatLieu,
                    MoTa = result.MoTa,
                    TrangThai = result.TrangThai
                };

            await ChatLieuService.UpdateAsync(updated);
        }
        else
        {
            var newItem = new ChatLieu
                {
                    TenChatLieu = result.TenChatLieu,
                    MoTa = result.MoTa,
                    TrangThai = result.TrangThai
                };

            await ChatLieuService.CreateAsync(newItem);
        }

        CloseModal();
        await LoadDataAsync();
    }

    private static string GetFirstLetter(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        return name.Trim()[0]
            .ToString()
            .ToUpperInvariant();
    }
