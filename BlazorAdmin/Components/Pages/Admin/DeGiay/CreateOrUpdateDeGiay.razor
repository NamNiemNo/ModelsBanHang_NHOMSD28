@using API.Models.DTO
@using Microsoft.AspNetCore.Components.Forms

@if (IsVisible && _editContext != null)
{
    <div class="sole-modal-overlay"
         @onclick="CloseModal">

        <div class="sole-modal"
             role="dialog"
             aria-modal="true"
             @onclick:stopPropagation="true">

            <EditForm EditContext="_editContext"
                      OnSubmit="HandleSubmit">

                <DataAnnotationsValidator />

                <!-- Tiêu đề -->
                <header class="sole-modal-header">

                    <div class="modal-header-icon">
                        @if (IsEdit)
                        {
                            <svg viewBox="0 0 24 24">
                                <path d="M4 20h4L19 9l-4-4L4 16v4Z" />
                                <path d="m13 7 4 4" />
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                        }
                    </div>

                    <div>
                        <span class="modal-eyebrow">
                            @(IsEdit
                                ? "CẬP NHẬT DỮ LIỆU"
                                : "TẠO MỚI")
                        </span>

                        <h2>
                            @(IsEdit
                                ? "Chỉnh sửa đế giày"
                                : "Thêm đế giày")
                        </h2>

                        <p>
                            Điền đầy đủ thông tin đế giày bên dưới.
                        </p>
                    </div>

                    <button type="button"
                            class="modal-close-button"
                            title="Đóng"
                            @onclick="CloseModal">
                        ×
                    </button>
                </header>

                <!-- Nội dung -->
                <div class="sole-modal-body">

                    <!-- Tên đế giày -->
                    <div class="modal-form-group">
                        <div class="form-label-row">
                            <label for="sole-name">
                                Tên đế giày
                                <span>*</span>
                            </label>

                            <small>
                                @GetNameLength()/50
                            </small>
                        </div>

                        <InputText id="sole-name"
                                   class="@GetInputClass(
                                       nameof(FormData.TenDeGiay))"
                                   placeholder="Ví dụ: Đế cao su, Đế EVA..."
                                   maxlength="50"
                                   @bind-Value="FormData.TenDeGiay" />

                        <ValidationMessage For="@(() => FormData.TenDeGiay)"
                                           class="validation-message" />
                    </div>

                    <!-- Mô tả -->
                    <div class="modal-form-group">
                        <div class="form-label-row">
                            <label for="sole-description">
                                Mô tả
                            </label>

                            <small>
                                @GetDescriptionLength()/250
                            </small>
                        </div>

                        <InputTextArea id="sole-description"
                                       class="@GetInputClass(
                                           nameof(FormData.MoTa))"
                                       placeholder="Nhập mô tả về đế giày..."
                                       maxlength="250"
                                       rows="4"
                                       @bind-Value="FormData.MoTa" />

                        <ValidationMessage For="@(() => FormData.MoTa)"
                                           class="validation-message" />
                    </div>

                    <!-- Trạng thái -->
                    <div class="status-form-card">
                        <div>
                            <strong>Trạng thái hoạt động</strong>

                            <span>
                                @(FormData.TrangThai
                                    ? "Đế giày đang được sử dụng"
                                    : "Đế giày đã ngừng sử dụng")
                            </span>
                        </div>

                        <label class="sole-switch">
                            <InputCheckbox @bind-Value="FormData.TrangThai" />

                            <span class="switch-slider"></span>
                        </label>
                    </div>
                </div>

                <!-- Nút thao tác -->
                <footer class="sole-modal-footer">

                    <button type="button"
                            class="modal-cancel-button"
                            disabled="@IsSubmitting"
                            @onclick="CloseModal">
                        Hủy
                    </button>

                    <button type="submit"
                            class="modal-save-button"
                            disabled="@IsSubmitting">

                        @if (IsSubmitting)
                        {
                            <span class="button-spinner"></span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24">
                                <path d="M5 4h12l2 2v14H5z" />
                                <path d="M8 4v6h8V4M8 20v-6h8v6" />
                            </svg>

                            <span>
                                @(IsEdit
                                    ? "Lưu thay đổi"
                                    : "Thêm đế giày")
                            </span>
                        }
                    </button>
                </footer>
            </EditForm>
        </div>
    </div>
}

<style>
    .sole-modal-overlay,
    .sole-modal-overlay * {
        box-sizing: border-box;
    }

    .sole-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(15, 23, 42, 0.62);
        backdrop-filter: blur(4px);
        animation: soleModalFadeIn 0.2s ease;
    }

    .sole-modal {
        width: min(560px, 100%);
        max-height: 94vh;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 25px 70px rgba(15, 23, 42, 0.3);
        animation: soleModalSlideUp 0.22s ease;
    }

        .sole-modal form {
            display: flex;
            max-height: 94vh;
            flex-direction: column;
        }

    /* Tiêu đề modal */

    .sole-modal-header {
        position: relative;
        display: flex;
        flex-shrink: 0;
        align-items: flex-start;
        gap: 13px;
        padding: 22px 65px 19px 22px;
        border-bottom: 1px solid #e8edf3;
        background: linear-gradient( 135deg, #ffffff, #fff7ed );
    }

    .modal-header-icon {
        display: grid;
        flex: 0 0 43px;
        width: 43px;
        height: 43px;
        place-items: center;
        border-radius: 12px;
        background: #f97316;
        color: #ffffff;
    }

        .modal-header-icon svg {
            width: 20px;
            height: 20px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .modal-eyebrow {
        display: block;
        margin-bottom: 5px;
        color: #ea580c;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.13em;
    }

    .sole-modal-header h2 {
        margin: 0;
        color: #0f172a;
        font-size: 19px;
        font-weight: 800;
    }

    .sole-modal-header p {
        margin: 5px 0 0;
        color: #64748b;
        font-size: 10px;
    }

    .modal-close-button {
        position: absolute;
        top: 18px;
        right: 18px;
        display: grid;
        width: 34px;
        height: 34px;
        padding: 0;
        place-items: center;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        background: #ffffff;
        color: #64748b;
        font-size: 22px;
        cursor: pointer;
    }

        .modal-close-button:hover {
            background: #fef2f2;
            color: #dc2626;
        }

    /* Nội dung */

    .sole-modal-body {
        flex: 1;
        min-height: 0;
        padding: 22px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #94a3b8 #f1f5f9;
    }

    .modal-form-group {
        margin-bottom: 19px;
    }

    .form-label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
    }

        .form-label-row label {
            color: #334155;
            font-size: 11px;
            font-weight: 800;
        }

            .form-label-row label span {
                color: #ef4444;
            }

        .form-label-row small {
            color: #94a3b8;
            font-size: 9px;
        }

    .modal-form-control {
        width: 100%;
        padding: 0 13px;
        border: 1px solid #dce3ec;
        border-radius: 10px;
        outline: none;
        background: #f8fafc;
        color: #334155;
        font-size: 12px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    input.modal-form-control {
        height: 43px;
    }

    textarea.modal-form-control {
        min-height: 105px;
        padding-top: 12px;
        resize: vertical;
    }

    .modal-form-control:focus {
        border-color: #fb923c;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.1);
    }

    .modal-form-control.input-invalid {
        border-color: #ef4444;
        background: #fffafa;
    }

    .validation-message {
        display: block;
        margin-top: 6px;
        color: #dc2626;
        font-size: 10px;
    }

    /* Trạng thái */

    .status-form-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 15px;
        border: 1px solid #e8edf3;
        border-radius: 11px;
        background: #f8fafc;
    }

        .status-form-card strong,
        .status-form-card span {
            display: block;
        }

        .status-form-card strong {
            color: #334155;
            font-size: 11px;
        }

        .status-form-card > div > span {
            margin-top: 4px;
            color: #94a3b8;
            font-size: 9px;
        }

    /* Công tắc */

    .sole-switch {
        position: relative;
        display: inline-block;
        flex: 0 0 46px;
        width: 46px;
        height: 25px;
    }

        .sole-switch input {
            width: 0;
            height: 0;
            opacity: 0;
        }

    .switch-slider {
        position: absolute;
        inset: 0;
        border-radius: 999px;
        background: #cbd5e1;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .switch-slider::before {
            position: absolute;
            bottom: 3px;
            left: 3px;
            width: 19px;
            height: 19px;
            border-radius: 50%;
            background: #ffffff;
            content: "";
            box-shadow: 0 2px 5px rgba(15, 23, 42, 0.2);
            transition: transform 0.2s ease;
        }

    .sole-switch input:checked + .switch-slider {
        background: #22c55e;
    }

        .sole-switch input:checked + .switch-slider::before {
            transform: translateX(21px);
        }

    /* Footer */

    .sole-modal-footer {
        display: flex;
        flex-shrink: 0;
        justify-content: flex-end;
        gap: 9px;
        padding: 14px 22px;
        border-top: 1px solid #e8edf3;
        background: #fbfcfe;
    }

    .modal-cancel-button,
    .modal-save-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 40px;
        padding: 0 16px;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 800;
        cursor: pointer;
    }

    .modal-cancel-button {
        border: 1px solid #dce3ec;
        background: #ffffff;
        color: #64748b;
    }

    .modal-save-button {
        border: none;
        background: #f97316;
        color: #ffffff;
        box-shadow: 0 5px 12px rgba(249, 115, 22, 0.2);
    }

        .modal-save-button:hover:not(:disabled) {
            background: #ea580c;
        }

        .modal-save-button:disabled,
        .modal-cancel-button:disabled {
            opacity: 0.6;
            cursor: wait;
        }

        .modal-save-button svg {
            width: 16px;
            height: 16px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linejoin: round;
        }

    .button-spinner {
        width: 15px;
        height: 15px;
        border: 2px solid rgba(255, 255, 255, 0.45);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: soleButtonSpin 0.7s linear infinite;
    }

    @@keyframes soleModalFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes soleModalSlideUp {
        from {
            opacity: 0;
            transform: translateY(16px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes soleButtonSpin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 600px) {
        .sole-modal-overlay {
            padding: 10px;
        }

        .sole-modal {
            border-radius: 14px;
        }

        .sole-modal-header {
            padding: 18px 55px 16px 17px;
        }

        .sole-modal-body {
            padding: 17px;
        }

        .sole-modal-footer {
            padding: 12px 17px;
        }
    }
</style>

@code {
    [Parameter]
    public DeGiayDTO FormData { get; set; } = new();

    [Parameter]
    public List<DeGiayDTO> ExistingItems { get; set; } = new();

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }

    private EditContext? _editContext;
    private ValidationMessageStore? _messageStore;
    private DeGiayDTO? _currentModel;

    private bool IsSubmitting;

    protected override void OnParametersSet()
    {
        if (!IsVisible)
        {
            return;
        }

        /*
         * Chỉ tạo lại EditContext khi FormData thay đổi,
         * tránh reset dữ liệu khi người dùng đang nhập.
         */
        if (_editContext == null ||
            !ReferenceEquals(_currentModel, FormData))
        {
            _currentModel = FormData;

            FormData.TenDeGiay ??= string.Empty;
            FormData.MoTa ??= string.Empty;

            _editContext =
                new EditContext(FormData);

            _messageStore =
                new ValidationMessageStore(_editContext);
        }
    }

    private async Task HandleSubmit()
    {
        if (_editContext == null ||
            _messageStore == null)
        {
            return;
        }

        _messageStore.Clear();
        _editContext.NotifyValidationStateChanged();

        if (!_editContext.Validate())
        {
            return;
        }

        FormData.TenDeGiay =
            FormData.TenDeGiay?.Trim()
            ?? string.Empty;

        FormData.MoTa =
            FormData.MoTa?.Trim()
            ?? string.Empty;

        var isDuplicate =
            ExistingItems.Any(item =>
                item.DeGiayId != FormData.DeGiayId
                &&
                (item.TenDeGiay ?? string.Empty)
                    .Trim()
                    .Equals(
                        FormData.TenDeGiay,
                        StringComparison.OrdinalIgnoreCase
                    )
            );

        if (isDuplicate)
        {
            var fieldIdentifier =
                new FieldIdentifier(
                    FormData,
                    nameof(FormData.TenDeGiay)
                );

            _messageStore.Add(
                fieldIdentifier,
                "Tên đế giày đã tồn tại."
            );

            _editContext.NotifyValidationStateChanged();
            return;
        }

        IsSubmitting = true;

        try
        {
            await OnSubmit.InvokeAsync();
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task CloseModal()
    {
        if (!IsSubmitting)
        {
            await OnClose.InvokeAsync();
        }
    }

    private bool HasError(string fieldName)
    {
        if (_editContext == null)
        {
            return false;
        }

        var fieldIdentifier =
            new FieldIdentifier(
                FormData,
                fieldName
            );

        return _editContext
            .GetValidationMessages(fieldIdentifier)
            .Any();
    }

    private string GetInputClass(string fieldName)
    {
        return HasError(fieldName)
            ? "modal-form-control input-invalid"
            : "modal-form-control";
    }

    private int GetNameLength()
    {
        return FormData.TenDeGiay?.Length ?? 0;
    }

    private int GetDescriptionLength()
    {
        return FormData.MoTa?.Length ?? 0;
    }
}