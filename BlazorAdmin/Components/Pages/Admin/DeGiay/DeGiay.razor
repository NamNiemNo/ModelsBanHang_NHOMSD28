@page "/DeGiay"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@using API.Models.DTO
@using Data.Models
@inject IDeGiayService deGiayService
@inject IJSRuntime JS

<PageTitle>Quản lý đế giày</PageTitle>

<div class="sole-page">

    <!-- Tiêu đề -->
    <header class="sole-header">
        <div>
            <span class="page-eyebrow">QUẢN LÝ SẢN PHẨM</span>
            <h1>Quản lý đế giày</h1>
            <p>Thêm mới, chỉnh sửa và theo dõi trạng thái đế giày.</p>
        </div>

        <button type="button"
                class="add-sole-button"
                @onclick="ShowAddForm">
            <svg viewBox="0 0 24 24">
                <path d="M12 5v14M5 12h14" />
            </svg>

            Thêm đế giày
        </button>
    </header>

    <!-- Thống kê -->
    <section class="sole-statistics">

        <article class="sole-stat-card stat-total">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M4 16c4 0 7-2 9-7l2 5 5 2v4H4z" />
                </svg>
            </div>

            <div>
                <span>Tổng số đế giày</span>
                <strong>@danhSachDeGiay.Count</strong>
                <small>Tất cả đế giày trong hệ thống</small>
            </div>
        </article>

        <article class="sole-stat-card stat-active">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9" />
                    <path d="m8 12 3 3 5-6" />
                </svg>
            </div>

            <div>
                <span>Đang hoạt động</span>
                <strong>
                    @danhSachDeGiay.Count(x => x.TrangThai)
                </strong>
                <small>Đế giày đang được sử dụng</small>
            </div>
        </article>

        <article class="sole-stat-card stat-disabled">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9" />
                    <path d="m8 8 8 8M16 8l-8 8" />
                </svg>
            </div>

            <div>
                <span>Ngừng hoạt động</span>
                <strong>
                    @danhSachDeGiay.Count(x => !x.TrangThai)
                </strong>
                <small>Đế giày đã ngừng sử dụng</small>
            </div>
        </article>
    </section>

    <!-- Thông báo lỗi -->
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="page-error-message">
            <span>@ErrorMessage</span>

            <button type="button" @onclick="LoadDataAsync">
                Thử lại
            </button>
        </div>
    }

    <!-- Khung danh sách -->
    <section class="sole-panel">

        <!-- Tìm kiếm và bộ lọc -->
        <div class="sole-toolbar">

            <div class="sole-search">
                <svg viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-4-4" />
                </svg>

                <input type="text"
                       value="@searchTerm"
                       @oninput="HandleSearch"
                       placeholder="Tìm tên hoặc mô tả đế giày..." />

                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <button type="button"
                            class="clear-search-button"
                            title="Xóa tìm kiếm"
                            @onclick="ClearSearch">
                        ×
                    </button>
                }
            </div>

            <div class="status-filter-buttons">

                <button type="button"
                        class="status-filter-button @(StatusFilter == "all" ? "active" : "")"
                        @onclick='() => SetStatusFilter("all")'>
                    Tất cả
                    <span>@danhSachDeGiay.Count</span>
                </button>

                <button type="button"
                        class="status-filter-button @(StatusFilter == "active" ? "active" : "")"
                        @onclick='() => SetStatusFilter("active")'>
                    Hoạt động

                    <span>
                        @danhSachDeGiay.Count(x => x.TrangThai)
                    </span>
                </button>

                <button type="button"
                        class="status-filter-button @(StatusFilter == "disabled" ? "active" : "")"
                        @onclick='() => SetStatusFilter("disabled")'>
                    Ngừng hoạt động

                    <span>
                        @danhSachDeGiay.Count(x => !x.TrangThai)
                    </span>
                </button>
            </div>
        </div>

        <!-- Bảng dữ liệu -->
        <div class="sole-table-wrapper">
            <table class="sole-table">
                <thead>
                    <tr>
                        <th class="number-column">STT</th>
                        <th>Tên đế giày</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        <th class="action-column">Chức năng</th>
                    </tr>
                </thead>

                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="loading-state">
                                    <span class="loading-spinner"></span>
                                    <strong>Đang tải dữ liệu...</strong>
                                    <small>Vui lòng chờ trong giây lát</small>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (PagedData.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <div class="empty-icon">
                                        <svg viewBox="0 0 24 24">
                                            <path d="M4 16c4 0 7-2 9-7l2 5 5 2v4H4z" />
                                        </svg>
                                    </div>

                                    <strong>Không tìm thấy đế giày</strong>

                                    <small>
                                        Hãy thử từ khóa hoặc bộ lọc khác.
                                    </small>

                                    <button type="button"
                                            @onclick="ResetFilter">
                                        Đặt lại bộ lọc
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in PagedData
                            .Select((item, index) => new
                            {
                                Item = item,
                                Number =
                                    (CurrentPage - 1) * PageSize
                                    + index + 1
                            }))
                        {
                            <tr>
                                <td class="table-number">
                                    @row.Number
                                </td>

                                <td>
                                    <div class="sole-name-cell">
                                        <span class="sole-avatar">
                                            @GetFirstLetter(
                                                row.Item.TenDeGiay
                                            )
                                        </span>

                                        <div>
                                            <strong>
                                                @row.Item.TenDeGiay
                                            </strong>

                                            <small>
                                                Đế giày sản phẩm
                                            </small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="sole-description"
                                         title="@row.Item.MoTa">

                                        @(string.IsNullOrWhiteSpace(
                                            row.Item.MoTa)
                                            ? "Chưa có mô tả"
                                            : row.Item.MoTa)
                                    </div>
                                </td>

                                <td>
                                    <span class="sole-status @(row.Item.TrangThai ? "status-active" : "status-disabled")">

                                        <span class="status-dot"></span>

                                        @(row.Item.TrangThai
                                            ? "Đang hoạt động"
                                            : "Ngừng hoạt động")
                                    </span>
                                </td>

                                <td>
                                    <div class="table-actions">

                                        <button type="button"
                                                class="table-action-button edit-button"
                                                title="Chỉnh sửa"
                                                @onclick="() => ShowEditForm(row.Item)">

                                            <svg viewBox="0 0 24 24">
                                                <path d="M4 20h4L19 9l-4-4L4 16v4Z" />
                                                <path d="m13 7 4 4" />
                                            </svg>

                                            Sửa
                                        </button>

                                        <button type="button"
                                                class="table-action-button delete-button"
                                                title="Xóa"
                                                @onclick="() => AskDelete(row.Item)">

                                            <svg viewBox="0 0 24 24">
                                                <path d="M4 7h16M9 7V4h6v3" />
                                                <path d="m6 7 1 13h10l1-13" />
                                                <path d="M10 11v5M14 11v5" />
                                            </svg>

                                            Xóa
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        <footer class="sole-table-footer">

            <div class="page-size-control">
                <span>Hiển thị</span>

                <select value="@PageSize"
                        @onchange="OnPageSizeChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                </select>

                <span>
                    / @FilteredList.Count đế giày
                </span>
            </div>

            <nav class="sole-pagination">
                <button type="button"
                        class="pagination-button pagination-arrow"
                        disabled="@(CurrentPage == 1)"
                        @onclick="() => ChangePage(1)">
                    «
                </button>

                <button type="button"
                        class="pagination-button pagination-arrow"
                        disabled="@(CurrentPage == 1)"
                        @onclick="() => ChangePage(CurrentPage - 1)">
                    ‹
                </button>

                @foreach (var page in VisiblePages)
                {
                    <button type="button"
                            class="pagination-button @(CurrentPage == page ? "active" : "")"
                            @onclick="() => ChangePage(page)">
                        
                    </button>
                }

                <button type="button"
                        class="pagination-button pagination-arrow"
                        disabled="@(CurrentPage == TotalPages)"
                        @onclick="() => ChangePage(CurrentPage + 1)">
                    ›
                </button>

                <button type="button"
                        class="pagination-button pagination-arrow"
                        disabled="@(CurrentPage == TotalPages)"
                        @onclick="() => ChangePage(TotalPages)">
                    »
                </button>
            </nav>
        </footer>
    </section>

    <!-- Component thêm/sửa -->
    <CreateOrUpdateDeGiay FormData="@FormData"
                          ExistingItems="@danhSachDeGiay"
                          IsVisible="@IsPopupVisible"
                          IsEdit="@IsEdit"
                          OnSubmit="SubmitForm"
                          OnClose="ClosePopup" />

    <!-- Component xác nhận xóa -->
    <DeleteDeGiay Item="@SelectedItem"
                  IsVisible="@IsConfirmVisible"
                  OnDelete="ConfirmDelete"
                  OnCancel="@(() => IsConfirmVisible = false)" />

    <!-- Toast -->
    @if (!string.IsNullOrWhiteSpace(ToastMessage))
    {
        <div class="custom-toast @(ToastSuccess ? "toast-success" : "toast-error")">
            <div class="toast-icon">
                @(ToastSuccess ? "✓" : "!")
            </div>

            <div class="toast-content">
                <strong>
                    @(ToastSuccess ? "Thành công" : "Thông báo")
                </strong>

                <span>@ToastMessage</span>
            </div>

            <button type="button"
                    class="toast-close"
                    @onclick="CloseToast">
                ×
            </button>
        </div>
    }
</div>

<style>
    .sole-page,
    .sole-page * {
        box-sizing: border-box;
    }

    .sole-page {
        --primary: #f97316;
        --primary-dark: #ea580c;
        --primary-light: #fff7ed;
        --text-dark: #0f172a;
        --text: #334155;
        --muted: #64748b;
        --border: #e8edf3;

        min-height: 100vh;
        padding: 28px;
        background: #f6f8fb;
        color: var(--text-dark);
    }

    /* Tiêu đề */

    .sole-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 24px;
    }

    .page-eyebrow {
        display: block;
        margin-bottom: 6px;
        color: var(--primary-dark);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.14em;
    }

    .sole-header h1 {
        margin: 0;
        color: var(--text-dark);
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .sole-header p {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 13px;
    }

    .add-sole-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        min-height: 44px;
        padding: 0 18px;

        border: none;
        border-radius: 11px;
        background: var(--primary);
        color: #ffffff;

        font-size: 12px;
        font-weight: 800;
        cursor: pointer;

        box-shadow: 0 6px 15px rgba(249, 115, 22, 0.22);

        transition:
            background 0.2s ease,
            transform 0.2s ease;
    }

    .add-sole-button:hover {
        background: var(--primary-dark);
        transform: translateY(-1px);
    }

    .add-sole-button svg {
        width: 18px;
        height: 18px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
    }

    /* Thống kê */

    .sole-statistics {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .sole-stat-card {
        display: flex;
        align-items: center;
        gap: 15px;
        min-width: 0;
        padding: 20px;

        border: 1px solid var(--border);
        border-radius: 16px;
        background: #ffffff;

        box-shadow: 0 6px 24px rgba(15, 23, 42, 0.045);
    }

    .stat-icon {
        display: grid;
        flex: 0 0 50px;
        width: 50px;
        height: 50px;
        place-items: center;

        border-radius: 14px;
        background: currentColor;
    }

    .stat-icon svg {
        width: 24px;
        height: 24px;
        fill: none;
        stroke: #ffffff;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .sole-stat-card > div:last-child {
        min-width: 0;
    }

    .sole-stat-card span,
    .sole-stat-card small {
        display: block;
    }

    .sole-stat-card span {
        margin-bottom: 4px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 700;
    }

    .sole-stat-card strong {
        display: block;
        margin-bottom: 3px;
        color: var(--text-dark);
        font-size: 25px;
    }

    .sole-stat-card small {
        overflow: hidden;
        color: #94a3b8;
        font-size: 10px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .stat-total {
        color: #6366f1;
    }

    .stat-active {
        color: #10b981;
    }

    .stat-disabled {
        color: #94a3b8;
    }

    /* Panel */

    .sole-panel {
        display: flex;
        height: 620px;
        min-height: 470px;
        flex-direction: column;
        overflow: hidden;

        border: 1px solid var(--border);
        border-radius: 18px;
        background: #ffffff;

        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.05);
    }

    /* Toolbar */

    .sole-toolbar {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: space-between;
        gap: 20px;

        padding: 18px 20px;
        border-bottom: 1px solid var(--border);
    }

    .sole-search {
        position: relative;
        width: min(100%, 480px);
    }

    .sole-search > svg {
        position: absolute;
        top: 50%;
        left: 14px;

        width: 18px;
        height: 18px;

        transform: translateY(-50%);
        fill: none;
        stroke: #94a3b8;
        stroke-width: 2;
        pointer-events: none;
    }

    .sole-search input {
        width: 100%;
        height: 44px;
        padding: 0 43px;

        border: 1px solid #dce3ec;
        border-radius: 11px;
        outline: none;

        background: #f8fafc;
        color: var(--text-dark);
        font-size: 12px;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .sole-search input:focus {
        border-color: #fb923c;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.1);
    }

    .clear-search-button {
        position: absolute;
        top: 50%;
        right: 10px;

        display: grid;
        width: 28px;
        height: 28px;
        padding: 0;

        transform: translateY(-50%);
        place-items: center;

        border: none;
        border-radius: 8px;
        background: transparent;
        color: #94a3b8;

        font-size: 19px;
        cursor: pointer;
    }

    .clear-search-button:hover {
        background: #eef2f7;
        color: #475569;
    }

    /* Lọc trạng thái */

    .status-filter-buttons {
        display: flex;
        gap: 6px;
        overflow-x: auto;
    }

    .status-filter-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        min-height: 38px;
        padding: 0 11px;

        border: 1px solid #e2e8f0;
        border-radius: 9px;
        background: #ffffff;
        color: #64748b;

        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
    }

    .status-filter-button span {
        min-width: 20px;
        padding: 2px 6px;

        border-radius: 999px;
        background: #f1f5f9;

        font-size: 9px;
        text-align: center;
    }

    .status-filter-button.active {
        border-color: #fdba74;
        background: #fff7ed;
        color: #ea580c;
    }

    .status-filter-button.active span {
        background: #ffedd5;
    }

    /* Khung cuộn */

    .sole-table-wrapper {
        flex: 1;
        min-height: 0;
        overflow-x: auto;
        overflow-y: auto;

        scrollbar-width: thin;
        scrollbar-color: #94a3b8 #f1f5f9;
    }

    .sole-table-wrapper::-webkit-scrollbar {
        width: 10px;
        height: 10px;
    }

    .sole-table-wrapper::-webkit-scrollbar-track {
        background: #f1f5f9;
    }

    .sole-table-wrapper::-webkit-scrollbar-thumb {
        border: 2px solid #f1f5f9;
        border-radius: 10px;
        background: #94a3b8;
    }

    /* Bảng */

    .sole-table {
        width: 100%;
        min-width: 900px;

        border-collapse: separate;
        border-spacing: 0;

        color: #334155;
        font-size: 12px;
    }

    .sole-table th {
        position: sticky;
        top: 0;
        z-index: 5;

        padding: 14px;

        border-bottom: 1px solid var(--border);
        background: #f8fafc;
        color: #64748b;

        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-align: left;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .sole-table td {
        padding: 14px;
        border-bottom: 1px solid #edf1f5;
        background: #ffffff;
        vertical-align: middle;
    }

    .sole-table tbody tr:hover td {
        background: #fffaf5;
    }

    .number-column {
        width: 70px;
        text-align: center !important;
    }

    .action-column {
        width: 190px;
        text-align: center !important;
    }

    .table-number {
        color: #94a3b8;
        font-weight: 800;
        text-align: center;
    }

    /* Tên đế giày */

    .sole-name-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 190px;
    }

    .sole-avatar {
        display: grid;
        flex: 0 0 40px;
        width: 40px;
        height: 40px;
        place-items: center;

        border-radius: 11px;
        background: #fff7ed;
        color: #ea580c;

        font-size: 15px;
        font-weight: 900;
    }

    .sole-name-cell strong {
        display: block;
        color: #1e293b;
        font-size: 12px;
    }

    .sole-name-cell small {
        display: block;
        margin-top: 3px;
        color: #94a3b8;
        font-size: 10px;
    }

    .sole-description {
        display: -webkit-box;
        max-width: 500px;
        overflow: hidden;

        color: #64748b;
        line-height: 1.5;

        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    /* Trạng thái */

    .sole-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        min-height: 28px;
        padding: 0 10px;

        border: 1px solid transparent;
        border-radius: 999px;

        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    .status-active {
        border-color: #bbf7d0;
        background: #f0fdf4;
        color: #15803d;
    }

    .status-disabled {
        border-color: #e2e8f0;
        background: #f8fafc;
        color: #64748b;
    }

    /* Nút thao tác */

    .table-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
    }

    .table-action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;

        min-height: 33px;
        padding: 0 10px;

        border-radius: 8px;

        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
    }

    .table-action-button svg {
        width: 14px;
        height: 14px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .edit-button {
        border: 1px solid #c7d2fe;
        background: #eef2ff;
        color: #4f46e5;
    }

    .edit-button:hover {
        border-color: #818cf8;
        background: #e0e7ff;
    }

    .delete-button {
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: #dc2626;
    }

    .delete-button:hover {
        border-color: #f87171;
        background: #fee2e2;
    }

    /* Phân trang */

    .sole-table-footer {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: space-between;
        gap: 16px;

        min-height: 66px;
        padding: 12px 20px;

        border-top: 1px solid var(--border);
        background: #fbfcfe;
    }

    .page-size-control {
        display: flex;
        align-items: center;
        gap: 7px;

        color: #64748b;
        font-size: 11px;
    }

    .page-size-control select {
        height: 34px;
        padding: 0 27px 0 10px;

        border: 1px solid #dce3ec;
        border-radius: 8px;
        outline: none;

        background: #ffffff;
        color: #475569;

        font-size: 11px;
    }

    .sole-pagination {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .pagination-button {
        display: grid;
        width: 34px;
        height: 34px;
        padding: 0;
        place-items: center;

