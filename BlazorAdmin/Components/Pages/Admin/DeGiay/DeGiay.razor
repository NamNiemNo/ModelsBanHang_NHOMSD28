@code {
    private List<DeGiayDTO> danhSachDeGiay = new();

    private string searchTerm = string.Empty;
    private string StatusFilter = "all";
    private string ErrorMessage = string.Empty;

    private int CurrentPage = 1;
    private int PageSize = 5;

    private bool IsLoading;
    private bool IsPopupVisible;
    private bool IsEdit;

    private DeGiayDTO FormData = new();

    private bool IsConfirmVisible;
    private DeGiayDTO? SelectedItem;

    private string? ToastMessage;
    private bool ToastSuccess;

    private int ToastVersion;

    private List<DeGiayDTO> FilteredList
    {
        get
        {
            IEnumerable<DeGiayDTO> query =
                danhSachDeGiay;

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var keyword = searchTerm.Trim();

                query = query.Where(x =>
                    (x.TenDeGiay ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase
                        )
                    ||
                    (x.MoTa ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase
                        )
                );
            }

            query = StatusFilter switch
            {
                "active" =>
                    query.Where(x => x.TrangThai),

                "disabled" =>
                    query.Where(x => !x.TrangThai),

                _ => query
            };

            return query
                .OrderByDescending(x => x.TrangThai)
                .ThenBy(x => x.TenDeGiay)
                .ToList();
        }
    }

    private List<DeGiayDTO> PagedData =>
        FilteredList
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                FilteredList.Count / (double)PageSize
            )
        );

    private IEnumerable<int> VisiblePages
    {
        get
        {
            var start =
                Math.Max(1, CurrentPage - 2);

            var end =
                Math.Min(TotalPages, start + 4);

            start =
                Math.Max(1, end - 4);

            return Enumerable.Range(
                start,
                end - start + 1
            );
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;

        try
        {
            danhSachDeGiay =
                await deGiayService.GetAllAsync()
                ?? new List<DeGiayDTO>();

            CurrentPage =
                Math.Clamp(
                    CurrentPage,
                    1,
                    TotalPages
                );
        }
        catch (Exception ex)
        {
            danhSachDeGiay.Clear();

            ErrorMessage =
                "Không thể tải danh sách đế giày: "
                + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void HandleSearch(ChangeEventArgs e)
    {
        searchTerm =
            e.Value?.ToString()
            ?? string.Empty;

        CurrentPage = 1;
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        CurrentPage = 1;
    }

    private void SetStatusFilter(string status)
    {
        StatusFilter = status;
        CurrentPage = 1;
    }

    private void ResetFilter()
    {
        searchTerm = string.Empty;
        StatusFilter = "all";
        CurrentPage = 1;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(
            e.Value?.ToString(),
            out var newSize))
        {
            PageSize = newSize;
            CurrentPage = 1;
        }
    }

    private void ShowAddForm()
    {
        IsEdit = false;

        FormData = new DeGiayDTO
        {
            TenDeGiay = string.Empty,
            MoTa = string.Empty,
            TrangThai = true
        };

        IsPopupVisible = true;
    }

    private void ShowEditForm(DeGiayDTO item)
    {
        IsEdit = true;

        FormData = new DeGiayDTO
        {
            DeGiayId = item.DeGiayId,
            TenDeGiay = item.TenDeGiay,
            MoTa = item.MoTa,
            TrangThai = item.TrangThai
        };

        IsPopupVisible = true;
    }

    private void ClosePopup()
    {
        IsPopupVisible = false;
    }

    private async Task SubmitForm()
    {
        FormData.TenDeGiay =
            FormData.TenDeGiay?.Trim()
            ?? string.Empty;

        FormData.MoTa =
            FormData.MoTa?.Trim()
            ?? string.Empty;

        try
        {
            var result = IsEdit
                ? await deGiayService.UpdateAsync(FormData)
                : await deGiayService.CreateAsync(FormData);

            if (result)
            {
                ShowToast(
                    IsEdit
                        ? "Cập nhật đế giày thành công!"
                        : "Thêm đế giày thành công!",
                    true
                );

                ClosePopup();
                await LoadDataAsync();
            }
            else
            {
                ShowToast(
                    "Không thể lưu thông tin đế giày.",
                    false
                );
            }
        }
        catch (Exception ex)
        {
            ShowToast(
                "Đã xảy ra lỗi: " + ex.Message,
                false
            );
        }
    }

    private void AskDelete(DeGiayDTO item)
    {
        SelectedItem = item;
        IsConfirmVisible = true;
    }

    private async Task ConfirmDelete()
    {
        if (SelectedItem == null)
        {
            return;
        }

        try
        {
            var result =
                await deGiayService.DeleteAsync(
                    SelectedItem.DeGiayId
                );

            if (result)
            {
                ShowToast(
                    "Xóa đế giày thành công!",
                    true
                );

                await LoadDataAsync();
            }
            else
            {
                ShowToast(
                    "Xóa đế giày thất bại!",
                    false
                );
            }
        }
        catch (Exception ex)
        {
            ShowToast(
                "Không thể xóa: " + ex.Message,
                false
            );
        }
        finally
        {
            IsConfirmVisible = false;
            SelectedItem = null;
        }
    }

    private void ShowToast(
        string message,
        bool success)
    {
        ToastMessage = message;
        ToastSuccess = success;

        var currentVersion =
            ++ToastVersion;

        _ = HideToastAsync(currentVersion);
    }

    private async Task HideToastAsync(int version)
    {
        await Task.Delay(3000);

        if (version == ToastVersion)
        {
            ToastMessage = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseToast()
    {
        ToastVersion++;
        ToastMessage = null;
    }

    private static string GetFirstLetter(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        return name.Trim()[0]
            .ToString()
            .ToUpperInvariant();
    }
