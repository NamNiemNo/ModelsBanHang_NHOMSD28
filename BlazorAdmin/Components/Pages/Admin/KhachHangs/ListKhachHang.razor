@code {
    private List<KhachHang> khachHangs = new();

    private string searchKeyword = string.Empty;
    private string StatusFilter = "all";
    private string ErrorMessage = string.Empty;

    private int CurrentPage = 1;
    private int PageSize = 10;

    private bool IsLoading;

    private string? ToastMessage;
    private bool ToastSuccess;
    private int ToastVersion;

    private int SoKhachHangMoiTrongThang =>
        khachHangs.Count(x =>
            x.NgayTao.Month == DateTime.Now.Month &&
            x.NgayTao.Year == DateTime.Now.Year);

    private List<KhachHang> FilteredCustomers
    {
        get
        {
            IEnumerable<KhachHang> query = khachHangs;

            if (!string.IsNullOrWhiteSpace(searchKeyword))
            {
                var keyword = searchKeyword.Trim();

                query = query.Where(x =>
                    (x.HoTen ?? string.Empty).Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    (x.SoDienThoai ?? string.Empty).Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    (x.Email ?? string.Empty).Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase));
            }

            query = StatusFilter switch
            {
                "active" => query.Where(x => x.TrangThai),
                "disabled" => query.Where(x => !x.TrangThai),
                _ => query
            };

            return query
                .OrderByDescending(x => x.NgayTao)
                .ToList();
        }
    }

    private List<KhachHang> PagedCustomers =>
        FilteredCustomers
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                FilteredCustomers.Count / (double)PageSize));

    private IEnumerable<int> VisiblePages
    {
        get
        {
            var start = Math.Max(1, CurrentPage - 2);
            var end = Math.Min(TotalPages, start + 4);
            start = Math.Max(1, end - 4);

            return Enumerable.Range(
                start,
                end - start + 1);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;

        try
        {
            khachHangs =
                await service.GetAll()
                ?? new List<KhachHang>();

            CurrentPage = Math.Clamp(
                CurrentPage,
                1,
                TotalPages);
        }
        catch (Exception ex)
        {
            khachHangs.Clear();

            ErrorMessage =
                "Không thể tải danh sách khách hàng: "
                + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void HandleSearch(ChangeEventArgs e)
    {
        searchKeyword =
            e.Value?.ToString()
            ?? string.Empty;

        CurrentPage = 1;
    }

    private void ClearSearch()
    {
        searchKeyword = string.Empty;
        CurrentPage = 1;
    }

    private void SetStatusFilter(string status)
    {
        StatusFilter = status;
        CurrentPage = 1;
    }

    private void ResetFilter()
    {
        searchKeyword = string.Empty;
        StatusFilter = "all";
        CurrentPage = 1;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void ChangePageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            PageSize = size;
            CurrentPage = 1;
        }
    }

    private void NavigateToCreate()
    {
        manager.NavigateTo("/AddKhachHang");
    }

    private void NavigateToEdit(Guid id)
    {
        manager.NavigateTo($"/EditKhachHang/{id}");
    }

    private async Task ToggleTrangThai(Guid id)
    {
        var customer =
            khachHangs.FirstOrDefault(
                x => x.KhachHangId == id);

        if (customer == null)
        {
            return;
        }

        var newStatus = !customer.TrangThai;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            newStatus
                ? "Bạn có chắc muốn kích hoạt khách hàng này?"
                : "Bạn có chắc muốn ngừng hoạt động khách hàng này?");

        if (!confirmed)
        {
            return;
        }

        try
        {
            customer.TrangThai = newStatus;
            customer.NgayCapNhatCuoiCung = DateTime.Now;

            await service.Update(customer);
            await LoadDataAsync();

            ShowToast(
                "Cập nhật trạng thái thành công.",
                true);
        }
        catch (Exception ex)
        {
            customer.TrangThai = !newStatus;

            ShowToast(
                "Không thể cập nhật trạng thái: " + ex.Message,
                false);
        }
    }

    private void ShowToast(string message, bool success)
    {
        ToastMessage = message;
        ToastSuccess = success;

        var version = ++ToastVersion;
        _ = HideToastAsync(version);
    }

    private async Task HideToastAsync(int version)
    {
        await Task.Delay(3000);

        if (version == ToastVersion)
        {
            ToastMessage = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseToast()
    {
        ToastVersion++;
        ToastMessage = null;
    }

    private static string GetFirstLetter(string? name)
    {
        return string.IsNullOrWhiteSpace(name)
            ? "?"
            : name.Trim()[0].ToString().ToUpperInvariant();
    }

    private static string GetShortId(Guid id)
    {
        var value = id.ToString("N");

        return value[..Math.Min(8, value.Length)]
            .ToUpperInvariant();
    }
}