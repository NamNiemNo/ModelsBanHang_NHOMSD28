    private async Task HandleUploadAnhTheoMau(
        InputFileChangeEventArgs e,
        GiayChiTietTheoMauDTO color)
    {
        try
        {
            var file = e.File;

            if (!file.ContentType.StartsWith(
                "image/",
                StringComparison.OrdinalIgnoreCase))
            {
                SetError("Chỉ được chọn tệp hình ảnh.");
                return;
            }

            if (file.Size > 5 * 1024 * 1024)
            {
                SetError("Dung lượng ảnh tối đa là 5MB.");
                return;
            }

            var resized = await file.RequestImageFileAsync(
                "image/jpeg",
                700,
                700);

            await using var stream =
                resized.OpenReadStream(5 * 1024 * 1024);

            using var memory = new MemoryStream();

            await stream.CopyToAsync(memory);

            color.AnhDaTai =
                $"data:image/jpeg;base64," +
                Convert.ToBase64String(memory.ToArray());

            _errorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            SetError("Không thể đọc ảnh: " + ex.Message);
        }
    }

    private async Task HandleLuuToanBo()
    {
        if (_isSubmitting)
            return;

        try
        {
            _isSubmitting = true;
            _errorMessage = string.Empty;
            _successMessage = string.Empty;

            _giayModel.TenGiay =
                _giayModel.TenGiay?.Trim() ?? string.Empty;

            if (!ValidateForm())
                return;

            var allProducts =
                await _giayService.GetAllAsync();

            // Nếu trùng toàn bộ thuộc tính thì sử dụng sản phẩm cũ
            // để thêm hoặc cập nhật biến thể.
            var product = allProducts.FirstOrDefault(x =>
                string.Equals(
                    x.TenGiay?.Trim(),
                    _giayModel.TenGiay,
                    StringComparison.OrdinalIgnoreCase)
                && x.ThuongHieuId == _giayModel.ThuongHieuId
                && x.ChatLieuId == _giayModel.ChatLieuId
                && x.KieuDangId == _giayModel.KieuDangId
                && x.DeGiayId == _giayModel.DeGiayId
                && x.TheLoaiGiayId == _giayModel.TheLoaiGiayId);

            if (product == null)
            {
                product =
                    await _giayService.CreateAsync(_giayModel);

                if (product == null)
                {
                    SetError("Không thể tạo sản phẩm.");
                    return;
                }
            }

            var allDetails =
                await _giayChiTietService.GetAllAsync();

            var detailsToCreate =
                new List<GiayChiTietDTO>();

            foreach (var color in _danhSachChiTiet)
            {
                foreach (var size in color.ChiTietSizes)
                {
                    var existing = allDetails.FirstOrDefault(x =>
                        x.GiayId == product.GiayId
                        && x.MauSacId == color.MauSacId
                        && x.KichCoId == size.KichCoId);

                    if (existing != null)
                    {
                        var newPrice = (float)size.Gia;

                        if (Math.Abs(existing.Gia - newPrice) > 0.01f)
                        {
                            var sizeName = _danhSachKichCo
                                .FirstOrDefault(x =>
                                    x.KichCoId == size.KichCoId)
                                ?.size;

                            var confirmed =
                                await _jsRuntime.InvokeAsync<bool>(
                                    "confirm",
                                    $"Biến thể màu {color.TenMau} - size {sizeName} " +
                                    $"đã tồn tại với giá {existing.Gia:N0}đ.\n" +
                                    $"Bạn có muốn đổi thành {newPrice:N0}đ không?");

                            if (!confirmed)
                            {
                                SetError(
                                    $"Đã hủy cập nhật màu {color.TenMau}, size {sizeName}.");
                                return;
                            }

                            existing.Gia = newPrice;
                        }

                        existing.SoLuongCon += size.SoLuong;
                        existing.NgaySua = DateTime.Now;

                        await _giayChiTietService.UpdateAsync(
                            existing.GiayChiTietId,
                            existing);
                    }
                    else
                    {
                        detailsToCreate.Add(new GiayChiTietDTO
                            {
                                GiayId = product.GiayId,
                                MauSacId = color.MauSacId,
                                KichCoId = size.KichCoId,
                                Gia = (float)size.Gia,
                                SoLuongCon = size.SoLuong,
                                AnhGiay = color.AnhDaTai,
                                TrangThai = true,
                                NgayTao = DateTime.Now,
                                NgaySua = DateTime.Now
                            });
                    }
                }
            }

            if (detailsToCreate.Any())
            {
                var createdVariants =
                    await _giayChiTietService.CreateMultipleAsync(
                        detailsToCreate);

                foreach (var color in _danhSachChiTiet)
                {
                    if (string.IsNullOrWhiteSpace(color.AnhDaTai))
                        continue;

                    foreach (var size in color.ChiTietSizes)
                    {
                        var createdVariant = createdVariants
                            .FirstOrDefault(x =>
                                x.MauSacId == color.MauSacId
                                && x.KichCoId == size.KichCoId);

                        if (createdVariant == null)
                            continue;

                        var imageUrl =
                            await UploadImageToServerAsync(
                                color.AnhDaTai,
                                createdVariant.GiayChiTietId);

                        if (string.IsNullOrWhiteSpace(imageUrl))
                            continue;

                        createdVariant.AnhGiay = imageUrl;

                        await _giayChiTietService.UpdateAsync(
                            createdVariant.GiayChiTietId,
                            createdVariant);
                    }
                }
            }

            _successMessage = "Thêm sản phẩm thành công.";

            await InvokeAsync(StateHasChanged);
            await Task.Delay(800);

            _navigationManager.NavigateTo("/sanpham");
        }
        catch (Exception ex)
        {
            SetError("Không thể lưu sản phẩm: " + ex.Message);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private bool ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(_giayModel.TenGiay))
        {
            SetError("Tên sản phẩm không được để trống.");
            return false;
        }

        if (_giayModel.TenGiay.Length < 2)
        {
            SetError("Tên sản phẩm phải có ít nhất 2 ký tự.");
            return false;
        }

        if (_giayModel.TenGiay.Length > 100)
        {
            SetError("Tên sản phẩm không vượt quá 100 ký tự.");
            return false;
        }

        if (IsEmptyGuid(_giayModel.ThuongHieuId))
        {
            SetError("Vui lòng chọn thương hiệu.");
            return false;
        }

        if (IsEmptyGuid(_giayModel.ChatLieuId))
        {
            SetError("Vui lòng chọn chất liệu.");
            return false;
        }

        if (IsEmptyGuid(_giayModel.KieuDangId))
        {
            SetError("Vui lòng chọn kiểu dáng.");
            return false;
        }

        if (IsEmptyGuid(_giayModel.DeGiayId))
        {
            SetError("Vui lòng chọn đế giày.");
            return false;
        }

        if (IsEmptyGuid(_giayModel.TheLoaiGiayId))
        {
            SetError("Vui lòng chọn thể loại.");
            return false;
        }

        if (!_danhSachChiTiet.Any())
        {
            SetError("Vui lòng chọn ít nhất một màu sắc.");
            return false;
        }

        foreach (var color in _danhSachChiTiet)
        {
            if (!color.ChiTietSizes.Any())
            {
                _expandedColorId = color.MauSacId;

                SetError(
                    $"Màu {color.TenMau} chưa có kích cỡ.");
                return false;
            }

            var duplicatedSize = color.ChiTietSizes
                .Where(x => x.KichCoId != Guid.Empty)
                .GroupBy(x => x.KichCoId)
                .Any(group => group.Count() > 1);

            if (duplicatedSize)
            {
                _expandedColorId = color.MauSacId;

                SetError(
                    $"Màu {color.TenMau} đang có kích cỡ bị trùng.");
                return false;
            }

            foreach (var size in color.ChiTietSizes)
            {
                if (size.KichCoId == Guid.Empty)
                {
                    _expandedColorId = color.MauSacId;

                    SetError(
                        $"Màu {color.TenMau} chưa chọn kích cỡ.");
                    return false;
                }

                if (size.Gia <= 0)
                {
                    _expandedColorId = color.MauSacId;

                    SetError(
                        $"Giá của màu {color.TenMau} phải lớn hơn 0.");
                    return false;
                }

                if (size.SoLuong <= 0)
                {
                    _expandedColorId = color.MauSacId;

                    SetError(
                        $"Số lượng của màu {color.TenMau} phải lớn hơn 0.");
                    return false;
                }
            }
        }

        return true;
    }

    private static bool IsEmptyGuid(object? value)
    {
        if (value == null)
            return true;

        var text = value.ToString();

        return string.IsNullOrWhiteSpace(text)
               || !Guid.TryParse(text, out var id)
               || id == Guid.Empty;
    }

