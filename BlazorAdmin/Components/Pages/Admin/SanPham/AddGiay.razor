        var confirmed = await _jsRuntime.InvokeAsync<bool>(
            "confirm",
            "Bỏ toàn bộ màu sắc và biến thể đã nhập?");

        if (!confirmed)
            return;

        _danhSachChiTiet.Clear();
        _expandedColorId = null;
    }

    private void ToggleColorPanel(Guid colorId)
    {
        _expandedColorId =
