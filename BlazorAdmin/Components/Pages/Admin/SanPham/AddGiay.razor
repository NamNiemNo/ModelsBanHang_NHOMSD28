    private bool IsColorSelected(Guid colorId)
    {
        return _danhSachChiTiet.Any(x =>
            x.MauSacId == colorId);
    }

    private async Task ToggleMauSac(MauSacDTO color)
    {
        var existing = _danhSachChiTiet
            .FirstOrDefault(x => x.MauSacId == color.MauSacId);

        if (existing != null)
        {
            if (existing.ChiTietSizes.Any()
                || !string.IsNullOrWhiteSpace(existing.AnhDaTai))
            {
                var confirmed = await _jsRuntime.InvokeAsync<bool>(
                    "confirm",
                    $"Bỏ màu \"{existing.TenMau}\" và toàn bộ kích cỡ đã nhập?");

                if (!confirmed)
                    return;
            }

            _danhSachChiTiet.Remove(existing);

            if (_expandedColorId == existing.MauSacId)
            {
                _expandedColorId =
                    _danhSachChiTiet.FirstOrDefault()?.MauSacId;
            }
        }
        else
        {
            var newColor = new GiayChiTietTheoMauDTO
                {
                    MauSacId = color.MauSacId,
                    TenMau = color.TenMau ?? string.Empty,
                    ChiTietSizes = new List<GiayChiTietSizeDTO>
                {
                    new()
                    {
                        Gia = 100000,
                        SoLuong = 1
                    }
                }
                };

            _danhSachChiTiet.Add(newColor);
            _expandedColorId = newColor.MauSacId;
        }
    }

    private async Task RemoveSelectedColor(
        GiayChiTietTheoMauDTO color)
    {
        var colorOption = _danhSachMauCoBan
            .FirstOrDefault(x => x.MauSacId == color.MauSacId);

        if (colorOption != null)
        {
            await ToggleMauSac(colorOption);
