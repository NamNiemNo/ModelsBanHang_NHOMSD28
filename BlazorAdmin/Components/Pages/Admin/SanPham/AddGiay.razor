    private static string GetColorCode(string? color)
    {
        return string.IsNullOrWhiteSpace(color)
            ? "#cbd5e1"
            : color;
    }

    private static string GetProductInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "SP";

        var words = name.Trim()
            .Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
        {
            return words[0][0]
                .ToString()
                .ToUpperInvariant();
        }

        return string.Concat(
            words.First()[0],
            words.Last()[0])
            .ToUpperInvariant();
    }

