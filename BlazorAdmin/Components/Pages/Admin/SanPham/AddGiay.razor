@page "/AddGiay"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@using System.Linq
@using API.IService
@using API.Models.DTO
@using Data.Models
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IAnhService _anhService
@inject IMauSacService _mauSacService
@inject IGiayChiTietService _giayChiTietService
@inject IGiayService _giayService
@inject IThuongHieuService _thuongHieuService
@inject IChatLieuService _chatLieuService
@inject IKichCoService _kichCoService
@inject IDeGiayService _deGiayService
@inject ITheLoaiGiayService _theLoaiGiayService
@inject IKieuDangService _kieuDangService
@inject IJSRuntime _jsRuntime
@inject NavigationManager _navigationManager

<div class="add-product-page">

    <!-- HEADER -->
    <div class="page-header">
        <div class="header-left">
            <button type="button"
                    class="back-button"
                    title="Quay lại"
                    @onclick="HuyBo">
                ←
            </button>

            <div class="header-icon">＋</div>

            <div>
                <h2>Thêm sản phẩm mới</h2>
                <p>Tạo sản phẩm, màu sắc, kích cỡ và số lượng tồn kho</p>
            </div>
        </div>

        <button type="button"
                class="header-cancel"
                @onclick="HuyBo">
            Quay lại danh sách
        </button>
    </div>

    <!-- CÁC BƯỚC -->
    <div class="step-bar">

        <div class="step-item active">
            <span>1</span>
            <div>
                <strong>Thông tin chung</strong>
                <small>Tên và thuộc tính</small>
            </div>
        </div>

        <div class="step-line"></div>

        <div class="step-item @(_danhSachChiTiet.Any() ? "active" : "")">
            <span>2</span>
            <div>
                <strong>Biến thể</strong>
                <small>Màu, size và giá</small>
            </div>
        </div>

        <div class="step-line"></div>

        <div class="step-item @(_danhSachChiTiet.Any() && TotalVariants > 0 ? "active" : "")">
            <span>3</span>
            <div>
                <strong>Hoàn tất</strong>
                <small>Kiểm tra và lưu</small>
            </div>
        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="global-message error-message">
            <span class="message-icon">!</span>

            <div>
                <strong>Không thể tiếp tục</strong>
                <small>@_errorMessage</small>
            </div>

            <button type="button"
                    @onclick="CloseMessage">
                ×
            </button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="loading-card">
            <div class="loading-spinner"></div>
            <strong>Đang tải dữ liệu...</strong>
            <span>Đang tải màu sắc, kích cỡ và thuộc tính sản phẩm</span>
        </div>
    }
    else
    {
        <EditForm Model="@_giayModel"
                  OnValidSubmit="@HandleLuuToanBo"
                  FormName="AddGiayForm">

            <DataAnnotationsValidator />

            <div class="creation-layout">

                <div class="main-content">

                    <!-- THÔNG TIN CHUNG -->
                    <div class="form-card">

                        <div class="card-heading">
                            <div class="card-heading-icon">👟</div>

                            <div>
                                <h4>Thông tin chung</h4>
                                <p>
                                    Nhập thông tin cơ bản của sản phẩm
                                </p>
                            </div>
                        </div>

                        <div class="form-grid">

                            <!-- TÊN GIÀY -->
                            <div class="form-group full-width">
                                <label>
                                    Tên sản phẩm
                                    <span>*</span>
                                </label>

                                <div class="input-with-icon">
                                    <span>👟</span>

                                    <InputText class="form-control-custom"
                                               @bind-Value="_giayModel.TenGiay"
                                               placeholder="Ví dụ: Nike Air Force 1" />
                                </div>

                                <ValidationMessage For="@(() => _giayModel.TenGiay)" />
                            </div>

                            <!-- THƯƠNG HIỆU -->
                            <div class="form-group">
                                <label>
                                    Thương hiệu
                                    <span>*</span>
                                </label>

                                <InputSelect class="form-control-custom"
                                             @bind-Value="_giayModel.ThuongHieuId">

                                    <option value="">
                                        -- Chọn thương hiệu --
                                    </option>

                                    @foreach (var item in _thuongHieuOptions
                                .OrderBy(x => x.TenThuongHieu))
                                    {
                                        <option value="@item.ThuongHieuId">
                                            @item.TenThuongHieu
                                        </option>
                                    }

                                </InputSelect>
                            </div>

                            <!-- CHẤT LIỆU -->
                            <div class="form-group">
                                <label>
                                    Chất liệu
                                    <span>*</span>
                                </label>

                                <InputSelect class="form-control-custom"
                                             @bind-Value="_giayModel.ChatLieuId">

                                    <option value="">
                                        -- Chọn chất liệu --
                                    </option>

                                    @foreach (var item in _chatLieuOptions
                                .OrderBy(x => x.TenChatLieu))
                                    {
                                        <option value="@item.ChatLieuId">
                                            @item.TenChatLieu
                                        </option>
                                    }

                                </InputSelect>
                            </div>

                            <!-- KIỂU DÁNG -->
                            <div class="form-group">
                                <label>
                                    Kiểu dáng
                                    <span>*</span>
                                </label>

                                <InputSelect class="form-control-custom"
                                             @bind-Value="_giayModel.KieuDangId">

                                    <option value="">
                                        -- Chọn kiểu dáng --
                                    </option>

                                    @foreach (var item in _kieuDangOptions
                                .OrderBy(x => x.TenKieuDang))
                                    {
                                        <option value="@item.KieuDangId">
                                            @item.TenKieuDang
                                        </option>
                                    }

                                </InputSelect>
                            </div>

                            <!-- ĐẾ GIÀY -->
                            <div class="form-group">
                                <label>
                                    Đế giày
                                    <span>*</span>
                                </label>

                                <InputSelect class="form-control-custom"
                                             @bind-Value="_giayModel.DeGiayId">

                                    <option value="">
                                        -- Chọn đế giày --
                                    </option>

                                    @foreach (var item in _deGiayOptions
                                .OrderBy(x => x.TenDeGiay))
                                    {
                                        <option value="@item.DeGiayId">
                                            @item.TenDeGiay
                                        </option>
                                    }

                                </InputSelect>
                            </div>

                            <!-- THỂ LOẠI -->
                            <div class="form-group">
                                <label>
                                    Thể loại
                                    <span>*</span>
                                </label>

                                <InputSelect class="form-control-custom"
                                             @bind-Value="_giayModel.TheLoaiGiayId">

                                    <option value="">
                                        -- Chọn thể loại --
                                    </option>

                                    @foreach (var item in _theLoaiOptions
                                .OrderBy(x => x.TenTheLoai))
                                    {
                                        <option value="@item.TheLoaiGiayId">
                                            @item.TenTheLoai
                                        </option>
                                    }

                                </InputSelect>
                            </div>

                            <!-- TRẠNG THÁI -->
                            <div class="form-group">
                                <label>Trạng thái ban đầu</label>

                                <div class="status-switch-box">

                                    <label class="custom-switch">
                                        <input type="checkbox"
                                               @bind="_giayModel.TrangThai" />

                                        <span class="switch-slider"></span>
                                    </label>

                                    <div>
                                        <strong>
                                            @(_giayModel.TrangThai
                                                ? "Đang bán"
                                                : "Ngừng bán")
                                        </strong>

                                        <small>
                                            @(_giayModel.TrangThai
                                                ? "Sản phẩm được hiển thị"
                                                : "Sản phẩm tạm thời bị ẩn")
                                        </small>
                                    </div>

                                </div>
                            </div>

                        </div>

                    </div>

                    <!-- BIẾN THỂ -->
                    <div class="variant-section">

                        <div class="section-header">
                            <div>
                                <h3>Biến thể sản phẩm</h3>
                                <p>
                                    Chọn màu sắc, thêm kích cỡ, giá và số lượng
                                </p>
                            </div>

                            <div class="variant-count">
                                <strong>@TotalVariants</strong>
                                <span>biến thể</span>
                            </div>
                        </div>

                        <!-- CHỌN MÀU -->
                        <div class="color-selector-card">

                            <div class="color-toolbar">
                                <div>
                                    <h4>Chọn màu sắc</h4>
                                    <p>
                                        Đã chọn @_danhSachChiTiet.Count màu
                                    </p>
                                </div>

                                <div class="color-actions">
                                    <div class="color-search">
                                        <span>⌕</span>

                                        <input placeholder="Tìm màu..."
                                               @bind="_colorSearch"
                                               @bind:event="oninput" />
                                    </div>

                                    @if (_danhSachChiTiet.Any())
                                    {
                                        <button type="button"
                                                class="clear-color-button"
                                                @onclick="ClearSelectedColors">
                                            Bỏ chọn tất cả
                                        </button>
                                    }
                                </div>
                            </div>

                            @if (!FilteredColors.Any())
                            {
                                <div class="no-color-result">
                                    Không tìm thấy màu sắc phù hợp
                                </div>
                            }
                            else
                            {
                                <div class="color-grid">

                                    @foreach (var color in FilteredColors)
                                    {
                                        var isSelected =
                                        IsColorSelected(color.MauSacId);

                                        <label class="color-option @(isSelected ? "selected" : "")">

                                            <input type="checkbox"
                                                   checked="@isSelected"
                                                   @onchange="() => ToggleMauSac(color)" />

                                            <span class="color-circle"
                                                  style="background-color:@GetColorCode(color.Color)">
                                            </span>

                                            <span class="color-name">
                                                @color.TenMau
                                            </span>

                                            <span class="color-check">
                                                @(isSelected ? "✓" : "")
                                            </span>

                                        </label>
                                    }

                                </div>
                            }

                        </div>

                        <!-- CHƯA CHỌN MÀU -->
                        @if (!_danhSachChiTiet.Any())
                        {
                            <div class="variant-empty">
                                <div class="empty-icon">🎨</div>
                                <h4>Chưa chọn màu sắc</h4>
                                <p>
                                    Chọn ít nhất một màu để tạo biến thể sản phẩm
                                </p>
                            </div>
                        }
                        else
                        {
                            <!-- DANH SÁCH MÀU ĐÃ CHỌN -->
                            <div class="selected-color-list">

                                @foreach (var colorDetail in _danhSachChiTiet)
                                {
                                    <div class="color-variant-card"
                                         @key="colorDetail.MauSacId">

                                        <div class="variant-card-header">

                                            <button type="button"
                                                    class="variant-toggle"
                                                    @onclick="() => ToggleColorPanel(colorDetail.MauSacId)">

                                                <span class="selected-color-circle"
                                                      style="background-color:@GetSelectedColorCode(colorDetail.MauSacId)">
                                                </span>

                                                <div>
                                                    <strong>@colorDetail.TenMau</strong>

                                                    <small>
                                                        @colorDetail.ChiTietSizes.Count kích cỡ
                                                        ·
                                                        @colorDetail.ChiTietSizes.Sum(x => x.SoLuong) sản phẩm
                                                    </small>
                                                </div>

                                                <span class="expand-icon">
                                                    @(IsColorExpanded(colorDetail.MauSacId)
                                                        ? "⌃"
                                                        : "⌄")
                                                </span>

                                            </button>

                                            <button type="button"
                                                    class="remove-color-button"
                                                    title="Bỏ màu này"
                                                    @onclick="() => RemoveSelectedColor(colorDetail)">
                                                ×
                                            </button>

                                        </div>

                                        @if (IsColorExpanded(colorDetail.MauSacId))
                                        {
                                            <div class="variant-card-content">

                                                <!-- ẢNH -->
                                                <div class="image-size-layout">

                                                    <div class="image-upload-section">
                                                        <label class="field-title">
                                                            Ảnh sản phẩm màu @colorDetail.TenMau
                                                        </label>

                                                        @if (string.IsNullOrWhiteSpace(colorDetail.AnhDaTai))
                                                        {
                                                            <label class="upload-box">
                                                                <InputFile OnChange="@(e => HandleUploadAnhTheoMau(e, colorDetail))"
                                                                           accept="image/jpeg,image/png,image/webp" />

                                                                <span class="upload-icon">⇧</span>
                                                                <strong>Chọn ảnh sản phẩm</strong>
                                                                <small>
                                                                    JPG, PNG hoặc WEBP, tối đa 5MB
                                                                </small>
                                                            </label>
                                                        }
                                                        else
                                                        {
                                                            <div class="image-preview">
                                                                <img src="@colorDetail.AnhDaTai"
                                                                     alt="Ảnh màu @colorDetail.TenMau" />

                                                                <div class="image-overlay">

                                                                    <label title="Thay ảnh">
                                                                        <InputFile OnChange="@(e => HandleUploadAnhTheoMau(e, colorDetail))"
                                                                                   accept="image/jpeg,image/png,image/webp" />
                                                                        ✎
                                                                    </label>

                                                                    <button type="button"
                                                                            title="Xóa ảnh"
                                                                            @onclick="() => RemoveImage(colorDetail)">
                                                                        ×
                                                                    </button>

                                                                </div>
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="color-summary">
                                                        <span>Thông tin màu</span>

                                                        <div>
                                                            <small>Số kích cỡ</small>
                                                            <strong>
                                                                @colorDetail.ChiTietSizes.Count
                                                            </strong>
                                                        </div>

                                                        <div>
                                                            <small>Tổng tồn kho</small>
                                                            <strong>
                                                                @colorDetail.ChiTietSizes.Sum(x => x.SoLuong)
                                                            </strong>
                                                        </div>

                                                        <div>
                                                            <small>Khoảng giá</small>
                                                            <strong>
                                                                @GetColorPriceRange(colorDetail)
                                                            </strong>
                                                        </div>
                                                    </div>

                                                </div>

                                                <!-- SIZE -->
                                                <div class="size-section">

                                                    <div class="size-heading">
                                                        <div>
                                                            <h5>Danh sách kích cỡ</h5>
                                                            <p>
                                                                Mỗi kích cỡ chỉ được chọn một lần
                                                            </p>
                                                        </div>

                                                        <button type="button"
                                                                class="add-size-button"
                                                                @onclick="() => AddSize(colorDetail)">
                                                            ＋ Thêm size
                                                        </button>
                                                    </div>

                                                    @if (!colorDetail.ChiTietSizes.Any())
                                                    {
                                                        <div class="no-size">
                                                            Chưa có kích cỡ.
                                                            Nhấn “Thêm size” để tạo.
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="size-table-wrapper">

                                                            <table class="size-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Kích cỡ</th>
                                                                        <th>Giá bán</th>
                                                                        <th>Số lượng</th>
                                                                        <th>Thành tiền dự kiến</th>
                                                                        <th></th>
                                                                    </tr>
                                                                </thead>

                                                                <tbody>
                                                                    @foreach (var size in colorDetail.ChiTietSizes)
                                                                    {
                                                                        <tr @key="size">
                                                                            <td>
                                                                                <InputSelect class="size-input"
                                                                                             @bind-Value="size.KichCoId">

                                                                                    <option value="">
                                                                                        -- Chọn size --
                                                                                    </option>

                                                                                    @foreach (var sizeOption in _danhSachKichCo
                                                            .OrderBy(x => x.size))
                                                                                    {
                                                                                        var usedByOtherRow =
                                                                                        colorDetail.ChiTietSizes.Any(x =>
                                                                                        !ReferenceEquals(x, size)
                                                                                        && x.KichCoId == sizeOption.KichCoId);

                                                                                        <option value="@sizeOption.KichCoId"
                                                                                                disabled="@usedByOtherRow">
                                                                                            @sizeOption.size
                                                                                        </option>
                                                                                    }

                                                                                </InputSelect>
                                                                            </td>

                                                                            <td>
                                                                                <div class="money-input">
                                                                                    <InputNumber class="size-input"
                                                                                                 @bind-Value="size.Gia"
                                                                                                 min="1000"
                                                                                                 step="1000" />
                                                                                    <span>₫</span>
                                                                                </div>
                                                                            </td>

                                                                            <td>
                                                                                <InputNumber class="size-input quantity-input"
                                                                                             @bind-Value="size.SoLuong"
                                                                                             min="1" />
                                                                            </td>

                                                                            <td>
                                                                                <strong class="row-total">
                                                                                    @((size.Gia * size.SoLuong).ToString("N0")) ₫
                                                                                </strong>
                                                                            </td>

                                                                            <td>
                                                                                <button type="button"
                                                                                        class="remove-size-button"
                                                                                        title="Xóa kích cỡ"
                                                                                        @onclick="() => RemoveSize(colorDetail, size)">
                                                                                    ⌫
                                                                                </button>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>

                                                        </div>
                                                    }

                                                </div>

                                            </div>
                                        }

                                    </div>
                                }

                            </div>
                        }

                    </div>

                </div>

                <!-- TÓM TẮT -->
                <aside class="summary-card">

                    <div class="summary-title">
                        <span>☷</span>
                        Tóm tắt sản phẩm
                    </div>

                    <div class="summary-product">

                        <div class="summary-avatar">
                            @GetProductInitial(_giayModel.TenGiay)
                        </div>

                        <h3>
                            @(string.IsNullOrWhiteSpace(_giayModel.TenGiay)
                                ? "Sản phẩm mới"
                                : _giayModel.TenGiay)
                        </h3>

                        <span class="summary-status @(_giayModel.TrangThai ? "active" : "inactive")">
                            <i></i>
                            @(_giayModel.TrangThai
                                ? "Đang bán"
                                : "Ngừng bán")
                        </span>

                    </div>

                    <div class="summary-divider"></div>

                    <div class="attribute-summary">

                        <div>
                            <span>Thương hiệu</span>
                            <strong>@GetSelectedBrandName()</strong>
                        </div>

                        <div>
                            <span>Chất liệu</span>
                            <strong>@GetSelectedMaterialName()</strong>
                        </div>

                        <div>
                            <span>Thể loại</span>
                            <strong>@GetSelectedCategoryName()</strong>
                        </div>

                        <div>
                            <span>Kiểu dáng</span>
                            <strong>@GetSelectedStyleName()</strong>
                        </div>

                        <div>
                            <span>Đế giày</span>
                            <strong>@GetSelectedSoleName()</strong>
                        </div>

                    </div>

                    <div class="summary-divider"></div>

                    <div class="variant-stat-grid">

                        <div>
                            <span>Màu sắc</span>
                            <strong>@_danhSachChiTiet.Count</strong>
                        </div>

                        <div>
                            <span>Biến thể</span>
                            <strong>@TotalVariants</strong>
                        </div>

                        <div>
                            <span>Tồn kho</span>
                            <strong>@TotalStock</strong>
                        </div>

                        <div>
                            <span>Có ảnh</span>
                            <strong>@UploadedImageCount</strong>
                        </div>

                    </div>

                    <div class="price-summary">
                        <span>Khoảng giá sản phẩm</span>
                        <strong>@ProductPriceRange</strong>
                    </div>

                    <div class="summary-note">
                        <div>💡</div>
                        <p>
                            Kiểm tra kỹ màu sắc, kích cỡ, giá và số lượng
                            trước khi lưu sản phẩm.
                        </p>
                    </div>

                </aside>

            </div>

            <!-- ACTION -->
            <div class="bottom-actions">
                <div class="save-description">
                    <strong>Sẵn sàng tạo sản phẩm?</strong>
                    <span>
                        @_danhSachChiTiet.Count màu,
                        @TotalVariants biến thể,
                        @TotalStock sản phẩm trong kho
                    </span>
                </div>

                <div>
                    <button type="button"
                            class="cancel-button"
                            disabled="@_isSubmitting"
                            @onclick="HuyBo">
                        Hủy
                    </button>

                    <button type="submit"
                            class="save-button"
                            disabled="@_isSubmitting">

                        @if (_isSubmitting)
                        {
                            <span class="button-spinner"></span>
                            <span>Đang lưu sản phẩm...</span>
                        }
                        else
                        {
                            <span>✓</span>
                            <span>Lưu sản phẩm</span>
                        }

                    </button>
                </div>
            </div>

        </EditForm>
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="success-toast">
            <span class="toast-icon">✓</span>

            <div>
                <strong>Thành công</strong>
                <small>@_successMessage</small>
            </div>
        </div>
    }

</div>

@code {
    private GiayDTO _giayModel = new()
        {
            TrangThai = true,
            NgayTao = DateTime.Now
        };

    private List<ThuongHieu> _thuongHieuOptions = new();
    private List<ChatLieu> _chatLieuOptions = new();
    private List<KieuDangDTO> _kieuDangOptions = new();
    private List<TheLoaiGiayDTO> _theLoaiOptions = new();
    private List<DeGiayDTO> _deGiayOptions = new();

    private List<MauSacDTO> _danhSachMauCoBan = new();
    private List<KichCoDTO> _danhSachKichCo = new();
    private List<GiayChiTietTheoMauDTO> _danhSachChiTiet = new();

    private bool _isLoading = true;
    private bool _isSubmitting;

    private string _colorSearch = string.Empty;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;

    private Guid? _expandedColorId;

    private List<MauSacDTO> FilteredColors =>
        _danhSachMauCoBan
            .Where(x =>
                string.IsNullOrWhiteSpace(_colorSearch)
                || (x.TenMau ?? string.Empty)
                    .Contains(
                        _colorSearch,
                        StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.TenMau)
            .ToList();

    private int TotalVariants =>
        _danhSachChiTiet.Sum(x => x.ChiTietSizes.Count);

    private int TotalStock =>
        _danhSachChiTiet.Sum(x =>
            x.ChiTietSizes.Sum(size => size.SoLuong));

    private int UploadedImageCount =>
        _danhSachChiTiet.Count(x =>
            !string.IsNullOrWhiteSpace(x.AnhDaTai));

    private string ProductPriceRange
    {
        get
        {
            var prices = _danhSachChiTiet
                .SelectMany(x => x.ChiTietSizes)
                .Where(x => x.Gia > 0)
                .Select(x => x.Gia)
                .ToList();

            if (!prices.Any())
                return "Chưa có giá";

            if (prices.Min() == prices.Max())
                return $"{prices.Min():N0} ₫";

            return $"{prices.Min():N0} - {prices.Max():N0} ₫";
        }
    }

