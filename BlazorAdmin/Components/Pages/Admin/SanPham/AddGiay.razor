    private void AddSize(GiayChiTietTheoMauDTO color)
    {
        var availableSize = _danhSachKichCo
            .OrderBy(x => x.size)
            .FirstOrDefault(option =>
                color.ChiTietSizes.All(x =>
                    x.KichCoId != option.KichCoId));

        color.ChiTietSizes.Add(new GiayChiTietSizeDTO
            {
                KichCoId = availableSize?.KichCoId ?? Guid.Empty,
                Gia = 100000,
                SoLuong = 1
            });

        _expandedColorId = color.MauSacId;
    }

