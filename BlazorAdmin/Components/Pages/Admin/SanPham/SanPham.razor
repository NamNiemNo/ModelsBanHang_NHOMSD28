@page "/sanpham"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@using API.Models.DTO

@inject IGiayService GiayService
@inject IGiayChiTietService GiayChiTietService
@inject NavigationManager NavigationManager

<div class="product-page">

    <!-- HEADER -->
    <div class="page-header">
        <div class="page-heading">
            <div class="heading-icon">👟</div>

            <div>
                <h2>Quản lý sản phẩm giày</h2>
                <p>Quản lý sản phẩm, biến thể và số lượng tồn kho</p>
            </div>
        </div>

        <button class="add-button" @onclick="NavigateToCreate">
            <span>＋</span>
            Thêm sản phẩm
        </button>
    </div>

    <!-- THỐNG KÊ -->
    <div class="stat-grid">

        <div class="stat-card">
            <div class="stat-icon total">📦</div>
            <div>
                <span>Tổng sản phẩm</span>
                <strong>@ListSanPham.Count</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon selling">✓</div>
            <div>
                <span>Đang bán</span>
                <strong>@ListSanPham.Count(x => x.TrangThai)</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stopped">⏸</div>
            <div>
                <span>Ngừng bán</span>
                <strong>@ListSanPham.Count(x => !x.TrangThai)</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon variant">◫</div>
            <div>
                <span>Tổng biến thể</span>
                <strong>@soLuongBienThe</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stock">▣</div>
            <div>
                <span>Tổng tồn kho</span>
                <strong>@tongSoLuongCon</strong>
            </div>
        </div>

    </div>

    <!-- DANH SÁCH SẢN PHẨM -->
    <div class="product-panel">

        <!-- TOOLBAR -->
        <div class="panel-toolbar">

            <div class="search-box">
                <span class="search-icon">⌕</span>

                <input placeholder="Tìm tên giày, thương hiệu, chất liệu..."
                       @bind="SearchText"
                       @bind:event="oninput" />

                @if (!string.IsNullOrWhiteSpace(SearchText))
                {
                    <button class="clear-search"
                            title="Xóa tìm kiếm"
                            @onclick="ClearSearch">
                        ×
                    </button>
                }
            </div>

            <div class="status-filters">

                <button class="status-filter @(statusFilter == "all" ? "active" : "")"
                        @onclick='() => SetStatusFilter("all")'>
                    Tất cả
                    <span>@ListSanPham.Count</span>
                </button>

                <button class="status-filter @(statusFilter == "selling" ? "active" : "")"
                        @onclick='() => SetStatusFilter("selling")'>
                    Đang bán
                    <span>@ListSanPham.Count(x => x.TrangThai)</span>
                </button>

                <button class="status-filter @(statusFilter == "stopped" ? "active" : "")"
                        @onclick='() => SetStatusFilter("stopped")'>
                    Ngừng bán
                    <span>@ListSanPham.Count(x => !x.TrangThai)</span>
                </button>

            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="error-alert">
                <span>!</span>
                <div>@errorMessage</div>
                <button @onclick="() => errorMessage = string.Empty">×</button>
            </div>
        }

        <!-- KHUNG BẢNG CÓ THANH CUỘN -->
        <div class="table-wrapper">

            <table class="product-table">
                <thead>
                    <tr>
                        <th class="col-stt">STT</th>
                        <th>Sản phẩm</th>
                        <th>Thương hiệu</th>
                        <th>Chất liệu</th>
                        <th>Thể loại</th>
                        <th>Đế giày</th>
                        <th>Kiểu dáng</th>
                        <th class="center">Biến thể</th>
                        <th class="center">Tồn kho</th>
                        <th>Ngày thêm</th>
                        <th class="center">Trạng thái</th>
                        <th class="col-action">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="12">
                                <div class="loading-state">
                                    <div class="loading-spinner"></div>
                                    <span>Đang tải danh sách sản phẩm...</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (!PagedList.Any())
                    {
                        <tr>
                            <td colspan="12">
                                <div class="empty-state">
                                    <div>🔎</div>
                                    <strong>Không tìm thấy sản phẩm</strong>
                                    <span>
                                        Hãy thử thay đổi từ khóa hoặc bộ lọc
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in PagedList.Select((item, index) => new
                        {
                            Item = item,
                            Index = index
                        }))
                        {
                            var item = row.Item;
                            var variantCount =
                            variantCountByGiay.GetValueOrDefault(item.GiayId);

                            var activeVariantCount =
                            activeVariantCountByGiay.GetValueOrDefault(item.GiayId);

                            var stock =
                            stockByGiay.GetValueOrDefault(item.GiayId);

                            <tr>
                                <td class="stt-cell">
                                    @((currentPage - 1) * pageSize + row.Index + 1)
                                </td>

                                <td>
                                    <div class="product-info">
                                        <div class="product-avatar">
                                            @GetProductInitial(item.TenGiay)
                                        </div>

                                        <div>
                                            <strong>@item.TenGiay</strong>
                                            <small title="@item.GiayId">
                                                @ShortId(item.GiayId)
                                            </small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="attribute-value">
                                        @(item.TenThuongHieu ?? "Chưa cập nhật")
                                    </span>
                                </td>

                                <td>
                                    <span class="attribute-value">
                                        @(item.TenChatLieu ?? "Chưa cập nhật")
                                    </span>
                                </td>

                                <td>
                                    <span class="attribute-value">
                                        @(item.TenTheLoaiGiay ?? "Chưa cập nhật")
                                    </span>
                                </td>

                                <td>
                                    <span class="attribute-value">
                                        @(item.TenDeGiay ?? "Chưa cập nhật")
                                    </span>
                                </td>

                                <td>
                                    <span class="attribute-value">
                                        @(item.TenKieuDang ?? "Chưa cập nhật")
                                    </span>
                                </td>

                                <td class="center">
                                    <div class="variant-value">
                                        <strong>@variantCount</strong>
                                        <small>@activeVariantCount hoạt động</small>
                                    </div>
                                </td>

                                <td class="center">
                                    <span class="@GetStockClass(stock)">
                                        @stock sản phẩm
                                    </span>
                                </td>

                                <td>
                                    <div class="date-value">
                                        <strong>
                                            @item.NgayTao.ToString("dd/MM/yyyy")
                                        </strong>
                                        <small>
                                            @item.NgayTao.ToString("HH:mm")
                                        </small>
                                    </div>
                                </td>

                                <td class="center">
                                    <button class="product-status @(item.TrangThai ? "status-selling" : "status-stopped")"
                                            title="Nhấn để chuyển trạng thái"
                                            disabled="@(updatingProductId == item.GiayId)"
                                            @onclick="() => ToggleTrangThai(item)">

                                        @if (updatingProductId == item.GiayId)
                                        {
                                            <span class="mini-spinner"></span>
                                        }
                                        else
                                        {
                                            <span class="status-dot"></span>
                                        }

                                        @(item.TrangThai
                                            ? "Đang bán"
                                            : "Ngừng bán")
                                    </button>
                                </td>

                                <td>
                                    <div class="action-group">

                                        <button class="action-button view"
                                                title="Xem chi tiết"
                                                @onclick="() => ViewProduct(item.GiayId)">
                                            ◉
                                        </button>

                                        <button class="action-button edit"
                                                title="Chỉnh sửa"
                                                @onclick="() => EditProduct(item.GiayId)">
                                            ✎
                                        </button>

                                        <button class="action-button delete"
                                                title="Xóa sản phẩm"
                                                @onclick="() => OpenDeleteModal(item)">
                                            ⌫
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>

        <!-- PHÂN TRANG -->
        <div class="pagination-bar">

            <div class="page-size">
                <span>Hiển thị</span>

                <select value="@pageSize"
                        @onchange="OnPageSizeChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>

                <span>sản phẩm</span>
            </div>

            <div class="result-info">
                Hiển thị
                <strong>@FirstDisplayedItem</strong>
                -
                <strong>@LastDisplayedItem</strong>
                trong
                <strong>@FilteredList.Count</strong>
                kết quả
            </div>

            <div class="pagination">

                <button disabled="@(currentPage == 1)"
                        @onclick="PreviousPage">
                    ‹
                </button>

                @foreach (var page in VisiblePages)
                {
                    var pageNumber = page;

                    <button class="@(pageNumber == currentPage ? "active" : "")"
                            @onclick="() => ChangePage(pageNumber)">
                        @pageNumber
                    </button>
                }

                <button disabled="@(currentPage == TotalPages)"
                        @onclick="NextPage">
                    ›
                </button>

            </div>

        </div>

    </div>

    <!-- MODAL XÓA -->
    @if (showDeleteModal && selectedProduct != null)
    {
        <div class="modal-overlay" @onclick="CloseDeleteModal">

            <div class="delete-modal"
                 @onclick:stopPropagation="true">

                <div class="delete-icon">!</div>

                <h3>Xóa sản phẩm?</h3>

                <p>
                    Bạn có chắc chắn muốn xóa sản phẩm
                    <strong>@selectedProduct.TenGiay</strong> không?
                </p>

                <div class="delete-warning">
                    Hành động này có thể không hoàn tác được.
                </div>

                <div class="modal-actions">
                    <button class="cancel-delete"
                            disabled="@isDeleting"
                            @onclick="CloseDeleteModal">
                        Hủy
                    </button>

                    <button class="confirm-delete"
                            disabled="@isDeleting"
                            @onclick="ConfirmDelete">

                        @if (isDeleting)
                        {
                            <span class="mini-spinner"></span>
                            <span>Đang xóa...</span>
                        }
                        else
                        {
                            <span>⌫</span>
                            <span>Xóa sản phẩm</span>
                        }

                    </button>
                </div>

            </div>
        </div>
    }

    <!-- TOAST -->
    @if (!string.IsNullOrWhiteSpace(toastMessage))
    {
        <div class="custom-toast @(toastSuccess ? "toast-success" : "toast-error")">
            <span class="toast-icon">
                @(toastSuccess ? "✓" : "!")
            </span>

            <div>
                <strong>
                    @(toastSuccess ? "Thành công" : "Có lỗi xảy ra")
                </strong>
                <small>@toastMessage</small>
            </div>

            <button @onclick="CloseToast">×</button>
        </div>
    }

</div>

@code {
    private List<GiayDTO> ListSanPham = new();

    private Dictionary<Guid, int> variantCountByGiay = new();
    private Dictionary<Guid, int> activeVariantCountByGiay = new();
    private Dictionary<Guid, int> stockByGiay = new();

    private string searchText = string.Empty;
    private string statusFilter = "all";
    private string errorMessage = string.Empty;

    private bool isLoading = true;
    private bool isDeleting;

    private Guid? updatingProductId;

    private int currentPage = 1;
    private int pageSize = 10;

    private int soLuongBienThe;
    private int tongSoLuongCon;

    private bool showDeleteModal;
    private GiayDTO? selectedProduct;

    private string toastMessage = string.Empty;
    private bool toastSuccess;

    private string SearchText
    {
        get => searchText;
        set
        {
            searchText = value;
            currentPage = 1;
        }
    }

    private List<GiayDTO> FilteredList =>
        ListSanPham
            .Where(x =>
                statusFilter == "all"
                || (statusFilter == "selling" && x.TrangThai)
                || (statusFilter == "stopped" && !x.TrangThai))
            .Where(x =>
                string.IsNullOrWhiteSpace(searchText)
                || (x.TenGiay ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || (x.TenThuongHieu ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || (x.TenChatLieu ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || (x.TenTheLoaiGiay ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || (x.TenDeGiay ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || (x.TenKieuDang ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private List<GiayDTO> PagedList =>
        FilteredList
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                (double)FilteredList.Count / pageSize));

    private IEnumerable<int> VisiblePages
    {
        get
        {
            const int maxVisible = 5;

            var start = Math.Max(
                1,
                currentPage - maxVisible / 2);

            var end = Math.Min(
                TotalPages,
                start + maxVisible - 1);

            start = Math.Max(
                1,
                end - maxVisible + 1);

            return Enumerable.Range(
                start,
                end - start + 1);
        }
    }

    private int FirstDisplayedItem =>
        FilteredList.Count == 0
            ? 0
            : (currentPage - 1) * pageSize + 1;

    private int LastDisplayedItem =>
        Math.Min(
            currentPage * pageSize,
            FilteredList.Count);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var products =
                await GiayService.GetAllAsync();

            var variants =
                await GiayChiTietService.GetAllAsync();

            soLuongBienThe = variants.Count;
            tongSoLuongCon =
                variants.Sum(x => x.SoLuongCon);

            variantCountByGiay = variants
                .GroupBy(x => x.GiayId)
                .ToDictionary(
                    group => group.Key,
                    group => group.Count());

            activeVariantCountByGiay = variants
                .GroupBy(x => x.GiayId)
                .ToDictionary(
                    group => group.Key,
                    group => group.Count(x => x.TrangThai));

            stockByGiay = variants
                .GroupBy(x => x.GiayId)
                .ToDictionary(
                    group => group.Key,
                    group => group.Sum(x => x.SoLuongCon));

            ListSanPham = products
                .OrderByDescending(x => x.NgayTao)
                .Select((item, index) =>
                {
                    item.STT = index + 1;
                    return item;
                })
                .ToList();

            await AutoSyncProductStatus(variants);

            EnsureValidPage();
        }
        catch (Exception ex)
        {
            errorMessage =
                "Không thể tải danh sách sản phẩm: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AutoSyncProductStatus(
        IEnumerable<dynamic> variants)
    {
        foreach (var product in ListSanPham)
        {
            var productVariants = variants
                .Where(x => x.GiayId == product.GiayId)
                .ToList();

            var stock = productVariants
                .Sum(x => (int)x.SoLuongCon);

            var hasActiveVariant = productVariants
                .Any(x => (bool)x.TrangThai);

            if (product.TrangThai
                && (stock <= 0 || !hasActiveVariant))
            {
                product.TrangThai = false;
                await GiayService.UpdateAsync(product);
            }
        }
    }

    private void NavigateToCreate()
    {
        NavigationManager.NavigateTo("/AddGiay");
    }

    private void ViewProduct(Guid productId)
    {
        NavigationManager.NavigateTo($"/Giay/{productId}");
    }

    private void EditProduct(Guid productId)
    {
        NavigationManager.NavigateTo($"/editgiay/{productId}");
    }

    private void OpenDeleteModal(GiayDTO product)
    {
        selectedProduct = product;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        if (isDeleting)
            return;

        showDeleteModal = false;
        selectedProduct = null;
    }

    private async Task ConfirmDelete()
    {
        if (selectedProduct == null || isDeleting)
            return;

        try
        {
            isDeleting = true;

            await GiayService.DeleteAsync(
                selectedProduct.GiayId);

            showDeleteModal = false;
            selectedProduct = null;

            await LoadData();

            ShowToast(
                "Đã xóa sản phẩm thành công.",
                true);
        }
        catch (Exception ex)
        {
            ShowToast(
                "Không thể xóa sản phẩm: " + ex.Message,
                false);
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task ToggleTrangThai(GiayDTO product)
    {
        if (updatingProductId.HasValue)
            return;

        var stock =
            stockByGiay.GetValueOrDefault(product.GiayId);

        var activeVariants =
            activeVariantCountByGiay.GetValueOrDefault(product.GiayId);

        if (!product.TrangThai && stock <= 0)
        {
            ShowToast(
                "Không thể bật trạng thái vì sản phẩm đã hết hàng.",
                false);
            return;
        }

        if (!product.TrangThai && activeVariants <= 0)
        {
            ShowToast(
                "Không thể bật trạng thái vì không có biến thể đang hoạt động.",
                false);
            return;
        }

        var oldStatus = product.TrangThai;

        try
        {
            updatingProductId = product.GiayId;

            product.TrangThai = !product.TrangThai;

            await GiayService.UpdateAsync(product);
            await LoadData();

            ShowToast(
                product.TrangThai
                    ? "Đã chuyển sản phẩm sang Đang bán."
                    : "Đã chuyển sản phẩm sang Ngừng bán.",
                true);
        }
        catch (Exception ex)
        {
            product.TrangThai = oldStatus;

            ShowToast(
                "Không thể đổi trạng thái: " + ex.Message,
                false);
        }
        finally
        {
            updatingProductId = null;
        }
    }

    private void SetStatusFilter(string value)
    {
        statusFilter = value;
        currentPage = 1;
    }

    private void ClearSearch()
    {
        SearchText = string.Empty;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            currentPage = page;
        }
    }

    private void PreviousPage()
    {
        ChangePage(currentPage - 1);
    }

    private void NextPage()
    {
        ChangePage(currentPage + 1);
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(
            e.Value?.ToString(),
            out var newSize))
        {
            pageSize = newSize;
            currentPage = 1;
        }
    }

    private void EnsureValidPage()
    {
        if (currentPage > TotalPages)
        {
            currentPage = TotalPages;
        }

        if (currentPage < 1)
        {
            currentPage = 1;
        }
    }

    private static string ShortId(Guid id)
    {
        return "#" + id
            .ToString()[..8]
            .ToUpperInvariant();
    }

    private static string GetProductInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "SP";

        var words = name.Trim()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
        {
            return words[0][0]
                .ToString()
                .ToUpperInvariant();
        }

        return string.Concat(
            words.First()[0],
            words.Last()[0])
            .ToUpperInvariant();
    }

    private static string GetStockClass(int stock)
    {
        if (stock <= 0)
            return "stock-badge out-of-stock";

        if (stock <= 10)
            return "stock-badge low-stock";

        return "stock-badge in-stock";
    }

    private void ShowToast(string message, bool success)
    {
        toastMessage = message;
        toastSuccess = success;
    }

    private void CloseToast()
    {
        toastMessage = string.Empty;
    }
}

<style>
    .product-page {
        --primary: #f97316;
        --primary-dark: #ea580c;
        --primary-light: #fff7ed;
        --text: #172033;
        --muted: #718096;
        --border: #e7ebf1;
        min-height: 100vh;
        padding: 28px;
        background: #f6f8fc;
        color: var(--text);
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }

    .page-heading {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .heading-icon {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 15px;
        background: linear-gradient(135deg, #fb923c, #ea580c);
        font-size: 24px;
        box-shadow: 0 8px 20px rgba(249, 115, 22, .25);
    }

    .page-heading h2 {
        margin: 0 0 4px;
        font-size: 25px;
        font-weight: 800;
    }

    .page-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
    }

    .add-button {
        min-height: 44px;
        padding: 0 18px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(135deg, #fb923c, #ea580c);
        color: white;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(249, 115, 22, .23);
        transition: .2s;
    }

        .add-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(249, 115, 22, .3);
        }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
        min-height: 100px;
        padding: 17px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: white;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .045);
    }

    .stat-icon {
        width: 47px;
        height: 47px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
