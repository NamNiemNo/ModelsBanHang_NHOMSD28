@page "/giay/{giayid:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@using API.IService
@using API.Models.DTO
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization

@inject IGiayChiTietService giayChiTietService
@inject IMauSacService mauSacService
@inject IKichCoService kichCoService
@inject IAnhService anhService
@inject NavigationManager NavigationManager

<div class="variant-page">

    <!-- HEADER -->
    <div class="page-header">

        <div class="header-left">
            <button class="back-button"
                    title="Quay lại"
                    @onclick="NavigateBack">
                ←
            </button>

            <div class="header-icon">◫</div>

            <div>
                <div class="breadcrumb">
                    Sản phẩm / Chi tiết sản phẩm
                </div>

                <h2>@ProductName</h2>

                <p>Quản lý màu sắc, kích cỡ, giá và tồn kho</p>
            </div>
        </div>

        <button class="add-button"
                @onclick="ShowAddModal">
            <span>＋</span>
            Thêm biến thể
        </button>

    </div>

    <!-- THỐNG KÊ -->
    <div class="stat-grid">

        <div class="stat-card">
            <div class="stat-icon total">◫</div>
            <div>
                <span>Tổng biến thể</span>
                <strong>@danhSachChiTiet.Count</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon active">✓</div>
            <div>
                <span>Đang bán</span>
                <strong>
                    @danhSachChiTiet.Count(x => x.TrangThai)
                </strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon inactive">⏸</div>
            <div>
                <span>Ngừng bán</span>
                <strong>
                    @danhSachChiTiet.Count(x => !x.TrangThai)
                </strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stock">▣</div>
            <div>
                <span>Tổng tồn kho</span>
                <strong>
                    @danhSachChiTiet.Sum(x => x.SoLuongCon)
                </strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon ordered">↗</div>
            <div>
                <span>Tổng đã đặt</span>
                <strong>
                    @danhSachChiTiet.Sum(x => x.SoLuongDat)
                </strong>
            </div>
        </div>

    </div>

    <!-- KHUNG BẢNG -->
    <div class="variant-panel">

        <!-- FILTER -->
        <div class="filter-toolbar">

            <div class="search-box">
                <span>⌕</span>

                <input placeholder="Tìm màu sắc, kích cỡ..."
                       @bind="SearchText"
                       @bind:event="oninput" />

                @if (!string.IsNullOrWhiteSpace(SearchText))
                {
                    <button @onclick="() => SearchText = string.Empty">
                        ×
                    </button>
                }
            </div>

            <div class="filter-controls">

                <select class="filter-select"
                        @bind="FilterStatus">
                    <option value="">Tất cả trạng thái</option>
                    <option value="True">Đang bán</option>
                    <option value="False">Ngừng bán</option>
                </select>

                <InputSelect class="filter-select"
                             @bind-Value="FilterMauSacId">
                    <option value="">Tất cả màu sắc</option>

                    @foreach (var color in mauSacList.OrderBy(x => x.TenMau))
                    {
                        <option value="@color.MauSacId">
                            @color.TenMau
                        </option>
                    }
                </InputSelect>

                <InputSelect class="filter-select"
                             @bind-Value="FilterKichCoId">
                    <option value="">Tất cả kích cỡ</option>

                    @foreach (var size in kichCoList.OrderBy(x => x.size))
                    {
                        <option value="@size.KichCoId">
                            Size @size.size
                        </option>
                    }
                </InputSelect>

                @if (HasActiveFilter)
                {
                    <button class="reset-filter"
                            @onclick="ResetFilter">
                        Đặt lại
                    </button>
                }

            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(pageError))
        {
            <div class="page-error">
                <span>!</span>
                <div>@pageError</div>
                <button @onclick="() => pageError = string.Empty">×</button>
            </div>
        }

        <!-- TABLE CÓ THANH CUỘN -->
        <div class="table-wrapper">

            <table class="variant-table">
                <thead>
                    <tr>
                        <th class="col-image">Ảnh</th>
                        <th>Thông tin biến thể</th>
                        <th>Màu sắc</th>
                        <th>Kích cỡ</th>
                        <th>Giá bán</th>
                        <th class="center">Tồn kho</th>
                        <th class="center">Đã đặt</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th>Ngày cập nhật</th>
                        <th class="col-action">Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="11">
                                <div class="loading-state">
                                    <div class="loading-spinner"></div>
                                    <span>Đang tải danh sách biến thể...</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (!PagedVariants.Any())
                    {
                        <tr>
                            <td colspan="11">
                                <div class="empty-state">
                                    <div>🔎</div>
                                    <strong>Không tìm thấy biến thể</strong>
                                    <span>
                                        Hãy thay đổi bộ lọc hoặc thêm biến thể mới
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in PagedVariants)
                        {
                            <tr>
                                <td>
                                    <div class="product-image">
                                        <img src="@GetImageUrl(item.AnhGiay)"
                                             alt="@item.TenGiay"
                                             onerror="this.src='/images/no-image.png';" />
                                    </div>
                                </td>

                                <td>
                                    <div class="variant-info">
                                        <strong>
                                            @GetVariantName(item)
                                        </strong>

                                        <small title="@item.GiayChiTietId">
                                            @ShortId(item.GiayChiTietId)
                                        </small>
                                    </div>
                                </td>

                                <td>
                                    <div class="color-info">
                                        <span class="color-circle"
                                              style="background-color:@GetColorCode(item.MauSacId)">
                                        </span>

                                        <strong>
                                            @(item.TenMau ?? "Chưa cập nhật")
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    <span class="size-badge">
                                        @item.size
                                    </span>
                                </td>

                                <td>
                                    <strong class="price-value">
                                        @item.Gia.ToString(
                                                 "N0",
                                                 new CultureInfo("vi-VN")) ₫
                                    </strong>
                                </td>

                                <td class="center">
                                    <span class="@GetStockClass(item.SoLuongCon)">
                                        @item.SoLuongCon
                                    </span>
                                </td>

                                <td class="center">
                                    <span class="ordered-value">
                                        @item.SoLuongDat
                                    </span>
                                </td>

                                <td>
                                    <button class="status-button @(item.TrangThai ? "selling" : "stopped")"
                                            disabled="@(updatingId == item.GiayChiTietId)"
                                            title="Nhấn để chuyển trạng thái"
                                            @onclick="() => ToggleStatus(item)">

                                        @if (updatingId == item.GiayChiTietId)
                                        {
                                            <span class="mini-spinner"></span>
                                        }
                                        else
                                        {
                                            <span class="status-dot"></span>
                                        }

                                        @(item.TrangThai
                                            ? "Đang bán"
                                            : "Ngừng bán")
                                    </button>
                                </td>

                                <td>
                                    <div class="date-value">
                                        <strong>
                                            @item.NgayTao.ToString("dd/MM/yyyy")
                                        </strong>
                                        <small>
                                            @item.NgayTao.ToString("HH:mm")
                                        </small>
                                    </div>
                                </td>

                                <td>
                                    <div class="date-value">
                                        <strong>
                                            @item.NgaySua.ToString("dd/MM/yyyy")
                                        </strong>
                                        <small>
                                            @item.NgaySua.ToString("HH:mm")
                                        </small>
                                    </div>
                                </td>

                                <td>
                                    <div class="action-group">
                                        <button class="edit-button"
                                                title="Chỉnh sửa biến thể"
                                                @onclick="() => EditItem(item)">
                                            ✎
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>

        <!-- PAGINATION -->
        <div class="pagination-bar">

            <div class="page-size">
                <span>Hiển thị</span>

                <select value="@pageSize"
                        @onchange="OnPageSizeChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>

                <span>biến thể</span>
            </div>

            <div class="result-info">
                Hiển thị
                <strong>@FirstDisplayedItem</strong>
                -
                <strong>@LastDisplayedItem</strong>
                trong
                <strong>@FilteredVariants.Count</strong>
                kết quả
            </div>

            <div class="pagination">

                <button disabled="@(currentPage == 1)"
                        @onclick="PreviousPage">
                    ‹
                </button>

                @foreach (var page in VisiblePages)
                {
                    var pageNumber = page;

                    <button class="@(pageNumber == currentPage ? "active" : "")"
                            @onclick="() => ChangePage(pageNumber)">
                        @pageNumber
                    </button>
                }

                <button disabled="@(currentPage == TotalPages)"
                        @onclick="NextPage">
                    ›
                </button>

            </div>

        </div>

    </div>

    <!-- MODAL THÊM/SỬA -->
    @if (showModal)
    {
        <div class="modal-overlay" @onclick="CloseModal">

            <div class="variant-modal"
                 @onclick:stopPropagation="true">

                <div class="modal-header">

                    <div>
                        <span class="modal-label">
                            @(isEditMode ? "CHỈNH SỬA" : "THÊM MỚI")
                        </span>

                        <h3>
                            @(isEditMode
                                ? "Cập nhật biến thể"
                                : "Thêm biến thể sản phẩm")
                        </h3>

                        <p>
                            Nhập màu sắc, kích cỡ, giá và số lượng
                        </p>
                    </div>

                    <button type="button"
                            class="close-modal"
                            disabled="@isSaving"
                            @onclick="CloseModal">
                        ×
                    </button>

                </div>

                <EditForm Model="@currentItem"
                          OnValidSubmit="@HandleSave"
                          FormName="GiayChiTietForm">

                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        <div class="modal-grid">

                            <!-- FORM -->
                            <div class="modal-form">

                                <div class="form-grid">

                                    <div class="form-group">
                                        <label>
                                            Màu sắc
                                            <span>*</span>
                                        </label>

                                        <InputSelect class="form-control-custom"
                                                     @bind-Value="currentItem.MauSacId">

                                            <option value="">
                                                -- Chọn màu sắc --
                                            </option>

                                            @foreach (var color in mauSacList
                                        .OrderBy(x => x.TenMau))
                                            {
                                                <option value="@color.MauSacId">
                                                    @color.TenMau
                                                </option>
                                            }

                                        </InputSelect>

                                        <ValidationMessage For="@(() => currentItem.MauSacId)" />
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            Kích cỡ
                                            <span>*</span>
                                        </label>

                                        <InputSelect class="form-control-custom"
                                                     @bind-Value="currentItem.KichCoId">

                                            <option value="">
                                                -- Chọn kích cỡ --
                                            </option>

                                            @foreach (var size in kichCoList
                                        .OrderBy(x => x.size))
                                            {
                                                <option value="@size.KichCoId">
                                                    Size @size.size
                                                </option>
                                            }

                                        </InputSelect>

                                        <ValidationMessage For="@(() => currentItem.KichCoId)" />
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            Giá bán
                                            <span>*</span>
                                        </label>

                                        <div class="money-input">
                                            <InputNumber class="form-control-custom"
                                                         @bind-Value="currentItem.Gia"
                                                         min="1000"
                                                         step="1000" />

                                            <span>₫</span>
                                        </div>

                                        <ValidationMessage For="@(() => currentItem.Gia)" />
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            Số lượng tồn kho
                                            <span>*</span>
                                        </label>

                                        <InputNumber class="form-control-custom"
                                                     @bind-Value="currentItem.SoLuongCon"
                                                     min="0" />

                                        <ValidationMessage For="@(() => currentItem.SoLuongCon)" />
                                    </div>

                                    <div class="form-group">
                                        <label>Số lượng đã đặt</label>

                                        <InputNumber class="form-control-custom readonly-input"
                                                     @bind-Value="currentItem.SoLuongDat"
                                                     readonly />

                                        <small class="field-note">
                                            Số lượng này được cập nhật từ đơn hàng
                                        </small>
                                    </div>

                                    <div class="form-group">
                                        <label>Trạng thái</label>

                                        <div class="status-switch-box">

                                            <label class="custom-switch">
                                                <InputCheckbox @bind-Value="currentItem.TrangThai" />
                                                <span class="switch-slider"></span>
                                            </label>

                                            <div>
                                                <strong>
                                                    @(currentItem.TrangThai
                                                        ? "Đang bán"
                                                        : "Ngừng bán")
                                                </strong>

                                                <small>
                                                    @(currentItem.TrangThai
                                                        ? "Biến thể được hiển thị"
                                                        : "Biến thể đang bị ẩn")
                                                </small>
                                            </div>

                                        </div>
                                    </div>

                                    <div class="form-group full-width">
                                        <label>Mô tả</label>

                                        <InputTextArea class="form-control-custom textarea-control"
                                                       @bind-Value="currentItem.MoTa"
                                                       placeholder="Nhập mô tả cho biến thể..." />
                                    </div>

                                </div>

                            </div>

                            <!-- IMAGE -->
                            <div class="image-column">
                                <label>Ảnh biến thể</label>

                                @if (HasPreviewImage)
                                {
                                    <div class="modal-image-preview">
                                        <img src="@CurrentPreviewImage"
                                             alt="Ảnh biến thể"
                                             onerror="this.src='/images/no-image.png';" />

                                        @if (pendingFile != null)
                                        {
                                            <button type="button"
                                                    title="Bỏ ảnh vừa chọn"
                                                    @onclick="RemovePendingImage">
                                                ×
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="empty-image">
                                        <span>🖼️</span>
                                        <strong>Chưa có ảnh</strong>
                                    </div>
                                }

                                <label class="upload-button">
                                    <InputFile OnChange="HandleFileChange"
                                               accept="image/jpeg,image/png,image/webp" />

                                    <span>⇧</span>
                                    @(HasPreviewImage ? "Thay ảnh" : "Chọn ảnh")
                                </label>

                                <small class="image-note">
                                    JPG, PNG hoặc WEBP, tối đa 5MB
                                </small>
                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(modalError))
                        {
                            <div class="modal-error">
                                <span>!</span>
                                <div>@modalError</div>
                            </div>
                        }

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="cancel-modal"
                                disabled="@isSaving"
                                @onclick="CloseModal">
                            Hủy
                        </button>

                        <button type="submit"
                                class="save-modal"
                                disabled="@isSaving">

                            @if (isSaving)
                            {
                                <span class="mini-spinner"></span>
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <span>✓</span>
                                <span>
                                    @(isEditMode ? "Lưu thay đổi" : "Thêm biến thể")
                                </span>
                            }

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>
    }

    <!-- TOAST -->
    @if (!string.IsNullOrWhiteSpace(toastMessage))
    {
        <div class="custom-toast @(toastSuccess ? "success" : "error")">
            <span class="toast-icon">
                @(toastSuccess ? "✓" : "!")
            </span>

            <div>
                <strong>
                    @(toastSuccess ? "Thành công" : "Có lỗi xảy ra")
                </strong>
                <small>@toastMessage</small>
            </div>

            <button @onclick="CloseToast">×</button>
        </div>
    }

</div>

@code {
    [Parameter]
    public Guid giayid { get; set; }

    private GiayChiTietDTO currentItem = new();

    private List<MauSacDTO> mauSacList = new();
    private List<KichCoDTO> kichCoList = new();
    private List<GiayChiTietDTO> danhSachChiTiet = new();

    private IBrowserFile? pendingFile;
    private string? pendingImagePreview;

    private bool isLoading = true;
    private bool isSaving;
    private bool isEditMode;
    private bool showModal;

    private Guid? updatingId;

    private string searchText = string.Empty;
    private string filterStatus = string.Empty;
    private Guid? filterMauSacId;
    private Guid? filterKichCoId;

    private string pageError = string.Empty;
    private string modalError = string.Empty;

    private string toastMessage = string.Empty;
    private bool toastSuccess;

    private int currentPage = 1;
    private int pageSize = 10;

    private string ProductName =>
        danhSachChiTiet.FirstOrDefault()?.TenGiay
        ?? "Chi tiết sản phẩm";

    private string SearchText
    {
        get => searchText;
        set
        {
            searchText = value;
            currentPage = 1;
        }
    }

    private string FilterStatus
    {
        get => filterStatus;
        set
        {
            filterStatus = value;
            currentPage = 1;
        }
    }

    private Guid? FilterMauSacId
    {
        get => filterMauSacId;
        set
        {
            filterMauSacId = value;
            currentPage = 1;
        }
    }

    private Guid? FilterKichCoId
    {
        get => filterKichCoId;
        set
        {
            filterKichCoId = value;
            currentPage = 1;
        }
    }

    private bool HasActiveFilter =>
        !string.IsNullOrWhiteSpace(searchText)
        || !string.IsNullOrWhiteSpace(filterStatus)
        || filterMauSacId.HasValue
        || filterKichCoId.HasValue;

    private List<GiayChiTietDTO> FilteredVariants =>
        danhSachChiTiet
            .Where(x =>
                string.IsNullOrWhiteSpace(searchText)
                || (x.TenMau ?? string.Empty)
                    .Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase)
                || x.size.ToString()
                    .Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase))
            .Where(x =>
                string.IsNullOrWhiteSpace(filterStatus)
                || x.TrangThai.ToString() == filterStatus)
            .Where(x =>
                !filterMauSacId.HasValue
                || x.MauSacId == filterMauSacId.Value)
            .Where(x =>
                !filterKichCoId.HasValue
                || x.KichCoId == filterKichCoId.Value)
            .ToList();

    private List<GiayChiTietDTO> PagedVariants =>
        FilteredVariants
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                (double)FilteredVariants.Count / pageSize));

    private IEnumerable<int> VisiblePages
    {
        get
        {
            const int maxVisible = 5;

            var start = Math.Max(
                1,
                currentPage - maxVisible / 2);

            var end = Math.Min(
                TotalPages,
                start + maxVisible - 1);

            start = Math.Max(
                1,
                end - maxVisible + 1);

            return Enumerable.Range(
                start,
                end - start + 1);
        }
    }

    private int FirstDisplayedItem =>
        FilteredVariants.Count == 0
            ? 0
            : (currentPage - 1) * pageSize + 1;

    private int LastDisplayedItem =>
        Math.Min(
            currentPage * pageSize,
            FilteredVariants.Count);

    private bool HasPreviewImage =>
        !string.IsNullOrWhiteSpace(pendingImagePreview)
        || !string.IsNullOrWhiteSpace(currentItem.AnhGiay);

    private string CurrentPreviewImage =>
        !string.IsNullOrWhiteSpace(pendingImagePreview)
            ? pendingImagePreview
            : GetImageUrl(currentItem.AnhGiay);

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            pageError = string.Empty;

            mauSacList =
                (await mauSacService.GetAllAsync())?.ToList()
                ?? new List<MauSacDTO>();

            kichCoList =
                (await kichCoService.GetAllAsync())?.ToList()
                ?? new List<KichCoDTO>();

            await LoadVariants();
        }
        catch (Exception ex)
        {
            pageError =
                "Không thể tải dữ liệu: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadVariants()
    {
        danhSachChiTiet =
            (await giayChiTietService
                .GetByGiayIdAsync(giayid))
            ?.OrderBy(x => x.TenMau)
            .ThenBy(x => x.size)
            .ToList()
            ?? new List<GiayChiTietDTO>();

        EnsureValidPage();
    }

    private void ShowAddModal()
    {
        currentItem = new GiayChiTietDTO
            {
                GiayId = giayid,
                TrangThai = true,
                SoLuongCon = 1,
                SoLuongDat = 0,
                NgayTao = DateTime.Now,
                NgaySua = DateTime.Now
            };

        isEditMode = false;
        modalError = string.Empty;
        pendingFile = null;
        pendingImagePreview = null;
        showModal = true;
    }

    private void EditItem(GiayChiTietDTO item)
    {
        currentItem = new GiayChiTietDTO
            {
                GiayChiTietId = item.GiayChiTietId,
                GiayId = item.GiayId,
                MauSacId = item.MauSacId,
                KichCoId = item.KichCoId,
                Gia = item.Gia,
                SoLuongCon = item.SoLuongCon,
                SoLuongDat = item.SoLuongDat,
                MoTa = item.MoTa,
                TrangThai = item.TrangThai,
                AnhGiay = item.AnhGiay,
                NgayTao = item.NgayTao,
                NgaySua = item.NgaySua,
                size = item.size,
                TenMau = item.TenMau,
                TenGiay = item.TenGiay
            };

        isEditMode = true;
        modalError = string.Empty;
        pendingFile = null;
        pendingImagePreview = null;
        showModal = true;
    }

    private void CloseModal()
    {
        if (isSaving)
            return;

        showModal = false;
        modalError = string.Empty;
        pendingFile = null;
        pendingImagePreview = null;
    }

    private async Task HandleSave()
    {
        if (isSaving)
            return;

        try
        {
            isSaving = true;
            modalError = string.Empty;

            if (!ValidateForm())
                return;

            currentItem.GiayId = giayid;
            currentItem.NgaySua = DateTime.Now;

            if (currentItem.SoLuongCon <= 0)
            {
                currentItem.SoLuongCon = 0;
                currentItem.TrangThai = false;
            }

            GiayChiTietDTO? savedItem;

            if (isEditMode)
            {
                savedItem =
                    await giayChiTietService.UpdateAsync(
                        currentItem.GiayChiTietId,
                        currentItem);
            }
            else
            {
                currentItem.NgayTao = DateTime.Now;

                savedItem =
                    await giayChiTietService.CreateAsync(
                        currentItem);
            }

            if (savedItem == null
                || savedItem.GiayChiTietId == Guid.Empty)
            {
                modalError =
                    "Không thể lưu biến thể sản phẩm.";
                return;
            }

            currentItem = savedItem;

            // Nếu biến thể đã được tạo nhưng ảnh lỗi,
            // chuyển về chế độ sửa để tránh tạo trùng khi lưu lại.
            isEditMode = true;

            if (pendingFile != null)
            {
                var uploaded =
                    await UploadImage(pendingFile);

                if (!uploaded)
                {
                    modalError =
                        "Biến thể đã được lưu nhưng upload ảnh thất bại.";
                    return;
                }
            }

            showModal = false;
            pendingFile = null;
            pendingImagePreview = null;

            await LoadVariants();

            ShowToast(
                isEditMode
                    ? "Đã lưu thông tin biến thể."
                    : "Đã thêm biến thể mới.",
                true);
        }
        catch (Exception ex)
        {
            modalError =
                "Không thể lưu biến thể: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool ValidateForm()
    {
        if (IsEmptyGuid(currentItem.MauSacId))
        {
            modalError = "Vui lòng chọn màu sắc.";
            return false;
        }

        if (IsEmptyGuid(currentItem.KichCoId))
        {
            modalError = "Vui lòng chọn kích cỡ.";
            return false;
        }

        if (currentItem.Gia <= 0)
        {
            modalError = "Giá bán phải lớn hơn 0.";
            return false;
        }

        if (currentItem.SoLuongCon < 0)
        {
            modalError =
                "Số lượng tồn kho không được nhỏ hơn 0.";
            return false;
        }

        var duplicated = danhSachChiTiet.Any(x =>
            x.GiayChiTietId != currentItem.GiayChiTietId
            && x.MauSacId == currentItem.MauSacId
            && x.KichCoId == currentItem.KichCoId);

        if (duplicated)
        {
            modalError =
                "Biến thể màu sắc và kích cỡ này đã tồn tại.";
            return false;
        }

        return true;
    }

    private async Task HandleFileChange(
        InputFileChangeEventArgs e)
    {
        try
        {
            modalError = string.Empty;

            var file = e.File;

            if (!file.ContentType.StartsWith(
                "image/",
                StringComparison.OrdinalIgnoreCase))
            {
                modalError =
                    "Chỉ được chọn tệp hình ảnh.";
                return;
            }

            if (file.Size > 5 * 1024 * 1024)
            {
                modalError =
                    "Dung lượng ảnh tối đa là 5MB.";
                return;
            }

            pendingFile = file;

            var resized =
                await file.RequestImageFileAsync(
                    "image/jpeg",
                    700,
                    700);

            await using var stream =
                resized.OpenReadStream(5 * 1024 * 1024);

            using var memory = new MemoryStream();

            await stream.CopyToAsync(memory);

            pendingImagePreview =
                $"data:image/jpeg;base64," +
                Convert.ToBase64String(memory.ToArray());
        }
        catch (Exception ex)
        {
            pendingFile = null;
            pendingImagePreview = null;

            modalError =
                "Không thể đọc ảnh: " + ex.Message;
        }
    }

    private void RemovePendingImage()
    {
        pendingFile = null;
        pendingImagePreview = null;
    }

    private async Task<bool> UploadImage(
        IBrowserFile file)
    {
        try
        {
            if (currentItem.GiayChiTietId == Guid.Empty)
                return false;

            var image = await anhService.UploadAsync(
                file,
                file.Name,
                currentItem.GiayChiTietId);

            if (image == null
                || string.IsNullOrWhiteSpace(image.DuongDan))
            {
                return false;
            }

            currentItem.AnhGiay = image.DuongDan;

            var updated =
                await giayChiTietService.UpdateAsync(
                    currentItem.GiayChiTietId,
                    currentItem);

            if (updated == null)
                return false;

            currentItem = updated;
            return true;
        }
        catch
        {
            return false;
        }
    }

    private async Task ToggleStatus(
        GiayChiTietDTO item)
    {
        if (updatingId.HasValue)
            return;

        if (!item.TrangThai && item.SoLuongCon <= 0)
        {
            ShowToast(
                "Biến thể đã hết hàng nên không thể chuyển sang Đang bán.",
                false);
            return;
        }

        var oldStatus = item.TrangThai;

        try
        {
            updatingId = item.GiayChiTietId;

            item.TrangThai = !item.TrangThai;
            item.NgaySua = DateTime.Now;

            var updated =
                await giayChiTietService.UpdateAsync(
                    item.GiayChiTietId,
                    item);

            if (updated == null)
            {
                item.TrangThai = oldStatus;

                ShowToast(
                    "Không thể cập nhật trạng thái.",
                    false);
                return;
            }

            await LoadVariants();

            ShowToast(
                updated.TrangThai
                    ? "Đã chuyển biến thể sang Đang bán."
                    : "Đã chuyển biến thể sang Ngừng bán.",
                true);
        }
        catch (Exception ex)
        {
            item.TrangThai = oldStatus;

            ShowToast(
                "Không thể đổi trạng thái: " + ex.Message,
                false);
        }
        finally
        {
            updatingId = null;
        }
    }

    private void ResetFilter()
    {
        SearchText = string.Empty;
        FilterStatus = string.Empty;
        FilterMauSacId = null;
        FilterKichCoId = null;
        currentPage = 1;
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(
            e.Value?.ToString(),
            out var newSize))
        {
            pageSize = newSize;
            currentPage = 1;
        }
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            currentPage = page;
        }
    }

    private void PreviousPage()
    {
        ChangePage(currentPage - 1);
    }

    private void NextPage()
    {
        ChangePage(currentPage + 1);
    }

    private void EnsureValidPage()
    {
        if (currentPage > TotalPages)
        {
            currentPage = TotalPages;
        }

        if (currentPage < 1)
        {
            currentPage = 1;
        }
    }

    private static bool IsEmptyGuid(object? value)
    {
        if (value == null)
            return true;

        var text = value.ToString();

        return string.IsNullOrWhiteSpace(text)
               || !Guid.TryParse(text, out var id)
               || id == Guid.Empty;
    }

    private string GetVariantName(GiayChiTietDTO item)
    {
        return $"{item.TenMau ?? "Màu"} - Size {item.size}";
    }

    private string GetColorCode(Guid? colorId)
    {
        var color = mauSacList.FirstOrDefault(x =>
            x.MauSacId == colorId);

        return string.IsNullOrWhiteSpace(color?.Color)
            ? "#cbd5e1"
            : color.Color;
    }

    private static string GetStockClass(int stock)
    {
        if (stock <= 0)
            return "stock-badge out-of-stock";

        if (stock <= 10)
            return "stock-badge low-stock";

        return "stock-badge in-stock";
    }

    private static string ShortId(Guid id)
    {
        return "#" + id
            .ToString()[..8]
            .ToUpperInvariant();
    }

    private static string GetImageUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return "/images/no-image.png";

        if (path.StartsWith(
                "http",
                StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(
                "data:",
                StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        if (!path.StartsWith("/"))
        {
            path = "/" + path;
        }

        return $"https://localhost:7246{path}";
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/sanpham");
    }

    private void ShowToast(
        string message,
        bool success)
    {
        toastMessage = message;
        toastSuccess = success;
    }

    private void CloseToast()
    {
        toastMessage = string.Empty;
    }
}

