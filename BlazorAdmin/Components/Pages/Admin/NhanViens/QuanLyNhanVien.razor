@page "/QuanLyNhanVien"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@using Data.Models
@using BlazorAdmin.Service.IService
@using Microsoft.JSInterop

@inject INhanVienService service
@inject ITaiKhoanService TKservice
@inject NavigationManager manager
@inject IJSRuntime JS

<div class="employee-page">

    <!-- HEADER -->
    <div class="page-header">
        <div>
            <div class="page-title-row">
                <div class="title-icon">NV</div>

                <div>
                    <h2>Quản lý nhân viên</h2>
                    <p>Quản lý thông tin, tài khoản và trạng thái nhân viên</p>
                </div>
            </div>
        </div>

        <button class="btn-add" @onclick="NavigateToCreate">
            <span>＋</span>
            Thêm nhân viên
        </button>
    </div>

    <!-- THỐNG KÊ -->
    <div class="stat-grid">

        <div class="stat-card">
            <div class="stat-icon total">👥</div>
            <div>
                <span class="stat-label">Tổng nhân viên</span>
                <strong>@NhanViens.Count</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon active">✓</div>
            <div>
                <span class="stat-label">Đang hoạt động</span>
                <strong>@NhanViens.Count(x => x.TrangThai)</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon inactive">⏸</div>
            <div>
                <span class="stat-label">Ngừng hoạt động</span>
                <strong>@NhanViens.Count(x => !x.TrangThai)</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon admin">★</div>
            <div>
                <span class="stat-label">Quản trị viên</span>
                <strong>@NhanViens.Count(x => x.ChucVuId == AdminRoleId)</strong>
            </div>
        </div>

    </div>

    <!-- KHUNG DANH SÁCH -->
    <div class="employee-panel">

        <!-- TOOLBAR -->
        <div class="panel-toolbar">

            <div class="search-box">
                <span class="search-icon">⌕</span>

                <input type="text"
                       placeholder="Tìm theo tên, số điện thoại, email..."
                       @bind="SearchKeyword"
                       @bind:event="oninput" />

                @if (!string.IsNullOrWhiteSpace(SearchKeyword))
                {
                    <button class="clear-search"
                            title="Xóa tìm kiếm"
                            @onclick="ClearSearch">
                        ×
                    </button>
                }
            </div>

            <div class="filter-group">

                <button class="@GetFilterClass("all")"
                        @onclick='() => SetStatusFilter("all")'>
                    Tất cả
                    <span>@NhanViens.Count</span>
                </button>

                <button class="@GetFilterClass("active")"
                        @onclick='() => SetStatusFilter("active")'>
                    Hoạt động
                    <span>@NhanViens.Count(x => x.TrangThai)</span>
                </button>

                <button class="@GetFilterClass("inactive")"
                        @onclick='() => SetStatusFilter("inactive")'>
                    Ngừng hoạt động
                    <span>@NhanViens.Count(x => !x.TrangThai)</span>
                </button>

            </div>

        </div>

        <!-- BẢNG CÓ THANH CUỘN NGANG + DỌC -->
        <div class="table-scroll">

            <table class="employee-table">
                <thead>
                    <tr>
                        <th class="col-stt">STT</th>
                        <th>Nhân viên</th>
                        <th>Liên hệ</th>
                        <th>Ngày sinh</th>
                        <th>Chức vụ</th>
                        <th>Ngày cập nhật</th>
                        <th>Trạng thái</th>
                        <th class="col-action">Chức năng</th>
                    </tr>
                </thead>

                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="loading-spinner"></div>
                                    <span>Đang tải danh sách nhân viên...</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (!PagedNhanViens.Any())
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="empty-icon">🔎</div>
                                    <strong>Không tìm thấy nhân viên</strong>
                                    <span>Hãy thử thay đổi từ khóa hoặc bộ lọc</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in PagedNhanViens.Select((item, index) => new
                        {
                            Item = item,
                            Index = index
                        }))
                        {
                            var item = row.Item;

                            <tr>
                                <td class="stt-cell">
                                    @((CurrentPage - 1) * PageSize + row.Index + 1)
                                </td>

                                <td>
                                    <div class="employee-info">
                                        <div class="employee-avatar">
                                            @GetInitials(item.HoTen)
                                        </div>

                                        <div>
                                            <strong>@item.HoTen</strong>
                                            <small title="@item.NhanVienId">
                                                @ShortId(item.NhanVienId)
                                            </small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="contact-info">
                                        <span>☎ @item.SoDienThoai</span>
                                        <small>✉ @item.Email</small>
                                    </div>
                                </td>

                                <td>
                                    @item.NgaySinh.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    <span class="role-badge @(item.ChucVuId == AdminRoleId ? "role-admin" : "role-staff")">
                                        @(item.ChucVu?.MotaChucVu ?? "Chưa có chức vụ")
                                    </span>
                                </td>

                                <td>
                                    <div class="date-info">
                                        <span>
                                            @item.NgayCapNhatCuoiCung.ToString("dd/MM/yyyy")
                                        </span>
                                        <small>
                                            @item.NgayCapNhatCuoiCung.ToString("HH:mm")
                                        </small>
                                    </div>
                                </td>

                                <td>
                                    <button class="status-button @(item.TrangThai ? "status-active" : "status-inactive")"
                                            title="Nhấn để chuyển trạng thái"
                                            disabled="@(updatingId == item.NhanVienId)"
                                            @onclick="() => ToggleTrangThai(item.NhanVienId)">

                                        @if (updatingId == item.NhanVienId)
                                        {
                                            <span class="mini-spinner"></span>
                                        }
                                        else
                                        {
                                            <span class="status-dot"></span>
                                        }

                                        @(item.TrangThai
                                            ? "Đang hoạt động"
                                            : "Ngừng hoạt động")
                                    </button>
                                </td>

                                <td>
                                    <div class="action-group">

                                        <button class="action-button edit"
                                                title="Chỉnh sửa nhân viên"
                                                @onclick="() => NavigateToEdit(item.NhanVienId)">
                                            ✎
                                        </button>

                                        <button class="action-button delete"
                                                title="Xóa nhân viên"
                                                disabled="@(deletingId == item.NhanVienId)"
                                                @onclick="() => DeleteAsyncNhanVien(item.NhanVienId)">

                                            @if (deletingId == item.NhanVienId)
                                            {
                                                <span class="mini-spinner"></span>
                                            }
                                            else
                                            {
                                                <span>⌫</span>
                                            }

                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>

        <!-- PHÂN TRANG -->
        <div class="pagination-bar">

            <div class="page-size">
                <span>Hiển thị</span>

                <select value="@PageSize" @onchange="OnPageSizeChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                </select>

                <span>nhân viên</span>
            </div>

            <div class="result-count">
                Hiển thị
                <strong>@FirstDisplayedItem</strong>
                -
                <strong>@LastDisplayedItem</strong>
                trong
                <strong>@FilteredNhanViens.Count</strong>
                kết quả
            </div>

            <div class="pagination">

                <button disabled="@(CurrentPage == 1)"
                        @onclick="PreviousPage">
                    ‹
                </button>

                @for (var page = 1; page <= TotalPages; page++)
                {
                    var pageNumber = page;

                    <button class="@(pageNumber == CurrentPage ? "active" : "")"
                            @onclick="() => ChangePage(pageNumber)">
                        @pageNumber
                    </button>
                }

                <button disabled="@(CurrentPage == TotalPages)"
                        @onclick="NextPage">
                    ›
                </button>

            </div>

        </div>
    </div>

    <!-- THÔNG BÁO -->
    @if (!string.IsNullOrWhiteSpace(toastMessage))
    {
        <div class="custom-toast @(toastSuccess ? "toast-success" : "toast-error")">
            <span>@(toastSuccess ? "✓" : "!")</span>
            <div>
                <strong>@(toastSuccess ? "Thành công" : "Có lỗi xảy ra")</strong>
                <small>@toastMessage</small>
            </div>
            <button @onclick="CloseToast">×</button>
        </div>
    }

</div>

@code {
    private readonly Guid AdminEmployeeId =
        Guid.Parse("88888888-8888-8888-8888-888888888888");

    private readonly Guid AdminRoleId =
        Guid.Parse("11111111-1111-1111-1111-111111111111");

    private List<NhanVien> NhanViens = new();

    private string searchKeyword = string.Empty;
    private string statusFilter = "all";

    private int CurrentPage = 1;
    private int PageSize = 10;

    private bool isLoading = true;

    private Guid? deletingId;
    private Guid? updatingId;

    private string toastMessage = string.Empty;
    private bool toastSuccess;

    private string SearchKeyword
    {
        get => searchKeyword;
        set
        {
            searchKeyword = value;
            CurrentPage = 1;
        }
    }

    private List<NhanVien> FilteredNhanViens =>
        NhanViens
            .Where(x =>
                statusFilter == "all"
                || (statusFilter == "active" && x.TrangThai)
                || (statusFilter == "inactive" && !x.TrangThai))
            .Where(x =>
                string.IsNullOrWhiteSpace(searchKeyword)
                || (x.HoTen ?? string.Empty)
                    .Contains(searchKeyword, StringComparison.OrdinalIgnoreCase)
                || (x.SoDienThoai ?? string.Empty)
                    .Contains(searchKeyword, StringComparison.OrdinalIgnoreCase)
                || (x.Email ?? string.Empty)
                    .Contains(searchKeyword, StringComparison.OrdinalIgnoreCase)
                || (x.ChucVu?.MotaChucVu ?? string.Empty)
                    .Contains(searchKeyword, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private List<NhanVien> PagedNhanViens =>
        FilteredNhanViens
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                (double)FilteredNhanViens.Count / PageSize));

    private int FirstDisplayedItem =>
        FilteredNhanViens.Count == 0
            ? 0
            : (CurrentPage - 1) * PageSize + 1;

    private int LastDisplayedItem =>
        Math.Min(
            CurrentPage * PageSize,
            FilteredNhanViens.Count);

    protected override async Task OnInitializedAsync()
    {
        await LoadNhanViensAsync();
    }

    private async Task LoadNhanViensAsync()
    {
        try
        {
            isLoading = true;

            var result = await service.GetAllNhanVienAsync();

            NhanViens = result
                .Where(x => x.NhanVienId != AdminEmployeeId)
                .OrderByDescending(x => x.NgayCapNhatCuoiCung)
                .ToList();

            EnsureValidPage();
        }
        catch (Exception ex)
        {
            ShowToast("Không thể tải nhân viên: " + ex.Message, false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToCreate()
    {
        manager.NavigateTo("/AddNhanVien");
    }

    private void NavigateToEdit(Guid id)
    {
        manager.NavigateTo($"/EditNhanVien/{id}");
    }

    private async Task DeleteAsyncNhanVien(Guid id)
    {
        var employee = NhanViens.FirstOrDefault(x => x.NhanVienId == id);

        if (employee == null)
            return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Bạn có chắc chắn muốn xóa nhân viên \"{employee.HoTen}\" không?");

        if (!confirmed)
            return;

        try
        {
            deletingId = id;

            var employeeDetail =
                await service.GetByIdNhanVienAsync(id);

            if (employeeDetail == null)
            {
                ShowToast("Không tìm thấy nhân viên.", false);
                return;
            }

            var accountId = employeeDetail.TaikhoanId;

            await service.DeleteNhanVienAsync(id);

            if (accountId.HasValue)
            {
                await TKservice.DeleteTaiKhoanAsync(accountId.Value);
            }

            await LoadNhanViensAsync();

            ShowToast("Đã xóa nhân viên thành công.", true);
        }
        catch (Exception ex)
        {
            ShowToast("Không thể xóa nhân viên: " + ex.Message, false);
        }
        finally
        {
            deletingId = null;
        }
    }

    private async Task ToggleTrangThai(Guid id)
    {
        var employee =
            NhanViens.FirstOrDefault(x => x.NhanVienId == id);

        if (employee == null)
            return;

        var oldStatus = employee.TrangThai;

        try
        {
            updatingId = id;

            employee.TrangThai = !employee.TrangThai;
            employee.NgayCapNhatCuoiCung = DateTime.Now;

            await service.UpdateNhanVienAsync(employee);
            await LoadNhanViensAsync();

            ShowToast(
                employee.TrangThai
                    ? "Đã kích hoạt nhân viên."
                    : "Đã ngừng hoạt động nhân viên.",
                true);
        }
        catch (Exception ex)
        {
            employee.TrangThai = oldStatus;

            ShowToast(
                "Không thể cập nhật trạng thái: " + ex.Message,
                false);
        }
        finally
        {
            updatingId = null;
        }
    }

    private void SetStatusFilter(string status)
    {
        statusFilter = status;
        CurrentPage = 1;
    }

    private string GetFilterClass(string status)
    {
        return statusFilter == status
            ? "filter-button active"
            : "filter-button";
    }

    private void ClearSearch()
    {
        SearchKeyword = string.Empty;
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void PreviousPage()
    {
        ChangePage(CurrentPage - 1);
    }

    private void NextPage()
    {
        ChangePage(CurrentPage + 1);
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            PageSize = value;
            CurrentPage = 1;
        }
    }

    private void EnsureValidPage()
    {
        if (CurrentPage > TotalPages)
        {
            CurrentPage = TotalPages;
        }

        if (CurrentPage < 1)
        {
            CurrentPage = 1;
        }
    }

    private static string ShortId(Guid id)
    {
        return "#" + id.ToString()[..8].ToUpperInvariant();
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "NV";

        var words = fullName
            .Trim()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
        {
            return words[0][0].ToString().ToUpperInvariant();
        }

        return string.Concat(
            words.First()[0],
            words.Last()[0]).ToUpperInvariant();
    }

    private void ShowToast(string message, bool success)
    {
        toastMessage = message;
        toastSuccess = success;
    }

    private void CloseToast()
    {
        toastMessage = string.Empty;
    }
}

<style>
    .employee-page {
        --primary: #f97316;
        --primary-dark: #ea580c;
        --primary-light: #fff7ed;
        --text: #172033;
        --muted: #718096;
        --border: #e8edf4;
        min-height: 100vh;
        padding: 28px;
        background: #f6f8fc;
        color: var(--text);
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .page-title-row {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .title-icon {
        width: 50px;
        height: 50px;
        display: grid;
        place-items: center;
        border-radius: 15px;
        background: linear-gradient(135deg, #fb923c, #ea580c);
        color: white;
        font-size: 15px;
        font-weight: 800;
        box-shadow: 0 8px 20px rgba(249, 115, 22, .25);
    }

    .page-header h2 {
        margin: 0 0 4px;
        font-size: 25px;
        font-weight: 800;
    }

    .page-header p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
    }

    .btn-add {
        min-height: 44px;
        padding: 0 18px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(135deg, #fb923c, #ea580c);
        color: white;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(249, 115, 22, .22);
        transition: .2s;
    }

        .btn-add:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(249, 115, 22, .3);
        }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 105px;
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: white;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .045);
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 14px;
        font-size: 20px;
        font-weight: 800;
    }

        .stat-icon.total {
            color: #2563eb;
            background: #eff6ff;
        }

        .stat-icon.active {
            color: #059669;
            background: #ecfdf5;
        }

        .stat-icon.inactive {
            color: #64748b;
            background: #f1f5f9;
        }

        .stat-icon.admin {
            color: var(--primary-dark);
            background: var(--primary-light);
        }

    .stat-label {
        display: block;
        margin-bottom: 5px;
        color: var(--muted);
        font-size: 13px;
    }

    .stat-card strong {
        font-size: 25px;
        line-height: 1;
    }

    .employee-panel {
        display: flex;
        flex-direction: column;
        height: 620px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: white;
        box-shadow: 0 8px 28px rgba(15, 23, 42, .055);
    }

    .panel-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-shrink: 0;
        padding: 18px 20px;
        border-bottom: 1px solid var(--border);
    }

    .search-box {
        position: relative;
        width: min(480px, 100%);
    }

        .search-box input {
            width: 100%;
            height: 44px;
            padding: 0 42px;
            border: 1px solid #dce3ec;
            border-radius: 12px;
            outline: none;
            font-size: 14px;
            transition: .2s;
        }

            .search-box input:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(249, 115, 22, .1);
            }

    .search-icon {
        position: absolute;
        top: 50%;
        left: 15px;
        color: #94a3b8;
        font-size: 22px;
        transform: translateY(-50%);
    }

    .clear-search {
        position: absolute;
        top: 50%;
        right: 12px;
        width: 26px;
        height: 26px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: #f1f5f9;
        color: #64748b;
        cursor: pointer;
        transform: translateY(-50%);
    }

    .filter-group {
        display: flex;
        gap: 8px;
        overflow-x: auto;
    }

    .filter-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 38px;
        padding: 0 12px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: white;
        color: #64748b;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
        cursor: pointer;
    }

        .filter-button span {
            padding: 2px 7px;
            border-radius: 20px;
            background: #f1f5f9;
            font-size: 11px;
        }

        .filter-button.active {
            border-color: #fed7aa;
            background: var(--primary-light);
            color: var(--primary-dark);
        }

            .filter-button.active span {
                background: #ffedd5;
            }

    .table-scroll {
        flex: 1;
        min-height: 0;
        overflow-x: auto;
        overflow-y: auto;
    }

    .employee-table {
        width: 100%;
        min-width: 1180px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .employee-table thead th {
            position: sticky;
            top: 0;
            z-index: 3;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            background: #f8fafc;
            color: #64748b;
            font-size: 12px;
            font-weight: 800;
            text-align: left;
            text-transform: uppercase;
            letter-spacing: .35px;
            white-space: nowrap;
        }

        .employee-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid #edf1f6;
            color: #334155;
            font-size: 14px;
            vertical-align: middle;
        }

        .employee-table tbody tr {
            transition: background .15s;
        }

            .employee-table tbody tr:hover {
                background: #fffaf5;
            }

    .col-stt {
        width: 70px;
        text-align: center !important;
    }

    .col-action {
        width: 120px;
        text-align: center !important;
    }

    .stt-cell {
        color: #94a3b8 !important;
        font-weight: 700;
        text-align: center;
    }

    .employee-info {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 185px;
    }

    .employee-avatar {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border: 1px solid #fed7aa;
        border-radius: 12px;
        background: var(--primary-light);
        color: var(--primary-dark);
        font-size: 13px;
        font-weight: 800;
    }

    .employee-info strong,
    .employee-info small,
    .contact-info span,
    .contact-info small,
    .date-info span,
    .date-info small {
