<div class="staff-navigation">

    <div class="staff-brand">
        <div class="staff-brand-icon">
            <i class="bi bi-shop"></i>
        </div>

        <div>
            <strong>Sneaker Store</strong>
            <small>Khu vực nhân viên</small>
        </div>
    </div>

    <div class="staff-menu">
        <div class="staff-menu-title">Chức năng</div>

        <NavLink class="staff-menu-entry"
                 href="/BanHang"
                 @onclick="NotifyNavigation">
            <span>
                <i class="bi bi-cart-check-fill"></i>
            </span>

            <div>
                <strong>Bán hàng tại quầy</strong>
                <small>Tạo và thanh toán đơn hàng</small>
            </div>
        </NavLink>

        <NavLink class="staff-menu-entry"
                 href="/TraHang"
                 @onclick="NotifyNavigation">
            <span>
                <i class="bi bi-arrow-return-left"></i>
            </span>

            <div>
                <strong>Trả hàng</strong>
                <small>Tiếp nhận yêu cầu trả hàng</small>
            </div>
        </NavLink>
    </div>

    <div class="staff-footer">
        <i class="bi bi-person-badge"></i>

        <div>
            <strong>Nhân viên</strong>
            <small>Tài khoản bán hàng</small>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private async Task NotifyNavigation()
    {
        await OnNavigate.InvokeAsync();
    }
}

<style>
    .staff-navigation {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: radial-gradient(circle at top left, rgba(249,115,22,.18), transparent 35%), #111827;
        color: #fff;
    }

    .staff-brand {
        min-height: 82px;
        padding: 17px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .staff-brand-icon {
        width: 45px;
        height: 45px;
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: linear-gradient(135deg, #fb923c, #ea580c);
        font-size: 20px;
    }

    .staff-brand strong,
    .staff-brand small {
        display: block;
    }

    .staff-brand strong {
        font-size: 15px;
    }

    .staff-brand small {
        margin-top: 3px;
        color: #94a3b8;
        font-size: 11px;
    }

    .staff-menu {
        flex: 1;
        padding: 20px 12px;
        overflow-y: auto;
    }

    .staff-menu-title {
        padding: 0 12px 10px;
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .staff-menu-entry {
        margin-bottom: 7px;
        padding: 11px;
        display: flex;
        align-items: center;
        gap: 11px;
        border-radius: 12px;
        color: #cbd5e1;
        text-decoration: none;
        transition: .2s ease;
    }

        .staff-menu-entry:hover {
            background: rgba(255,255,255,.07);
            color: #fff;
        }

        .staff-menu-entry.active {
            background: linear-gradient(135deg, #f97316, #ea580c);
            color: #fff;
            box-shadow: 0 8px 18px rgba(234,88,12,.24);
        }

        .staff-menu-entry > span {
            width: 37px;
            height: 37px;
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: rgba(255,255,255,.08);
        }

        .staff-menu-entry strong,
        .staff-menu-entry small {
            display: block;
        }

        .staff-menu-entry strong {
            font-size: 13px;
        }

        .staff-menu-entry small {
            margin-top: 3px;
            color: #94a3b8;
            font-size: 10px;
        }

        .staff-menu-entry.active small {
            color: rgba(255,255,255,.75);
        }

    .staff-footer {
        margin: 12px;
        padding: 13px;
        display: flex;
        align-items: center;
        gap: 11px;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 13px;
        background: rgba(255,255,255,.04);
    }

        .staff-footer > i {
            color: #fb923c;
            font-size: 22px;
        }

        .staff-footer strong,
        .staff-footer small {
            display: block;
        }

        .staff-footer strong {
            font-size: 12px;
        }

        .staff-footer small {
            margin-top: 2px;
            color: #64748b;
            font-size: 10px;
        }
</style>